# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# P-048: com R8 ligado em `kotlin.**` o build de release caía ao abrir (PushHub -> kotlin.sequences) com
# IllegalAccessError: "Class kotlin.sequences.d extended by class qh1 is inaccessible". O R8 renomeou as partes das fachadas multi-arquivo
# da stdlib (SequencesKt__*, SequencesKt___*) para pacotes diferentes, e a superclasse não pública deixou de ser acessível.
# Manter os nomes das classes da stdlib do Kotlin evita isso; o que não é usado continua sendo removido pelo shrinking.
-keepnames class kotlin.** { *; }
