<?xml version="1.0" encoding="utf-8"?><!--
   Backup automático do Android até a API 30 (fullBackupContent). A sessão do paciente fica cifrada com uma chave do Android Keystore,
   que nunca sai do aparelho: o arquivo dela fica FORA do backup (decisão de 26/11/2026). O resto continua como era.
   Veja https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="nora_secure_session.xml" />
</full-backup-content>
