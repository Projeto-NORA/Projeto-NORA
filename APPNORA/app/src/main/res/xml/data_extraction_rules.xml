<?xml version="1.0" encoding="utf-8"?><!--
   Backup na nuvem e transferência entre aparelhos a partir da API 31 (dataExtractionRules). A sessão do paciente fica cifrada com uma chave
   do Android Keystore, que nunca sai do aparelho: o arquivo dela fica FORA dos dois caminhos (decisão de 26/11/2026). O resto continua como era.
   Veja https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nora_secure_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nora_secure_session.xml" />
    </device-transfer>
</data-extraction-rules>
