<UserControl x:Class="Nora.Desktop.Views.OperationalAccessView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{Binding AccessRequiredTitle}" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="{Binding AccessRequiredDescription}" Style="{StaticResource Muted}" Margin="0,8,0,26" />
    <Border Background="{DynamicResource BrandGradientBrush}" CornerRadius="22" Padding="30" MaxWidth="680" HorizontalAlignment="Left">
      <StackPanel>
        <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource BrandSoftBrush}" HorizontalAlignment="Left">
          <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Dados protegidos da unidade" Foreground="{DynamicResource BrandTextBrush}" Style="{StaticResource SectionTitle}" Margin="0,18,0,6" />
        <TextBlock Text="{Binding AccessRequiredHint}" Foreground="#D9FFFFFF" TextWrapping="Wrap" />
        <Button Content="Ir para acesso" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="home" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" Background="#063B7A" Foreground="#FFFFFF" BorderThickness="0" ToolTip="Vai à tela de acesso."/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
