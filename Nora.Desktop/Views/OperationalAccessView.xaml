<UserControl x:Class="Nora.Desktop.Views.OperationalAccessView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Tela protegida sem sessão (só aparece fora do login compacto, em prévias e testes): o nome da tela fica no cabeçalho da janela, então aqui vai só o aviso e o caminho para entrar, no visual de NoticeItem. -->
  <ContentControl Style="{StaticResource NoticeItem}" MaxWidth="820" HorizontalAlignment="Left" AutomationProperties.Name="Dados protegidos da unidade">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding AccessRequiredHint}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Ir para acesso" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="home" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" MinHeight="36" ToolTip="Vai à tela de acesso." />
    </Grid>
  </ContentControl>
</UserControl>
