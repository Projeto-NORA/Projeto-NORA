<UserControl x:Class="Nora.Desktop.Views.AlertCriteriaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Nenhum alerta é avaliado: os limites ainda não foram definidos. A lista mostra o dado que já existe e a decisão que falta, sem números. -->
  <StackPanel>
    <Border Background="{DynamicResource BrandSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18" AutomationProperties.Name="Alertas ainda não avaliados">
      <StackPanel>
        <TextBlock Text="Nenhum alerta é avaliado ainda" FontWeight="SemiBold" FontSize="15" />
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="Os limites que definem um alerta ainda não foram definidos, e nenhum número é inventado aqui. Abaixo está o que já tem dado para virar alerta assim que os limites forem decididos." />
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding AlertCriteria}" AutomationProperties.Name="Critérios de alerta">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12" AutomationProperties.Name="{Binding Title}">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock">
                      <Setter Property="Text" Value="&#xE7BA;" /><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                      <Style.Triggers><DataTrigger Binding="{Binding DataReady}" Value="True"><Setter Property="Text" Value="&#xE73E;" /><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                  </TextBlock>
                  <TextBlock Text="{Binding DataStateLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"><Run Text="O que mediria: " FontWeight="SemiBold" /><Run Text="{Binding Measures, Mode=OneWay}" /></TextBlock>
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="Onde está o dado: " FontWeight="SemiBold" /><Run Text="{Binding DataSource, Mode=OneWay}" /></TextBlock>
              <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"><Run Text="Falta decidir: " FontWeight="SemiBold" /><Run Text="{Binding Pending, Mode=OneWay}" /></TextBlock>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
