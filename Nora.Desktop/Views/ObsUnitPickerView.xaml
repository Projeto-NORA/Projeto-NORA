<UserControl x:Class="Nora.Desktop.Views.ObsUnitPickerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Seletor único de UBS: Painel da UBS e Pacientes usam o mesmo. Trocar de UBS sempre exige confirmar. -->
  <StackPanel IsEnabled="{Binding CanOperate}">
    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" Text="{Binding ObsUnitPrompt}" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="Escolha a UBS (nome e região)" />
    <ComboBox ItemsSource="{Binding ObsUnits}" SelectedItem="{Binding CandidateObsUnit}" DisplayMemberPath="SelectorLabel" IsEnabled="{Binding HasAvailableObsUnits}" AutomationProperties.Name="UBS autorizada no OBS" Margin="0,6,0,12" />
    <WrapPanel>
      <Button Content="Confirmar UBS" Click="OnConfirm" IsEnabled="{Binding CanConfirmObsUnit}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" ToolTip="Carrega cadastro, fila, vagas, resumo do dia e agenda da UBS escolhida." />
      <Button Content="Atualizar lista de UBS" Click="OnLoadUnits" Margin="0,0,8,8" ToolTip="Consulta novamente as UBS que a Secretaria autorizou para esta conta." />
      <Button Content="Sugerir UBS pela localização" Click="OnLocate" IsEnabled="{Binding HasAvailableObsUnits}" Margin="0,0,0,8" />
    </WrapPanel>
  </StackPanel>
</UserControl>
