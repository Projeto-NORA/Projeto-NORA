<UserControl x:Class="Nora.Desktop.Views.LoadingStatus" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False" Visibility="Collapsed">
  <!-- Leitura em andamento das telas de números da rede: o indicador girando na cor da marca e o passo escrito ao lado ("Atualizando os indicadores…"). Some quando o texto fica vazio. -->
  <StackPanel Orientation="Horizontal">
    <Path x:Name="Spinner" Data="M 7,1.3 A 5.7,5.7 0 1 1 1.3,7" Stroke="{DynamicResource BrandBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0">
      <Path.RenderTransform><RotateTransform x:Name="SpinnerRotation" Angle="0" /></Path.RenderTransform>
    </Path>
    <TextBlock x:Name="Label" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>
