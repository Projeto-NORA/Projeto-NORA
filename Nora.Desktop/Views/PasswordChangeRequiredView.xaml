<UserControl x:Class="Nora.Desktop.Views.PasswordChangeRequiredView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Troca obrigatória da senha provisória: o nome da tela ("Definir nova senha") fica no cabeçalho da janela, então aqui só vai a instrução e o formulário, sem card. Sair fica à esquerda do primário. -->
  <StackPanel MaxWidth="860" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,18" Text="Sua senha é provisória. Escolha uma nova para usar o sistema." />
    <views:ChangePasswordView>
      <views:ChangePasswordView.Secondary>
        <Button Content="Sair" Command="{Binding LogoutCommand}" MinHeight="40" MinWidth="112" ToolTip="Sai da conta sem trocar a senha." AutomationProperties.Name="Sair da conta" />
      </views:ChangePasswordView.Secondary>
    </views:ChangePasswordView>
  </StackPanel>
</UserControl>
