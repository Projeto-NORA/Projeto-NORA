<UserControl x:Class="Nora.Desktop.Views.PasswordChangeRequiredView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <Border Style="{StaticResource Card}" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
    <StackPanel>
      <TextBlock Text="Defina uma nova senha" FontSize="26" FontWeight="SemiBold" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,20" Text="Sua senha é provisória. Escolha uma nova para usar o sistema." />
      <views:ChangePasswordView />
      <Button Content="Sair" Command="{Binding LogoutCommand}" HorizontalAlignment="Left" Margin="0,20,0,0" ToolTip="Sai da conta sem trocar a senha." AutomationProperties.Name="Sair da conta" />
    </StackPanel>
  </Border>
</UserControl>
