<UserControl x:Class="Nora.Desktop.Views.AgendaBookingForm" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Formulário do pop-up "Agendar nova consulta" (DataContext = o espaço de trabalho). UBS com profissional ativo marca só pelo catálogo (especialidade, profissional e horário livre da grade);
       sem profissional ativo o agendamento continua em texto livre. Sem card: o pop-up já é o card. -->
  <UserControl.Resources>
    <Style x:Key="BookingLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelText}"><Setter Property="Margin" Value="0,0,0,6" /></Style>
  </UserControl.Resources>
  <views:FormGrid MaxColumns="2">
    <TextBlock views:FormGrid.FullRow="True" Text="{Binding BookingIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="{Binding BookingIntro, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />

    <StackPanel views:FormGrid.FullRow="True">
      <TextBlock Text="Paciente cadastrado na UBS" Style="{StaticResource BookingLabel}" />
      <ComboBox ItemsSource="{Binding ActiveObsRegistry}" SelectedItem="{Binding AppointmentPatient}" DisplayMemberPath="FullName" AutomationProperties.Name="Paciente da consulta" views:EnterNavigation.Group="AgendaBooking" />
    </StackPanel>

    <!-- UBS com profissional ativo: só o catálogo. -->
    <StackPanel Visibility="{Binding UsesCatalogBooking, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Especialidade" Style="{StaticResource BookingLabel}" />
      <ComboBox ItemsSource="{Binding BookingSpecialties}" SelectedItem="{Binding BookingSpecialty}" DisplayMemberPath="Name" AutomationProperties.Name="Especialidade da consulta pelo catálogo" views:EnterNavigation.Group="AgendaBooking" />
    </StackPanel>
    <StackPanel Visibility="{Binding UsesCatalogBooking, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Profissional" Style="{StaticResource BookingLabel}" />
      <ComboBox ItemsSource="{Binding BookingProfessionals}" SelectedItem="{Binding BookingProfessional}" DisplayMemberPath="FullName" AutomationProperties.Name="Profissional da consulta pelo catálogo" views:EnterNavigation.Group="AgendaBooking" />
    </StackPanel>
    <StackPanel views:FormGrid.FullRow="True" Visibility="{Binding UsesCatalogBooking, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Horário livre" Style="{StaticResource BookingLabel}" />
      <TextBlock Text="{Binding BookingWindowLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
      <ListBox Style="{StaticResource OpenListLow}" SelectionMode="Single" ItemsSource="{Binding BookingSlots}" SelectedItem="{Binding BookingSlot}" DisplayMemberPath="Display" MinHeight="72" MaxHeight="190" AutomationProperties.Name="Horários livres" views:EnterNavigation.Group="AgendaBooking" />
      <TextBlock Text="{Binding BookingState}" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="{Binding BookingState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding BookingSelectionLabel}" FontWeight="SemiBold" Margin="0,8,0,0" />
    </StackPanel>

    <!-- UBS sem profissional ativo: texto livre, no dia escolhido na agenda. -->
    <StackPanel views:FormGrid.FullRow="True" Visibility="{Binding UsesFreeTextBooking, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Dia da consulta" Style="{StaticResource BookingLabel}" />
      <TextBlock Text="{Binding SelectedAgendaDateLabel}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" ToolTip="A consulta usa o dia escolhido na agenda. Escolha um horário futuro." />
    </StackPanel>
    <StackPanel Visibility="{Binding UsesFreeTextBooking, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Especialidade" Style="{StaticResource BookingLabel}" />
      <ComboBox ItemsSource="{Binding ObsSpecialties}" SelectedValue="{Binding AppointmentSpecialty}" SelectedValuePath="Name" DisplayMemberPath="Name" AutomationProperties.Name="Especialidade da consulta" ToolTip="Especialidades cadastradas na rede (lista da Secretaria)." views:EnterNavigation.Group="AgendaBooking" />
    </StackPanel>
    <StackPanel Visibility="{Binding UsesFreeTextBooking, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Profissional" Style="{StaticResource BookingLabel}" />
      <TextBox Text="{Binding AppointmentProfessional, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Profissional da consulta" views:EnterNavigation.Group="AgendaBooking" />
    </StackPanel>
    <StackPanel Visibility="{Binding UsesFreeTextBooking, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Horário inicial (HH:mm)" Style="{StaticResource BookingLabel}" />
      <TextBox Text="{Binding AppointmentStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horário inicial da consulta" views:EnterNavigation.Group="AgendaBooking" />
    </StackPanel>
    <StackPanel Visibility="{Binding UsesFreeTextBooking, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="Horário final (HH:mm)" Style="{StaticResource BookingLabel}" />
      <TextBox Text="{Binding AppointmentEnd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horário final da consulta" views:EnterNavigation.Group="AgendaBooking" />
    </StackPanel>
  </views:FormGrid>
</UserControl>
