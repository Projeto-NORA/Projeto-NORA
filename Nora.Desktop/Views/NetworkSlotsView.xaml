<UserControl x:Class="Nora.Desktop.Views.NetworkSlotsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Vaga Relâmpago da rede: cartões coloridos com os números das vagas e ofertas; o período e a UBS ficam no cabeçalho. Sem título repetido e sem botão de atualizar (a tela relê sozinha). -->
  <StackPanel>
    <StackPanel.Resources><ItemsPanelTemplate x:Key="CardsPanel"><views:AdaptiveGridPanel ColumnWidth="215" MaxColumns="4" /></ItemsPanelTemplate></StackPanel.Resources>
    <views:LightningFiltersView />
    <ItemsControl ItemsSource="{Binding NetworkLightningCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource CardsPanel}" Margin="-8,0,-8,0" Focusable="False" AutomationProperties.Name="Vaga Relâmpago da rede" />
    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Text="Os totais seguem a data de criação da vaga e a UBS escolhida em Filtros. A oferta é automática: aceite não confirma o atendimento, e ofertas criadas não comprovam a entrega da notificação." />
  </StackPanel>
</UserControl>
