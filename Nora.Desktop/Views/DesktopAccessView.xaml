<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.DesktopAccessView" Background="{DynamicResource BackgroundGradientBrush}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
    <StackPanel>
      <Image Source="{DynamicResource BrandMarkImage}" Width="52" Height="52" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logotipo NORA" />
      <TextBlock Text="{Binding AccessTitle}" FontSize="25" FontWeight="SemiBold" Margin="0,14,0,20" />
      <TextBlock Text="E-mail" FontWeight="SemiBold" />
      <TextBox x:Name="Email" Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" AutomationProperties.Name="E-mail" KeyDown="OnEmailKeyDown"  enter:EnterNavigation.Group="DesktopAccessView.login"/>
      <TextBlock Text="Senha" FontWeight="SemiBold" />
      <PasswordBox x:Name="LoginPassword" Margin="0,5,0,12" AutomationProperties.Name="Senha" KeyDown="OnLoginKeyDown"  enter:EnterNavigation.Group="DesktopAccessView.login"/>
      <CheckBox IsChecked="{Binding RememberDesktopSession}" Content="Manter conectado por 30 dias" HorizontalAlignment="Left" Margin="0,0,0,4" />
      <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" Text="Sem marcar, você continua conectado por 1 dia neste computador." />
      <StackPanel Visibility="{Binding NeedsLoginUnit, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
        <TextBlock Text="Unidade" FontWeight="SemiBold" />
        <ComboBox x:Name="Unit" ItemsSource="{Binding LoginUnits}" SelectedItem="{Binding LoginUnit}" DisplayMemberPath="Name" AutomationProperties.Name="Escolher unidade para entrar" KeyDown="OnLoginKeyDown"  enter:EnterNavigation.Group="DesktopAccessView.login"/>
      </StackPanel>
      <Button Content="Entrar" Style="{StaticResource PrimaryButton}" Click="OnLogin" IsEnabled="{Binding CanLogin}"  enter:EnterNavigation.Group="DesktopAccessView.login"/>
      <ItemsControl ItemsSource="{Binding OpeningSteps}" ItemTemplate="{StaticResource ProgressStepTemplate}" Margin="0,10,0,0" />
    </StackPanel>
  </Border>
</UserControl>
