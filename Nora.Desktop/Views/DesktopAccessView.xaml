<UserControl x:Class="Nora.Desktop.Views.DesktopAccessView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
    <StackPanel>
      <Border Width="48" Height="48" Background="{DynamicResource BrandGradientBrush}" CornerRadius="12" HorizontalAlignment="Left">
        <TextBlock Text="N" Foreground="{DynamicResource BrandTextBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="{Binding AccessTitle}" FontSize="25" FontWeight="SemiBold" Margin="0,14,0,20" />
      <TextBlock Text="E-mail" FontWeight="SemiBold" />
      <TextBox x:Name="Email" Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,12" AutomationProperties.Name="E-mail" />
      <TextBlock Text="Senha" FontWeight="SemiBold" />
      <PasswordBox x:Name="LoginPassword" Margin="0,5,0,12" AutomationProperties.Name="Senha" KeyDown="OnLoginKeyDown" />
      <CheckBox IsChecked="{Binding RememberDesktopSession}" Content="Manter conectado por 30 dias" Margin="0,0,0,14" />
      <StackPanel Visibility="{Binding NeedsLoginUnit, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12">
        <TextBlock Text="Unidade" FontWeight="SemiBold" />
        <ComboBox ItemsSource="{Binding LoginUnits}" SelectedItem="{Binding LoginUnit}" DisplayMemberPath="Name" AutomationProperties.Name="Escolher unidade para entrar" />
      </StackPanel>
      <Button Content="Entrar" Style="{StaticResource PrimaryButton}" Click="OnLogin" IsEnabled="{Binding CanLogin}" />
      <ItemsControl ItemsSource="{Binding OpeningSteps}" ItemTemplate="{StaticResource ProgressStepTemplate}" Margin="0,10,0,0" />
    </StackPanel>
  </Border>
</UserControl>
