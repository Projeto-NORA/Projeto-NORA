<UserControl x:Class="Nora.Desktop.Views.UnitSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels">
  <!--
    Informações da UBS (OBS): atendimento ao público, profissionais, consultórios, grade semanal e bloqueios. Todos consultam; só o administrador da UBS grava.
    Sem título, sem card e sem botão Atualizar: o nome da tela fica no cabeçalho da janela, as listagens são abertas (OpenList, balão de ações no pé da tela,
    ficha em linhas no segundo clique) e os cadastros abrem em pop-up (FormDialog) com a grade de campos.
  -->
  <UserControl.Resources>
    <views:EmptySearchVisibilityConverter x:Key="EmptySearchVisibility" />
    <!-- Caixa de seleção com o quadrado à esquerda do texto (o estilo padrão põe o quadrado à direita). -->
    <Style x:Key="LeadingCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
            <TextBlock x:Name="Check" Text="✓" Foreground="{DynamicResource BrandTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
          </Border>
          <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,16,0" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource BrandBrush}" /><Setter TargetName="Check" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /><Setter TargetName="Box" Property="BorderThickness" Value="2" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Campo de horário HH:mm do atendimento: cerca de 1,2 vez mais baixo que o campo padrão. -->
    <Style x:Key="TimeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Width" Value="76" />
      <Setter Property="MaxLength" Value="5" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="InlineError" TargetType="TextBlock" BasedOn="{StaticResource FieldError}"><Setter Property="Margin" Value="0,4,0,0" /></Style>
    <Style x:Key="HintText" TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,0" /></Style>
    <Style x:Key="EmptyState" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Top" /><Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="MaxWidth" Value="560" /><Setter Property="Margin" Value="0,36,0,0" /><Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Itens das listagens: duas linhas (título e dados com " | " só entre o que foi informado) e, quando há situação, a etiqueta à direita. -->
    <DataTemplate x:Key="ProfessionalItem">
      <Grid AutomationProperties.Name="{Binding FullName}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding FullName}" Style="{StaticResource ItemTitleText}" />
          <TextBlock Text="{Binding MetaLine}" Style="{StaticResource ItemMetaText}" Visibility="{Binding MetaLine, Converter={StaticResource TextVisibility}}" />
        </StackPanel>
        <views:StatusTag Grid.Column="1" Text="{Binding StatusDisplay}" Tone="{Binding StatusTone}" Margin="12,0,0,0" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="RoomItem">
      <Grid AutomationProperties.Name="{Binding Name}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleText}" VerticalAlignment="Center" />
        <views:StatusTag Grid.Column="1" Text="{Binding StatusDisplay}" Tone="{Binding StatusTone}" Margin="12,0,0,0" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ScheduleItem">
      <StackPanel AutomationProperties.Name="{Binding TitleDisplay}">
        <TextBlock Text="{Binding TitleDisplay}" Style="{StaticResource ItemTitleText}" />
        <TextBlock Text="{Binding MetaLine}" Style="{StaticResource ItemMetaText}" Visibility="{Binding MetaLine, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="BlockItem">
      <StackPanel AutomationProperties.Name="{Binding Reason}">
        <TextBlock Text="{Binding Reason}" Style="{StaticResource ItemTitleText}" />
        <TextBlock Text="{Binding MetaLine}" Style="{StaticResource ItemMetaText}" Visibility="{Binding MetaLine, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </DataTemplate>

    <!-- Cadastros dos pop-ups: cada um é uma grade de campos (FormGrid); o DataContext é o ViewModel da tela (o pop-up não herda o da janela). -->
    <DataTemplate x:Key="ProfessionalFormTemplate">
      <views:FormGrid>
        <StackPanel>
          <TextBlock Text="Nome completo" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding ProfessionalName, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Nome do profissional" views:EnterNavigation.Group="UnitSettingsView.professional" />
          <TextBlock Text="{Binding ProfessionalNameError}" Style="{StaticResource InlineError}" Visibility="{Binding ProfessionalNameError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Registro no conselho (opcional)" Style="{StaticResource FieldLabelText}" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
            <TextBox Text="{Binding CouncilAcronym, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" CharacterCasing="Upper" Margin="0,0,8,0" AutomationProperties.Name="Sigla do conselho" ToolTip="Sigla do conselho, por exemplo CRM" views:EnterNavigation.Group="UnitSettingsView.professional" />
            <TextBox Grid.Column="1" Text="{Binding CouncilNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,0,8,0" AutomationProperties.Name="Número do conselho" ToolTip="Número do registro" views:EnterNavigation.Group="UnitSettingsView.professional" />
            <TextBox Grid.Column="2" Text="{Binding CouncilState, UpdateSourceTrigger=PropertyChanged}" MaxLength="2" CharacterCasing="Upper" AutomationProperties.Name="UF do conselho" ToolTip="UF do registro" views:EnterNavigation.Group="UnitSettingsView.professional" />
          </Grid>
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /></Grid.ColumnDefinitions>
            <TextBlock Text="Sigla" Style="{StaticResource Muted}" FontSize="11" /><TextBlock Grid.Column="1" Text="Número" Style="{StaticResource Muted}" FontSize="11" /><TextBlock Grid.Column="2" Text="UF" Style="{StaticResource Muted}" FontSize="11" />
          </Grid>
          <TextBlock Style="{StaticResource HintText}" Text="O conselho profissional é o órgão que registra cada profissão da saúde: CRM (médicos), CRO (dentistas), COREN (enfermagem), CRP (psicologia)… Informe sigla, número e UF juntos. O NORA não confere o registro." />
          <TextBlock Text="{Binding CouncilError}" Style="{StaticResource InlineError}" Visibility="{Binding CouncilError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel views:FormGrid.FullRow="True">
          <TextBlock Text="Especialidades" Style="{StaticResource FieldLabelText}" />
          <ItemsControl ItemsSource="{Binding ProfessionalSpecialtyChoices}" AutomationProperties.Name="Especialidades do profissional">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><CheckBox Style="{StaticResource LeadingCheckBox}" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}" ToolTip="Liga ou desliga esta especialidade para o profissional." Content="{Binding Name}" Margin="0,0,10,0" Checked="OnSpecialtyChoice" Unchecked="OnSpecialtyChoice" AutomationProperties.Name="{Binding Name}" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Sem especialidades ativas. Peça à Secretaria para cadastrá-las." Style="{StaticResource HintText}" Visibility="{Binding NoSpecialtyChoices, Converter={StaticResource BoolVisibility}}" />
          <TextBlock Text="{Binding ProfessionalSpecialtyError}" Style="{StaticResource InlineError}" Visibility="{Binding ProfessionalSpecialtyError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </views:FormGrid>
    </DataTemplate>
    <DataTemplate x:Key="RoomFormTemplate">
      <views:FormGrid>
        <StackPanel>
          <TextBlock Text="Nome do consultório" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding RoomName, UpdateSourceTrigger=PropertyChanged}" MaxLength="80" AutomationProperties.Name="Nome do consultório" views:EnterNavigation.Group="UnitSettingsView.room" />
          <TextBlock Text="{Binding RoomNameError}" Style="{StaticResource InlineError}" Visibility="{Binding RoomNameError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </views:FormGrid>
    </DataTemplate>
    <DataTemplate x:Key="ScheduleFormTemplate">
      <views:FormGrid>
        <StackPanel><TextBlock Text="Profissional" Style="{StaticResource FieldLabelText}" />
          <ComboBox ItemsSource="{Binding ActiveProfessionalOptions}" SelectedItem="{Binding ScheduleProfessional}" DisplayMemberPath="FullName" AutomationProperties.Name="Profissional da grade" views:EnterNavigation.Group="UnitSettingsView.schedule" /></StackPanel>
        <StackPanel><TextBlock Text="Especialidade do atendimento" Style="{StaticResource FieldLabelText}" />
          <ComboBox ItemsSource="{Binding ScheduleSpecialtyOptions}" SelectedItem="{Binding ScheduleSpecialty}" DisplayMemberPath="Name" AutomationProperties.Name="Especialidade da grade" views:EnterNavigation.Group="UnitSettingsView.schedule" /></StackPanel>
        <StackPanel><TextBlock Text="Consultório" Style="{StaticResource FieldLabelText}" />
          <ComboBox ItemsSource="{Binding ActiveRoomOptions}" SelectedItem="{Binding ScheduleRoom}" DisplayMemberPath="Name" AutomationProperties.Name="Consultório da grade" views:EnterNavigation.Group="UnitSettingsView.schedule" /></StackPanel>
        <StackPanel><TextBlock Text="Dia da semana" Style="{StaticResource FieldLabelText}" />
          <ComboBox ItemsSource="{x:Static vm:WorkspaceViewModel.WeekdayOptions}" DisplayMemberPath="Label" SelectedValuePath="Day" SelectedValue="{Binding ScheduleWeekday}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Dia da semana da grade" views:EnterNavigation.Group="UnitSettingsView.schedule" /></StackPanel>
        <StackPanel><TextBlock Text="Início (HH:mm)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding ScheduleStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Início da grade" views:EnterNavigation.Group="UnitSettingsView.schedule" /></StackPanel>
        <StackPanel><TextBlock Text="Fim (HH:mm)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding ScheduleEnd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fim da grade" views:EnterNavigation.Group="UnitSettingsView.schedule" /></StackPanel>
        <StackPanel><TextBlock Text="Duração (minutos)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding ScheduleSlotMinutes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Duração do atendimento da grade" ToolTip="De 5 a 240 minutos" views:EnterNavigation.Group="UnitSettingsView.schedule" /></StackPanel>
        <StackPanel><TextBlock Text="Vigência de (opcional)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding ScheduleValidFrom, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Início da vigência da grade" ToolTip="dd/mm/aaaa; em branco = sem limite" views:EnterNavigation.Group="UnitSettingsView.schedule" /></StackPanel>
        <StackPanel><TextBlock Text="Vigência até (opcional)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding ScheduleValidUntil, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Fim da vigência da grade" ToolTip="dd/mm/aaaa; em branco = sem limite" views:EnterNavigation.Group="UnitSettingsView.schedule" /></StackPanel>
        <Border views:FormGrid.FullRow="True" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Visibility="{Binding ScheduleOverlapError, Converter={StaticResource TextVisibility}}" AutomationProperties.Name="Aviso de sobreposição na grade">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Path Data="{StaticResource IconWarningGeometry}" Width="18" Height="18" Stretch="None" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="0,0,10,0" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding ScheduleOverlapError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Grid>
        </Border>
        <TextBlock views:FormGrid.FullRow="True" Text="{Binding ScheduleError}" Style="{StaticResource InlineError}" Visibility="{Binding ScheduleError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      </views:FormGrid>
    </DataTemplate>
    <DataTemplate x:Key="BlockFormTemplate">
      <views:FormGrid>
        <StackPanel><TextBlock Text="Vale para" Style="{StaticResource FieldLabelText}" />
          <ComboBox ItemsSource="{Binding BlockScopeOptions}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding BlockScope}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Quem o bloqueio atinge" views:EnterNavigation.Group="UnitSettingsView.block" /></StackPanel>
        <StackPanel><TextBlock Text="De (dd/mm/aaaa)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding BlockFromText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Data inicial do bloqueio" views:EnterNavigation.Group="UnitSettingsView.block" /></StackPanel>
        <StackPanel><TextBlock Text="Até (opcional)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding BlockToText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Data final do bloqueio" ToolTip="Em branco, o bloqueio vale só para o dia inicial." views:EnterNavigation.Group="UnitSettingsView.block" /></StackPanel>
        <CheckBox Style="{StaticResource LeadingCheckBox}" Content="Dia inteiro (feriado ou folga)" IsChecked="{Binding BlockFullDay}" ToolTip="Bloqueia o dia todo, sem escolher horário." AutomationProperties.Name="Bloquear dias inteiros" VerticalAlignment="Bottom" />
        <StackPanel IsEnabled="{Binding BlockTimesEnabled}"><TextBlock Text="Início (HH:mm)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding BlockStartTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horário inicial do bloqueio" views:EnterNavigation.Group="UnitSettingsView.block" /></StackPanel>
        <StackPanel IsEnabled="{Binding BlockTimesEnabled}"><TextBlock Text="Fim (HH:mm)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding BlockEndTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horário final do bloqueio" views:EnterNavigation.Group="UnitSettingsView.block" /></StackPanel>
        <StackPanel views:FormGrid.FullRow="True"><TextBlock Text="Motivo" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding BlockReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Motivo do bloqueio" views:EnterNavigation.Group="UnitSettingsView.block" /></StackPanel>
        <TextBlock views:FormGrid.FullRow="True" Text="{Binding BlockError}" Style="{StaticResource InlineError}" Visibility="{Binding BlockError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      </views:FormGrid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel>
      <views:ObsUnitNoticeView />
      <!-- A conta de atendente só consulta: o aviso vale para as quatro listagens (o atendimento ao público tem o próprio). -->
      <Grid views:SubPage.Key="professionals,rooms,schedule,blocks">
        <Border Background="{DynamicResource BrandSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" AutomationProperties.Name="Somente leitura para atendente" Visibility="{Binding ShowCatalogReadOnlyNotice, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{Binding CatalogReadOnlyNotice}" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </StackPanel>

    <views:SubPageStack Grid.Row="1">
      <!-- Atendimento: um intervalo por dia (caixa marcada = aberto), serviços oferecidos e Salvar embaixo à direita. A página rola, sem Fill. -->
      <StackPanel views:SubPage.Key="profile" AutomationProperties.Name="Atendimento ao público">
        <ContentControl Style="{StaticResource NoticeItem}" Content="{Binding ProfileNotInformedNotice}" Visibility="{Binding ProfileNotInformedNotice, Converter={StaticResource TextVisibility}}" Margin="0,0,0,16" AutomationProperties.Name="Horário ainda não informado" />
        <Border Background="{DynamicResource BrandSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12" AutomationProperties.Name="Atendimento somente em leitura" Visibility="{Binding ShowProfileReadOnlyNotice, Converter={StaticResource BoolVisibility}}">
          <TextBlock Text="{Binding ProfileReadOnlyNotice}" TextWrapping="Wrap" />
        </Border>
        <TextBlock Text="{Binding ProfileState}" Style="{StaticResource Muted}" Margin="0,0,0,10" Visibility="{Binding ProfileState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        <ItemsControl ItemsSource="{Binding OpeningDays}" IsEnabled="{Binding CanEditProfile}" AutomationProperties.Name="Horário de funcionamento por dia da semana">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,4">
                <Grid MinHeight="38">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <CheckBox Style="{StaticResource LeadingCheckBox}" Content="{Binding Label}" IsChecked="{Binding IsOpen}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Label}" ToolTip="Marque os dias em que a UBS atende ao público." />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasIntervals, Converter={StaticResource BoolVisibility}}">
                    <TextBox Style="{StaticResource TimeBox}" Text="{Binding Opens, UpdateSourceTrigger=PropertyChanged}" ToolTip="Abre (HH:mm)" AutomationProperties.Name="{Binding Label, StringFormat='Abre {0}'}" AutomationProperties.HelpText="Abre, HH:mm" views:EnterNavigation.Group="UnitSettingsView.profile" />
                    <TextBlock Text="às" VerticalAlignment="Center" Margin="12,0" />
                    <TextBox Style="{StaticResource TimeBox}" Text="{Binding Closes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Fecha (HH:mm)" AutomationProperties.Name="{Binding Label, StringFormat='Fecha {0}'}" AutomationProperties.HelpText="Fecha, HH:mm" views:EnterNavigation.Group="UnitSettingsView.profile" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding GapNotice}" Style="{StaticResource HintText}" Margin="200,0,0,2" Visibility="{Binding GapNotice, Converter={StaticResource TextVisibility}}" />
                <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="200,2,0,4" Visibility="{Binding Error, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Serviços oferecidos" Style="{StaticResource FieldLabelText}" Margin="0,16,0,4" />
        <TextBox Text="{Binding UnitServices, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditProfile}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="96" MaxHeight="200" AutomationProperties.Name="Serviços oferecidos pela UBS" ToolTip="Texto livre, até 1.000 caracteres; quebras de linha são permitidas." views:EnterNavigation.Group="UnitSettingsView.profile" />
        <DockPanel Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding ServicesCounter}" Style="{StaticResource Muted}" FontSize="12" AutomationProperties.Name="Contador de caracteres dos serviços" />
          <TextBlock Text="{Binding ServicesError}" Style="{StaticResource FieldError}" Margin="0" Visibility="{Binding ServicesError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" /></DockPanel>
        <DockPanel Margin="0,16,0,0">
          <Button DockPanel.Dock="Right" Content="Salvar" Click="OnSaveProfile" IsEnabled="{Binding CanSaveProfile}" Style="{StaticResource ObsPrimaryButton}" MinWidth="120" ToolTip="Grava horários e serviços de uma vez." ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Salvar" views:EnterNavigation.Group="UnitSettingsView.profile" />
          <TextBlock Text="{Binding ProfileUpdatedLabel}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Visibility="{Binding ProfileUpdatedLabel, Converter={StaticResource TextVisibility}}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding ProfileSteps}" ItemTemplate="{StaticResource ProgressStepTemplate}" Margin="0,8,0,0" AutomationProperties.Name="Passos do salvamento" />
      </StackPanel>

      <!-- Profissionais -->
      <Grid views:SubPage.Key="professionals" views:PageLayout.Fill="True" AutomationProperties.Name="Profissionais">
        <views:PageFilterGroup Label="Profissionais" SearchFields="FullName,SpecialtiesDisplay,CouncilDisplay,StatusDisplay" ItemsTarget="{Binding ElementName=ProfessionalsList}" />
        <views:PageActions>
          <Button Style="{StaticResource NewItemButton}" Content="Novo profissional" Click="OnNewProfessional" IsEnabled="{Binding CanEditCatalog}" ToolTip="Abre o cadastro de profissional." ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Novo profissional" />
        </views:PageActions>
        <ListBox x:Name="ProfessionalsList" Style="{StaticResource OpenList}" ItemsSource="{Binding Professionals}" ItemTemplate="{StaticResource ProfessionalItem}" AutomationProperties.Name="Profissionais da UBS"
                 views:ListingBehavior.Balloon="{Binding ElementName=ProfessionalsBalloon}" views:ListingBehavior.LabelPath="FullName" views:ListingBehavior.KeyPath="Id" views:ListingBehavior.PluralName="profissionais" />
        <TextBlock Style="{StaticResource EmptyState}" Text="{Binding ProfessionalsState}" Visibility="{Binding ProfessionalsState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Estado da lista de profissionais" />
        <TextBlock Style="{StaticResource EmptyState}" Text="Nenhum profissional encontrado para esta busca.">
          <TextBlock.Visibility><MultiBinding Converter="{StaticResource EmptySearchVisibility}"><Binding Path="Items.Count" ElementName="ProfessionalsList" /><Binding Path="ProfessionalsState" /></MultiBinding></TextBlock.Visibility>
        </TextBlock>
        <views:SelectionBalloon x:Name="ProfessionalsBalloon">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ProfessionalEditButton" Style="{StaticResource ListActionEditButton}" views:SelectionBalloon.SingleItemOnly="True" Content="Editar" Click="OnEditProfessional" IsEnabled="{Binding CanEditCatalog}" ToolTip="Edita o profissional selecionado." AutomationProperties.Name="Editar profissional" />
            <Button x:Name="ProfessionalRestoreButton" Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconRestoreGeometry}" Content="Reativar" Click="OnReactivateProfessionals" IsEnabled="{Binding CanEditCatalog}" ToolTip="Reativa o profissional selecionado." AutomationProperties.Name="Reativar profissional" />
            <Button x:Name="ProfessionalDeactivateButton" Style="{StaticResource ListActionDangerButton}" Content="Desativar" Click="OnDeactivateProfessionals" IsEnabled="{Binding CanEditCatalog}" ToolTip="Pede confirmação. Desativar não cancela consultas já marcadas." AutomationProperties.Name="Desativar profissional" />
          </StackPanel>
        </views:SelectionBalloon>
      </Grid>

      <!-- Consultórios -->
      <Grid views:SubPage.Key="rooms" views:PageLayout.Fill="True" AutomationProperties.Name="Consultórios">
        <views:PageFilterGroup Label="Consultórios" SearchFields="Name,StatusDisplay" ItemsTarget="{Binding ElementName=RoomsList}" />
        <views:PageActions>
          <Button Style="{StaticResource NewItemButton}" Content="Novo consultório" Click="OnNewRoom" IsEnabled="{Binding CanEditCatalog}" ToolTip="Abre o cadastro de consultório." ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Novo consultório" />
        </views:PageActions>
        <ListBox x:Name="RoomsList" Style="{StaticResource OpenList}" ItemsSource="{Binding Rooms}" ItemTemplate="{StaticResource RoomItem}" AutomationProperties.Name="Consultórios da UBS"
                 views:ListingBehavior.Balloon="{Binding ElementName=RoomsBalloon}" views:ListingBehavior.LabelPath="Name" views:ListingBehavior.KeyPath="Id" views:ListingBehavior.PluralName="consultórios" />
        <TextBlock Style="{StaticResource EmptyState}" Text="{Binding RoomsState}" Visibility="{Binding RoomsState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Estado da lista de consultórios" />
        <TextBlock Style="{StaticResource EmptyState}" Text="Nenhum consultório encontrado para esta busca.">
          <TextBlock.Visibility><MultiBinding Converter="{StaticResource EmptySearchVisibility}"><Binding Path="Items.Count" ElementName="RoomsList" /><Binding Path="RoomsState" /></MultiBinding></TextBlock.Visibility>
        </TextBlock>
        <views:SelectionBalloon x:Name="RoomsBalloon">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="RoomEditButton" Style="{StaticResource ListActionEditButton}" views:SelectionBalloon.SingleItemOnly="True" Content="Renomear" Click="OnEditRoom" IsEnabled="{Binding CanEditCatalog}" ToolTip="Renomeia o consultório selecionado." AutomationProperties.Name="Renomear consultório" />
            <Button x:Name="RoomRestoreButton" Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconRestoreGeometry}" Content="Reativar" Click="OnReactivateRooms" IsEnabled="{Binding CanEditCatalog}" ToolTip="Reativa o consultório selecionado." AutomationProperties.Name="Reativar consultório" />
            <Button x:Name="RoomDeactivateButton" Style="{StaticResource ListActionDangerButton}" Content="Desativar" Click="OnDeactivateRooms" IsEnabled="{Binding CanEditCatalog}" ToolTip="Pede confirmação. Os horários dele saem da disponibilidade." AutomationProperties.Name="Desativar consultório" />
          </StackPanel>
        </views:SelectionBalloon>
      </Grid>

      <!-- Grade semanal: sete botões de dia (segunda ao abrir) e, abaixo, os horários do dia -->
      <Grid views:SubPage.Key="schedule" views:PageLayout.Fill="True" AutomationProperties.Name="Grade semanal">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <views:PageFilterGroup Label="Grade semanal" SearchFields="WeekdayDisplay,ProfessionalName,RoomName,SpecialtyName,RangeDisplay" ItemsTarget="{Binding ElementName=ScheduleList}" />
        <views:PageActions>
          <Button Style="{StaticResource NewItemButton}" Content="Novo horário" Click="OnNewSchedule" IsEnabled="{Binding CanEditCatalog}" ToolTip="Abre o cadastro de horário na grade, já com o dia escolhido." ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Novo horário" />
        </views:PageActions>
        <views:SegmentedToggle x:Name="ScheduleDays" ItemsSource="{x:Static vm:WorkspaceViewModel.ScheduleDayOptions}" DisplayMemberPath="Label" SelectedItem="{Binding ScheduleDay, Mode=TwoWay}" HorizontalAlignment="Left" Margin="0,0,0,12" AutomationProperties.Name="Dia da semana da grade" />
        <Grid Grid.Row="1">
          <ListBox x:Name="ScheduleList" Style="{StaticResource OpenList}" ItemsSource="{Binding ScheduleDayRows}" ItemTemplate="{StaticResource ScheduleItem}" AutomationProperties.Name="Grade semanal da UBS"
                   views:ListingBehavior.Balloon="{Binding ElementName=ScheduleBalloon}" views:ListingBehavior.LabelPath="TitleDisplay" views:ListingBehavior.KeyPath="Id" views:ListingBehavior.PluralName="horários" />
          <TextBlock Style="{StaticResource EmptyState}" Text="{Binding ScheduleListState}" Visibility="{Binding ScheduleListState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Estado da grade" />
          <TextBlock Style="{StaticResource EmptyState}" Text="Nenhum horário encontrado para esta busca.">
            <TextBlock.Visibility><MultiBinding Converter="{StaticResource EmptySearchVisibility}"><Binding Path="Items.Count" ElementName="ScheduleList" /><Binding Path="ScheduleListState" /></MultiBinding></TextBlock.Visibility>
          </TextBlock>
          <views:SelectionBalloon x:Name="ScheduleBalloon">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource ListActionEditButton}" views:SelectionBalloon.SingleItemOnly="True" Content="Editar" Click="OnEditSchedule" IsEnabled="{Binding CanEditCatalog}" ToolTip="Edita o horário selecionado da grade." AutomationProperties.Name="Editar horário" />
              <Button Style="{StaticResource ListActionDangerButton}" Content="Remover" Click="OnDeleteSchedules" IsEnabled="{Binding CanEditCatalog}" ToolTip="Pede confirmação. Consultas já marcadas não são afetadas." AutomationProperties.Name="Remover horário" />
            </StackPanel>
          </views:SelectionBalloon>
        </Grid>
      </Grid>

      <!-- Bloqueios -->
      <Grid views:SubPage.Key="blocks" views:PageLayout.Fill="True" AutomationProperties.Name="Bloqueios">
        <views:PageFilterGroup Label="Bloqueios" SearchFields="ScopeDisplay,Reason,PeriodDisplay" ItemsTarget="{Binding ElementName=BlocksList}" />
        <views:PageActions>
          <Button Style="{StaticResource NewItemButton}" Content="Novo bloqueio" Click="OnNewBlock" IsEnabled="{Binding CanEditCatalog}" ToolTip="Abre o cadastro de bloqueio de agenda." ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Novo bloqueio" />
        </views:PageActions>
        <ListBox x:Name="BlocksList" Style="{StaticResource OpenList}" ItemsSource="{Binding ScheduleBlocks}" ItemTemplate="{StaticResource BlockItem}" AutomationProperties.Name="Bloqueios da UBS"
                 views:ListingBehavior.Balloon="{Binding ElementName=BlocksBalloon}" views:ListingBehavior.LabelPath="Reason" views:ListingBehavior.KeyPath="Id" views:ListingBehavior.PluralName="bloqueios" />
        <TextBlock Style="{StaticResource EmptyState}" Text="{Binding BlocksState}" Visibility="{Binding BlocksState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Estado da lista de bloqueios" />
        <TextBlock Style="{StaticResource EmptyState}" Text="Nenhum bloqueio encontrado para esta busca.">
          <TextBlock.Visibility><MultiBinding Converter="{StaticResource EmptySearchVisibility}"><Binding Path="Items.Count" ElementName="BlocksList" /><Binding Path="BlocksState" /></MultiBinding></TextBlock.Visibility>
        </TextBlock>
        <views:SelectionBalloon x:Name="BlocksBalloon">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource ListActionDangerButton}" Content="Remover" Click="OnDeleteBlocks" IsEnabled="{Binding CanEditCatalog}" ToolTip="Pede confirmação. Os horários que ele cobria voltam a ser oferecidos." AutomationProperties.Name="Remover bloqueio" />
          </StackPanel>
        </views:SelectionBalloon>
      </Grid>
    </views:SubPageStack>
  </Grid>
</UserControl>
