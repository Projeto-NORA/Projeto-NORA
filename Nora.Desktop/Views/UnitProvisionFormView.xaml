<UserControl x:Class="Nora.Desktop.Views.UnitProvisionFormView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- "Tentar criar a base de novo", no pop-up: a explicação e os passos da operação demorada. O DataContext é o WorkspaceViewModel. -->
  <StackPanel>
    <TextBlock Text="{Binding SelectedUnitLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="UBS cadastrada, mas sem base de dados: fica fora da rede e do aplicativo. Dê à API permissão para criar bancos e tente de novo. É seguro repetir." />
    <ItemsControl ItemsSource="{Binding UnitProvisionSteps}" ItemTemplate="{StaticResource ProgressStepTemplate}" Margin="0,10,0,0" AutomationProperties.Name="Passos da criação da base da UBS" />
  </StackPanel>
</UserControl>
