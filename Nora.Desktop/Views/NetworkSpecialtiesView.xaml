<UserControl x:Class="Nora.Desktop.Views.NetworkSpecialtiesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <StackPanel>
    <views:NetworkFiltersView />
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Demanda por especialidade" Style="{StaticResource SectionTitle}"  ToolTip="A especialidade é o texto informado em cada consulta e fila; grafias que só diferem em maiúsculas formam um grupo. Clique no título de uma coluna para ordenar." Margin="0,0,0,12" />

        <DataGrid ItemsSource="{Binding SpecialtyPerformance}" CanUserSortColumns="True" MaxHeight="360" MinHeight="64" AutomationProperties.Name="Indicadores por especialidade">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Especialidade" Binding="{Binding Name}" Width="*" MinWidth="160" />
            <DataGridTextColumn Header="Comparecimento" Binding="{Binding ScoreDisplay}" SortMemberPath="ScoreSort" Width="140" />
            <DataGridTextColumn Header="Concluídas" Binding="{Binding Completed}" Width="100" />
            <DataGridTextColumn Header="Faltas" Binding="{Binding Missed}" Width="80" />
            <DataGridTextColumn Header="Cancelamentos" Binding="{Binding Cancelled}" Width="125" />
            <DataGridTextColumn Header="Na fila" Binding="{Binding ActiveEntries}" Width="80" />
            <DataGridTextColumn Header="Espera média" Binding="{Binding WaitDisplay}" SortMemberPath="WaitSort" Width="125" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding MetricsStateText}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding MetricsStateText, Converter={StaticResource TextVisibility}}" />
        <views:ScoreNoteView Margin="0,12,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
