<UserControl x:Class="Nora.Desktop.Views.StaffResetFormView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Redefinição de senha provisória, no pop-up. Sem e-mail de recuperação: a Secretaria define uma nova senha provisória e as sessões da conta são encerradas. O DataContext é o WorkspaceViewModel. -->
  <StackPanel>
    <TextBlock Text="{Binding SelectedStaff.FullName}" FontWeight="SemiBold" Margin="0,0,0,4" TextWrapping="Wrap" />
    <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" Text="Sem e-mail de recuperação: a Secretaria define uma nova senha provisória, e as sessões da conta são encerradas. A pessoa troca a senha no próximo acesso." />
    <views:FormGrid>
      <StackPanel>
        <TextBlock Text="Nova senha provisória (8 a 256 caracteres)" Style="{StaticResource FieldLabelText}" />
        <PasswordBox x:Name="PasswordField" AutomationProperties.Name="Nova senha provisória da conta" views:EnterNavigation.Group="StaffResetFormView.reset" />
        <TextBlock Text="{Binding StaffResetPasswordError}" Style="{StaticResource FieldError}" Margin="0,4,0,0" Visibility="{Binding StaffResetPasswordError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Confirmar a senha provisória" Style="{StaticResource FieldLabelText}" />
        <PasswordBox x:Name="ConfirmField" AutomationProperties.Name="Confirmação da senha provisória da conta" views:EnterNavigation.Group="StaffResetFormView.reset" />
        <TextBlock Text="{Binding StaffResetConfirmError}" Style="{StaticResource FieldError}" Margin="0,4,0,0" Visibility="{Binding StaffResetConfirmError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </views:FormGrid>
  </StackPanel>
</UserControl>
