<UserControl x:Class="Nora.Desktop.Views.LineChartView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Gráfico de linhas desenhado em código (sem pacote externo): a legenda só aparece com mais de uma linha. A altura do desenho é a que sobra (ou PlotHeight, quando definida). -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <WrapPanel x:Name="Legend" Margin="0,0,0,10" />
    <Grid x:Name="PlotHost" Grid.Row="1" MinHeight="180">
      <Canvas x:Name="Plot" ClipToBounds="True" />
      <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0" Visibility="Collapsed" />
    </Grid>
  </Grid>
</UserControl>
