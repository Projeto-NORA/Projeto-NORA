<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.GoalsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" views:PageLayout.Fill="True">
  <!-- Relatórios e metas. Cabeçalho: o escopo das metas em linha, os filtros no botão Filtros e a exportação do resumo em CSV (PageActions). Metas: listagem aberta (uma linha por métrica) com ficha no duplo clique; a situação das metas por UBS é uma tabela solta, sem card, que ocupa o resto da tela. O balão (Editar meta abre o pop-up; Remover é a lixeira) flutua no pé da tela, sem reservar espaço. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <views:PageFilterGroup Label="Metas" FilterKey="goalScope" Inline="True" IsEnabled="{Binding CanEditGoals}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Metas" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox MinWidth="150" ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding GoalScope}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Escopo das metas" ToolTip="A meta da rede vale para toda UBS que não tem meta própria; escolher uma UBS permite sobrescrever a meta só nela." enter:EnterNavigation.Group="GoalsView.scope" />
        </StackPanel>
      </views:PageFilterGroup>
      <views:LightningFiltersView PeriodInline="False" ShowUnit="False" ShowNotice="False" />
      <views:NetworkFiltersView PeriodInline="False" AllowCustom="True" />
      <views:PageActions>
        <Button x:Name="ExportButton" Content="Exportar CSV" Click="OnExport" IsEnabled="{Binding CanExportSummary}" AutomationProperties.Name="Exportar resumo em CSV" ToolTip="{Binding SummaryExportNote}" />
      </views:PageActions>
      <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,6" TextWrapping="Wrap" AutomationProperties.Name="Escopo da exportação"><Run Text="Exportação: resumo de" /> <Run Text="{Binding AppliedSummaryUnitLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding SummaryReceivedLabel, Mode=OneWay}" /></TextBlock>
      <TextBlock Text="{Binding GoalScopeLabel}" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" ToolTip="Situação: atingida; perto (até 10% da meta); fora; sem dado (sem consulta ou fila para calcular)." />
      <TextBlock Text="{Binding GoalsState}" Style="{StaticResource Muted}" Margin="0,0,0,10" Visibility="{Binding GoalsState, Converter={StaticResource TextVisibility}}" />
    </StackPanel>
    <ListBox Grid.Row="1" x:Name="GoalList" Style="{StaticResource OpenList}" ItemsSource="{Binding GoalEditors}" IsEnabled="{Binding CanEditGoals}" AutomationProperties.Name="Metas editáveis"
             views:ListingBehavior.Balloon="{Binding ElementName=Balloon}" views:ListingBehavior.LabelPath="Title" views:ListingBehavior.KeyPath="Metric" views:ListingBehavior.PluralName="metas" views:ListingBehavior.Feminine="True">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid AutomationProperties.Name="{Binding AutomationLabel}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding Title}" Style="{StaticResource ItemTitleText}" />
              <TextBlock Text="{Binding MetaLine}" Style="{StaticResource ItemMetaText}" />
            </StackPanel>
            <views:StatusTag Grid.Column="1" Text="{Binding StatusText}" Tone="{Binding StatusTone}" Margin="12,0,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="Situação por UBS" Style="{StaticResource SectionTitle}" Margin="0,18,0,10" ToolTip="Calculada pelos indicadores do período e dos filtros. Cada UBS usa a meta própria ou, se não tiver, a da rede; sem meta definida aparece Sem meta. O estado vem escrito, com ícone." />
    <!-- Colunas mínimas que cabem na janela mínima (980): a tabela não rola na horizontal. -->
    <DataGrid Grid.Row="3" ItemsSource="{Binding GoalUnitRows}" RowHeight="64" MinHeight="64" VerticalAlignment="Top" AutomationProperties.Name="Situação das metas por UBS">
      <DataGrid.Columns>
        <DataGridTextColumn Header="UBS" Binding="{Binding Name}" Width="*" MinWidth="120">
          <!-- Na janela estreita o nome quebra em duas linhas (a linha tem 64 px) em vez de ser cortado. -->
          <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="VerticalAlignment" Value="Center" /></Style></DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTemplateColumn Header="Comparecimento (mín.)" Width="1.4*" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Score}" ContentTemplate="{StaticResource GoalCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Taxa de faltas (máx.)" Width="1.4*" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Missed}" ContentTemplate="{StaticResource GoalCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Espera média (máx.)" Width="1.4*" MinWidth="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Wait}" ContentTemplate="{StaticResource GoalCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="4" Text="{Binding GoalStatusState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding GoalStatusState, Converter={StaticResource TextVisibility}}" />
    <views:SelectionBalloon Grid.Row="0" Grid.RowSpan="5" x:Name="Balloon">
      <!-- Enquanto outra ação roda (gravação, remoção) as ações ficam desabilitadas, como a própria lista: um segundo clique não pede outra confirmação. -->
      <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEditGoals}">
        <Button Style="{StaticResource ListActionEditButton}" views:SelectionBalloon.SingleItemOnly="True" Content="Editar meta" Click="OnEdit" AutomationProperties.Name="Editar meta" ToolTip="Define ou altera a meta num pop-up." />
        <Button x:Name="RemoveButton" Style="{StaticResource ListActionDangerButton}" Content="Remover" Click="OnRemove" AutomationProperties.Name="Remover meta" ToolTip="Remove a meta gravada neste escopo (pede confirmação)." />
      </StackPanel>
    </views:SelectionBalloon>
  </Grid>
</UserControl>
