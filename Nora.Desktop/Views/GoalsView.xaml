<UserControl x:Class="Nora.Desktop.Views.GoalsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Metas: a Secretaria define comparecimento (mínimo), faltas (máximo) e espera média (máximo) para a rede e, se quiser, sobrescreve por UBS. A situação vem dos indicadores. -->
  <UserControl.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,6,0,6" /></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,6,0,6" /></Style>
  </UserControl.Resources>
  <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Definir metas">
      <StackPanel IsEnabled="{Binding CanEditGoals}">
        <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Atualizar metas" Style="{StaticResource IconRefreshButton}" AutomationProperties.Name="Atualizar metas" ToolTip="Atualizar metas" Click="OnRefresh" /><TextBlock Text="Definir metas" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" ToolTip="A meta da rede vale para toda UBS que não tem meta própria; escolher uma UBS abaixo permite sobrescrever a meta só nela. Situação: atingida; perto (até 10% da meta); fora; sem dado (sem consulta ou fila para calcular)." /></DockPanel>

        <StackPanel Width="320" HorizontalAlignment="Left"><TextBlock Text="Escopo das metas" FontWeight="SemiBold" FontSize="12" />
          <ComboBox ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding GoalScope}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Escopo das metas" /></StackPanel>
        <TextBlock Text="{Binding GoalScopeLabel}" FontWeight="SemiBold" Margin="0,0,0,10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding GoalsState}" Style="{StaticResource Muted}" Margin="0,0,0,10" Visibility="{Binding GoalsState, Converter={StaticResource TextVisibility}}" />
        <ItemsControl ItemsSource="{Binding GoalEditors}" AutomationProperties.Name="Metas editáveis">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10" AutomationProperties.Name="{Binding AutomationLabel}">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                  <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,6" />
                  <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Bound}" VerticalAlignment="Center" Margin="0,0,10,0" Width="62" />
                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Width="110" Margin="0,6,8,6" AutomationProperties.Name="{Binding Title, StringFormat=Valor da meta de {0}}" />
                    <TextBlock Text="{Binding Suffix}" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding Suffix, Converter={StaticResource TextVisibility}}" />
                    <ComboBox SelectedValue="{Binding WaitUnit}" SelectedValuePath="Tag" Width="110" Margin="0,6,16,6" Visibility="{Binding IsWait, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Unidade da espera máxima">
                      <ComboBoxItem Content="horas" Tag="h" /><ComboBoxItem Content="dias" Tag="d" />
                    </ComboBox>
                    <Button Content="Salvar meta" Tag="{Binding Metric}" Click="OnSave" Margin="0,0,8,0" AutomationProperties.Name="{Binding Title, StringFormat=Salvar meta de {0}}" ToolTip="Grava a meta desta linha."/>
                    <Button Content="Remover meta" Tag="{Binding Metric}" Click="OnRemove" IsEnabled="{Binding HasCurrent}" AutomationProperties.Name="{Binding Title, StringFormat=Remover meta de {0}}" ToolTipService.ShowOnDisabled="True" ToolTip="Remove a meta gravada neste escopo." />
                  </WrapPanel>
                  <TextBlock Text="{Binding Error}" Style="{StaticResource FieldError}" Margin="0,0,0,4" Visibility="{Binding Error, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Text="{Binding Current}" FontSize="12" Margin="0,2,0,0" />
                  <TextBlock Text="{Binding Inherited}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding Inherited, Converter={StaticResource TextVisibility}}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <views:NetworkFiltersView />
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Situação das metas por UBS">
      <StackPanel>
        <TextBlock Text="Situação das metas por UBS" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" ToolTip="Calculada pelos indicadores do período e dos filtros acima. Cada UBS usa a meta própria ou, se não tiver, a da rede; sem meta definida aparece Sem meta. O estado vem escrito, com ícone." />

        <DataGrid ItemsSource="{Binding GoalUnitRows}" RowHeight="64" MaxHeight="420" MinHeight="64" AutomationProperties.Name="Situação das metas por UBS">
          <DataGrid.Columns>
            <DataGridTextColumn Header="UBS" Binding="{Binding Name}" Width="*" MinWidth="150" />
            <DataGridTemplateColumn Header="Comparecimento (mín.)" Width="1.4*" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Score}" ContentTemplate="{StaticResource GoalCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Taxa de faltas (máx.)" Width="1.4*" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Missed}" ContentTemplate="{StaticResource GoalCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Espera média (máx.)" Width="1.4*" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><ContentControl Content="{Binding Wait}" ContentTemplate="{StaticResource GoalCellTemplate}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding GoalStatusState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding GoalStatusState, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
