<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.ChangePasswordView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Senha atual, nova e confirmação em grade (sem card), com o botão primário embaixo à direita; Secondary é o botão opcional à esquerda dele (ex.: Sair na troca obrigatória). -->
  <StackPanel IsEnabled="{Binding CanOperate}">
    <views:FormGrid>
      <StackPanel>
        <TextBlock Text="Senha atual" Style="{StaticResource FieldLabelText}" />
        <PasswordBox x:Name="Current" Margin="0,0,0,10" AutomationProperties.Name="Senha atual" KeyDown="OnAdvanceKeyDown" enter:EnterNavigation.Group="ChangePasswordView.password" />
        <TextBlock Text="{Binding CurrentPasswordError}" Style="{StaticResource FieldError}" Margin="0,-6,0,0" Visibility="{Binding CurrentPasswordError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Nova senha (8 a 256 caracteres)" Style="{StaticResource FieldLabelText}" />
        <PasswordBox x:Name="Next" Margin="0,0,0,10" AutomationProperties.Name="Nova senha" KeyDown="OnAdvanceKeyDown" enter:EnterNavigation.Group="ChangePasswordView.password" />
        <TextBlock Text="{Binding NewPasswordError}" Style="{StaticResource FieldError}" Margin="0,-6,0,0" Visibility="{Binding NewPasswordError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <StackPanel>
        <TextBlock Text="Confirmar a nova senha" Style="{StaticResource FieldLabelText}" />
        <PasswordBox x:Name="Confirm" Margin="0,0,0,10" AutomationProperties.Name="Confirmar nova senha" KeyDown="OnKeyDown" enter:EnterNavigation.Group="ChangePasswordView.password" />
        <TextBlock Text="{Binding ConfirmPasswordError}" Style="{StaticResource FieldError}" Margin="0,-6,0,0" Visibility="{Binding ConfirmPasswordError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </views:FormGrid>
    <DockPanel Margin="0,16,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Content="Salvar nova senha" Style="{StaticResource ObsPrimaryButton}" Click="OnChange" MinHeight="40" ToolTip="Troca a senha e encerra as outras sessões desta conta." enter:EnterNavigation.Group="ChangePasswordView.password" />
      <ContentControl DockPanel.Dock="Left" Focusable="False" IsTabStop="False" VerticalAlignment="Center" Content="{Binding Secondary, RelativeSource={RelativeSource AncestorType=views:ChangePasswordView}}" />
    </DockPanel>
  </StackPanel>
</UserControl>
