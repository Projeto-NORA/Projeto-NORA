<UserControl x:Class="Nora.Desktop.Views.ChangePasswordView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel IsEnabled="{Binding CanOperate}" Width="420" HorizontalAlignment="Left">
    <TextBlock Text="Senha atual" FontWeight="SemiBold" FontSize="12" />
    <PasswordBox x:Name="Current" Margin="0,6,0,14" AutomationProperties.Name="Senha atual" KeyDown="OnAdvanceKeyDown" />
    <TextBlock Text="{Binding CurrentPasswordError}" Style="{StaticResource FieldError}" Visibility="{Binding CurrentPasswordError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="Nova senha (8 a 256 caracteres)" FontWeight="SemiBold" FontSize="12" />
    <PasswordBox x:Name="Next" Margin="0,6,0,14" AutomationProperties.Name="Nova senha" KeyDown="OnAdvanceKeyDown" />
    <TextBlock Text="{Binding NewPasswordError}" Style="{StaticResource FieldError}" Visibility="{Binding NewPasswordError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="Confirmar a nova senha" FontWeight="SemiBold" FontSize="12" />
    <PasswordBox x:Name="Confirm" Margin="0,6,0,14" AutomationProperties.Name="Confirmar nova senha" KeyDown="OnKeyDown" />
    <TextBlock Text="{Binding ConfirmPasswordError}" Style="{StaticResource FieldError}" Visibility="{Binding ConfirmPasswordError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
    <Button Content="Salvar nova senha" Style="{StaticResource PrimaryButton}" Click="OnChange" HorizontalAlignment="Left" ToolTip="Troca a senha e encerra as outras sessões desta conta." />
  </StackPanel>
</UserControl>
