<UserControl x:Class="Nora.Desktop.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <UserControl.Resources>
    <DataTemplate x:Key="MunicipalPage"><views:MunicipalView /></DataTemplate>
    <DataTemplate x:Key="WorkspacePage"><views:WorkspaceView /></DataTemplate>
    <DataTemplate x:Key="DashboardPage"><views:OperationalOverviewView /></DataTemplate>
    <DataTemplate x:Key="AgendaPage"><views:AgendaView /></DataTemplate>
    <DataTemplate x:Key="InsightsPage"><views:OperationalInsightsView /></DataTemplate>
    <DataTemplate x:Key="AccessRequiredPage"><views:OperationalAccessView /></DataTemplate>
    <DataTemplate x:Key="UnitSettingsPage"><views:UnitSettingsView /></DataTemplate>
    <DataTemplate x:Key="AnnouncementsPage"><views:AnnouncementsView /></DataTemplate>
    <DataTemplate x:Key="FamilyPage"><views:FamilyView /></DataTemplate>
  </UserControl.Resources>
  <!-- A única ContentControl garante que uma aba não possa deixar a tela anterior visível. -->
  <ContentControl Content="{Binding Workspace}">
    <ContentControl.Style>
      <Style TargetType="ContentControl">
        <Setter Property="ContentTemplate" Value="{StaticResource WorkspacePage}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding Workspace.ShowMunicipal}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource MunicipalPage}" /></DataTrigger>
          <DataTrigger Binding="{Binding Workspace.ShowDashboard}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource DashboardPage}" /></DataTrigger>
          <DataTrigger Binding="{Binding Workspace.ShowAgenda}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource AgendaPage}" /></DataTrigger>
          <DataTrigger Binding="{Binding Workspace.ShowIndicators}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource InsightsPage}" /></DataTrigger>
          <DataTrigger Binding="{Binding Workspace.ShowAlerts}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource InsightsPage}" /></DataTrigger>
          <DataTrigger Binding="{Binding Workspace.ShowUnitSettings}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource UnitSettingsPage}" /></DataTrigger>
          <DataTrigger Binding="{Binding Workspace.ShowAnnouncements}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource AnnouncementsPage}" /></DataTrigger>
          <DataTrigger Binding="{Binding Workspace.ShowFamily}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource FamilyPage}" /></DataTrigger>
          <DataTrigger Binding="{Binding Workspace.RequiresSignInForCurrentSection}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource AccessRequiredPage}" /></DataTrigger>
        </Style.Triggers>
      </Style>
    </ContentControl.Style>
  </ContentControl>
</UserControl>
