<UserControl x:Class="Nora.Desktop.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <StackPanel>
    <views:WorkspaceView DataContext="{Binding Workspace}" />
    <StackPanel Visibility="{Binding Workspace.IsSignedOut, Converter={StaticResource BoolVisibility}}">
    <TextBlock Text="{Binding WorkspaceName}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}" Margin="0,0,0,12" />
    <TextBlock Text="{Binding HomeTitle}" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,10" />
    <TextBlock Text="{Binding HomeSubtitle}" Style="{StaticResource Muted}" FontSize="14" Margin="0,0,0,28" />
    <ItemsControl ItemsSource="{Binding Metrics}" Margin="-6,0,-6,24">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="4" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="6,0" Padding="20">
            <StackPanel>
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" Foreground="{DynamicResource BrandBrush}" FontSize="22" Margin="0,0,0,16" />
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
              <TextBlock Text="—" FontSize="29" Margin="0,8,0,4" />
              <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="12" />
              <TextBlock Text="Sem dados disponíveis" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding SectionTitle}" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Uma base organizada para acompanhar o cuidado." Style="{StaticResource Muted}" Margin="0,6,0,0" />
        </StackPanel>
        <Button Grid.Column="1" IsEnabled="False" Content="Filtrar" ToolTip="Disponível após a integração de dados" ToolTipService.ShowOnDisabled="True" VerticalAlignment="Top" />
      </Grid>
    </Border>
    <Border Style="{StaticResource Card}" Padding="0">
      <StackPanel>
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" SelectionMode="Single" SelectionUnit="FullRow" MaxHeight="300" MinHeight="44" Visibility="{Binding IsOperational, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Atendimentos da unidade">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Referência" Binding="{Binding Reference}" Width="*" />
            <DataGridTextColumn Header="Atendimento" Binding="{Binding Description}" Width="2*" />
            <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Margin="40,52" HorizontalAlignment="Center" MaxWidth="520" Visibility="{Binding HasNoRows, Converter={StaticResource BoolVisibility}}">
          <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource BrandSoftBrush}" Margin="0,0,0,22">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding EmptyTitle}" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" />
          <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource Muted}" FontSize="14" TextAlignment="Center" Margin="0,12,0,24" />
          <Button Content="Personalizar minha experiência" Command="{Binding NavigateCommand}" CommandParameter="settings" HorizontalAlignment="Center" />
        </StackPanel>
        <Border Background="{DynamicResource BrandSoftBrush}" Padding="18" Visibility="{Binding HasSelection, Converter={StaticResource BoolVisibility}}">
          <DockPanel>
            <TextBlock Text="1 atendimento selecionado" VerticalAlignment="Center" />
            <Button Content="Ações do atendimento indisponíveis" IsEnabled="False" HorizontalAlignment="Right" />
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,24,0,0" Visibility="{Binding IsMunicipal, Converter={StaticResource BoolVisibility}}">
      <StackPanel>
        <TextBlock Text="Evolução dos atendimentos" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="Séries históricas, comparativos e filtros por unidade serão disponibilizados com a integração." Style="{StaticResource Muted}" Margin="0,10,0,18" />
        <Border Height="110" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="Sem série histórica para exibir" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </StackPanel>
    </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
