<UserControl x:Class="Nora.Desktop.Views.SpecialtyCatalogView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Lista única de especialidades da rede (banco central): a Secretaria mantém, cada UBS escolhe dela. Não há exclusão: só ativar e desativar (a lixeira desativa). Cadastro e renomeação são pop-ups. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <views:PageFilterGroup Label="Cadastro de especialidades" SearchFields="Name,StatusDisplay" ItemsTarget="{Binding ElementName=SpecialtyList}" />
      <views:PageActions>
        <Button Style="{StaticResource NewItemButton}" Content="Nova especialidade" Click="OnNew" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="Nova especialidade" ToolTip="Abre o cadastro de especialidade." />
      </views:PageActions>
    </StackPanel>
    <Grid Grid.Row="1">
      <ListBox x:Name="SpecialtyList" Style="{StaticResource OpenList}" ItemsSource="{Binding SpecialtyCatalog}" AutomationProperties.Name="Lista de especialidades"
               views:ListingBehavior.Balloon="{Binding ElementName=Balloon}" views:ListingBehavior.PluralName="especialidades" views:ListingBehavior.Feminine="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid AutomationProperties.Name="{Binding SelectorLabel}" ToolTip="Desativar tira a especialidade da lista do paciente e de novos vínculos e horários; o que já existe é preservado. Maiúsculas, acentos e espaços não diferenciam nomes.">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleText}" VerticalAlignment="Center" />
              <views:StatusTag Grid.Column="1" Text="{Binding StatusDisplay}" Tone="{Binding StatusTone}" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <views:ListEmptyText List="{Binding ElementName=SpecialtyList}" EmptyText="{Binding SpecialtyCatalogState}" NoMatchText="Nenhuma especialidade encontrada para esta busca." Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="4,8" />
      <views:SelectionBalloon x:Name="Balloon">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="RenameButton" Style="{StaticResource ListActionEditButton}" views:SelectionBalloon.SingleItemOnly="True" Content="Renomear" Click="OnRename" IsEnabled="{Binding CanOperate}" ToolTip="Renomeia a especialidade selecionada." />
          <Button x:Name="ReactivateButton" Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconRestoreGeometry}" Content="Reativar" Click="OnReactivate" IsEnabled="{Binding CanOperate}" ToolTip="Reativa as especialidades desativadas selecionadas." />
          <Button x:Name="DeactivateButton" Style="{StaticResource ListActionDangerButton}" Content="Desativar" Click="OnDeactivate" IsEnabled="{Binding CanOperate}" ToolTip="Desativa as especialidades ativas selecionadas (pede confirmação)." AutomationProperties.Name="Desativar especialidade" />
        </StackPanel>
      </views:SelectionBalloon>
    </Grid>
  </Grid>
</UserControl>
