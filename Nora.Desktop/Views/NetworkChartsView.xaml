<UserControl x:Class="Nora.Desktop.Views.NetworkChartsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Modo gráficos das telas de números da rede: uma grade de gráficos, cada um com o título e o alternador Linha | Pizza; sem tabelas. -->
  <StackPanel>
    <ItemsControl x:Name="ChartList" ItemsSource="{Binding NetworkCharts}" Margin="-8,0" Focusable="False" AutomationProperties.Name="Gráficos da rede">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:AdaptiveGridPanel ColumnWidth="430" MaxColumns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Margin="8" Padding="20" AutomationProperties.Name="{Binding Title}">
            <views:ChartPanel Title="{Binding Title}" Lines="{Binding Lines}" Slices="{Binding Slices}" LineNote="{Binding LineNote}" PieNote="{Binding PieNote}" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding NetworkChartsState}" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding NetworkChartsState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
  </StackPanel>
</UserControl>
