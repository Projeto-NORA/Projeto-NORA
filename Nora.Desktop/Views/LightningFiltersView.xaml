<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.LightningFiltersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <StackPanel>
    <views:PageFilterGroup Label="Vagas e ofertas" FilterKey="networkLightning">
      <WrapPanel>
        <StackPanel Width="190" Margin="0,0,12,10"><TextBlock Text="Período da vaga" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{x:Static vm:WorkspaceViewModel.LightningPeriodOptions}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding LightningPeriodDays}" IsSynchronizedWithCurrentItem="False" IsEnabled="{Binding CanFilterLightning}" AutomationProperties.Name="Período das vagas" ToolTip="Selecione pela data de criação da vaga."  enter:EnterNavigation.Group="LightningFiltersView.filters"/></StackPanel>
        <StackPanel Width="190" Margin="0,0,12,10"><TextBlock Text="UBS" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding SummaryUnitFilter}" IsSynchronizedWithCurrentItem="False" IsEnabled="{Binding CanFilterNetwork}" AutomationProperties.Name="Filtrar resumo por UBS"  enter:EnterNavigation.Group="LightningFiltersView.filters"/></StackPanel>
      </WrapPanel>
    </views:PageFilterGroup>
    <Border Margin="0,6,0,0" CornerRadius="10" Padding="12,10" BorderThickness="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource WarningBrush}" Visibility="{Binding HasUnitsWithoutDatabase, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Aviso de UBS sem base">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Top" /><TextBlock Text="{Binding UnitsWithoutDatabaseNotice}" FontSize="12" MaxWidth="760" /></StackPanel>
      </Border>
  </StackPanel>
</UserControl>
