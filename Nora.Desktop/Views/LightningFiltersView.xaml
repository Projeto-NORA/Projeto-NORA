<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.LightningFiltersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Filtros da Vaga Relâmpago da rede, no cabeçalho: o período da vaga em linha (ou no botão Filtros, com PeriodInline desligado) e a UBS no botão Filtros. -->
  <StackPanel>
    <views:PageFilterGroup x:Name="PeriodGroup" Label="Período da vaga" FilterKey="networkLightning" Inline="True" IsEnabled="{Binding CanFilterLightning}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Período" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox MinWidth="150" ItemsSource="{x:Static vm:WorkspaceViewModel.LightningPeriodOptions}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding LightningPeriodDays}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Período das vagas" ToolTip="Selecione pela data de criação da vaga." enter:EnterNavigation.Group="LightningFiltersView.filters" />
      </StackPanel>
    </views:PageFilterGroup>
    <views:PageFilterGroup Label="Vagas e ofertas" FilterKey="networkLightning">
      <StackPanel>
        <StackPanel x:Name="UnitPicker" Margin="0,0,0,10"><TextBlock Text="UBS" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding SummaryUnitFilter}" IsSynchronizedWithCurrentItem="False" IsEnabled="{Binding CanFilterNetwork}" AutomationProperties.Name="Filtrar resumo por UBS" enter:EnterNavigation.Group="LightningFiltersView.filters" /></StackPanel>
        <StackPanel x:Name="PopupPeriod" Margin="0,0,0,10" Visibility="Collapsed" IsEnabled="{Binding CanFilterLightning}"><TextBlock Text="Período da vaga" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{x:Static vm:WorkspaceViewModel.LightningPeriodOptions}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding LightningPeriodDays}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Período das vagas" ToolTip="Selecione pela data de criação da vaga." enter:EnterNavigation.Group="LightningFiltersView.filters" /></StackPanel>
      </StackPanel>
    </views:PageFilterGroup>
    <ContentControl x:Name="Notice" Style="{StaticResource NoticeItem}" Margin="0,0,0,12" Visibility="{Binding HasUnitsWithoutDatabase, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Aviso de UBS sem base">
      <TextBlock Text="{Binding UnitsWithoutDatabaseNotice}" TextWrapping="Wrap" FontSize="12" />
    </ContentControl>
  </StackPanel>
</UserControl>
