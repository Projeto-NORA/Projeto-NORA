<UserControl x:Class="Nora.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <UserControl.Resources>
    <Style x:Key="AppearanceCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="AutomationProperties.HelpText" Value="Opção de aparência não selecionada" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
          <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" />
          <Setter Property="AutomationProperties.HelpText" Value="Opção de aparência selecionada" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ShortcutKey" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>
    <Style x:Key="ShortcutRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,10,10" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Border Background="{DynamicResource BrandGradientBrush}" CornerRadius="22" Padding="28" Margin="0,0,0,28">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Ellipse Width="132" Height="132" Fill="#16FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-75,-62,0" IsHitTestVisible="False" />
        <StackPanel>
          <TextBlock Text="SUA EXPERIÊNCIA NORA" FontSize="11" FontWeight="SemiBold" Foreground="#D9FFFFFF" />
          <TextBlock Text="Configurações" Foreground="{DynamicResource BrandTextBrush}" FontSize="30" FontWeight="SemiBold" Margin="0,9,0,7" />
        </StackPanel>
        <Border Grid.Column="1" Width="52" Height="52" CornerRadius="16" Background="#22FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="{DynamicResource BrandTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
      </Grid>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
      <StackPanel>
        <TextBlock Text="Perfil e unidade" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" Visibility="{Binding Workspace.IsOperational, Converter={StaticResource BoolVisibility}}" />
        <TextBlock Text="Perfil" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" Visibility="{Binding Workspace.IsMunicipal, Converter={StaticResource BoolVisibility}}" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel Margin="0,0,10,0"><TextBlock Text="Nome da conta" Style="{StaticResource Muted}" FontSize="12" /><TextBlock Text="{Binding Workspace.AccountName}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" Visibility="{Binding Workspace.IsOperational, Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Workspace.UnitLabelTitle}" Style="{StaticResource Muted}" FontSize="12" /><TextBlock Text="{Binding Workspace.UnitLabel}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" Visibility="{Binding Workspace.IsMunicipal, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Escopo da conta" Style="{StaticResource Muted}" FontSize="12" /><TextBlock Text="Toda a rede" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
          <StackPanel Grid.Row="1" Margin="0,14,10,0"><TextBlock Text="Perfil da conta" Style="{StaticResource Muted}" FontSize="12" /><TextBlock Text="{Binding Workspace.AccountRoleLabel}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
        </Grid>
        <TextBlock Text="Para mudar nome ou e-mail, fale com a Secretaria." Style="{StaticResource Muted}" Margin="0,18,0,0" Visibility="{Binding Workspace.IsOperational, Converter={StaticResource BoolVisibility}}" />
        <TextBlock Text="Para mudar nome ou e-mail, fale com quem administra o sistema da rede." Style="{StaticResource Muted}" Margin="0,18,0,0" Visibility="{Binding Workspace.IsMunicipal, Converter={StaticResource BoolVisibility}}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24" x:Name="PasswordCard">
      <StackPanel>
        <TextBlock Text="Alterar senha" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Ao concluir, as outras sessões desta conta são encerradas. A senha nunca é salva neste computador." Style="{StaticResource Muted}" Margin="0,8,0,18" />
        <TextBlock Text="Entre na conta para alterar a senha." Style="{StaticResource Muted}" Visibility="{Binding Workspace.IsSignedOut, Converter={StaticResource BoolVisibility}}" />
        <views:ChangePasswordView DataContext="{Binding Workspace}" Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisibility}}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
      <StackPanel>
        <TextBlock Text="Aparência" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
        <UniformGrid Columns="3" Margin="-6,0">
          <Button Style="{StaticResource AppearanceCard}" Margin="6,0" Command="{Binding AppearanceCommand}" CommandParameter="Light" Tag="{Binding LightSelected}" AutomationProperties.Name="Aparência clara">
            <StackPanel>
              <Border Background="#F4F7FB" BorderBrush="#D5E0EC" BorderThickness="1" Height="86" CornerRadius="8" Margin="0,0,0,16" Padding="10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Border Background="#E6F0FA" CornerRadius="4" Margin="0,0,6,0" />
                  <StackPanel Grid.Column="1">
                    <Border Background="White" CornerRadius="4" Height="18" Margin="0,0,0,6" />
                    <Border Background="White" CornerRadius="4" Height="30" />
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock Text="Clara" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="Selecionada ✓" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Hidden" /><Style.Triggers><DataTrigger Binding="{Binding LightSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource AppearanceCard}" Margin="6,0" Command="{Binding AppearanceCommand}" CommandParameter="Dark" Tag="{Binding DarkSelected}" AutomationProperties.Name="Aparência escura">
            <StackPanel>
              <Border Background="#071B33" BorderBrush="#274966" BorderThickness="1" Height="86" CornerRadius="8" Margin="0,0,0,16" Padding="10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Border Background="#123A5D" CornerRadius="4" Margin="0,0,6,0" />
                  <StackPanel Grid.Column="1">
                    <Border Background="#0C2744" CornerRadius="4" Height="18" Margin="0,0,0,6" />
                    <Border Background="#0C2744" CornerRadius="4" Height="30" />
                  </StackPanel>
                </Grid>
              </Border>
              <TextBlock Text="Escura" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="Selecionada ✓" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Hidden" /><Style.Triggers><DataTrigger Binding="{Binding DarkSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource AppearanceCard}" Margin="6,0" Command="{Binding AppearanceCommand}" CommandParameter="System" Tag="{Binding SystemSelected}" AutomationProperties.Name="Aparência do sistema">
            <StackPanel>
              <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Height="86" CornerRadius="8" Margin="0,0,0,16" ClipToBounds="True">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Border Background="#F4F7FB" />
                  <Border Grid.Column="1" Background="#071B33" />
                  <TextBlock Grid.ColumnSpan="2" Text="" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#1479CE" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
              </Border>
              <TextBlock Text="Sistema" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="Selecionada ✓" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Hidden" /><Style.Triggers><DataTrigger Binding="{Binding SystemSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel>
          </Button>
        </UniformGrid>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
      <StackPanel>
        <TextBlock Text="Preferências da interface" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
        <CheckBox IsChecked="{Binding ShowSidebarTips}" Content="Mostrar dicas na barra lateral" />
        <CheckBox IsChecked="{Binding ConfirmClose}" Content="Confirmar antes de fechar o aplicativo" />
        <CheckBox IsChecked="{Binding SaveNavigation}" Content="Retomar a última tela ao abrir" />
        <CheckBox IsChecked="{Binding Animations}" Content="Usar animações suaves ao navegar" />
        <CheckBox IsChecked="{Binding RememberSidebar}" Content="Lembrar a largura escolhida para a barra lateral" />
        <CheckBox IsChecked="{Binding FullScreen}" Content="Usar tela cheia" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
      <StackPanel>
        <TextBlock Text="Atalhos de teclado" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
        <UniformGrid Columns="2" Margin="0,0,-10,-10">
          <Border Style="{StaticResource ShortcutRow}"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + 1" FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Visão geral" FontWeight="SemiBold" /><TextBlock Text="Abre o Painel da UBS" Style="{StaticResource Muted}" FontSize="11" Visibility="{Binding Workspace.IsOperational, Converter={StaticResource BoolVisibility}}" /><TextBlock Text="Abre a Visão geral da rede" Style="{StaticResource Muted}" FontSize="11" Visibility="{Binding Workspace.IsMunicipal, Converter={StaticResource BoolVisibility}}" /></StackPanel></StackPanel></Border>
          <Border Style="{StaticResource ShortcutRow}"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + ," FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Configurações" FontWeight="SemiBold" /><TextBlock Text="Abre suas preferências" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></StackPanel></Border>
          <Border Style="{StaticResource ShortcutRow}"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ShortcutKey}"><TextBlock Text="Ctrl + Shift + T" FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Aparência" FontWeight="SemiBold" /><TextBlock Text="Alterna o tema visual" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></StackPanel></Border>
          <Border Style="{StaticResource ShortcutRow}"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ShortcutKey}"><TextBlock Text="F11" FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Tela cheia" FontWeight="SemiBold" /><TextBlock Text="Entra ou sai do modo amplo" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></StackPanel></Border>
          <Border Style="{StaticResource ShortcutRow}"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ShortcutKey}"><TextBlock Text="Esc" FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Sair da tela cheia" FontWeight="SemiBold" /><TextBlock Text="Volta ao tamanho anterior" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></StackPanel></Border>
          <Border Style="{StaticResource ShortcutRow}"><StackPanel Orientation="Horizontal"><Border Style="{StaticResource ShortcutKey}"><TextBlock Text="Alt + F4" FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" /></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Fechar aplicativo" FontWeight="SemiBold" /><TextBlock Text="Respeita sua confirmação" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></StackPanel></Border>
        </UniformGrid>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Restaurar padrões" FontSize="18" FontWeight="SemiBold" />
        </StackPanel>
        <Button Grid.Column="1" Content="Restaurar padrões" Command="{Binding RestoreCommand}" Margin="20,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,24,0,0">
      <Expander Header="Avançado" AutomationProperties.Name="Configurações avançadas">
        <StackPanel Margin="0,12,0,0">
        <TextBlock Text="Conexão" FontWeight="SemiBold" />
        <TextBlock ToolTip="Também pode ser definido pela variável privada NORA_API_URL." Text="Endereço do servidor para o próximo login." Style="{StaticResource Muted}" Margin="0,6,0,12" />
        <TextBox Text="{Binding Workspace.Endpoint, UpdateSourceTrigger=PropertyChanged}" Padding="10" MinHeight="42" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="Endereço do servidor em Configurações" />
        <TextBlock Text="{Binding Workspace.ConnectionLabel}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
        </StackPanel>
      </Expander>
    </Border>
  </StackPanel>
</UserControl>
