<UserControl x:Class="Nora.Desktop.Views.AnnouncementsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Comunicados da Secretaria para a equipe (OBS). Não lido aparece como texto e ícone, nunca só em cor; título e texto são texto puro. -->
  <StackPanel>
    <TextBlock Text="Comunicados" Style="{StaticResource PageTitle}" Margin="0,0,0,20" ToolTip="Comunicados da Secretaria para a equipe. Marque cada comunicado como lido para confirmar a leitura." />
    <DockPanel Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconRefreshButton}" Click="OnRefresh" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="Atualizar comunicados" ToolTip="Lê de novo todos os comunicados em vigor." />
      <StackPanel>
        <TextBlock Text="{Binding AnnouncementsSummary}" FontWeight="SemiBold" Visibility="{Binding AnnouncementsSummary, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding AnnouncementsFootnote}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding AnnouncementsFootnote, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </DockPanel>
    <Border Background="{DynamicResource BrandSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18" Visibility="{Binding AnnouncementsState, Converter={StaticResource TextVisibility}}" AutomationProperties.Name="Estado dos comunicados">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Text="{Binding AnnouncementsState}" AutomationProperties.LiveSetting="Polite" />
      </Grid>
    </Border>
    <views:PageFilterGroup Label="Comunicados recebidos" SearchFields="Title,Body,StateDisplay" ItemsTarget="{Binding ElementName=ReceivedFilterList}" />
    <ItemsControl x:Name="ReceivedFilterList" ItemsSource="{Binding Announcements}" AutomationProperties.Name="Comunicados recebidos">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,14" AutomationProperties.Name="{Binding AutomationLabel}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
                <Style.Triggers><DataTrigger Binding="{Binding IsUnread}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger></Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Marcar como lido" Style="{StaticResource ObsPrimaryButton}" Click="OnMarkRead" Visibility="{Binding IsUnread, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=UserControl}}" MinHeight="36" Padding="14,6" AutomationProperties.Name="Marcar como lido" ToolTip="Marca o comunicado como lido."/>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,2,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding StateDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding PublishedAtDisplay}" Style="{StaticResource Muted}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </DockPanel>
              <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22" />
              <TextBlock Text="{Binding ValidityDisplay}" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" Visibility="{Binding ValidityDisplay, Converter={StaticResource TextVisibility}}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
