<UserControl x:Class="Nora.Desktop.Views.AnnouncementsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" views:PageLayout.Fill="True">
  <!-- Comunicados da Secretaria para a equipe (OBS): só a listagem. Não lido aparece como texto na etiqueta, nunca só em cor; título e texto são texto puro.
       Balão: "Marcar como lido" (vale para vários). Duplo clique, segundo clique ou Enter abre o texto completo. A pesquisa fica no cabeçalho, em linha. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel>
      <views:PageFilterGroup Label="Comunicados recebidos" SearchFields="Title,Body,StateDisplay" ItemsTarget="{Binding ElementName=ReceivedFilterList}" />
      <!-- A última leitura falhou e a lista mostrada é a de uma leitura anterior. -->
      <ContentControl Style="{StaticResource NoticeItem}" Margin="0,0,0,10" Content="{Binding AnnouncementsFootnote}" Visibility="{Binding AnnouncementsFootnote, Converter={StaticResource TextVisibility}}" AutomationProperties.Name="Estado dos comunicados" AutomationProperties.LiveSetting="Polite">
        <ContentControl.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
    </StackPanel>
    <Grid Grid.Row="1">
      <ListBox x:Name="ReceivedFilterList" Style="{StaticResource OpenList}" ItemsSource="{Binding Announcements}" AutomationProperties.Name="Comunicados recebidos" ToolTip="Duplo clique ou Enter abre o texto completo do comunicado."
               views:SearchEmptyNotice.Target="{Binding ElementName=SearchEmpty}" views:ListingBehavior.Balloon="{Binding ElementName=Balloon}" views:ListingBehavior.LabelPath="Title" views:ListingBehavior.KeyPath="Id" views:ListingBehavior.PluralName="comunicados">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid AutomationProperties.Name="{Binding AutomationLabel}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource ItemTitleText}" />
                <TextBlock Text="{Binding MetaLine}" Style="{StaticResource ItemMetaText}" />
              </StackPanel>
              <views:StatusTag Grid.Column="1" Text="{Binding StateDisplay}" Tone="{Binding StateTone}" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <views:SelectionBalloon x:Name="Balloon" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="MarkReadButton" Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconCheckAllGeometry}" Content="Marcar como lido" Click="OnMarkRead" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="Marcar como lido" ToolTip="Marca como lido o comunicado selecionado (ou todos os selecionados)." />
        </StackPanel>
      </views:SelectionBalloon>
      <!-- Lista vazia: nenhum comunicado em vigor, leitura em andamento ou falha da primeira leitura; "encontrado para esta busca" é outro estado. -->
      <TextBlock Text="{Binding AnnouncementsState}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Margin="0,28,0,0" Visibility="{Binding AnnouncementsState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Estado dos comunicados" />
      <TextBlock x:Name="SearchEmpty" Text="Nenhum comunicado encontrado para esta busca." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
      <ProgressBar IsIndeterminate="True" Height="3" Width="220" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0" Visibility="{Binding IsAnnouncementsLoading, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Lendo os comunicados" />
    </Grid>
  </Grid>
</UserControl>
