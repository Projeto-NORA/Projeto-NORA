<UserControl x:Class="Nora.Desktop.Views.ScoreNoteView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="0,0,0,20">
    <TextBlock Text="Como é calculado o comparecimento ⓘ" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" ToolTip="Comparecimento = concluídas ÷ (concluídas + faltas + cancelamentos feitos pelo paciente, ponderados pela antecedência). Consultas ainda agendadas e cancelamentos feitos pela unidade não entram." />
    <Expander Header="Saiba mais sobre o comparecimento" Margin="0,6,0,0" AutomationProperties.Name="Saiba mais sobre o comparecimento">
      <StackPanel Margin="0,8,0,0">
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Conta só consultas encerradas. Cancelamento feito pelo paciente pesa como fração de falta, maior quanto mais perto da consulta (100% com menos de 1 h; 0% com 96 h ou mais)." />
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Text="Consultas agendadas, chamadas e cancelamentos da unidade não pesam. Sem consulta encerrada, o valor aparece como —." />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
