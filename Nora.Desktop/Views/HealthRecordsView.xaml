<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.HealthRecordsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels">
  <!-- Aba "Exames e vacinas" da ficha do paciente (OBS). Nada é apagado: a correção é a anulação, com motivo. O paciente só visualiza no aplicativo. -->
  <UserControl.Resources>
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,6,0,10" /></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,6,0,10" /></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="12" /></Style>
    <Style x:Key="Panel" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="16" /><Setter Property="Margin" Value="0,0,0,14" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <!-- Retorno das ações, dentro da ficha: erro, sucesso e informação aparecem como ícone, palavra e texto. -->
    <Border Padding="12,8" CornerRadius="10" BorderThickness="1" Margin="0,0,0,12" Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Retorno da Jornada">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding MessageKindName}" Value="success"><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding MessageKindName}" Value="error"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding MessageIcon}" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,2,10,0" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Message}"><Run Text="{Binding MessageKindLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" /></TextBlock>
      </Grid>
    </Border>
    <Border Style="{StaticResource Panel}" Visibility="{Binding HasRegisterNotice, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Cadastro desativado">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,2,10,0" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Text="{Binding RegisterNotice}" TextWrapping="Wrap" />
      </Grid>
    </Border>
    <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Content="Atualizar" Click="OnRefresh" IsEnabled="{Binding CanRefresh}" MinHeight="36" Padding="14,6" />
      <CheckBox IsChecked="{Binding IncludeVoided}" Content="Mostrar anulados" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="Mostrar anulados" />
    </DockPanel>
    <TextBlock Text="{Binding ListState}" Style="{StaticResource Muted}" Margin="0,0,0,12" Visibility="{Binding ListState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />

    <!-- Exames -->
    <Border Style="{StaticResource Panel}" AutomationProperties.Name="Exames">
      <StackPanel>
        <TextBlock Text="Exames" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10" Text="O exame nasce solicitado. A partir daí só pode ficar realizado (com a data) ou cancelado, uma única vez. Para corrigir um registro errado, use Anular." />
        <DataGrid ItemsSource="{Binding Exams}" SelectedItem="{Binding SelectedExam}" IsReadOnly="True" MaxHeight="230" MinHeight="64" AutomationProperties.Name="Exames do paciente" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Exame" Binding="{Binding Name}" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}" />
            <DataGridTemplateColumn Header="Situação" SortMemberPath="Status" Width="125">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"><TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" /><TextBlock Text="{Binding StatusDisplay}" TextWrapping="NoWrap" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Data" Binding="{Binding DateDisplay}" Width="195" ElementStyle="{StaticResource CellText}" />
            <DataGridTemplateColumn Header="Detalhes" Width="1.4*" MinWidth="130">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NoteDisplay}" Style="{StaticResource CellText}" Visibility="{Binding NoteDisplay, Converter={StaticResource TextVisibility}}" />
                    <TextBlock Text="{Binding VoidDisplay}" Style="{StaticResource CellText}" Visibility="{Binding VoidDisplay, Converter={StaticResource TextVisibility}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding ExamsState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding ExamsState, Converter={StaticResource TextVisibility}}" />
        <TextBlock Text="Exame selecionado: marcar como realizado (informe a data) ou cancelar" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
        <WrapPanel Margin="0,4,0,0">
          <TextBox Text="{Binding ExamDoneDate, UpdateSourceTrigger=PropertyChanged}" MinWidth="130" MaxLength="10" Margin="0,6,10,10" ToolTip="Data de realização, dd/mm/aaaa" AutomationProperties.Name="Data de realização do exame"  enter:EnterNavigation.Group="HealthRecordsView.done"/>
          <Button Content="Marcar como realizado" Click="OnExamDone" IsEnabled="{Binding CanMarkExamDone}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" ToolTip="Só um exame solicitado, selecionado na lista."  enter:EnterNavigation.Group="HealthRecordsView.done"/>
          <Button Content="Cancelar exame" Click="OnExamCancel" IsEnabled="{Binding CanCancelExam}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" ToolTip="Só um exame solicitado, selecionado na lista. Pede confirmação." />
        </WrapPanel>
        <TextBlock Text="{Binding ExamDoneError}" Style="{StaticResource FieldError}" Margin="0,-4,0,10" Visibility="{Binding ExamDoneError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,4,0,0">
          <StackPanel IsEnabled="{Binding CanRegister}">
            <TextBlock Text="Registrar exame solicitado" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Nome do exame" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ExamName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Nome do exame"  enter:EnterNavigation.Group="HealthRecordsView.exam"/>
            <TextBlock Text="{Binding ExamNameError}" Style="{StaticResource FieldError}" Margin="0,-6,0,10" Visibility="{Binding ExamNameError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="Observação (opcional, até 280 caracteres, sem anexo)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding ExamNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="400" AutomationProperties.Name="Observação do exame"  enter:EnterNavigation.Group="HealthRecordsView.exam"/>
            <TextBlock Text="{Binding ExamNoteError}" Style="{StaticResource FieldError}" Margin="0,-6,0,10" Visibility="{Binding ExamNoteError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
            <Button Content="Registrar exame" Click="OnCreateExam" IsEnabled="{Binding CanCreateExam}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"  enter:EnterNavigation.Group="HealthRecordsView.exam"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Vacinas -->
    <Border Style="{StaticResource Panel}" AutomationProperties.Name="Vacinas">
      <StackPanel>
        <TextBlock Text="Vacinas" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10" Text="A vacina é registrada já aplicada, com a dose e a data. Para corrigir um registro errado, use Anular." />
        <DataGrid ItemsSource="{Binding Vaccines}" SelectedItem="{Binding SelectedVaccine}" IsReadOnly="True" MaxHeight="230" MinHeight="64" AutomationProperties.Name="Vacinas do paciente" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Vacina" Binding="{Binding Name}" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Dose" Binding="{Binding DoseDisplay}" SortMemberPath="Dose" Width="105" />
            <DataGridTextColumn Header="Data" Binding="{Binding DateDisplay}" SortMemberPath="AppliedOn" Width="195" ElementStyle="{StaticResource CellText}" />
            <DataGridTemplateColumn Header="Situação" SortMemberPath="Status" Width="115">
              <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0"><TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" /><TextBlock Text="{Binding StatusDisplay}" TextWrapping="NoWrap" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Detalhes" Width="1.2*" MinWidth="120">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel Margin="4,2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NoteDisplay}" Style="{StaticResource CellText}" Visibility="{Binding NoteDisplay, Converter={StaticResource TextVisibility}}" />
                    <TextBlock Text="{Binding VoidDisplay}" Style="{StaticResource CellText}" Visibility="{Binding VoidDisplay, Converter={StaticResource TextVisibility}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding VaccinesState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding VaccinesState, Converter={StaticResource TextVisibility}}" />
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
          <StackPanel IsEnabled="{Binding CanRegister}">
            <TextBlock Text="Registrar vacina aplicada" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Nome da vacina" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding VaccineName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Nome da vacina"  enter:EnterNavigation.Group="HealthRecordsView.vaccine"/>
            <TextBlock Text="{Binding VaccineNameError}" Style="{StaticResource FieldError}" Margin="0,-6,0,10" Visibility="{Binding VaccineNameError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Dose" Style="{StaticResource FieldLabel}" />
                <ComboBox ItemsSource="{x:Static vm:HealthRecordsViewModel.DoseOptions}" DisplayMemberPath="Label" SelectedItem="{Binding VaccineDoseChoice}" AutomationProperties.Name="Dose da vacina"  enter:EnterNavigation.Group="HealthRecordsView.vaccine"/>
                <TextBlock Text="{Binding VaccineDoseError}" Style="{StaticResource FieldError}" Margin="0,-6,0,10" Visibility="{Binding VaccineDoseError, Converter={StaticResource TextVisibility}}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Data de aplicação (dd/mm/aaaa)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding VaccineDate, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" AutomationProperties.Name="Data de aplicação da vacina"  enter:EnterNavigation.Group="HealthRecordsView.vaccine"/>
                <TextBlock Text="{Binding VaccineDateError}" Style="{StaticResource FieldError}" Margin="0,-6,0,10" Visibility="{Binding VaccineDateError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
            </Grid>
            <TextBlock Text="Observação (opcional, até 280 caracteres, sem anexo)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding VaccineNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="400" AutomationProperties.Name="Observação da vacina"  enter:EnterNavigation.Group="HealthRecordsView.vaccine"/>
            <TextBlock Text="{Binding VaccineNoteError}" Style="{StaticResource FieldError}" Margin="0,-6,0,10" Visibility="{Binding VaccineNoteError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
            <Button Content="Registrar vacina" Click="OnCreateVaccine" IsEnabled="{Binding CanCreateVaccine}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"  enter:EnterNavigation.Group="HealthRecordsView.vaccine"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- Anulação -->
    <Border Style="{StaticResource Panel}" AutomationProperties.Name="Anular registro">
      <StackPanel>
        <TextBlock Text="Anular registro" FontSize="17" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10" Text="Anular corrige um registro errado sem apagar: ele sai da lista (volta com Mostrar anulados), o motivo fica gravado e quem anulou e quando também. O paciente não vê o motivo." />
        <TextBlock Text="{Binding SelectedRecordLabel}" FontWeight="SemiBold" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="Motivo da anulação (3 a 280 caracteres)" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding VoidReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="400" IsEnabled="{Binding CanRegister}" AutomationProperties.Name="Motivo da anulação"  enter:EnterNavigation.Group="HealthRecordsView.void"/>
        <TextBlock Text="{Binding VoidReasonError}" Style="{StaticResource FieldError}" Margin="0,-6,0,10" Visibility="{Binding VoidReasonError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        <Button Content="Anular registro selecionado" Click="OnVoid" IsEnabled="{Binding CanVoid}" HorizontalAlignment="Left" ToolTipService.ShowOnDisabled="True" ToolTip="Selecione um exame ou uma vacina que não esteja anulado. Pede confirmação."  enter:EnterNavigation.Group="HealthRecordsView.void"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
