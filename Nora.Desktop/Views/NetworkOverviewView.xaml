<UserControl x:Class="Nora.Desktop.Views.NetworkOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,20" ToolTip="Os totais mostram a situação atual e podem ser filtrados por UBS.">
      <StackPanel><TextBlock Text="Filtrar por UBS" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,10" />
        <ComboBox ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding SummaryUnitFilter}" IsSynchronizedWithCurrentItem="False" IsEnabled="{Binding CanFilterNetwork}" AutomationProperties.Name="Filtrar por UBS" />
        <TextBlock Text="{Binding UnitsWithoutDatabaseNotice}" Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0" Visibility="{Binding HasUnitsWithoutDatabase, Converter={StaticResource BoolVisibility}}" />
      </StackPanel>
    </Border>
    <TextBlock Text="Rede agora" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10"><Run Text="Totais atuais de" /> <Run Text="{Binding AppliedSummaryUnitLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Respeitam a UBS escolhida, não o período." /></TextBlock>
    <ItemsControl ItemsSource="{Binding SummaryCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-6,0,-6,14" AutomationProperties.Name="Totais atuais da rede" />
  </StackPanel>
</UserControl>
