<UserControl x:Class="Nora.Desktop.Views.NetworkOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <StackPanel>
    <views:NetworkFiltersView />
    <TextBlock Text="Rede agora" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10"><Run Text="Totais atuais de" /> <Run Text="{Binding AppliedSummaryUnitLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Respeitam a UBS escolhida, não o período." /></TextBlock>
    <ItemsControl ItemsSource="{Binding SummaryCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-6,0,-6,14" AutomationProperties.Name="Totais atuais da rede" />
    <TextBlock Text="Indicadores do período" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0" />
    <TextBlock Text="{Binding MetricsStateText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding MetricsStateText, Converter={StaticResource TextVisibility}}" />
    <ItemsControl ItemsSource="{Binding OverviewCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-6,10,-6,6" AutomationProperties.Name="Indicadores do período" />
    <views:ScoreNoteView />
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Evolução no período" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="Pela data marcada." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" />
        <views:EvolutionChartView Data="{Binding NetworkChart}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="O que ainda não é medido" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="O aceite da oferta não confirma o atendimento, e a taxa de reaproveitamento ainda não é calculada. Aprovação fica na aba Vaga Relâmpago, capacidade na aba Capacidade e metas em Relatórios e metas." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
