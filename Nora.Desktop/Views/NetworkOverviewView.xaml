<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.NetworkOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <StackPanel>
    <views:PageFilterGroup Label="Resumo da rede" FilterKey="networkOverview">
      <StackPanel><TextBlock Text="UBS" FontWeight="SemiBold" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding SummaryUnitFilter}" IsSynchronizedWithCurrentItem="False" IsEnabled="{Binding CanFilterNetwork}" AutomationProperties.Name="Filtrar por UBS"  enter:EnterNavigation.Group="NetworkOverviewView.filters"/></StackPanel>
    </views:PageFilterGroup>
    <TextBlock Text="{Binding UnitsWithoutDatabaseNotice}" Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,0" Visibility="{Binding HasUnitsWithoutDatabase, Converter={StaticResource BoolVisibility}}" />
    <TextBlock Text="Rede agora" FontSize="20" FontWeight="SemiBold" />
    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10"><Run Text="Totais atuais de" /> <Run Text="{Binding AppliedSummaryUnitLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Respeitam a UBS escolhida, não o período." /></TextBlock>
    <ItemsControl ItemsSource="{Binding SummaryCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-6,0,-6,14" AutomationProperties.Name="Totais atuais da rede" />
  </StackPanel>
</UserControl>
