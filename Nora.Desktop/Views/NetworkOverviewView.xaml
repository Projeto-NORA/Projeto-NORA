<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.NetworkOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Visão geral da rede. Cabeçalho: pesquisa, Período em linha, Filtros (UBS, região, especialidade) e o alternador cards / gráficos. Cards: os totais de agora e o resumo do período, em cartões coloridos, e a tabela por região. Gráficos: a grade de gráficos, sem tabelas. -->
  <UserControl.Resources>
    <ItemsPanelTemplate x:Key="NowPanel"><views:AdaptiveGridPanel ColumnWidth="215" MaxColumns="4" /></ItemsPanelTemplate>
    <Style x:Key="CardsModeOnly" TargetType="StackPanel">
      <Style.Triggers><DataTrigger Binding="{Binding Mode, ElementName=ModeToggle}" Value="Charts"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="ChartsModeOnly" TargetType="views:NetworkChartsView">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers><DataTrigger Binding="{Binding Mode, ElementName=ModeToggle}" Value="Charts"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <views:PageFilterGroup Label="Visão geral" FilterKey="networkSearch" Inline="True" IsEnabled="{Binding CanFilterNetwork}"><views:NetworkSearchField Label="Visão geral" /></views:PageFilterGroup>
    <views:NetworkFiltersView />
    <views:PageActions><views:ViewModeToggle x:Name="ModeToggle" ScreenKey="home" /></views:PageActions>
    <TextBlock x:Name="SearchEmpty" Text="Nenhum resultado para esta busca." Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    <StackPanel Style="{StaticResource CardsModeOnly}">
      <TextBlock Text="Rede agora" Style="{StaticResource SectionTitle}" Margin="0,16,0,0" />
      <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,10"><Run Text="Totais atuais de" /> <Run Text="{Binding AppliedSummaryUnitLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Respeitam a UBS escolhida, não o período." /></TextBlock>
      <ItemsControl x:Name="NowCards" ItemsSource="{Binding SummaryCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource NowPanel}" Margin="-8,0" Focusable="False" AutomationProperties.Name="Totais atuais da rede" />
      <TextBlock Text="{Binding PeriodSummaryTitle}" Style="{StaticResource SectionTitle}" Margin="0,16,0,10" />
      <ItemsControl x:Name="PeriodCards" ItemsSource="{Binding OverviewCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-8,0" Focusable="False" AutomationProperties.Name="Indicadores do período" />
      <TextBlock Text="{Binding MetricsStateText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding MetricsStateText, Converter={StaticResource TextVisibility}}" />
      <views:RegionPerformanceTable x:Name="Regions" Margin="0,22,0,0" />
    </StackPanel>
    <views:NetworkChartsView x:Name="Charts" Margin="0,16,0,0" Style="{StaticResource ChartsModeOnly}" />
  </StackPanel>
</UserControl>
