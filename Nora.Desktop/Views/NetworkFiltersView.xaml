<UserControl x:Class="Nora.Desktop.Views.NetworkFiltersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels">
  <UserControl.Resources>
    <!-- Nome longo de UBS ou de especialidade cabe inteiro na dica do mouse mesmo se a caixa o cortar. -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="ToolTip" Value="{x:Null}" /></Trigger></Style.Triggers></Style>
  </UserControl.Resources>
  <Border Style="{StaticResource Card}" Margin="0,0,0,20">
    <StackPanel>
      <DockPanel Margin="0,0,0,12">
        <TextBlock DockPanel.Dock="Right" Text="{Binding MetricsLoadingLabel}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="Filtros da rede" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <WrapPanel IsEnabled="{Binding CanFilterNetwork}">
        <StackPanel Width="230" Margin="0,0,12,10"><TextBlock Text="Período" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{x:Static vm:WorkspaceViewModel.PeriodOptions}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding MetricsPeriodDays}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Período dos indicadores" /></StackPanel>
        <StackPanel Width="230" Margin="0,0,12,10"><TextBlock Text="UBS" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding SummaryUnitFilter}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar por UBS" /></StackPanel>
        <StackPanel Width="230" Margin="0,0,12,10"><TextBlock Text="Região" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{Binding RegionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MetricsRegion}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar por região" /></StackPanel>
        <StackPanel Width="230" Margin="0,0,12,10"><TextBlock Text="Especialidade" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{Binding SpecialtyOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MetricsSpecialty}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar por especialidade" /></StackPanel>
      </WrapPanel>
      <StackPanel Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0">
        <WrapPanel IsEnabled="{Binding CanFilterNetwork}">
          <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="De (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding MetricsFromText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data inicial do período" /></StackPanel>
          <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="Até (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding MetricsToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data final do período" /></StackPanel>
          <Button Content="Aplicar período" Click="OnApplyPeriod" VerticalAlignment="Bottom" Margin="0,0,0,8" ToolTip="Consulta os indicadores no intervalo informado (até 366 dias)." />
        </WrapPanel>
        <TextBlock Text="{Binding MetricsRangeError}" Style="{StaticResource FieldError}" Margin="0,0,0,8" Visibility="{Binding MetricsRangeError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <TextBlock Text="{Binding MetricsScopeLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" Visibility="{Binding MetricsScopeLabel, Converter={StaticResource TextVisibility}}" />
      <Border Margin="0,12,0,0" CornerRadius="10" Padding="12,10" BorderThickness="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource WarningBrush}" Visibility="{Binding HasUnitsWithoutDatabase, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Aviso de UBS sem base">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Top" /><TextBlock Grid.Column="1" Text="{Binding UnitsWithoutDatabaseNotice}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="2" Content="Abrir Unidades" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="units" Margin="14,0,0,0" VerticalAlignment="Center">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Section}" Value="units"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
