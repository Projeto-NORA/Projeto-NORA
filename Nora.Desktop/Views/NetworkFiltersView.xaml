<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.NetworkFiltersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Filtros dos indicadores da rede, no cabeçalho: o Período fica em linha (Dia, Semana, Mês, Ano, 5 anos e Máximo; Personalizado só onde AllowCustom) e UBS, região, especialidade e as datas do período personalizado ficam no botão Filtros. -->
  <UserControl.Resources>
    <!-- "Personalizado" só aparece nas telas que oferecem as datas (Tag = custom) ou enquanto o período personalizado está valendo; nas demais é escondido. -->
    <Style x:Key="PeriodItem" TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Days}" Value="0" />
            <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="fixed" />
            <Condition Binding="{Binding DataContext.IsCustomPeriod, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="False" />
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Collapsed" />
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <views:PageFilterGroup x:Name="PeriodGroup" Label="Período" FilterKey="networkMetrics" Inline="True" IsEnabled="{Binding CanFilterNetwork}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Período" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox x:Name="PeriodBox" Tag="fixed" MinWidth="100" ItemsSource="{x:Static vm:WorkspaceViewModel.PeriodOptions}" ItemContainerStyle="{StaticResource PeriodItem}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding MetricsPeriodDays}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Período dos indicadores" ToolTip="Janela que termina hoje. Escolha o intervalo exato em Personalizado, no botão Filtros." enter:EnterNavigation.Group="NetworkFiltersView.filters" />
      </StackPanel>
    </views:PageFilterGroup>
    <views:PageFilterGroup Label="Escopo dos indicadores" FilterKey="networkMetrics" IsEnabled="{Binding CanFilterNetwork}">
      <StackPanel>
        <StackPanel Margin="0,0,0,10"><TextBlock Text="UBS" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding SummaryUnitFilter}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar por UBS" enter:EnterNavigation.Group="NetworkFiltersView.filters" /></StackPanel>
        <StackPanel Margin="0,0,0,10"><TextBlock Text="Região" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{Binding RegionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MetricsRegion}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar por região" enter:EnterNavigation.Group="NetworkFiltersView.filters" /></StackPanel>
        <StackPanel Margin="0,0,0,10"><TextBlock Text="Especialidade" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{Binding SpecialtyOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding MetricsSpecialty}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar por especialidade" enter:EnterNavigation.Group="NetworkFiltersView.filters" /></StackPanel>
        <StackPanel x:Name="PopupPeriod" Margin="0,0,0,10" Visibility="Collapsed">
          <TextBlock Text="Período" FontWeight="SemiBold" FontSize="12" />
          <ComboBox x:Name="PopupPeriodBox" Tag="fixed" Margin="0,6,0,0" ItemsSource="{x:Static vm:WorkspaceViewModel.PeriodOptions}" ItemContainerStyle="{StaticResource PeriodItem}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding MetricsPeriodDays}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Período dos indicadores" enter:EnterNavigation.Group="NetworkFiltersView.filters" />
        </StackPanel>
        <StackPanel Visibility="{Binding IsCustomPeriod, Converter={StaticResource BoolVisibility}}" IsEnabled="{Binding CanFilterNetwork}">
          <WrapPanel>
            <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="De (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding MetricsFromText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data inicial do período" enter:EnterNavigation.Group="NetworkFiltersView.filters" /></StackPanel>
            <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="Até (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding MetricsToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data final do período" enter:EnterNavigation.Group="NetworkFiltersView.filters" /></StackPanel>
            <Button Content="Aplicar período" Click="OnApplyPeriod" VerticalAlignment="Bottom" Margin="0,0,0,8" ToolTip="Consulta os indicadores no intervalo informado (até 20 anos)." enter:EnterNavigation.Group="NetworkFiltersView.filters" />
          </WrapPanel>
          <TextBlock Text="{Binding MetricsRangeError}" Style="{StaticResource FieldError}" Margin="0,0,0,8" Visibility="{Binding MetricsRangeError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </StackPanel>
    </views:PageFilterGroup>
    <TextBlock Text="{Binding MetricsLoadingLabel}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding MetricsLoadingLabel, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="{Binding MetricsScopeLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" Visibility="{Binding MetricsScopeLabel, Converter={StaticResource TextVisibility}}" />
    <ContentControl Style="{StaticResource NoticeItem}" Margin="0,10,0,0" Visibility="{Binding HasUnitsWithoutDatabase, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Aviso de UBS sem base">
      <TextBlock Text="{Binding UnitsWithoutDatabaseNotice}" TextWrapping="Wrap" FontSize="12" />
    </ContentControl>
  </StackPanel>
</UserControl>
