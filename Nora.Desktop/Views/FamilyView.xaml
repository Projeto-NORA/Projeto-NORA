<UserControl x:Class="Nora.Desktop.Views.FamilyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Família e Vínculos aprovados (OBS): o responsável pede o vínculo pelo aplicativo; a equipe confere os documentos e decide. Aprovado, o responsável age pelo dependente.
       Cada subtela é uma listagem aberta e uma pesquisa (no cabeçalho); as decisões ficam no balão de ações. A mesma célula guarda as duas subtelas, e só uma aparece por vez (SubPage.Key). -->
  <UserControl.Resources>
    <!-- O item da listagem: "responsável → dependente" e, embaixo, os CPFs e a data. -->
    <DataTemplate x:Key="PendingItem">
      <StackPanel AutomationProperties.Name="{Binding AutomationLabel}">
        <TextBlock Text="{Binding Title}" Style="{StaticResource ItemTitleText}" ToolTip="{Binding Title}" />
        <TextBlock Text="{Binding PendingMetaLine}" Style="{StaticResource ItemMetaText}" ToolTip="{Binding PendingMetaLine}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="ApprovedItem">
      <StackPanel AutomationProperties.Name="{Binding AutomationLabel}">
        <TextBlock Text="{Binding Title}" Style="{StaticResource ItemTitleText}" ToolTip="{Binding Title}" />
        <TextBlock Text="{Binding ApprovedMetaLine}" Style="{StaticResource ItemMetaText}" ToolTip="{Binding ApprovedMetaLine}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <views:ObsUnitNoticeView />
    <!-- Família: os pedidos aguardando decisão, do mais antigo ao mais novo. Aprovar e Recusar no balão. -->
    <Grid Grid.Row="1" views:SubPage.Key="requests" views:PageLayout.Fill="True" IsEnabled="{Binding HasActiveObsUnit}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <StackPanel>
        <views:PageFilterGroup Label="Pedidos de vínculo" SearchFields="GuardianName,DependentDisplay,GuardianCpfDisplay,DependentCpfDisplay" ItemsTarget="{Binding ElementName=PendingList}" />
        <ProgressBar IsIndeterminate="True" Height="3" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" Visibility="{Binding FamilyPendingLoading, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Carregando os pedidos" />
        <TextBlock Text="{Binding FamilyPendingState}" Style="{StaticResource Muted}" Margin="0,0,0,12" Visibility="{Binding FamilyPendingState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="PendingSearchEmpty" Text="Nenhum pedido encontrado para esta busca." Style="{StaticResource Muted}" Margin="0,0,0,12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <Grid Grid.Row="1">
        <ListBox x:Name="PendingList" Style="{StaticResource OpenList}" ItemsSource="{Binding FamilyPending}" SelectedItem="{Binding SelectedPendingFamily}" ItemTemplate="{StaticResource PendingItem}" AutomationProperties.Name="Pedidos de família pendentes"
                 views:ListingBehavior.Balloon="{Binding ElementName=PendingBalloon}" views:ListingBehavior.LabelPath="Title" views:ListingBehavior.KeyPath="Id" views:ListingBehavior.PluralName="pedidos" />
        <views:SelectionBalloon x:Name="PendingBalloon">
          <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanDecideFamily}">
            <Button Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconCheckGeometry}" views:SelectionBalloon.SingleItemOnly="True" Content="Aprovar" Click="OnApprove" AutomationProperties.Name="Aprovar pedido" ToolTip="Pede confirmação: confira os documentos do responsável e do dependente antes; o sistema não verifica a idade." />
            <Button Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconCloseGeometry}" views:SelectionBalloon.SingleItemOnly="True" Content="Recusar" Click="OnReject" AutomationProperties.Name="Recusar pedido" ToolTip="Abre o pop-up para enviar a recusa; o motivo é opcional." />
          </StackPanel>
        </views:SelectionBalloon>
      </Grid>
    </Grid>
    <!-- Vínculos aprovados: encerrar o vínculo (lixeira) no balão. -->
    <Grid Grid.Row="1" views:SubPage.Key="approved" views:PageLayout.Fill="True" IsEnabled="{Binding HasActiveObsUnit}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <StackPanel>
        <views:PageFilterGroup Label="Vínculos aprovados" SearchFields="GuardianName,DependentDisplay,GuardianCpfDisplay,DependentCpfDisplay" ItemsTarget="{Binding ElementName=ApprovedList}" />
        <ProgressBar IsIndeterminate="True" Height="3" Width="220" HorizontalAlignment="Left" Margin="0,0,0,8" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" Visibility="{Binding FamilyApprovedLoading, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Carregando os vínculos" />
        <TextBlock Text="{Binding FamilyApprovedState}" Style="{StaticResource Muted}" Margin="0,0,0,12" Visibility="{Binding FamilyApprovedState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="ApprovedSearchEmpty" Text="Nenhum vínculo encontrado para esta busca." Style="{StaticResource Muted}" Margin="0,0,0,12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
      <Grid Grid.Row="1">
        <ListBox x:Name="ApprovedList" Style="{StaticResource OpenList}" ItemsSource="{Binding FamilyApproved}" SelectedItem="{Binding SelectedApprovedFamily}" ItemTemplate="{StaticResource ApprovedItem}" AutomationProperties.Name="Vínculos de família aprovados"
                 views:ListingBehavior.Balloon="{Binding ElementName=ApprovedBalloon}" views:ListingBehavior.LabelPath="Title" views:ListingBehavior.KeyPath="Id" views:ListingBehavior.PluralName="vínculos" />
        <views:SelectionBalloon x:Name="ApprovedBalloon">
          <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanEndFamily}">
            <Button Style="{StaticResource ListActionDangerButton}" views:SelectionBalloon.SingleItemOnly="True" Content="Encerrar vínculo" Click="OnEnd" AutomationProperties.Name="Encerrar vínculo selecionado" ToolTip="Pede confirmação. O responsável perde na hora o acesso ao dependente nesta UBS." />
          </StackPanel>
        </views:SelectionBalloon>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
