<UserControl x:Class="Nora.Desktop.Views.FamilyView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Família (OBS): o responsável pede o vínculo pelo aplicativo; a equipe confere os documentos e decide. Aprovado, o responsável age pelo dependente. -->
  <UserControl.Resources>
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,6,0,12" /></Style>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="Família" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="Pedidos de vínculo entre um responsável e um dependente com cadastro nesta UBS. Confira os documentos antes de aprovar. Com o vínculo aprovado, o responsável agenda, confirma presença, acompanha a fila e sai dela, responde ofertas e vê a Jornada do dependente pelo aplicativo." Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,20" />
    <views:ObsUnitNoticeView />
    <DockPanel Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" Content="Atualizar pedidos" Click="OnRefresh" IsEnabled="{Binding HasActiveObsUnit}" ToolTip="Lê de novo os pedidos e os vínculos desta UBS." />
      <StackPanel>
        <TextBlock Text="{Binding ActiveObsUnitLabel}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding FamilySummary}" Style="{StaticResource Muted}" FontSize="12" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </DockPanel>

    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Pedidos aguardando decisão">
      <StackPanel>
        <TextBlock Text="Pedidos aguardando decisão" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" Text="Do mais antigo ao mais novo. A idade do dependente não é conferida pelo sistema: a UBS decide se é menor de idade ou adulto sob cuidado. Se o cadastro do dependente estiver desativado, reative-o antes de aprovar." />
        <DataGrid ItemsSource="{Binding FamilyPending}" SelectedItem="{Binding SelectedPendingFamily}" MaxHeight="280" MinHeight="64" AutomationProperties.Name="Pedidos de família pendentes" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Responsável" Binding="{Binding GuardianName}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="CPF do responsável" Binding="{Binding GuardianCpfDisplay}" SortMemberPath="GuardianCpf" Width="150" />
            <DataGridTextColumn Header="Dependente" Binding="{Binding DependentDisplay}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="CPF do dependente" Binding="{Binding DependentCpfDisplay}" SortMemberPath="DependentCpf" Width="150" />
            <DataGridTextColumn Header="Pedido em" Binding="{Binding RequestedAtDisplay}" SortMemberPath="RequestedAt" Width="140" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding FamilyPendingState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding FamilyPendingState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Decidir o pedido selecionado" FontWeight="SemiBold" Margin="0,0,0,10" />
            <WrapPanel>
              <Button Content="Aprovar pedido" Click="OnApprove" IsEnabled="{Binding CanDecideFamily}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" ToolTip="Pede confirmação: confira os documentos antes." ToolTipService.ShowOnDisabled="True" />
              <Button Content="Recusar pedido" Click="OnReject" IsEnabled="{Binding CanDecideFamily}" Margin="0,0,8,8" ToolTip="O motivo é opcional." ToolTipService.ShowOnDisabled="True" />
            </WrapPanel>
            <TextBlock Text="Motivo da recusa (opcional, até 280 caracteres)" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
            <TextBox Text="{Binding FamilyRejectReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="400" AutomationProperties.Name="Motivo da recusa" />
            <TextBlock Text="{Binding FamilyRejectReasonError}" Style="{StaticResource FieldError}" Visibility="{Binding FamilyRejectReasonError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Vínculos aprovados">
      <StackPanel>
        <TextBlock Text="Vínculos aprovados" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" Text="Encerrar o vínculo tira do responsável o acesso ao dependente nesta UBS na hora; as consultas já marcadas continuam. Para voltar, o responsável precisa pedir de novo." />
        <DataGrid ItemsSource="{Binding FamilyApproved}" SelectedItem="{Binding SelectedApprovedFamily}" MaxHeight="280" MinHeight="64" AutomationProperties.Name="Vínculos de família aprovados" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Responsável" Binding="{Binding GuardianName}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="CPF do responsável" Binding="{Binding GuardianCpfDisplay}" SortMemberPath="GuardianCpf" Width="150" />
            <DataGridTextColumn Header="Dependente" Binding="{Binding DependentDisplay}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Aprovado em" Binding="{Binding DecidedDisplay}" SortMemberPath="DecidedAt" Width="*" MinWidth="170" ElementStyle="{StaticResource CellText}" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding FamilyApprovedState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding FamilyApprovedState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel Margin="0,12,0,0">
          <Button Content="Encerrar vínculo selecionado" Click="OnEnd" IsEnabled="{Binding CanEndFamily}" Margin="0,0,8,8" ToolTip="Pede confirmação." ToolTipService.ShowOnDisabled="True" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
