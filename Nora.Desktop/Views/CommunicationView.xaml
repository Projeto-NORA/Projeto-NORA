<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.CommunicationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Comunicação (Secretaria): publica comunicados em texto puro para equipes (OBS) e/ou pacientes, com pré-visualização, contagem de leituras por público e encerramento. -->
  <UserControl.Resources>
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,6,0,12" /></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,6,0,12" /></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="12" /></Style>
  </UserControl.Resources>
  <StackPanel>
    <!-- Novo comunicado -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Novo comunicado">
      <StackPanel IsEnabled="{Binding CanPublishAnnouncement}">
        <TextBlock Text="Novo comunicado" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" ToolTip="Título e texto são texto puro: aparecem exatamente como forem digitados, sem formatação e sem links clicáveis. Depois de publicado não dá para editar; dá para encerrar. O comunicado não leva dado pessoal." />

        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
          <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding AnnouncementTitleCounter}" Style="{StaticResource Muted}" FontSize="12" /><TextBlock Text="Título" Style="{StaticResource FieldLabel}" /></DockPanel>
          <TextBox Text="{Binding AnnouncementTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.Name="Título do comunicado"  enter:EnterNavigation.Group="CommunicationView.message"/>
          <TextBlock Text="{Binding AnnouncementTitleError}" Style="{StaticResource FieldError}" Visibility="{Binding AnnouncementTitleError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
          <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding AnnouncementBodyCounter}" Style="{StaticResource Muted}" FontSize="12" /><TextBlock Text="Texto" Style="{StaticResource FieldLabel}" /></DockPanel>
          <TextBox Text="{Binding AnnouncementBodyText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="260" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" MaxLength="4000" AutomationProperties.Name="Texto do comunicado"  enter:EnterNavigation.Group="CommunicationView.message"/>
          <TextBlock Text="{Binding AnnouncementBodyError}" Style="{StaticResource FieldError}" Visibility="{Binding AnnouncementBodyError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Para quem" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{x:Static vm:WorkspaceViewModel.AudienceOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding AnnouncementAudienceKey}" AutomationProperties.Name="Público do comunicado"  enter:EnterNavigation.Group="CommunicationView.message"/>
              <TextBlock Text="{Binding AnnouncementAudienceError}" Style="{StaticResource FieldError}" Visibility="{Binding AnnouncementAudienceError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Alcance" Style="{StaticResource FieldLabel}" />
              <ComboBox ItemsSource="{x:Static vm:WorkspaceViewModel.ScopeOptions}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding AnnouncementScopeKey}" AutomationProperties.Name="Alcance do comunicado"  enter:EnterNavigation.Group="CommunicationView.message"/>
            </StackPanel>
          </Grid>
          <StackPanel Visibility="{Binding ShowRegionChoices, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
            <TextBlock Text="Regiões (as UBS de cada região recebem; a região de cada UBS vale no momento da leitura)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding AnnouncementRegionChoices}" AutomationProperties.Name="Regiões do comunicado">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" Margin="0,0,18,8" AutomationProperties.Name="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Visibility="{Binding ShowUnitChoices, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
            <TextBlock Text="UBS (marque uma ou mais)" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding AnnouncementUnitChoices}" AutomationProperties.Name="UBS do comunicado">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" Margin="0,0,18,8" AutomationProperties.Name="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
          <TextBlock Text="{Binding AnnouncementChoicesState}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" Visibility="{Binding AnnouncementChoicesState, Converter={StaticResource TextVisibility}}" />
          <TextBlock Text="{Binding AnnouncementScopeError}" Style="{StaticResource FieldError}" Margin="0,0,0,12" Visibility="{Binding AnnouncementScopeError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="Validade (opcional): data e hora no seu horário. Depois dela o comunicado some das leituras." Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
          <WrapPanel>
            <StackPanel Margin="0,0,16,0"><TextBlock Text="Data (dd/mm/aaaa)" Style="{StaticResource Muted}" FontSize="12" /><TextBox Text="{Binding AnnouncementExpiryDate, UpdateSourceTrigger=PropertyChanged}" MinWidth="150" MaxLength="10" AutomationProperties.Name="Data de validade do comunicado" ToolTip="dd/mm/aaaa"  enter:EnterNavigation.Group="CommunicationView.message"/></StackPanel>
            <StackPanel><TextBlock Text="Hora (HH:mm)" Style="{StaticResource Muted}" FontSize="12" /><TextBox Text="{Binding AnnouncementExpiryTime, UpdateSourceTrigger=PropertyChanged}" MinWidth="90" MaxLength="5" AutomationProperties.Name="Hora de validade do comunicado" ToolTip="HH:mm; em branco vale 23:59"  enter:EnterNavigation.Group="CommunicationView.message"/></StackPanel>
          </WrapPanel>
          <TextBlock Text="{Binding AnnouncementExpiryError}" Style="{StaticResource FieldError}" Visibility="{Binding AnnouncementExpiryError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
          <WrapPanel Margin="0,4,0,0">
            <Button Content="Publicar comunicado" Click="OnPublish" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"  enter:EnterNavigation.Group="CommunicationView.message"/>
            <Button Content="Limpar formulário" Click="OnClear" />
          </WrapPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Pré-visualização -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Pré-visualização do comunicado">
      <StackPanel>
        <TextBlock Text="Pré-visualização" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,12" ToolTip="É assim que o comunicado aparece para quem recebe: texto puro, com as quebras de linha digitadas." />

        <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="760" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel>
            <TextBlock Text="{Binding AnnouncementPreviewMeta}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" />
            <TextBlock Text="{Binding AnnouncementPreviewTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Título na pré-visualização" />
            <TextBlock Text="{Binding AnnouncementPreviewBody}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="22" AutomationProperties.Name="Texto na pré-visualização" />
          </StackPanel>
        </Border>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Meus comunicados -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Meus comunicados">
      <StackPanel>
        <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Atualizar lista" Style="{StaticResource IconRefreshButton}" AutomationProperties.Name="Atualizar lista" ToolTip="Atualizar lista" Click="OnRefresh" IsEnabled="{Binding CanOperate}" /><TextBlock Text="Meus comunicados" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="Só os comunicados desta conta, do mais novo ao mais antigo. A contagem é de contas que marcaram como lido (— quando o comunicado não é para aquele público)." /></DockPanel>

        <views:PageFilterGroup Label="Meus comunicados" SearchFields="Title,AudienceDisplay,ScopeDisplay,StatusDisplay" ItemsTarget="{Binding ElementName=PublishedFilterList}" />
        <DataGrid x:Name="PublishedFilterList" ItemsSource="{Binding MyAnnouncements}" SelectedItem="{Binding SelectedMyAnnouncement}" MaxHeight="360" MinHeight="64" AutomationProperties.Name="Comunicados da Secretaria" CanUserSortColumns="True">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Título" SortMemberPath="Title" Width="1.3*" MinWidth="190">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" Margin="4,2" ToolTip="{Binding Title}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource CellText}" />
                    <TextBlock Text="{Binding CreatedAtDisplay, StringFormat='Publicado {0}'}" Style="{StaticResource Muted}" FontSize="11" LineHeight="15" TextWrapping="NoWrap" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Situação" SortMemberPath="StatusDisplay" Width="165">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <StackPanel VerticalAlignment="Center" Margin="4,2">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StatusGlyph}" FontFamily="Segoe MDL2 Assets" Margin="0,2,6,0" /><TextBlock Text="{Binding StatusDisplay}" TextWrapping="NoWrap" /></StackPanel>
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Muted}" FontSize="11" LineHeight="15" TextWrapping="NoWrap" Margin="22,0,0,0" Visibility="{Binding StatusDetail, Converter={StaticResource TextVisibility}}" />
                  </StackPanel>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Para" Binding="{Binding AudienceDisplay}" Width="140" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Alcance" Binding="{Binding ScopeDisplay}" Width="*" MinWidth="120" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Equipes leram" Binding="{Binding StaffReadsDisplay}" SortMemberPath="StaffReads" Width="125" />
            <DataGridTextColumn Header="Pacientes leram" Binding="{Binding PatientReadsDisplay}" SortMemberPath="PatientReads" Width="135" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding MyAnnouncementsState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding MyAnnouncementsState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding MyAnnouncementsFootnote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding MyAnnouncementsFootnote, Converter={StaticResource TextVisibility}}" />
        <WrapPanel Margin="0,12,0,0">
          <Button Content="Ver quem da equipe leu" Click="OnReaders" IsEnabled="{Binding CanLoadAnnouncementReaders}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" ToolTip="Carrega as contas de equipe que marcaram o comunicado selecionado como lido." />
          <Button Content="Encerrar comunicado selecionado" Click="OnClose" IsEnabled="{Binding CanCloseMyAnnouncement}" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" ToolTip="Pede confirmação. O comunicado continua na lista, mas deixa de aparecer para quem o recebe." />
          <Button Content="Carregar mais antigos" Click="OnLoadMore" IsEnabled="{Binding CanLoadMoreAnnouncements}" Margin="0,0,8,8" />
        </WrapPanel>
        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,8,0,0" AutomationProperties.Name="Quem leu">
          <StackPanel>
            <TextBlock Text="Quem da equipe leu" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="{Binding AnnouncementReadersSummary}" Margin="0,0,0,8" Visibility="{Binding AnnouncementReadersSummary, Converter={StaticResource TextVisibility}}" />
            <views:PageFilterGroup Label="Equipe que leu o comunicado" SearchFields="FullName" ItemsTarget="{Binding ElementName=ReadersFilterList}" />
            <DataGrid x:Name="ReadersFilterList" ItemsSource="{Binding AnnouncementReaders}" MaxHeight="260" MinHeight="40" AutomationProperties.Name="Contas de equipe que leram" CanUserSortColumns="True" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding FullName}" Width="*" MinWidth="180" ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="Leu em" Binding="{Binding ReadAtDisplay}" SortMemberPath="ReadAt" Width="160" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding AnnouncementReadersState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding AnnouncementReadersState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
