<UserControl x:Class="Nora.Desktop.Views.CommunicationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Comunicação (Secretaria): a listagem dos comunicados da conta (aberta, na tela inteira). O comunicado novo é um pop-up; a ficha mostra o texto completo e quem da equipe leu. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <views:PageFilterGroup Label="Meus comunicados" SearchFields="Title,AudienceDisplay,ScopeDisplay,StatusDisplay" ItemsTarget="{Binding ElementName=PublishedList}" />
      <views:PageActions>
        <Button Style="{StaticResource NewItemButton}" Content="Novo comunicado" Click="OnNew" IsEnabled="{Binding CanOperate}" AutomationProperties.Name="Novo comunicado" ToolTip="Abre o formulário de um comunicado novo. Título e texto são texto puro: aparecem exatamente como forem digitados, sem formatação e sem links clicáveis. Depois de publicado não dá para editar; dá para encerrar." />
      </views:PageActions>
    </StackPanel>
    <Grid Grid.Row="1">
      <ListBox x:Name="PublishedList" Style="{StaticResource OpenList}" ItemsSource="{Binding MyAnnouncements}" AutomationProperties.Name="Comunicados da Secretaria"
               views:ListingBehavior.Balloon="{Binding ElementName=Balloon}" views:ListingBehavior.LabelPath="Title" views:ListingBehavior.PluralName="comunicados">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid AutomationProperties.Name="{Binding AutomationLabel}" ToolTip="{Binding Title}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Style="{StaticResource ItemTitleText}" />
                <TextBlock Text="{Binding MetaLine}" Style="{StaticResource ItemMetaText}" />
              </StackPanel>
              <views:StatusTag Grid.Column="1" Text="{Binding StatusDisplay}" Tone="{Binding StatusTone}" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <views:ListEmptyText List="{Binding ElementName=PublishedList}" EmptyText="{Binding MyAnnouncementsState}" NoMatchText="Nenhum comunicado encontrado para esta busca." Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="4,8" />
      <views:SelectionBalloon x:Name="Balloon">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconEyeGeometry}" views:SelectionBalloon.SingleItemOnly="True" Content="Ver ficha" Click="OnView" ToolTip="Abre o texto completo e quem da equipe leu." />
          <Button x:Name="CloseButton" Style="{StaticResource ListActionDangerButton}" Content="Encerrar" Click="OnClose" IsEnabled="{Binding CanOperate}" ToolTip="Pede confirmação. O comunicado continua na lista, mas deixa de aparecer para quem o recebe." AutomationProperties.Name="Encerrar comunicado" />
        </StackPanel>
      </views:SelectionBalloon>
    </Grid>
    <Button Grid.Row="2" Content="Carregar mais antigos" Click="OnLoadMore" HorizontalAlignment="Right" Margin="0,10,0,0" Visibility="{Binding CanLoadMoreAnnouncements, Converter={StaticResource BoolVisibility}}" ToolTip="Mostra comunicados mais antigos." />
  </Grid>
</UserControl>
