<UserControl x:Class="Nora.Desktop.Views.NetworkMapView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <!-- Mapa da rede: o mapa ocupa a tela. A UBS a localizar fica no cabeçalho (filtro em linha) e "Mostrar no mapa" é a ação da tela; o estado do mapa e o crédito ficam numa linha embaixo (o WebView2 cobre qualquer coisa posta por cima dele). -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <views:PageFilterGroup Label="UBS para localizar" Inline="True">
        <ComboBox x:Name="UnitPicker" Width="260" MinWidth="140" VerticalAlignment="Center" ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="Name" IsSynchronizedWithCurrentItem="False" ToolTip="UBS a localizar no mapa. Você pode atualizar os dados e as coordenadas da unidade em Cadastro de UBS." AutomationProperties.Name="UBS para localizar no mapa" />
      </views:PageFilterGroup>
      <views:PageActions>
        <Button x:Name="LoadButton" Content="Mostrar no mapa" Click="OnLoadMap" Style="{StaticResource PrimaryButton}" MinHeight="40" MinWidth="150" Padding="16,0" ToolTip="Mostra as UBS no mapa." AutomationProperties.Name="Mostrar no mapa" />
      </views:PageActions>
    </StackPanel>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" MinHeight="260" ClipToBounds="True">
      <Grid><TextBlock x:Name="Placeholder" Text="Carregue o mapa para explorar o território" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20" /><wv2:WebView2 x:Name="Browser" Visibility="Collapsed" /></Grid>
    </Border>
    <WrapPanel Grid.Row="2" Margin="2,10,0,0">
      <TextBlock x:Name="MapStatus" Text="O mapa usa OpenStreetMap e precisa de conexão com a internet." Style="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
      <TextBlock Text="{Binding UnitsState}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,16,0" Visibility="{Binding UnitsState, Converter={StaticResource TextVisibility}}" />
      <TextBlock Text="Mapa © colaboradores do OpenStreetMap · Coordenadas cadastradas pela Secretaria" Style="{StaticResource Muted}" FontSize="12" />
    </WrapPanel>
  </Grid>
</UserControl>
