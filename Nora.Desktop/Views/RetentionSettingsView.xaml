<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.RetentionSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:Nora.Desktop.Views"
 Loaded="OnLoaded" Unloaded="OnUnloaded" IsVisibleChanged="OnVisibilityChanged">
  <!-- Exclusão programada (dentro de Configurações): seção sem card, com título discreto e um fio. A política geral é um bloco curto; os cadastros desativados são uma lista aberta com balão. -->
  <UserControl.Resources>
    <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
    <Style x:Key="SectionRule" TargetType="Border"><Setter Property="Height" Value="1" /><Setter Property="Background" Value="{DynamicResource DividerBrush}" /><Setter Property="Margin" Value="0,6,0,12" /></Style>
    <DataTemplate x:Key="RetentionRow">
      <Grid AutomationProperties.Name="{Binding AutomationLabel}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleText}" ToolTip="{Binding Name}" />
          <TextBlock Text="{Binding Status}" Style="{StaticResource ItemMetaText}" />
        </StackPanel>
        <views:StatusTag Grid.Column="1" Text="{Binding Tag}" Tone="{Binding TagTone}" Margin="12,0,0,0" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="Exclusão programada" Style="{StaticResource SectionHeading}" />
    <Border Style="{StaticResource SectionRule}" />
    <TextBlock x:Name="Explanation" Style="{StaticResource Muted}" Margin="0,0,0,12" />
    <StackPanel x:Name="Controls" IsEnabled="False">
      <views:FormGrid>
        <CheckBox x:Name="NeverDelete" IsChecked="True" Content="Nunca excluir sozinho" HorizontalAlignment="Left" views:FormGrid.FullRow="True" Checked="OnPolicyChanged" Unchecked="OnPolicyChanged" ToolTip="Com a opção marcada, nada é excluído sem um agendamento seu." />
        <Grid x:Name="PolicyActions" views:FormGrid.FullRow="True" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel HorizontalAlignment="Left">
            <TextBlock x:Name="PolicyDaysLabel" Text="Excluir automaticamente após (dias)" Style="{StaticResource FieldLabelText}" />
            <TextBox x:Name="PolicyDays" Width="140" HorizontalAlignment="Left" Margin="0,2,0,0" AutomationProperties.Name="Prazo automático em dias" enter:EnterNavigation.Group="RetentionSettingsView.policy" />
          </StackPanel>
          <Button x:Name="SavePolicy" Grid.Column="1" Content="Salvar prazo" Click="OnSavePolicy" Style="{StaticResource ObsPrimaryButton}" VerticalAlignment="Bottom" MinHeight="40" MinWidth="132" enter:EnterNavigation.Group="RetentionSettingsView.policy" />
        </Grid>
      </views:FormGrid>
      <TextBlock Text="Cadastros desativados" Style="{StaticResource FieldLabelText}" Margin="0,18,0,6" />
      <!-- A segunda linha é a faixa fixa onde o balão flutua: a lista é curta e não rola até o fim, então o balão não pode cobrir os últimos cadastros. A faixa existe sempre (nada pula ao selecionar). -->
      <Grid x:Name="ListCell">
        <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="64" /><RowDefinition Height="66" /></Grid.RowDefinitions>
        <ListBox x:Name="Items" Style="{StaticResource OpenList}" MaxHeight="300" VerticalAlignment="Top" ItemTemplate="{StaticResource RetentionRow}" AutomationProperties.Name="Cadastros desativados"
                 views:NestedListScroll.PassWheelToParent="True"
                 views:ListingBehavior.Balloon="{Binding ElementName=ItemBalloon}" views:ListingBehavior.LabelPath="Name" views:ListingBehavior.KeyPath="Id" views:ListingBehavior.ComplementPath="Tag" views:ListingBehavior.PluralName="cadastros" />
        <TextBlock x:Name="ItemsEmpty" Text="Nenhum cadastro desativado." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" IsHitTestVisible="False" Visibility="Collapsed" />
        <views:SelectionBalloon x:Name="ItemBalloon" Grid.RowSpan="2" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="Schedule" Style="{StaticResource ListActionDangerButton}" views:SelectionBalloon.SingleItemOnly="True" Content="Agendar exclusão" Click="OnSchedule" ToolTip="Programa a exclusão definitiva do cadastro para daqui a alguns dias. Pede o prazo e uma confirmação." />
            <Button x:Name="CancelSchedule" Style="{StaticResource ListActionDangerButton}" views:SelectionBalloon.SingleItemOnly="True" Content="Cancelar exclusão" Click="OnCancelSchedule" ToolTip="Cancela a exclusão programada deste cadastro. Pede confirmação." />
          </StackPanel>
        </views:SelectionBalloon>
      </Grid>
    </StackPanel>
    <ProgressBar x:Name="Progress" Height="4" Margin="0,8,0,4" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource BrandBrush}" />
    <TextBlock x:Name="Feedback" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,0" />
    <Button x:Name="Retry" Click="OnRetry" Content="Tentar novamente" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="Collapsed" />
  </StackPanel>
</UserControl>
