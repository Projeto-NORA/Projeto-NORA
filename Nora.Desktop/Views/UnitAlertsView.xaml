<UserControl x:Class="Nora.Desktop.Views.UnitAlertsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" views:PageLayout.Fill="True">
  <!-- Alertas da UBS ativa, avaliados pela API (GET /api/obs/units/{id}/alerts) com os limites da rede: só a listagem, sem títulos nem textos explicativos.
       Sem alerta, o estado da lista diz isso e a hora da avaliação; falha de leitura é outro estado. A pesquisa fica no cabeçalho, em linha. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel>
      <views:ObsUnitNoticeView />
      <views:PageFilterGroup Label="Alertas da unidade" SearchFields="Title,Specialty,Value" ItemsTarget="{Binding ElementName=AlertsFilterList}" />
      <!-- Com alertas na lista e a última avaliação falhando, o aviso fica acima dela (a lista é a da avaliação anterior). -->
      <ContentControl Style="{StaticResource NoticeItem}" Margin="0,0,0,10" Content="{Binding UnitAlertsState}" Visibility="{Binding HasUnitAlertsNotice, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Estado dos alertas" AutomationProperties.LiveSetting="Polite">
        <ContentControl.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ContentControl.ContentTemplate>
      </ContentControl>
    </StackPanel>
    <Grid Grid.Row="1">
      <ListBox x:Name="AlertsFilterList" Style="{StaticResource OpenList}" ItemsSource="{Binding UnitAlerts}" views:SearchEmptyNotice.Target="{Binding ElementName=SearchEmpty}" AutomationProperties.Name="Alertas da UBS ativa" ToolTip="Duplo clique ou Enter abre a ficha do alerta."
               views:ListingBehavior.Balloon="{Binding ElementName=NoBalloon}" views:ListingBehavior.LabelPath="ItemTitle" views:ListingBehavior.KeyPath="Key" views:ListingBehavior.PluralName="alertas">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid AutomationProperties.Name="{Binding AutomationLabel}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ItemTitle}" Style="{StaticResource ItemTitleText}" />
                <TextBlock Text="{Binding MetaLine}" Style="{StaticResource ItemMetaText}" />
              </StackPanel>
              <views:StatusTag Grid.Column="1" Text="{Binding TagText}" Tone="{Binding TagTone}" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <!-- Alerta é só leitura: sem ações, o balão fica sempre escondido. Ele existe porque o ListingBehavior (segundo clique, Enter, Esc e a seleção que sobrevive ao ciclo de 20 s) precisa de um. -->
      <Border Visibility="Collapsed"><views:SelectionBalloon x:Name="NoBalloon" /></Border>
      <!-- Lista sem alerta: "Nenhum alerta" (com a hora da avaliação) ou a falha da leitura; são estados diferentes. -->
      <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" Orientation="Horizontal" AutomationProperties.Name="Estado dos alertas" AutomationProperties.LiveSetting="Polite">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasUnitAlerts}" Value="False" /><Condition Binding="{Binding HasActiveObsUnit}" Value="True" /><Condition Binding="{Binding IsAlertsLoading}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
              <DataTrigger Binding="{Binding IsAuthenticated}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <Path Data="{StaticResource IconCheckGeometry}" Width="18" Height="18" Stretch="None" VerticalAlignment="Center" Margin="0,0,10,0" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="{Binding UnitAlertsAllClear, Converter={StaticResource BoolVisibility}}" />
        <TextBlock Text="{Binding UnitAlertsState}" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock x:Name="SearchEmpty" Text="Nenhum alerta encontrado para esta busca." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" Visibility="{Binding IsAlertsLoading, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Avaliando os alertas" AutomationProperties.LiveSetting="Polite">
        <ProgressBar IsIndeterminate="True" Height="3" Width="220" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" />
        <TextBlock Text="Avaliando os alertas…" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
