<UserControl x:Class="Nora.Desktop.Views.UnitAlertsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Alertas da UBS ativa, avaliados pela API (GET /api/obs/units/{id}/alerts) com os limites da rede. Sem alerta, o estado vazio diz isso e quando foi a leitura. -->
  <StackPanel>
    <views:ObsUnitNoticeView />
    <DockPanel Margin="0,0,0,14">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconRefreshButton}" Click="OnRefresh" IsEnabled="{Binding HasActiveObsUnit}" AutomationProperties.Name="Atualizar alertas" ToolTip="Avalia os alertas da UBS de novo." />
      <StackPanel><TextBlock Text="{Binding ActiveObsUnitLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding ActiveObsUnitRegion}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
    </DockPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Alertas da UBS" ToolTip="Fila alta, espera longa, faltas, ocupação da grade e metas fora dos limites da rede.">
      <StackPanel>
        <TextBlock Text="O que passou do limite" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
        <views:PageFilterGroup Label="Alertas da unidade" SearchFields="Title,Specialty,Value" ItemsTarget="{Binding ElementName=AlertsFilterList}" />
        <ItemsControl x:Name="AlertsFilterList" ItemsSource="{Binding UnitAlerts}" AutomationProperties.Name="Alertas da UBS ativa">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,10" AutomationProperties.Name="{Binding AutomationLabel}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource WarningBrush}" Margin="0,2,12,0" VerticalAlignment="Top" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Margin="0,4,0,0" Visibility="{Binding Specialty, Converter={StaticResource TextVisibility}}"><Run Text="Especialidade: " FontWeight="SemiBold" /><Run Text="{Binding Specialty, Mode=OneWay}" /></TextBlock>
                    <WrapPanel Margin="0,4,0,0">
                      <TextBlock Margin="0,0,24,0"><Run Text="Valor: " FontWeight="SemiBold" /><Run Text="{Binding Value, Mode=OneWay}" /></TextBlock>
                      <TextBlock Margin="0,0,24,0"><Run Text="Limite: " FontWeight="SemiBold" /><Run Text="{Binding Threshold, Mode=OneWay}" /></TextBlock>
                      <TextBlock><Run Text="Desde: " FontWeight="SemiBold" /><Run Text="{Binding Since, Mode=OneWay}" /></TextBlock>
                    </WrapPanel>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Background="{DynamicResource BrandSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Visibility="{Binding UnitAlertsState, Converter={StaticResource TextVisibility}}" AutomationProperties.Name="Estado dos alertas">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,10,0" VerticalAlignment="Top" Visibility="{Binding UnitAlertsAllClear, Converter={StaticResource BoolVisibility}}" /><TextBlock Grid.Column="1" Text="{Binding UnitAlertsState}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></Grid>
        </Border>
        <TextBlock Text="{Binding UnitAlertsFootnote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding UnitAlertsFootnote, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
