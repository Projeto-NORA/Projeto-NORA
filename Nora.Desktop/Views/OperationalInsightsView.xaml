<UserControl x:Class="Nora.Desktop.Views.OperationalInsightsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <StackPanel>
    <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,26" />
    <views:UnitIndicatorsView Visibility="{Binding IsIndicatorsPage, Converter={StaticResource BoolVisibility}}" />
    <views:AlertCriteriaView Visibility="{Binding IsAlertsPage, Converter={StaticResource BoolVisibility}}" />
  </StackPanel>
</UserControl>
