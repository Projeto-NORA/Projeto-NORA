<UserControl x:Class="Nora.Desktop.Views.OperationalInsightsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,26" />
    <Border Style="{StaticResource Card}" Margin="0,0,0,24"><StackPanel><TextBlock Text="Acompanhamento da unidade" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="Indicadores serão calculados somente com eventos reais da fila, agenda e atendimentos." Style="{StaticResource Muted}" Margin="0,6,0,18" /><Border Height="220" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><Grid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource BrandBrush}" HorizontalAlignment="Center" /><TextBlock Text="Aguardando dados para o gráfico" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0" /><TextBlock Text="Nenhuma série fictícia é exibida." Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" /></StackPanel></Grid></Border></StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="{Binding IsAlertsPage, Converter={StaticResource BoolVisibility}}"><StackPanel><TextBlock Text="Regras de atenção" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="A central vai sinalizar fila alta, atrasos e conflitos de agenda somente após receber os eventos correspondentes da API." Style="{StaticResource Muted}" Margin="0,6,0,14" /><WrapPanel><Border Background="#FFE0E5" CornerRadius="8" Padding="10,6" Margin="0,0,8,0"><TextBlock Text="Fila alta" Foreground="#B4233E" /></Border><Border Background="#FFE4D2" CornerRadius="8" Padding="10,6" Margin="0,0,8,0"><TextBlock Text="Atrasos" Foreground="#B54708" /></Border><Border Background="#E8D8FF" CornerRadius="8" Padding="10,6"><TextBlock Text="Agenda" Foreground="#5B21B6" /></Border></WrapPanel></StackPanel></Border>
    <UniformGrid Columns="3" Margin="-6,0" Visibility="{Binding IsIndicatorsPage, Converter={StaticResource BoolVisibility}}"><Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><TextBlock Text="Tempo de espera" FontWeight="SemiBold" /><TextBlock Text="—" FontSize="28" Foreground="{DynamicResource BrandBrush}" Margin="0,10,0,2" /><TextBlock Text="Meta e média do período" Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border><Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><TextBlock Text="Comparecimento" FontWeight="SemiBold" /><TextBlock Text="—" FontSize="28" Foreground="{DynamicResource BrandBrush}" Margin="0,10,0,2" /><TextBlock Text="Consultas concluídas" Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border><Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><TextBlock Text="Uso da agenda" FontWeight="SemiBold" /><TextBlock Text="—" FontSize="28" Foreground="{DynamicResource BrandBrush}" Margin="0,10,0,2" /><TextBlock Text="Horários ocupados e livres" Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border></UniformGrid>
  </StackPanel>
</UserControl>
