<UserControl x:Class="Nora.Desktop.Views.UnitLightningSlotsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels">
  <!-- Painel automático da Vaga Relâmpago: só leitura. A API oferece a vaga a quem tem consulta marcada depois, na mesma especialidade. -->
  <UserControl.Resources>
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style>
    <Style x:Key="Counter" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Margin" Value="0,0,12,0" /><Setter Property="Padding" Value="16,14" /></Style>
  </UserControl.Resources>
  <StackPanel>
    <views:ObsUnitNoticeView />
    <Grid Margin="0,0,0,24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBlock Text="Vaga Relâmpago" Style="{StaticResource PageTitle}" Margin="0" /></StackPanel>
        <TextBlock Text="Automática: quem tem consulta mais tarde, na mesma especialidade, recebe a vaga. Aqui você só acompanha." Style="{StaticResource Muted}" Margin="0,8,0,0" />
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource IconRefreshButton}" Click="OnLoad" IsEnabled="{Binding HasActiveObsUnit}" VerticalAlignment="Top" AutomationProperties.Name="Atualizar vagas da UBS" ToolTip="Relê as vagas e as ofertas agora. O painel também se atualiza sozinho a cada 20 segundos." />
    </Grid>
    <UniformGrid Columns="5" Margin="0,0,-12,24" AutomationProperties.Name="Resumo das vagas">
      <Border Style="{StaticResource Counter}" ToolTip="Vagas criadas e ainda procurando paciente."><StackPanel><TextBlock Text="Vagas abertas" Style="{StaticResource FieldLabelText}" /><TextBlock Text="{Binding PanelOpenCount}" FontSize="24" FontWeight="SemiBold" /></StackPanel></Border>
      <Border Style="{StaticResource Counter}" ToolTip="Ofertas com o prazo de resposta correndo agora."><StackPanel><TextBlock Text="Em oferta" Style="{StaticResource FieldLabelText}" /><TextBlock Text="{Binding PanelOfferedCount}" Style="{StaticResource PageTitle}" /></StackPanel></Border>
      <Border Style="{StaticResource Counter}" ToolTip="Vagas aceitas por um paciente."><StackPanel><TextBlock Text="Aceitas" Style="{StaticResource FieldLabelText}" /><TextBlock Text="{Binding PanelAcceptedCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" /></StackPanel></Border>
      <Border Style="{StaticResource Counter}" ToolTip="Ofertas recusadas pelos pacientes (nas vagas carregadas)."><StackPanel><TextBlock Text="Recusadas" Style="{StaticResource FieldLabelText}" /><TextBlock Text="{Binding PanelDeclinedCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" /></StackPanel></Border>
      <Border Style="{StaticResource Counter}" ToolTip="Ofertas que venceram sem resposta (nas vagas carregadas)."><StackPanel><TextBlock Text="Vencidas" Style="{StaticResource FieldLabelText}" /><TextBlock Text="{Binding PanelExpiredCount}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" /></StackPanel></Border>
    </UniformGrid>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
      <StackPanel>
        <TextBlock Text="Filtros" Style="{StaticResource SectionTitle}" />
        <Grid Margin="0,0,0,16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0"><TextBlock Text="Especialidade" Style="{StaticResource FieldLabelText}" /><ComboBox ItemsSource="{Binding SlotSpecialtyOptions}" SelectedItem="{Binding SlotSpecialtyFilter}" AutomationProperties.Name="Filtrar vagas por especialidade" ToolTip="Mostra só as vagas desta especialidade." /></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Situação" Style="{StaticResource FieldLabelText}" /><ComboBox ItemsSource="{x:Static vm:WorkspaceViewModel.SlotStatusOptions}" SelectedItem="{Binding SlotStatusFilter}" AutomationProperties.Name="Filtrar vagas por situação" ToolTip="Abertas, em oferta, aceitas, recusadas ou vencidas." /></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="Pesquisar" Style="{StaticResource FieldLabelText}" /><TextBox Text="{Binding SlotSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar vagas por paciente ou profissional" ToolTip="Procura no nome do paciente, do profissional ou da especialidade." /></StackPanel>
        </Grid>
        <DataGrid ItemsSource="{Binding FilteredSlotPanelRows}" SelectedItem="{Binding SelectedSlotRow}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" MinHeight="64" MaxHeight="440" AutomationProperties.Name="Vagas da UBS" MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnRowKeyDown" ToolTip="Duplo clique ou Enter abre a ficha da vaga, com todas as ofertas.">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Horário" Binding="{Binding TimeDisplay}" Width="1.4*" MinWidth="130" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Especialidade" Binding="{Binding Specialty}" Width="*" MinWidth="90" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Profissional" Binding="{Binding Professional}" Width="*" MinWidth="90" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Paciente" Binding="{Binding PatientName}" Width="1.2*" MinWidth="110" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Situação" Binding="{Binding StatusDisplay}" Width="110" ElementStyle="{StaticResource CellText}" />
            <DataGridTemplateColumn Header="Prazo" Width="130">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal" ToolTip="{Binding CountdownTip}">
                  <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasDeadline, Converter={StaticResource BoolVisibility}}" />
                  <TextBlock Text="{Binding Countdown}" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsUrgent}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Ofertas" Binding="{Binding OffersSummary}" Width="1.3*" MinWidth="140" ElementStyle="{StaticResource CellText}" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Nenhuma vaga nesta UBS até agora." Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="{Binding HasNoUnitSlots, Converter={StaticResource BoolVisibility}}" />
        <TextBlock Text="Nenhuma vaga corresponde aos filtros." Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="{Binding HasNoFilteredSlots, Converter={StaticResource BoolVisibility}}" />
        <DockPanel Margin="0,12,0,0" Visibility="{Binding SlotsHistoryState, Converter={StaticResource TextVisibility}}">
          <Button DockPanel.Dock="Right" Content="Carregar mais histórico" Click="OnMoreHistory" IsEnabled="{Binding CanLoadMoreSlotsHistory}" Margin="12,0,0,0" AutomationProperties.Name="Carregar mais histórico das vagas" ToolTip="Traz vagas encerradas mais antigas." ToolTipService.ShowOnDisabled="True" />
          <TextBlock Text="{Binding SlotsHistoryState}" Style="{StaticResource Muted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
