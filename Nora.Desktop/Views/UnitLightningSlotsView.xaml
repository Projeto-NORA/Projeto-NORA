<UserControl x:Class="Nora.Desktop.Views.UnitLightningSlotsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels" views:PageLayout.Fill="True">
  <!-- Painel automático da Vaga Relâmpago (Em andamento e Encerradas): só leitura. A API oferece a vaga a quem tem consulta marcada depois, na mesma especialidade.
       Sem título e sem totais: o nome da tela fica no cabeçalho da janela. Filtros no botão Filtros do cabeçalho; a lista ocupa a tela inteira. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <views:ObsUnitNoticeView />
    <views:PageFilterGroup Grid.Row="1" Label="Vagas" FilterKey="slots">
      <StackPanel>
        <TextBlock Text="Especialidade" Style="{StaticResource FieldLabelText}" />
        <ComboBox ItemsSource="{Binding SlotSpecialtyOptions}" SelectedItem="{Binding SlotSpecialtyFilter}" Margin="0,6,0,12" AutomationProperties.Name="Filtrar vagas por especialidade" ToolTip="Mostra só as vagas desta especialidade." />
        <TextBlock Text="Situação" Style="{StaticResource FieldLabelText}" />
        <ComboBox ItemsSource="{x:Static vm:WorkspaceViewModel.SlotStatusOptions}" SelectedItem="{Binding SlotStatusFilter}" Margin="0,6,0,12" AutomationProperties.Name="Filtrar vagas por situação" ToolTip="Abertas, em oferta, aceitas, recusadas ou vencidas." />
        <TextBlock Text="Pesquisar" Style="{StaticResource FieldLabelText}" />
        <TextBox Text="{Binding SlotSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Pesquisar vagas por paciente ou profissional" ToolTip="Procura no nome do paciente, do profissional ou da especialidade." />
      </StackPanel>
    </views:PageFilterGroup>
    <Grid Grid.Row="2">
      <ListBox x:Name="SlotList" Style="{StaticResource OpenList}" ItemsSource="{Binding FilteredSlotPanelRows}" AutomationProperties.Name="Vagas da UBS" ToolTip="Duplo clique ou Enter abre a ficha da vaga, com todas as ofertas."
               views:ListingBehavior.Balloon="{Binding ElementName=NoBalloon}" views:ListingBehavior.LabelPath="ItemTitle" views:ListingBehavior.KeyPath="Id" views:ListingBehavior.PluralName="vagas" views:ListingBehavior.Feminine="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid AutomationProperties.Name="{Binding AutomationLabel}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ItemTitle}" Style="{StaticResource ItemTitleText}" />
                <!-- Profissional | paciente | prazo: o prazo muda a cada segundo, na própria linha (vermelho nos últimos 2 minutos), sem recriar a lista. -->
                <TextBlock Style="{StaticResource ItemMetaText}" ToolTip="{Binding CountdownTip}"><Run Text="{Binding MetaLead, Mode=OneWay}" /><Run Text="{Binding SeparatorBeforeDeadline, Mode=OneWay}" /><Run Text="{Binding DeadlineText, Mode=OneWay}">
                  <Run.Style>
                    <Style TargetType="Run"><Style.Triggers><DataTrigger Binding="{Binding IsUrgent}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style>
                  </Run.Style></Run></TextBlock>
              </StackPanel>
              <views:StatusTag Grid.Column="1" Text="{Binding StatusDisplay}" Tone="{Binding StatusTone}" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <!-- A vaga é só leitura: não há ações, então o balão da listagem fica sempre escondido. Ele existe só porque o ListingBehavior (segundo clique, Enter, Esc e seleção que sobrevive à releitura) precisa de um. -->
      <Border Visibility="Collapsed"><views:SelectionBalloon x:Name="NoBalloon" /></Border>
      <TextBlock Text="{Binding SlotsEmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" TextWrapping="Wrap" Margin="0,28,0,0" Visibility="{Binding SlotsEmptyText, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Estado da lista de vagas" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" Visibility="{Binding IsSlotsLoading, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Lendo as vagas" AutomationProperties.LiveSetting="Polite">
        <ProgressBar IsIndeterminate="True" Height="3" Width="220" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" />
        <TextBlock Text="Lendo as vagas da UBS…" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding SlotsHistoryState, Converter={StaticResource TextVisibility}}">
      <Button DockPanel.Dock="Right" Content="Carregar mais histórico" Click="OnMoreHistory" IsEnabled="{Binding CanLoadMoreSlotsHistory}" Margin="12,0,0,0" AutomationProperties.Name="Carregar mais histórico das vagas" ToolTip="Traz vagas encerradas mais antigas." ToolTipService.ShowOnDisabled="True" />
      <TextBlock Text="{Binding SlotsHistoryState}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</UserControl>
