<UserControl x:Class="Nora.Desktop.Views.UnitLightningSlotsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <UserControl.Resources>
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style>
  </UserControl.Resources>
  <StackPanel>
    <views:ObsUnitNoticeView />
    <Border Style="{StaticResource Card}" Margin="0,0,0,24" ToolTip="Uma vaga pode vir de uma consulta cancelada, do Chamar próximo ou de um cancelamento sujeito à aprovação."><Grid>
      <Path Data="M 54,0 L 12,75 L 45,75 L 25,145 L 102,55 L 63,55 L 88,0 Z" Fill="{DynamicResource WarningBrush}" Opacity="0.09" Stretch="Uniform" Width="150" Height="210" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" />
      <StackPanel IsEnabled="{Binding CanEditDraft}">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="⚡" FontSize="24" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" /><TextBlock Text="Vagas Relâmpago da UBS" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" /></StackPanel>
      <StackPanel Margin="0,0,0,10"><TextBlock Text="{Binding ActiveObsUnitLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding ActiveObsUnitRegion}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
      <Button Style="{StaticResource IconRefreshButton}" Click="OnLoad" IsEnabled="{Binding HasActiveObsUnit}" HorizontalAlignment="Right" Margin="0,0,0,12" AutomationProperties.Name="Atualizar vagas da UBS" ToolTip="Atualizar vagas da UBS" />
      <!-- Aprovação das vagas reaproveitadas: aparece com a chave ligada nas Configurações da UBS ou enquanto houver vaga aguardando. -->
      <Border Visibility="{Binding ShowAwaitingSlots, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16" AutomationProperties.Name="Vagas aguardando aprovação" ToolTip="Cada cancelamento sujeito à aprovação só é oferecido após a conferência da equipe; sem aprovação até uma hora antes, a vaga fecha.">
        <StackPanel>
          <TextBlock Text="{Binding AwaitingSlotsTitle}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
          <DataGrid ItemsSource="{Binding AwaitingSlots}" SelectedItem="{Binding SelectedAwaitingSlot}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" MinHeight="64" MaxHeight="260" AutomationProperties.Name="Vagas aguardando aprovação da equipe">
            <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="8,8" /></Style></DataGrid.CellStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Especialidade" Binding="{Binding Specialty}" Width="*" MinWidth="90" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Profissional" Binding="{Binding Professional}" Width="*" MinWidth="90" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Horário" Binding="{Binding TimeDisplay}" Width="1.4*" MinWidth="130" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Origem" Binding="{Binding SourceDisplay}" Width="2*" MinWidth="200" ElementStyle="{StaticResource CellText}" />
              <DataGridTextColumn Header="Prazo" Binding="{Binding ApprovalDeadlineDisplay}" Width="130" ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="{Binding AwaitingSlotsState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding AwaitingSlotsState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
          <WrapPanel Margin="0,12,0,0">
            <Button Content="Aprovar e ofertar" Click="OnApprove" IsEnabled="{Binding CanDecideSlotApproval}" Style="{StaticResource ObsPrimaryButton}" Margin="0,0,8,8" ToolTip="Pede confirmação. A vaga passa a ser oferecida ao 1º da fila." ToolTipService.ShowOnDisabled="True" />
            <Button Content="Descartar" Style="{StaticResource ObsPrimaryButton}" Click="OnDiscard" IsEnabled="{Binding CanDecideSlotApproval}" Margin="0,0,8,8" ToolTip="Pede confirmação. A vaga fecha sem ser oferecida." ToolTipService.ShowOnDisabled="True" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding SlotSteps}" ItemTemplate="{StaticResource ProgressStepTemplate}" AutomationProperties.Name="Passos da aprovação" />
        </StackPanel>
      </Border>
      <TextBlock Text="Todas as vagas" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,8" />
      <DataGrid ItemsSource="{Binding UnitLightningSlots}" SelectedItem="{Binding SelectedUnitSlot}" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" MinHeight="64" MaxHeight="360" AutomationProperties.Name="Vagas da UBS" MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnRowKeyDown" ToolTip="Duplo clique ou Enter abre a ficha da vaga, com as ofertas já feitas.">
        <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="Padding" Value="8,8" /></Style></DataGrid.CellStyle>
        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}"><Setter Property="Padding" Value="8,8" /></Style></DataGrid.ColumnHeaderStyle>
        <DataGrid.Columns><DataGridTextColumn Header="Horário" Binding="{Binding TimeDisplay}" Width="1.6*" MinWidth="130" ElementStyle="{StaticResource CellText}" /><DataGridTextColumn Header="Especialidade" Binding="{Binding Specialty}" Width="*" MinWidth="80" ElementStyle="{StaticResource CellText}" /><DataGridTextColumn Header="Profissional" Binding="{Binding Professional}" Width="*" MinWidth="80" ElementStyle="{StaticResource CellText}" /><DataGridTextColumn Header="Origem" Binding="{Binding OriginDisplay}" Width="130" ElementStyle="{StaticResource CellText}" /><DataGridTextColumn Header="Criada em" Binding="{Binding CreatedAtDisplay}" Width="136" ElementStyle="{StaticResource CellText}" /><DataGridTextColumn Header="Situação" Binding="{Binding StatusDisplay}" Width="1.1*" MinWidth="130" ElementStyle="{StaticResource CellText}" /></DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="Nenhuma vaga criada nesta UBS." Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding HasNoUnitSlots, Converter={StaticResource BoolVisibility}}" />
    </StackPanel></Grid></Border>
  </StackPanel>
</UserControl>
