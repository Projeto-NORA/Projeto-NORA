<UserControl x:Class="Nora.Desktop.Views.OperationalOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels">
  <UserControl.Resources>
    <ItemsPanelTemplate x:Key="SummaryCardsPanel"><views:TileGridPanel MinTileWidth="250" MaxColumns="4" /></ItemsPanelTemplate>
  </UserControl.Resources>
  <StackPanel>
    <!-- Sem UBS ativa (nenhuma concedida, várias a escolher): a orientação e o botão que abre o pop-up "Trocar perfil" ficam no lugar do antigo cartão "UBS da operação". -->
    <views:ObsUnitNoticeView />
    <!-- Cabeçalho, em cima à direita: período e pesquisa em linha e, logo à direita da pesquisa, o alternador cards/gráficos (B2 e B3). O nome da tela fica só no cabeçalho da janela. -->
    <views:PageFilterGroup Label="Período" FilterKey="panelPeriod" Inline="True">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Período" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryBrush}" />
        <ComboBox Width="120" Height="36" ItemsSource="{x:Static vm:WorkspaceViewModel.PanelPeriodOptions}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding PanelPeriodDays}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Período do painel" ToolTip="Período dos números do painel: Dia, Semana, Mês, Ano, 5 anos ou Máximo." />
      </StackPanel>
    </views:PageFilterGroup>
    <views:PageFilterGroup Label="Pesquisar no painel" FilterKey="panelSearch" Inline="True">
      <views:HeaderSearchBox Text="{Binding PanelSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar no painel" ToolTip="Filtra os cards, os gráficos e a tabela do painel pelo texto, sem diferenciar acentos nem maiúsculas." />
    </views:PageFilterGroup>
    <views:PageActions>
      <views:ViewModeToggle ScreenKey="home" Mode="{Binding PanelViewMode, Mode=TwoWay}" />
    </views:PageActions>
    <TextBlock Text="{Binding PanelLoadingLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" Visibility="{Binding PanelLoadingLabel, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />

    <!-- Modo cards: resumo do período com o fluxo da unidade, consultórios ativos, tabela das consultas do período e atenção da equipe. -->
    <StackPanel Visibility="{Binding ShowPanelCards, Converter={StaticResource BoolVisibility}}">
      <TextBlock Text="{Binding PanelSummaryTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" Visibility="{Binding ShowPanelSummary, Converter={StaticResource BoolVisibility}}" />
      <ItemsControl ItemsSource="{Binding PanelCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource SummaryCardsPanel}" Margin="-8,0,-8,12" Focusable="False" AutomationProperties.Name="Resumo da UBS no período" />
      <Border Style="{StaticResource Card}" Background="{DynamicResource ToneTealSurfaceBrush}" Padding="20" Margin="0,0,0,24" AutomationProperties.Name="Consultórios ativos" ToolTip="{Binding ActiveRoomsHint}" Visibility="{Binding ShowPanelRooms, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
          <TextBlock Text="Consultórios ativos" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource SecondaryBrush}" />
          <Grid Margin="0,8,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding ActiveRoomsInUseValue}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ToneTealTextBrush}" /><TextBlock Text="em atendimento agora" Style="{StaticResource Muted}" FontSize="11" LineHeight="15" /></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding ActiveRoomsPlannedValue}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ToneTealTextBrush}" /><TextBlock Text="com grade hoje" Style="{StaticResource Muted}" FontSize="11" LineHeight="15" /></StackPanel>
          </Grid>
          <TextBlock Text="{Binding ActiveRoomsHint}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Visibility="{Binding ActiveRoomsHasError, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>
      <StackPanel Margin="0,0,0,24" Visibility="{Binding ShowPanelTable, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding PanelTableTitle}" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" ToolTip="Concluídas, faltas e canceladas pela data marcada. Períodos longos somam por semana ou por mês. Dias sem consultas não aparecem." />
        <DataGrid ItemsSource="{Binding PanelTableRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True" MaxHeight="320" MinHeight="64" RowHeight="40" AutomationProperties.Name="Consultas do período">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Período" Binding="{Binding Period}" Width="*" MinWidth="160" CanUserSort="False" />
            <DataGridTextColumn Header="Concluídas" Binding="{Binding Completed}" Width="110" />
            <DataGridTextColumn Header="Faltas" Binding="{Binding Missed}" Width="90" />
            <DataGridTextColumn Header="Canceladas" Binding="{Binding Cancelled}" Width="110" />
            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="90" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding PanelTableState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding PanelTableState, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
      <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,24" ToolTip="Acompanha fila alta, espera longa, faltas, ocupação da grade e metas fora do limite." Visibility="{Binding ShowPanelAttention, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
          <TextBlock Text="Atenção da equipe" Style="{StaticResource SectionTitle}" />
          <Border CornerRadius="10" Padding="14" Margin="0,14,0,0" AutomationProperties.Name="Resumo dos alertas">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasUnitAlerts}" Value="True"><Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel>
              <TextBlock Text="{Binding PanelAlertsTitle}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding PanelAlertsText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="{Binding PanelAlertsText, Converter={StaticResource TextVisibility}}" />
              <ItemsControl ItemsSource="{Binding UnitAlertPreview}" Margin="0,8,0,0" Focusable="False" AutomationProperties.Name="Primeiros alertas">
                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,3,8,0" VerticalAlignment="Top" /><TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxWidth="560" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Button Content="Ver central de alertas" Style="{StaticResource ObsPrimaryButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="alerts" Margin="0,16,0,0" HorizontalAlignment="Right" ToolTip="Abre os alertas da UBS." />
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding PanelCardsEmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,16" Visibility="{Binding PanelCardsEmptyText, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>

    <!-- Modo gráficos: grade de painéis com título e Linha | Pizza; sem tabela e sem "Atenção da equipe". -->
    <StackPanel Visibility="{Binding ShowPanelCharts, Converter={StaticResource BoolVisibility}}">
      <views:UnitChartGrid Cards="{Binding PanelChartCards}" AutomationProperties.Name="Gráficos do painel" />
      <TextBlock Text="{Binding PanelChartsEmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,16" Visibility="{Binding PanelChartsEmptyText, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </StackPanel>
</UserControl>
