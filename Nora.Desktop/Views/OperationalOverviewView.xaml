<UserControl x:Class="Nora.Desktop.Views.OperationalOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <StackPanel>
    <Border Background="{DynamicResource BrandGradientBrush}" CornerRadius="22" Padding="28" Margin="0,0,0,24">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Ellipse Width="180" Height="180" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-110,-74,0" Fill="#18FFFFFF" IsHitTestVisible="False" />
        <Ellipse Width="100" Height="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,120,-74" Fill="#12FFFFFF" IsHitTestVisible="False" />
        <StackPanel>
          <TextBlock Text="PAINEL OPERACIONAL" Foreground="{DynamicResource BrandTextBrush}" Opacity="0.82" FontSize="11" FontWeight="SemiBold" />
          <TextBlock Text="Sua unidade em um só lugar" Foreground="{DynamicResource BrandTextBrush}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8" />
          <TextBlock Text="Acompanhe o fluxo do dia e priorize o que precisa de atenção." Foreground="{DynamicResource BrandTextBrush}" Opacity="0.88" FontSize="14" />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="#22000000" CornerRadius="10" Padding="12,7" HorizontalAlignment="Right">
            <TextBlock Text="{Binding UnitLabel}" Foreground="{DynamicResource BrandTextBrush}" FontSize="12" />
          </Border>
          <Button Content="Atualizar dados" Command="{Binding RefreshCommand}" Margin="0,14,0,0" HorizontalAlignment="Right" ToolTip="Consulta novamente os dados disponíveis da API." />
        </StackPanel>
      </Grid>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24" AutomationProperties.Name="UBS da operação">
      <StackPanel>
        <TextBlock Text="UBS da operação" FontSize="18" FontWeight="SemiBold" />
        <StackPanel Margin="0,8,0,10"><TextBlock Text="{Binding ActiveObsUnitLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding ActiveObsUnitRegion}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
        <Expander Header="Escolher ou trocar UBS" IsExpanded="{Binding ObsUnitSelectionOpen}"><views:ObsUnitPickerView Margin="0,8,0,0" /></Expander>
      </StackPanel>
    </Border>

    <TextBlock Text="Resumo do dia" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />
    <UniformGrid Columns="4" Margin="-6,0,-6,24">
      <Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><TextBlock Text="Pacientes aguardando" FontWeight="SemiBold" /><TextBlock Text="{Binding QueueWaitingCount}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,10,0,4" /><TextBlock Text="Fila atualmente conectada" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><TextBlock Text="Consultas concluídas" FontWeight="SemiBold" /><TextBlock Text="{Binding TodayCompletedCount}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,10,0,4" /><TextBlock Text="Consultas de hoje concluídas" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><TextBlock Text="Tempo médio de espera" FontWeight="SemiBold" /><TextBlock Text="{Binding PanelWaitValue}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,10,0,4" /><TextBlock Text="{Binding PanelWaitHint}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" /></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><TextBlock Text="Consultas agendadas" FontWeight="SemiBold" /><TextBlock Text="{Binding TodayScheduledCount}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,10,0,4" /><TextBlock Text="Hoje, incluindo chamadas" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><TextBlock Text="Faltas" FontWeight="SemiBold" /><TextBlock Text="{Binding TodayMissedCount}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,10,0,4" /><TextBlock Text="Consultas de hoje com falta" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="6" Padding="18"><StackPanel><TextBlock Text="Cancelamentos" FontWeight="SemiBold" /><TextBlock Text="{Binding TodayCancelledCount}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,10,0,4" /><TextBlock Text="Consultas de hoje canceladas" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="6" Padding="18" AutomationProperties.Name="Consultórios ativos">
        <StackPanel>
          <TextBlock Text="Consultórios ativos" FontWeight="SemiBold" />
          <Grid Margin="0,10,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding ActiveRoomsInUseValue}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="em atendimento agora" Style="{StaticResource Muted}" FontSize="11" LineHeight="15" /></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding ActiveRoomsPlannedValue}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="com grade hoje" Style="{StaticResource Muted}" FontSize="11" LineHeight="15" /></StackPanel>
          </Grid>
          <TextBlock Text="{Binding ActiveRoomsHint}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Border Style="{StaticResource Card}" Margin="0,0,0,24" AutomationProperties.Name="Capacidade dos próximos 7 dias">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Capacidade dos próximos 7 dias" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding PanelCapacityHint}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"><StackPanel Margin="0,0,28,0"><TextBlock Text="{Binding PanelOfferedValue}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextAlignment="Center" /><TextBlock Text="ofertados" Style="{StaticResource Muted}" FontSize="11" /></StackPanel><StackPanel Margin="0,0,28,0"><TextBlock Text="{Binding PanelBookedValue}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextAlignment="Center" /><TextBlock Text="ocupados" Style="{StaticResource Muted}" FontSize="11" /></StackPanel><StackPanel><TextBlock Text="{Binding PanelOccupancyValue}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextAlignment="Center" /><TextBlock Text="ocupação" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></StackPanel>
      </Grid>
    </Border>

    <Grid Margin="0,0,0,24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="Consultas dos últimos 7 dias" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Concluídas, faltas e canceladas por dia, pela data marcada. Dias sem registro valem zero." Style="{StaticResource Muted}" Margin="0,6,0,14" TextWrapping="Wrap" />
          <views:EvolutionChartView Data="{Binding PanelChart}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0">
        <StackPanel>
          <TextBlock Text="Atenção da equipe" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Fila alta, espera longa, faltas, ocupação da grade e metas fora." Style="{StaticResource Muted}" Margin="0,6,0,18" TextWrapping="Wrap" />
          <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="14" AutomationProperties.Name="Resumo dos alertas">
            <StackPanel>
              <TextBlock Text="{Binding PanelAlertsTitle}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding PanelAlertsText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="{Binding PanelAlertsText, Converter={StaticResource TextVisibility}}" />
              <ItemsControl ItemsSource="{Binding UnitAlertPreview}" Margin="0,8,0,0" AutomationProperties.Name="Primeiros alertas">
                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,3,8,0" VerticalAlignment="Top" /><TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxWidth="360" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Button Content="Ver central de alertas" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="alerts" Margin="0,16,0,0" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="{Binding HasAwaitingSlots, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Vagas aguardando aprovação">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Vagas aguardando aprovação" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="{Binding PanelAwaitingText}" Style="{StaticResource Muted}" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="Cada vaga só é oferecida depois que alguém da equipe aprovar; sem aprovação até 1 h antes da consulta, ela fecha." Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
        <Button Grid.Column="1" Content="Ver vagas" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="slots" VerticalAlignment="Center" Margin="18,0,0,0" />
      </Grid>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Fluxo da unidade" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Pacientes cadastrados, fila e vagas relâmpago disponíveis neste momento." Style="{StaticResource Muted}" Margin="0,6,0,0" /></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Margin="0,0,28,0"><TextBlock Text="{Binding PatientTotalCount}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextAlignment="Center" /><TextBlock Text="pacientes" Style="{StaticResource Muted}" FontSize="11" /></StackPanel><StackPanel Margin="0,0,28,0"><TextBlock Text="{Binding QueueWaitingCount}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextAlignment="Center" /><TextBlock Text="na fila" Style="{StaticResource Muted}" FontSize="11" /></StackPanel><StackPanel><TextBlock Text="{Binding SlotOpenCount}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextAlignment="Center" /><TextBlock Text="vagas ativas" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
