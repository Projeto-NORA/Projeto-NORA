<UserControl x:Class="Nora.Desktop.Views.OperationalOverviewView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <StackPanel>
    <!-- Sem UBS ativa (nenhuma concedida, várias a escolher): a orientação e o botão que abre o pop-up "Trocar perfil" ficam no lugar do antigo cartão "UBS da operação". -->
    <views:ObsUnitNoticeView />
    <Border Background="{DynamicResource BrandGradientBrush}" CornerRadius="22" Padding="28" Margin="0,0,0,24">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Ellipse Width="180" Height="180" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-110,-74,0" Fill="#18FFFFFF" IsHitTestVisible="False" />
        <Ellipse Width="100" Height="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,120,-74" Fill="#12FFFFFF" IsHitTestVisible="False" />
        <StackPanel>
          <TextBlock Text="PAINEL OPERACIONAL" Foreground="{DynamicResource BrandTextBrush}" Opacity="0.82" FontSize="11" FontWeight="SemiBold" />
          <TextBlock Text="Sua unidade em um só lugar" Foreground="{DynamicResource BrandTextBrush}" FontSize="30" FontWeight="Bold" Margin="0,8,0,8" ToolTip="Acompanhe o fluxo do dia e priorize o que precisa de atenção." />
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Border Background="#22000000" CornerRadius="10" Padding="12,7" HorizontalAlignment="Right">
            <TextBlock Text="{Binding UnitLabel}" Foreground="{DynamicResource BrandTextBrush}" FontSize="12" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock Text="Resumo do dia" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
    <UniformGrid Columns="4" Margin="-8,0,-8,24">
      <Border Style="{StaticResource Card}" Margin="8" Padding="20" ToolTip="Ofertas de Vaga Relâmpago com prazo correndo agora."><Grid><StackPanel Margin="0,0,24,0"><TextBlock Text="Ofertas em andamento" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" /><TextBlock Text="{Binding QueueWaitingCount}" Style="{StaticResource PageTitle}" Margin="0,10,0,4" /></StackPanel><Button Style="{StaticResource ChartButton}" Command="{x:Static views:ChartCommands.Show}" CommandParameter="Ofertas em andamento" ToolTip="Mostra o gráfico deste indicador."/></Grid></Border>
      <Border Style="{StaticResource Card}" Margin="8" Padding="20" ToolTip="Consultas de hoje concluídas."><Grid><StackPanel Margin="0,0,24,0"><TextBlock Text="Consultas concluídas" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" /><TextBlock Text="{Binding TodayCompletedCount}" Style="{StaticResource PageTitle}" Margin="0,10,0,4" /></StackPanel><Button Style="{StaticResource ChartButton}" Command="{x:Static views:ChartCommands.Show}" CommandParameter="Consultas concluídas" ToolTip="Mostra o gráfico deste indicador."/></Grid></Border>
      <Border Style="{StaticResource Card}" Margin="8" Padding="20" ToolTip="{Binding PanelWaitHint}"><Grid><StackPanel Margin="0,0,24,0"><TextBlock Text="Tempo médio de espera" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" /><TextBlock Text="{Binding PanelWaitValue}" Style="{StaticResource PageTitle}" Margin="0,10,0,4" /><TextBlock Text="{Binding PanelWaitHint}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Visibility="{Binding PanelWaitHasError, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" /></StackPanel><Button Style="{StaticResource ChartButton}" Command="{x:Static views:ChartCommands.Show}" CommandParameter="Tempo médio de espera" ToolTip="Mostra o gráfico deste indicador."/></Grid></Border>
      <Border Style="{StaticResource Card}" Margin="8" Padding="20" ToolTip="Consultas agendadas para hoje, incluindo as chamadas."><Grid><StackPanel Margin="0,0,24,0"><TextBlock Text="Consultas agendadas" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" /><TextBlock Text="{Binding TodayScheduledCount}" Style="{StaticResource PageTitle}" Margin="0,10,0,4" /></StackPanel><Button Style="{StaticResource ChartButton}" Command="{x:Static views:ChartCommands.Show}" CommandParameter="Consultas agendadas" ToolTip="Mostra o gráfico deste indicador."/></Grid></Border>
      <Border Style="{StaticResource Card}" Margin="8" Padding="20" ToolTip="Consultas de hoje registradas como falta."><Grid><StackPanel Margin="0,0,24,0"><TextBlock Text="Faltas" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" /><TextBlock Text="{Binding TodayMissedCount}" Style="{StaticResource PageTitle}" Margin="0,10,0,4" /></StackPanel><Button Style="{StaticResource ChartButton}" Command="{x:Static views:ChartCommands.Show}" CommandParameter="Faltas" ToolTip="Mostra o gráfico deste indicador."/></Grid></Border>
      <Border Style="{StaticResource Card}" Margin="8" Padding="20" ToolTip="Consultas de hoje canceladas."><Grid><StackPanel Margin="0,0,24,0"><TextBlock Text="Cancelamentos" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" /><TextBlock Text="{Binding TodayCancelledCount}" Style="{StaticResource PageTitle}" Margin="0,10,0,4" /></StackPanel><Button Style="{StaticResource ChartButton}" Command="{x:Static views:ChartCommands.Show}" CommandParameter="Cancelamentos" ToolTip="Mostra o gráfico deste indicador."/></Grid></Border>
      <Border Style="{StaticResource Card}" Margin="6" Padding="18" AutomationProperties.Name="Consultórios ativos" ToolTip="{Binding ActiveRoomsHint}">
        <StackPanel>
          <TextBlock Text="Consultórios ativos" FontWeight="SemiBold" />
          <Grid Margin="0,10,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding ActiveRoomsInUseValue}" Style="{StaticResource PageTitle}" /><TextBlock Text="em atendimento agora" Style="{StaticResource Muted}" FontSize="11" LineHeight="15" /></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding ActiveRoomsPlannedValue}" Style="{StaticResource PageTitle}" /><TextBlock Text="com grade hoje" Style="{StaticResource Muted}" FontSize="11" LineHeight="15" /></StackPanel>
          </Grid>
          <TextBlock Text="{Binding ActiveRoomsHint}" Foreground="{DynamicResource ErrorBrush}" FontSize="12" Visibility="{Binding ActiveRoomsHasError, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Grid Margin="0,0,0,24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,12,0" ToolTip="Concluídas, faltas e canceladas por dia, pela data marcada. Dias sem registro valem zero.">
        <StackPanel>
          <TextBlock Text="Consultas dos últimos 7 dias" Style="{StaticResource SectionTitle}" />
          <views:EvolutionChartView Data="{Binding PanelChart}" Margin="0,14,0,0" />
          <views:ChartDataTable Data="{Binding PanelChart}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" ToolTip="Acompanha fila alta, espera longa, faltas, ocupação da grade e metas fora do limite.">
        <StackPanel>
          <TextBlock Text="Atenção da equipe" Style="{StaticResource SectionTitle}" />
          <Border CornerRadius="10" Padding="14" Margin="0,18,0,0" AutomationProperties.Name="Resumo dos alertas">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasUnitAlerts}" Value="True"><Setter Property="Background" Value="{DynamicResource WarningSurfaceBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel>
              <TextBlock Text="{Binding PanelAlertsTitle}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding PanelAlertsText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="{Binding PanelAlertsText, Converter={StaticResource TextVisibility}}" />
              <ItemsControl ItemsSource="{Binding UnitAlertPreview}" Margin="0,8,0,0" AutomationProperties.Name="Primeiros alertas">
                <ItemsControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource WarningBrush}" Margin="0,3,8,0" VerticalAlignment="Top" /><TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxWidth="360" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Button Content="Ver central de alertas" Style="{StaticResource ObsPrimaryButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="alerts" Margin="0,16,0,0" HorizontalAlignment="Right" ToolTip="Abre os alertas da UBS."/>
        </StackPanel>
      </Border>
    </Grid>

    <Border Style="{StaticResource Card}" Margin="0,0,0,24">
      <Grid ToolTip="Pacientes cadastrados, fila e vagas relâmpago disponíveis neste momento."><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="Fluxo da unidade" Style="{StaticResource SectionTitle}" /></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Margin="0,0,28,0"><TextBlock Text="{Binding PatientTotalCount}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextAlignment="Center" /><TextBlock Text="pacientes" Style="{StaticResource Muted}" FontSize="11" /></StackPanel><StackPanel Margin="0,0,28,0"><TextBlock Text="{Binding QueueWaitingCount}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextAlignment="Center" /><TextBlock Text="na fila" Style="{StaticResource Muted}" FontSize="11" /></StackPanel><StackPanel><TextBlock Text="{Binding SlotOpenCount}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" TextAlignment="Center" /><TextBlock Text="vagas ativas" Style="{StaticResource Muted}" FontSize="11" /></StackPanel></StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
