<UserControl x:Class="Nora.Desktop.Views.NetworkUnitsPerformanceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Desempenho das unidades: a tabela solta na tela (sem card e sem título repetido). Cabeçalho: pesquisa, Período em linha e Filtros. -->
  <StackPanel>
    <views:PageFilterGroup Label="Desempenho das unidades" FilterKey="networkSearch" Inline="True" IsEnabled="{Binding CanFilterNetwork}"><views:NetworkSearchField Label="Desempenho das unidades" /></views:PageFilterGroup>
    <views:NetworkFiltersView />
    <TextBlock x:Name="SearchEmpty" Text="Nenhum resultado para esta busca." Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    <DataGrid x:Name="UnitsGrid" ItemsSource="{Binding UnitPerformance}" CanUserSortColumns="True" MaxHeight="520" MinHeight="64" Margin="0,16,0,0" AutomationProperties.Name="Desempenho por unidade" ToolTip="Clique no título de uma coluna para ordenar. Os números seguem os filtros do cabeçalho.">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Unidade" Binding="{Binding Name}" Width="*" MinWidth="150" />
        <DataGridTextColumn Header="Região" Binding="{Binding Region}" Width="110" />
        <DataGridTextColumn Header="Comparecimento" Binding="{Binding ScoreDisplay}" SortMemberPath="ScoreSort" Width="140" />
        <DataGridTextColumn Header="Concluídas" Binding="{Binding Completed}" Width="100" />
        <DataGridTextColumn Header="Faltas" Binding="{Binding Missed}" Width="80" />
        <DataGridTextColumn Header="Cancelamentos" Binding="{Binding Cancelled}" Width="125" />
        <DataGridTextColumn Header="Na fila" Binding="{Binding ActiveEntries}" Width="80" />
        <DataGridTextColumn Header="Espera média" Binding="{Binding WaitDisplay}" SortMemberPath="WaitSort" Width="125" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Text="{Binding MetricsStateText}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding MetricsStateText, Converter={StaticResource TextVisibility}}" />
    <views:ScoreNoteView Margin="0,12,0,0" />
  </StackPanel>
</UserControl>
