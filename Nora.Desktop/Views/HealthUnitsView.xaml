<UserControl x:Class="Nora.Desktop.Views.HealthUnitsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Cadastro de UBS: listagem aberta na tela inteira. O cadastro e a edição são pop-ups (UnitFormView); a ação "Tentar criar a base de novo" mostra os passos num pop-up. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <views:PageFilterGroup Label="Cadastro de UBS" SearchFields="Name,Region,Address,DatabaseLabel" ItemsTarget="{Binding ElementName=UnitList}" />
      <views:PageActions>
        <Button Style="{StaticResource NewItemButton}" Content="Nova UBS" Click="OnNew" AutomationProperties.Name="Nova UBS" ToolTip="Abre o cadastro de uma nova UBS." />
      </views:PageActions>
    </StackPanel>
    <Grid Grid.Row="1">
      <ListBox x:Name="UnitList" Style="{StaticResource OpenList}" ItemsSource="{Binding Units}" AutomationProperties.Name="UBS cadastradas"
               views:ListingBehavior.Balloon="{Binding ElementName=Balloon}" views:ListingBehavior.PluralName="UBS" views:ListingBehavior.Feminine="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid AutomationProperties.Name="{Binding SelectorLabel}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleText}" />
                <TextBlock Text="{Binding MetaLine}" Style="{StaticResource ItemMetaText}" />
              </StackPanel>
              <views:StatusTag Grid.Column="1" Text="{Binding DatabaseLabel}" Tone="{Binding StatusTone}" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <views:ListEmptyText List="{Binding ElementName=UnitList}" EmptyText="{Binding UnitsState}" NoMatchText="Nenhuma UBS encontrada para esta busca." Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="4,8" />
      <views:SelectionBalloon x:Name="Balloon">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="EditButton" Style="{StaticResource ListActionEditButton}" views:SelectionBalloon.SingleItemOnly="True" Content="Editar" Click="OnEdit" ToolTip="Edita os dados da UBS selecionada." />
          <Button x:Name="ProvisionButton" Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconRestoreGeometry}" views:SelectionBalloon.SingleItemOnly="True" Content="Tentar criar a base de novo" Click="OnProvision" ToolTip="Repete a criação da base desta UBS; é seguro repetir." />
        </StackPanel>
      </views:SelectionBalloon>
    </Grid>
  </Grid>
</UserControl>
