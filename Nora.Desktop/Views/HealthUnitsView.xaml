<UserControl x:Class="Nora.Desktop.Views.HealthUnitsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="Atualizar unidades" Click="OnRefresh" IsEnabled="{Binding CanOperate}" /><TextBlock Text="Unidades cadastradas" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
        <Grid Margin="0,0,0,12">
          <TextBox Text="{Binding UnitSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar UBS por nome, região ou endereço" Padding="36,8,12,8" />
          <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
          <TextBlock Text="Pesquisar por nome, região ou endereço" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="36,0,12,0" IsHitTestVisible="False" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding UnitSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </Grid>
        <ListBox ItemsSource="{Binding FilteredUnits}" SelectedItem="{Binding SelectedUnit}" MaxHeight="260" AutomationProperties.Name="UBS cadastradas">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="6">
                <DockPanel LastChildFill="False">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Visibility="{Binding DatabaseLabel, Converter={StaticResource TextVisibility}}" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE73E;" /><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding DatabasePending}" Value="True"><Setter Property="Text" Value="&#xE7BA;" /><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding DatabaseLabel}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" DockPanel.Dock="Left" />
                </DockPanel>
                <TextBlock Text="{Binding Region}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" />
                <TextBlock Text="{Binding Address}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding UnitsState}" Style="{StaticResource Muted}" Margin="0,10,0,0" Visibility="{Binding UnitsState, Converter={StaticResource TextVisibility}}" />
        <TextBlock Text="{Binding SelectedUnitLabel}" FontWeight="SemiBold" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel Margin="0,12,0,0"><Button Content="Editar selecionada" Click="OnEdit" IsEnabled="{Binding CanEditUnit}" Margin="0,0,8,0" /><Button Content="Nova UBS" Click="OnNew" IsEnabled="{Binding CanOperate}" /></WrapPanel>
        <Border Margin="0,14,0,0" CornerRadius="10" Padding="14" BorderThickness="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource WarningBrush}" Visibility="{Binding SelectedUnitDatabasePending, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Base da UBS não criada">
          <StackPanel>
            <TextBlock Text="Base da UBS ainda não criada" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,10" Text="Sem a base, a UBS fica fora dos números da rede, do cadastro público e do aplicativo. Se a criação falhar, avise a equipe de TI." />
            <Button Content="Tentar criar a base" Click="OnProvision" IsEnabled="{Binding CanProvisionUnitDatabase}" HorizontalAlignment="Left" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" Visibility="{Binding IsUnitFormOpen, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Formulário da UBS"><StackPanel IsEnabled="{Binding CanOperate}">
      <TextBlock Text="{Binding UnitDraftTitle}" FontSize="19" FontWeight="SemiBold" /><Border Height="16" />
      <TextBlock Text="Nome da UBS" /><TextBox Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome da UBS" Margin="0,5,0,12" />
      <TextBlock Text="{Binding UnitNameError}" Style="{StaticResource FieldError}" Visibility="{Binding UnitNameError, Converter={StaticResource TextVisibility}}" />
      <TextBlock Text="Região" /><TextBox Text="{Binding UnitRegion, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Região da UBS" Margin="0,5,0,12" />
      <TextBlock Text="{Binding UnitRegionError}" Style="{StaticResource FieldError}" Visibility="{Binding UnitRegionError, Converter={StaticResource TextVisibility}}" />
      <TextBlock Text="Endereço" /><TextBox Text="{Binding UnitAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Endereço da UBS" Margin="0,5,0,12" />
      <TextBlock Text="{Binding UnitAddressError}" Style="{StaticResource FieldError}" Visibility="{Binding UnitAddressError, Converter={StaticResource TextVisibility}}" />
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0"><TextBlock Text="Latitude (ex.: -23,55)" /><TextBox Text="{Binding UnitLatitude, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Latitude da UBS" Margin="0,5,0,12" /><TextBlock Text="{Binding UnitLatitudeError}" Style="{StaticResource FieldError}" Visibility="{Binding UnitLatitudeError, Converter={StaticResource TextVisibility}}" /></StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Longitude (ex.: -46,63)" /><TextBox Text="{Binding UnitLongitude, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Longitude da UBS" Margin="0,5,0,12" /><TextBlock Text="{Binding UnitLongitudeError}" Style="{StaticResource FieldError}" Visibility="{Binding UnitLongitudeError, Converter={StaticResource TextVisibility}}" /></StackPanel>
      </Grid>
      <TextBlock Text="{Binding UnitCoordinateWarning}" Style="{StaticResource FieldWarning}" Visibility="{Binding UnitCoordinateWarning, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      <WrapPanel><Button Content="Salvar UBS" Click="OnSave" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" /><Button Content="Cancelar" Click="OnCancel" AutomationProperties.Name="Cancelar o formulário da UBS" /></WrapPanel>
    </StackPanel></Border>
  </StackPanel>
</UserControl>
