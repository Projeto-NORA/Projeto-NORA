<Window x:Class="Nora.Desktop.Views.ItemDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="580" Height="640" MinWidth="440" MinHeight="320" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Detalhes do item">
  <Window.Resources>
    <CollectionViewSource x:Key="GroupedFields" Source="{Binding Details.Fields}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group" /></CollectionViewSource.GroupDescriptions></CollectionViewSource>
  </Window.Resources>
  <Grid>
  <Border Margin="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24" AutomationProperties.Name="Ficha de detalhes">
    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20" MouseLeftButtonDown="OnDragHeader">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Details.Title}" FontSize="23" FontWeight="SemiBold" Margin="0,0,10,8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details.Title}" />
          <TextBlock Text="{Binding Details.Subtitle}" Foreground="{DynamicResource SecondaryBrush}" FontSize="13" Margin="0,0,10,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="×" FontSize="24" Padding="4" MinHeight="36" Height="36" VerticalAlignment="Top" Click="OnClose" IsCancel="True" ToolTip="Feche os detalhes e volte à listagem." AutomationProperties.Name="Fechar detalhes" />
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedFields}}">
          <ItemsControl.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,10" /><ItemsPresenter /></StackPanel>
            </Border>
          </ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ItemsControl.GroupStyle>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Grid Margin="0,4">
              <Grid.ColumnDefinitions><ColumnDefinition Width="105" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Value}" />
              <Button Grid.Column="2" Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding CanCopy, Converter={StaticResource BoolVisibility}}" Padding="6" MinHeight="34" Height="34" Width="34" VerticalAlignment="Center" ToolTip="{Binding Label, StringFormat='Copiar {0}'}" AutomationProperties.Name="{Binding Label, StringFormat='Copiar {0}'}"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="15" /></Button>
            </Grid>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock Grid.Row="2" Text="{Binding CopyStatus}" Foreground="{DynamicResource BrandBrush}" AutomationProperties.LiveSetting="Polite" Margin="0,12,0,0" MinHeight="18" FontSize="12" />
    </Grid>
  </Border>
  </Grid>
</Window>
