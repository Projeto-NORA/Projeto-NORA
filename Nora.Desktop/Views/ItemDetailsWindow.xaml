<Window x:Class="Nora.Desktop.Views.ItemDetailsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" Width="580" SizeToContent="Height" MinWidth="440" MinHeight="320" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Detalhes do item">
  <Window.Resources>
    <CollectionViewSource x:Key="GroupedFields" Source="{Binding Details.Fields}"><CollectionViewSource.GroupDescriptions><PropertyGroupDescription PropertyName="Group" /></CollectionViewSource.GroupDescriptions></CollectionViewSource>
    <DataTemplate x:Key="TabsTemplate">
      <!-- Abas da ficha do paciente: Dados e Exames e vacinas. A aba aberta é marcada por texto e traço, não só por cor. -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
        <Button Content="Dados" Command="{Binding SelectDataCommand}" MinHeight="40" Padding="18,6" Margin="0,0,8,0" AutomationProperties.Name="Aba Dados" ToolTip="Mostra os dados do item.">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding ShowDataTab}" Value="True"><Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" /><Setter Property="BorderThickness" Value="0,0,0,3" /></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <Button Content="Exames e vacinas" Command="{Binding SelectHealthCommand}" MinHeight="40" Padding="18,6" AutomationProperties.Name="Aba Exames e vacinas" ToolTip="Mostra exames e vacinas do paciente.">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding ShowHealthTab}" Value="True"><Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" /><Setter Property="BorderThickness" Value="0,0,0,3" /></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="HealthTemplate">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <views:HealthRecordsView DataContext="{Binding Health}" Margin="0,0,6,0" />
      </ScrollViewer>
    </DataTemplate>
  </Window.Resources>
  <Grid>
  <Border Margin="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24" AutomationProperties.Name="Ficha de detalhes">
    <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,20" MouseLeftButtonDown="OnDragHeader">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Details.Title}" FontSize="23" FontWeight="SemiBold" Margin="0,0,10,8" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details.Title}" />
          <TextBlock Text="{Binding Details.Subtitle}" Foreground="{DynamicResource SecondaryBrush}" FontSize="13" Margin="0,0,10,0" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource CircleIconButton}" Click="OnClose" IsCancel="True" VerticalAlignment="Top" ToolTip="Feche os detalhes e volte à listagem." AutomationProperties.Name="Fechar detalhes">
          <Path Data="{StaticResource IconCloseGeometry}" Width="18" Height="18" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Button>
      </Grid>
      <ContentControl x:Name="TabsHost" Grid.Row="1" Focusable="False" />
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding ShowDataTab, Converter={StaticResource BoolVisibility}}">
        <!-- Ficha em linhas horizontais, sem cards: rótulo à esquerda (cor secundária), valor à direita (em destaque), botão de copiar e um fio de 1 px entre as linhas. Cada seção tem um título discreto. -->
        <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedFields}}" Margin="0,0,10,0">
          <ItemsControl.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem">
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,8,0,2" />
              <ItemsPresenter />
            </StackPanel>
          </ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ItemsControl.GroupStyle>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="0,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="13.5" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ValueText" Grid.Column="1" Text="{Binding Value}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" TextWrapping="Wrap" ToolTip="{Binding Value}" />
                <Button Grid.Column="2" Style="{StaticResource CircleIconButton}" Width="30" Height="30" Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Visibility="{Binding CanCopy, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" ToolTip="{Binding Label, StringFormat='Copiar {0}'}" AutomationProperties.Name="{Binding Label, StringFormat='Copiar {0}'}">
                  <Path Data="{StaticResource IconCopyGeometry}" Width="18" Height="18" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <!-- Texto longo (Block): rótulo em cima e valor embaixo, na largura toda, alinhado à esquerda e com as quebras de linha como foram escritas. -->
              <DataTrigger Binding="{Binding Block}" Value="True">
                <Setter TargetName="ValueText" Property="Grid.Row" Value="1" />
                <Setter TargetName="ValueText" Property="Grid.Column" Value="0" />
                <Setter TargetName="ValueText" Property="Grid.ColumnSpan" Value="3" />
                <Setter TargetName="ValueText" Property="HorizontalAlignment" Value="Stretch" />
                <Setter TargetName="ValueText" Property="TextAlignment" Value="Left" />
                <Setter TargetName="ValueText" Property="FontWeight" Value="Normal" />
                <Setter TargetName="ValueText" Property="Margin" Value="0,8,0,0" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <ContentControl x:Name="HealthHost" Grid.Row="2" Focusable="False" Visibility="{Binding ShowHealthTab, Converter={StaticResource BoolVisibility}}" />
      <Grid Grid.Row="3" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding CopyStatus}" Foreground="{DynamicResource BrandBrush}" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" MinHeight="18" FontSize="12" />
        <ContentControl x:Name="ActionsHost" Grid.Column="1" Focusable="False" IsTabStop="False" HorizontalAlignment="Right" Visibility="Collapsed" />
      </Grid>
    </Grid>
  </Border>
  </Grid>
</Window>
