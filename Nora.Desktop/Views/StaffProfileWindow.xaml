<Window xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.StaffProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views"
        Title="Dados do perfil" Width="720" SizeToContent="Height" MaxHeight="780" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
  <!-- Pop-up da marca (mesmo padrão do FormDialog): sem moldura do Windows, cantos arredondados, título e X no topo, fundo da janela principal escurecido. Nome, e-mail e função em linhas; a troca de senha é um bloco próprio. Sem card dentro. -->
  <Window.Resources>
    <Style x:Key="ProfileRow" TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="Padding" Value="0,8" /></Style>
    <Style x:Key="ProfileRowLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="13.5" /><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,12,0" /></Style>
    <Style x:Key="ProfileRowValue" TargetType="TextBlock"><Setter Property="FontSize" Value="14.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="TextAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  </Window.Resources>
  <Border x:Name="Frame" Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" AutomationProperties.Name="Dados do perfil">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22" Color="Black" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Margin="24,18,14,8" Background="Transparent" MouseLeftButtonDown="OnDrag">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="Dados do perfil" Style="{StaticResource SectionTitle}" FontSize="20" Margin="0" VerticalAlignment="Center" />
        <Button Grid.Column="1" Style="{StaticResource CircleIconButton}" IsCancel="True" Click="OnClose" ToolTip="Fechar" AutomationProperties.Name="Fechar dados do perfil">
          <Path Data="{StaticResource IconCloseGeometry}" Width="18" Height="18" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Button>
      </Grid>
      <StackPanel Grid.Row="1" Margin="24,0,24,0">
        <ProgressBar x:Name="ProfileProgress" Height="3" Margin="0,0,0,6" IsIndeterminate="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" AutomationProperties.Name="Lendo seu perfil" />
        <TextBlock x:Name="ProfileStatus" Text="Carregando seu perfil…" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Muted}" Margin="0,0,0,8" Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource TextVisibility}}" />
        <TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Muted}" Margin="0,0,0,8" Visibility="{Binding Message, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ProfileFields" IsEnabled="False" Margin="24,0,24,22">
          <Border Style="{StaticResource ProfileRow}" BorderThickness="0,1,0,1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="Nome completo" Style="{StaticResource ProfileRowLabel}" />
              <TextBox x:Name="FullName" Grid.Column="1" MaxLength="160" MinWidth="300" HorizontalAlignment="Right" Margin="0" AutomationProperties.Name="Nome completo" enter:EnterNavigation.Group="StaffProfileWindow.name" />
            </Grid>
          </Border>
          <Border Style="{StaticResource ProfileRow}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="E-mail" Style="{StaticResource ProfileRowLabel}" />
              <TextBox x:Name="Email" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" FontSize="14.5" TextAlignment="Right" HorizontalAlignment="Stretch" MinHeight="0" Padding="0" Margin="0" AutomationProperties.Name="E-mail" ToolTip="O e-mail é a identificação da conta e não muda por aqui." enter:EnterNavigation.Group="StaffProfileWindow.name" />
            </Grid>
          </Border>
          <Border Style="{StaticResource ProfileRow}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="Função" Style="{StaticResource ProfileRowLabel}" />
              <TextBlock Grid.Column="1" Text="{Binding AccountRoleLabel}" Style="{StaticResource ProfileRowValue}" />
            </Grid>
          </Border>
          <Border x:Name="ScopeRow" Style="{StaticResource ProfileRow}" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="Acesso" Style="{StaticResource ProfileRowLabel}" />
              <TextBlock x:Name="ScopeText" Grid.Column="1" Style="{StaticResource ProfileRowValue}" />
            </Grid>
          </Border>
          <Button Content="Salvar nome" Click="OnSaveName" HorizontalAlignment="Right" Style="{StaticResource ObsPrimaryButton}" MinHeight="40" Margin="0,14,0,0" enter:EnterNavigation.Group="StaffProfileWindow.name" />
          <TextBlock Text="Alterar senha" Style="{StaticResource SectionHeading}" Margin="0,28,0,0" />
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,6,0,14" />
          <views:ChangePasswordView />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
