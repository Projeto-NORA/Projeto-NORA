<Window xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.StaffProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views"
        Title="Dados do perfil" Width="550" SizeToContent="Height" MaxHeight="750" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" FontSize="15">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24">
      <TextBlock Text="Dados do perfil" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14" />
      <ProgressBar x:Name="ProfileProgress" Height="4" Margin="0,0,0,8" IsIndeterminate="True" Foreground="{DynamicResource BrandBrush}" />
      <TextBlock x:Name="ProfileStatus" Text="Carregando seu perfil…" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Muted}" Margin="0,0,0,12" />
      <TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Muted}" Visibility="{Binding Message, Converter={StaticResource TextVisibility}}" />
      <StackPanel x:Name="ProfileFields" IsEnabled="False">
        <TextBlock Text="Nome completo" FontWeight="SemiBold" /><TextBox x:Name="FullName" MaxLength="160" Margin="0,4,0,10" AutomationProperties.Name="Nome completo"  enter:EnterNavigation.Group="StaffProfileWindow.name"/>
        <TextBlock Text="E-mail" FontWeight="SemiBold" /><TextBox x:Name="Email" IsReadOnly="True" Margin="0,4,0,10" AutomationProperties.Name="E-mail"  enter:EnterNavigation.Group="StaffProfileWindow.name"/>
        <TextBlock Text="Função" FontWeight="SemiBold" /><TextBlock Text="{Binding AccountRoleLabel}" Margin="0,4,0,10" />
        <TextBlock x:Name="ScopeText" Style="{StaticResource Muted}" Margin="0,0,0,12" />
        <Button Content="Salvar nome" Click="OnSaveName" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"  enter:EnterNavigation.Group="StaffProfileWindow.name"/>
        <Separator Margin="0,18,0,16" />
        <TextBlock Text="Alterar senha" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
        <views:ChangePasswordView />
      </StackPanel>
      <Button Content="Fechar" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0" />
    </StackPanel>
  </ScrollViewer>
</Window>
