<UserControl x:Class="Nora.Desktop.Views.UnitFormView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Cadastro e edição de UBS, no pop-up (sem card). O DataContext é o WorkspaceViewModel. A localização sai do endereço (Photon/OpenStreetMap) ao salvar. -->
  <views:FormGrid>
    <StackPanel>
      <TextBlock Text="Nome da UBS" Style="{StaticResource FieldLabelText}" />
      <TextBox Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome da UBS" views:EnterNavigation.Group="UnitFormView.unit" />
      <TextBlock Text="{Binding UnitNameError}" Style="{StaticResource FieldError}" Margin="0,4,0,0" Visibility="{Binding UnitNameError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Região" Style="{StaticResource FieldLabelText}" />
      <TextBox Text="{Binding UnitRegion, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Região da UBS" views:EnterNavigation.Group="UnitFormView.unit" />
      <TextBlock Text="{Binding UnitRegionError}" Style="{StaticResource FieldError}" Margin="0,4,0,0" Visibility="{Binding UnitRegionError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <StackPanel>
      <TextBlock Text="Endereço" Style="{StaticResource FieldLabelText}" />
      <TextBox Text="{Binding UnitAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Endereço da UBS" views:EnterNavigation.Group="UnitFormView.unit" />
      <TextBlock Text="{Binding UnitAddressError}" Style="{StaticResource FieldError}" Margin="0,4,0,0" Visibility="{Binding UnitAddressError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <StackPanel views:FormGrid.FullRow="True">
      <TextBlock Text="A localização será buscada pelo endereço. Dados: Photon e © colaboradores do OpenStreetMap." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding UnitSaveSteps}" ItemTemplate="{StaticResource ProgressStepTemplate}" Margin="0,6,0,0" AutomationProperties.Name="Passos do cadastro da UBS" />
    </StackPanel>
  </views:FormGrid>
</UserControl>
