<UserControl x:Class="Nora.Desktop.Views.ChartPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" Focusable="False">
  <!-- Um gráfico com o título à esquerda e, à direita do título, o alternador Linha | Pizza (que some quando o indicador só tem um dos dois tipos de dado). Sem moldura: quem usa decide se põe o gráfico num cartão. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
      <views:SegmentedToggle x:Name="KindToggle" Grid.Column="1" Margin="12,0,0,0" AutomationProperties.Name="Tipo de gráfico" ToolTip="Alterna entre o gráfico de linha (evolução) e o de pizza (composição)." />
    </Grid>
    <Grid Grid.Row="1" MinHeight="200">
      <views:LineChartView x:Name="LineView" />
      <Grid x:Name="PiePanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <views:OutcomePie x:Name="Pie" HoleRatio="0.6" MinWidth="150" MinHeight="150" Margin="4" />
        <StackPanel x:Name="PieLegend" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="180" />
      </Grid>
      <TextBlock x:Name="EmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="24,0" Visibility="Collapsed" />
    </Grid>
    <TextBlock x:Name="NoteText" Grid.Row="2" Style="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
  </Grid>
</UserControl>
