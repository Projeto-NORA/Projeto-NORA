<UserControl x:Class="Nora.Desktop.Views.UnitIndicatorsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels">
  <!-- Indicadores da UBS ativa: mesmos cartões, nota do score, tabela e gráfico da Secretaria, com os números só desta unidade. -->
  <StackPanel>
    <views:ObsUnitNoticeView />
    <Border Style="{StaticResource Card}" Margin="0,0,0,20">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding UnitMetricsLoadingLabel}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="Período" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="A escolha é aplicada na hora aos números desta tela." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" />
        <WrapPanel IsEnabled="{Binding CanFilterUnitMetrics}">
          <StackPanel Width="190" Margin="0,0,12,10"><TextBlock Text="Período" FontWeight="SemiBold" FontSize="12" />
            <ComboBox Margin="0,6,0,0" ItemsSource="{x:Static vm:WorkspaceViewModel.UnitPeriodOptions}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding UnitPeriodDays}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Período dos indicadores da UBS" /></StackPanel>
        </WrapPanel>
        <StackPanel Visibility="{Binding IsUnitCustomPeriod, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0">
          <WrapPanel IsEnabled="{Binding CanFilterUnitMetrics}">
            <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="De (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding UnitFromText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data inicial do período da UBS" /></StackPanel>
            <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="Até (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding UnitToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data final do período da UBS" /></StackPanel>
            <Button Content="Aplicar período da UBS" Click="OnApplyPeriod" VerticalAlignment="Bottom" Margin="0,0,0,8" ToolTip="Consulta os indicadores no intervalo informado (até 366 dias)." />
          </WrapPanel>
          <TextBlock Text="{Binding UnitRangeError}" Style="{StaticResource FieldError}" Margin="0,0,0,8" Visibility="{Binding UnitRangeError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <TextBlock Text="{Binding UnitMetricsScopeLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" Visibility="{Binding UnitMetricsScopeLabel, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </Border>
    <TextBlock Text="{Binding UnitMetricsStateText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" Visibility="{Binding UnitMetricsStateText, Converter={StaticResource TextVisibility}}" />
    <ItemsControl ItemsSource="{Binding UnitOverviewCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-6,0,-6,6" AutomationProperties.Name="Indicadores da UBS no período" />
    <views:ScoreNoteView />
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Vaga Relâmpago no período" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="Vagas criadas no período e o que aconteceu com as ofertas delas. Aceite da oferta não equivale a atendimento confirmado." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,8" />
        <ItemsControl ItemsSource="{Binding UnitLightningCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource FourColumnPanel}" Margin="-6,0" AutomationProperties.Name="Vaga Relâmpago da UBS no período" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Por especialidade" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="A especialidade é o texto informado em cada consulta e fila; grafias que só diferem em maiúsculas formam um grupo. Clique no título de uma coluna para ordenar." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" />
        <DataGrid ItemsSource="{Binding UnitSpecialtyPerformance}" CanUserSortColumns="True" MaxHeight="340" MinHeight="64" AutomationProperties.Name="Indicadores da UBS por especialidade">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Especialidade" Binding="{Binding Name}" Width="*" MinWidth="160" />
            <DataGridTextColumn Header="Comparecimento" Binding="{Binding ScoreDisplay}" SortMemberPath="ScoreSort" Width="140" />
            <DataGridTextColumn Header="Concluídas" Binding="{Binding Completed}" Width="100" />
            <DataGridTextColumn Header="Faltas" Binding="{Binding Missed}" Width="80" />
            <DataGridTextColumn Header="Cancelamentos" Binding="{Binding Cancelled}" Width="125" />
            <DataGridTextColumn Header="Na fila" Binding="{Binding ActiveEntries}" Width="80" />
            <DataGridTextColumn Header="Espera média" Binding="{Binding WaitDisplay}" SortMemberPath="WaitSort" Width="125" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding UnitSpecialtyState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding UnitSpecialtyState, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Série no tempo" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="Consultas por dia, pela data marcada, no período escolhido." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" />
        <views:EvolutionChartView Data="{Binding UnitChart}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Ainda sem dados" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Ocupação da agenda e uso dos consultórios dependem do cadastro de profissionais, consultórios e horários, previsto para uma próxima etapa. Nada disso é calculado ou simulado." />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
