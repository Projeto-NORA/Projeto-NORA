<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.UnitIndicatorsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels">
  <UserControl.Resources>
    <ItemsPanelTemplate x:Key="SummaryCardsPanel"><views:TileGridPanel MinTileWidth="250" MaxColumns="3" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="GoalCardsPanel"><views:TileGridPanel MinTileWidth="240" MaxColumns="3" /></ItemsPanelTemplate>
  </UserControl.Resources>
  <!-- Indicadores da UBS ativa (Desempenho): os mesmos números da Secretaria, só desta unidade. O nome da tela fica só no cabeçalho da janela. -->
  <StackPanel>
    <views:ObsUnitNoticeView />
    <!-- Cabeçalho: o período em linha (as datas do personalizado e os filtros da tabela ficam no botão Filtros) e o alternador cards/gráficos. -->
    <views:PageFilterGroup Label="Período" FilterKey="unitMetricsPeriod" Inline="True">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding CanFilterUnitMetrics}">
        <TextBlock Text="Período" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryBrush}" />
        <ComboBox Width="150" Height="36" ItemsSource="{x:Static vm:WorkspaceViewModel.UnitPeriodOptions}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding UnitPeriodDays}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Período dos indicadores da UBS" ToolTip="Dia, Semana, Mês, Ano, 5 anos, Máximo ou Personalizado (as datas ficam no botão Filtros)." enter:EnterNavigation.Group="UnitIndicatorsView.filters" />
      </StackPanel>
    </views:PageFilterGroup>
    <views:PageFilterGroup Label="Indicadores da unidade" FilterKey="unitMetrics">
      <StackPanel>
        <StackPanel Visibility="{Binding IsUnitCustomPeriod, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,4">
          <WrapPanel IsEnabled="{Binding CanFilterUnitMetrics}">
            <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="De (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding UnitFromText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data inicial do período da UBS" enter:EnterNavigation.Group="UnitIndicatorsView.filters" /></StackPanel>
            <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="Até (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding UnitToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data final do período da UBS" enter:EnterNavigation.Group="UnitIndicatorsView.filters" /></StackPanel>
            <Button Content="Aplicar período" AutomationProperties.Name="Aplicar período da UBS" Style="{StaticResource ObsPrimaryButton}" Click="OnApplyPeriod" VerticalAlignment="Bottom" Margin="0,0,0,8" ToolTip="Consulta os indicadores no intervalo informado." enter:EnterNavigation.Group="UnitIndicatorsView.filters" />
          </WrapPanel>
          <TextBlock Text="{Binding UnitRangeError}" Style="{StaticResource FieldError}" Margin="0,0,0,8" Visibility="{Binding UnitRangeError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <WrapPanel IsEnabled="{Binding CanFilterUnitMetrics}">
          <StackPanel Width="190" Margin="0,0,12,10"><TextBlock Text="Especialidade (tabela)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding UnitSpecialtySearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Pesquisar especialidade nos indicadores" enter:EnterNavigation.Group="UnitIndicatorsView.filters" /></StackPanel>
          <StackPanel Width="190" Margin="0,0,12,10"><TextBlock Text="Situação (tabela)" FontWeight="SemiBold" FontSize="12" /><ComboBox ItemsSource="{x:Static vm:WorkspaceViewModel.UnitSpecialtyFilterOptions}" SelectedItem="{Binding UnitSpecialtyFilter}" Margin="0,6,0,0" AutomationProperties.Name="Filtrar especialidades por situação" enter:EnterNavigation.Group="UnitIndicatorsView.filters" /></StackPanel>
        </WrapPanel>
      </StackPanel>
    </views:PageFilterGroup>
    <views:PageActions>
      <views:ViewModeToggle ScreenKey="indicators" Mode="{Binding UnitViewMode, Mode=TwoWay}" />
    </views:PageActions>
    <TextBlock Text="{Binding UnitMetricsLoadingLabel}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="{Binding UnitMetricsScopeLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" Visibility="{Binding UnitMetricsScopeLabel, Converter={StaticResource TextVisibility}}" />
    <TextBlock Text="{Binding UnitMetricsStateText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" Visibility="{Binding UnitMetricsStateText, Converter={StaticResource TextVisibility}}" />

    <!-- Modo cards: seis cards resumidos, a nota do comparecimento, a tabela por especialidade (sem card em volta) e as metas. -->
    <StackPanel Visibility="{Binding ShowUnitCards, Converter={StaticResource BoolVisibility}}">
      <ItemsControl ItemsSource="{Binding UnitOverviewCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource SummaryCardsPanel}" Margin="-8,4,-8,4" Focusable="False" AutomationProperties.Name="Indicadores da UBS no período" />
      <TextBlock Text="ⓘ Como é calculado o comparecimento" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Margin="0,0,0,24" ToolTip="Comparecimento = concluídas ÷ (concluídas + faltas + cancelamentos feitos pelo paciente, ponderados pela antecedência). Consultas agendadas e cancelamentos pela unidade não entram." AutomationProperties.HelpText="Comparecimento: concluídas, faltas e cancelamentos do paciente, ponderados pela antecedência." />
      <TextBlock Text="Por especialidade" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" ToolTip="Clique no título de uma coluna para ordenar. Os filtros de especialidade e situação, no botão Filtros, aplicam-se apenas a esta tabela." />
      <DataGrid ItemsSource="{Binding FilteredUnitSpecialtyPerformance}" CanUserSortColumns="True" MaxHeight="340" MinHeight="64" AutomationProperties.Name="Indicadores da UBS por especialidade">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Especialidade" Binding="{Binding Name}" Width="*" MinWidth="160" />
          <DataGridTextColumn Header="Comparecimento" Binding="{Binding ScoreDisplay}" SortMemberPath="ScoreSort" Width="140" />
          <DataGridTextColumn Header="Concluídas" Binding="{Binding Completed}" Width="100" />
          <DataGridTextColumn Header="Faltas" Binding="{Binding Missed}" Width="80" />
          <DataGridTextColumn Header="Cancelamentos" Binding="{Binding Cancelled}" Width="125" />
          <DataGridTextColumn Header="Na fila" Binding="{Binding ActiveEntries}" Width="80" />
          <DataGridTextColumn Header="Espera média" Binding="{Binding WaitDisplay}" SortMemberPath="WaitSort" Width="125" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding UnitSpecialtyState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding UnitSpecialtyState, Converter={StaticResource TextVisibility}}" />
      <StackPanel Margin="0,24,0,12" AutomationProperties.Name="Metas da UBS no período">
        <TextBlock Text="Metas da Secretaria" Style="{StaticResource SectionTitle}" ToolTip="Situação da meta da UBS ou, se não houver, da rede." />
        <ItemsControl ItemsSource="{Binding UnitGoalCells}" ItemTemplate="{StaticResource GoalCardTemplate}" ItemsPanel="{StaticResource GoalCardsPanel}" Margin="-6,8,-6,0" Focusable="False" AutomationProperties.Name="Situação das metas da UBS" />
        <TextBlock Text="{Binding UnitGoalsState}" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding UnitGoalsState, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </StackPanel>

    <!-- Modo gráficos: grade de painéis com título e Linha | Pizza; sem tabela. -->
    <StackPanel Visibility="{Binding ShowUnitCharts, Converter={StaticResource BoolVisibility}}">
      <views:UnitChartGrid Cards="{Binding UnitChartCards}" Margin="0,4,0,0" AutomationProperties.Name="Gráficos dos indicadores da UBS" />
      <TextBlock Text="{Binding UnitChartsEmptyText}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,16" Visibility="{Binding UnitChartsEmptyText, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </StackPanel>
</UserControl>
