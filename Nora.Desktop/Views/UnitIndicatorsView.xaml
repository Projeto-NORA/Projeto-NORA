<UserControl x:Class="Nora.Desktop.Views.UnitIndicatorsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels">
  <UserControl.Resources><DataTemplate x:Key="ObsMetricCard"><Border Style="{StaticResource Card}" Margin="6" Padding="20" ToolTip="{Binding Hint}" AutomationProperties.Name="{Binding AutomationLabel}"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" /><TextBlock Text="{Binding Value}" Foreground="{DynamicResource AccentTextBrush}" FontSize="28" FontWeight="Bold" Margin="0,10,0,0" /></StackPanel></Border></DataTemplate></UserControl.Resources>
  <!-- Indicadores da UBS ativa: mesmos cartões, nota do score, tabela e gráfico da Secretaria, com os números só desta unidade. -->
  <StackPanel>
    <views:ObsUnitNoticeView />
    <views:PageFilterGroup Label="Indicadores da unidade" FilterKey="unitMetrics">
      <StackPanel>
        <WrapPanel IsEnabled="{Binding CanFilterUnitMetrics}">
          <StackPanel Width="190" Margin="0,0,12,10"><TextBlock Text="Período" FontWeight="SemiBold" FontSize="12" />
            <ComboBox Margin="0,6,0,0" ItemsSource="{x:Static vm:WorkspaceViewModel.UnitPeriodOptions}" DisplayMemberPath="Label" SelectedValuePath="Days" SelectedValue="{Binding UnitPeriodDays}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Período dos indicadores da UBS" /></StackPanel>
          <StackPanel Width="190" Margin="0,0,12,10"><TextBlock Text="Especialidade (tabela)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding UnitSpecialtySearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Pesquisar especialidade nos indicadores" /></StackPanel>
          <StackPanel Width="190" Margin="0,0,12,10"><TextBlock Text="Situação (tabela)" FontWeight="SemiBold" FontSize="12" /><ComboBox ItemsSource="{x:Static vm:WorkspaceViewModel.UnitSpecialtyFilterOptions}" SelectedItem="{Binding UnitSpecialtyFilter}" Margin="0,6,0,0" AutomationProperties.Name="Filtrar especialidades por situação" /></StackPanel>
        </WrapPanel>
        <StackPanel Visibility="{Binding IsUnitCustomPeriod, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0">
          <WrapPanel IsEnabled="{Binding CanFilterUnitMetrics}">
            <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="De (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding UnitFromText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data inicial do período da UBS" /></StackPanel>
            <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="Até (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding UnitToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data final do período da UBS" /></StackPanel>
            <Button Content="Aplicar período" AutomationProperties.Name="Aplicar período da UBS" Style="{StaticResource ObsPrimaryButton}" Click="OnApplyPeriod" VerticalAlignment="Bottom" Margin="0,0,0,8" ToolTip="Consulta os indicadores no intervalo informado (até 366 dias)." />
          </WrapPanel>
          <TextBlock Text="{Binding UnitRangeError}" Style="{StaticResource FieldError}" Margin="0,0,0,8" Visibility="{Binding UnitRangeError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </StackPanel>
    </views:PageFilterGroup>
    <TextBlock Text="{Binding UnitMetricsLoadingLabel}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="{Binding UnitMetricsScopeLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" Visibility="{Binding UnitMetricsScopeLabel, Converter={StaticResource TextVisibility}}" />
    <TextBlock Text="{Binding UnitMetricsStateText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" Visibility="{Binding UnitMetricsStateText, Converter={StaticResource TextVisibility}}" />
    <TextBlock Text="Visão geral" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,4,0,8" />
    <ItemsControl ItemsSource="{Binding UnitOverviewCards}" ItemTemplate="{StaticResource ObsMetricCard}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-6,0,-6,6" AutomationProperties.Name="Indicadores da UBS no período" />
    <TextBlock Text="ⓘ Como é calculado o comparecimento" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Margin="0,0,0,20" ToolTip="Comparecimento = concluídas ÷ (concluídas + faltas + cancelamentos feitos pelo paciente, ponderados pela antecedência). Consultas agendadas e cancelamentos pela unidade não entram." AutomationProperties.HelpText="Comparecimento é calculado a partir das consultas concluídas, faltas e cancelamentos feitos pelo paciente, ponderados pela antecedência." />
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" ToolTip="Distribuição entre consultas concluídas, faltas e canceladas pela data marcada no período.">
      <StackPanel>
        <TextBlock Text="Distribuição das consultas encerradas" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
        <WrapPanel Margin="0,14,0,0" Visibility="{Binding HasUnitOutcomeData, Converter={StaticResource BoolVisibility}}">
          <views:OutcomePie Metrics="{Binding UnitMetricsData}" Width="150" Height="150" Margin="0,0,24,0" />
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding UnitMetricsData.Appointments.Completed, StringFormat='● Concluídas: {0}'}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" Margin="0,0,0,8" /><TextBlock Text="{Binding UnitMetricsData.Appointments.Missed, StringFormat='● Faltas: {0}'}" Foreground="{DynamicResource ErrorBrush}" FontWeight="Bold" Margin="0,0,0,8" /><TextBlock Text="{Binding UnitMetricsData.Appointments.Cancelled, StringFormat='● Canceladas: {0}'}" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" /></StackPanel>
        </WrapPanel>
        <TextBlock Text="Sem consultas encerradas ou indicadores ainda não carregados." Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="{Binding HasUnitOutcomeData, Converter={StaticResource InverseBoolVisibility}}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="⚡ Vaga Relâmpago no período" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" ToolTip="Aceite da oferta não equivale a atendimento confirmado." />
        <ItemsControl ItemsSource="{Binding UnitLightningCards}" ItemTemplate="{StaticResource ObsMetricCard}" ItemsPanel="{StaticResource FourColumnPanel}" Margin="-6,0" AutomationProperties.Name="Vaga Relâmpago da UBS no período" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Por especialidade" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,12" ToolTip="Clique no título de uma coluna para ordenar. Os filtros de especialidade e situação aplicam-se apenas a esta tabela." />
        <DataGrid ItemsSource="{Binding FilteredUnitSpecialtyPerformance}" CanUserSortColumns="True" MaxHeight="340" MinHeight="64" AutomationProperties.Name="Indicadores da UBS por especialidade">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Especialidade" Binding="{Binding Name}" Width="*" MinWidth="160" />
            <DataGridTextColumn Header="Comparecimento" Binding="{Binding ScoreDisplay}" SortMemberPath="ScoreSort" Width="140" />
            <DataGridTextColumn Header="Concluídas" Binding="{Binding Completed}" Width="100" />
            <DataGridTextColumn Header="Faltas" Binding="{Binding Missed}" Width="80" />
            <DataGridTextColumn Header="Cancelamentos" Binding="{Binding Cancelled}" Width="125" />
            <DataGridTextColumn Header="Na fila" Binding="{Binding ActiveEntries}" Width="80" />
            <DataGridTextColumn Header="Espera média" Binding="{Binding WaitDisplay}" SortMemberPath="WaitSort" Width="125" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding UnitSpecialtyState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding UnitSpecialtyState, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Série no tempo" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,12" ToolTip="Consultas por dia, pela data marcada, no período escolhido." />
        <views:EvolutionChartView Data="{Binding UnitChart}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Capacidade da UBS no período">
      <StackPanel>
        <TextBlock Text="Capacidade da agenda no período" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" ToolTip="Horários ofertados pela grade menos os bloqueados e quantos têm consulta marcada." />
        <ItemsControl ItemsSource="{Binding UnitCapacityCards}" ItemTemplate="{StaticResource ObsMetricCard}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-6,0" AutomationProperties.Name="Capacidade da UBS" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Metas da UBS no período">
      <StackPanel>
        <TextBlock Text="Metas da Secretaria" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" ToolTip="Situação da meta da UBS ou, se não houver, da rede." />
        <ItemsControl ItemsSource="{Binding UnitGoalCells}" ItemTemplate="{StaticResource GoalCardTemplate}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-6,0" AutomationProperties.Name="Situação das metas da UBS" />
        <TextBlock Text="{Binding UnitGoalsState}" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding UnitGoalsState, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
