<UserControl x:Class="Nora.Desktop.Views.UnitChartGrid" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" Focusable="False">
  <!-- Grade do modo gráficos: um ChartPanel (título e Linha | Pizza à direita) por cartão, em um quadro da superfície. As colunas seguem a largura (1 ou 2); sem tabela de dados. -->
  <ItemsControl x:Name="Grid" Margin="-8,0" Focusable="False">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:TileGridPanel MinTileWidth="460" MaxColumns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <Border Style="{StaticResource Card}" Margin="8" Padding="20">
          <views:ChartPanel Title="{Binding Title}" Lines="{Binding Lines}" Slices="{Binding Slices}" LineNote="{Binding LineNote}" PieNote="{Binding PieNote}" Kind="{Binding Kind, Mode=TwoWay}" />
        </Border>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
