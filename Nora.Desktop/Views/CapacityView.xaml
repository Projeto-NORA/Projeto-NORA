<UserControl x:Class="Nora.Desktop.Views.CapacityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Capacidade da rede: horários ofertados pela grade, ocupados e ocupação, por UBS e por região, com os filtros dos indicadores; mais o cadastro de uma UBS em leitura. -->
  <UserControl.Resources>
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style>
    <DataTemplate x:Key="OccupancyCell">
      <StackPanel Orientation="Horizontal">
        <Border Width="100" Height="10" CornerRadius="5" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
          <Border HorizontalAlignment="Left" Width="{Binding OccupancyBar}" CornerRadius="4" Background="{DynamicResource AccentTextBrush}" />
        </Border>
        <TextBlock Text="{Binding OccupancyDisplay}" Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel>
    <views:NetworkFiltersView />
    <TextBlock Text="{Binding MetricsStateText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" Visibility="{Binding MetricsStateText, Converter={StaticResource TextVisibility}}" />
    <ItemsControl ItemsSource="{Binding NetworkCapacityCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-6,0,-6,6" AutomationProperties.Name="Capacidade da rede no período" />
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Capacidade por UBS">
      <StackPanel>
        <TextBlock Text="Capacidade por UBS" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="Ofertados: atendimentos da grade com início no período, menos os bloqueados. Ocupados: os que têm consulta marcada. Ocupação = ocupados ÷ ofertados; sem horários ofertados aparece —. A barra acompanha a ocupação; o valor escrito é a informação." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap" />
        <DataGrid ItemsSource="{Binding CapacityByUnit}" CanUserSortColumns="True" MaxHeight="340" MinHeight="64" AutomationProperties.Name="Capacidade por UBS">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Unidade" Binding="{Binding Name}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Região" Binding="{Binding Region}" Width="130" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Ofertados" Binding="{Binding OfferedDisplay}" SortMemberPath="Offered" Width="110" />
            <DataGridTextColumn Header="Ocupados" Binding="{Binding BookedDisplay}" SortMemberPath="Booked" Width="110" />
            <DataGridTemplateColumn Header="Ocupação" SortMemberPath="OccupancySort" Width="210" CellTemplate="{StaticResource OccupancyCell}" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding CapacityState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding CapacityState, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Capacidade por região">
      <StackPanel>
        <TextBlock Text="Capacidade por região" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="Regiões agrupadas sem diferenciar maiúsculas, com os mesmos filtros." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" />
        <DataGrid ItemsSource="{Binding CapacityByRegion}" CanUserSortColumns="True" MaxHeight="300" MinHeight="64" AutomationProperties.Name="Capacidade por região">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Região" Binding="{Binding Name}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Ofertados" Binding="{Binding OfferedDisplay}" SortMemberPath="Offered" Width="110" />
            <DataGridTextColumn Header="Ocupados" Binding="{Binding BookedDisplay}" SortMemberPath="Booked" Width="110" />
            <DataGridTemplateColumn Header="Ocupação" SortMemberPath="OccupancySort" Width="210" CellTemplate="{StaticResource OccupancyCell}" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Cadastro de uma UBS">
      <StackPanel>
        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding CapacityCatalogLoadingLabel}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="Cadastro de uma UBS (somente leitura)" FontSize="19" FontWeight="SemiBold" /></DockPanel>
        <TextBlock Text="Profissionais, consultórios e grade semanal de uma UBS. Só o administrador da própria UBS altera esses dados; a Secretaria consulta." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap" />
        <WrapPanel><StackPanel Width="320" Margin="0,0,12,0"><TextBlock Text="UBS" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,12" ItemsSource="{Binding Units}" DisplayMemberPath="SelectorLabel" SelectedItem="{Binding CapacityUnit}" AutomationProperties.Name="UBS do cadastro em leitura" /></StackPanel>
          <Button Content="Ler o cadastro de novo" Click="OnRetryCatalog" IsEnabled="{Binding CanReloadCapacityCatalog}" VerticalAlignment="Bottom" Margin="0,0,0,12" ToolTip="Lê de novo os profissionais, os consultórios e a grade da UBS escolhida." /></WrapPanel>
        <TextBlock Text="{Binding CapacityCatalogState}" Style="{StaticResource Muted}" Margin="0,0,0,10" Visibility="{Binding CapacityCatalogState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="Profissionais" FontWeight="SemiBold" Margin="0,6,0,6" />
        <DataGrid ItemsSource="{Binding CapacityProfessionals}" CanUserSortColumns="True" MaxHeight="240" MinHeight="48" AutomationProperties.Name="Profissionais da UBS em leitura">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nome" Binding="{Binding FullName}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Especialidades" Binding="{Binding SpecialtiesDisplay}" Width="1.4*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Conselho" Binding="{Binding CouncilDisplay}" Width="150" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Situação" Binding="{Binding StatusDisplay}" Width="110" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Consultórios" FontWeight="SemiBold" Margin="0,14,0,6" />
        <DataGrid ItemsSource="{Binding CapacityRooms}" CanUserSortColumns="True" MaxHeight="200" MinHeight="48" AutomationProperties.Name="Consultórios da UBS em leitura">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="*" MinWidth="150" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Situação" Binding="{Binding StatusDisplay}" Width="130" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="Grade semanal" FontWeight="SemiBold" Margin="0,14,0,6" />
        <DataGrid ItemsSource="{Binding CapacitySchedule}" CanUserSortColumns="True" MaxHeight="300" MinHeight="48" AutomationProperties.Name="Grade semanal da UBS em leitura">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Dia" Binding="{Binding WeekdayDisplay}" SortMemberPath="Weekday" Width="130" />
            <DataGridTextColumn Header="Horário" Binding="{Binding RangeDisplay}" Width="110" />
            <DataGridTextColumn Header="Duração" Binding="{Binding SlotDisplay}" SortMemberPath="SlotMinutes" Width="90" />
            <DataGridTextColumn Header="Profissional" Binding="{Binding ProfessionalName}" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Consultório" Binding="{Binding RoomName}" Width="*" MinWidth="110" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Especialidade" Binding="{Binding SpecialtyName}" Width="*" MinWidth="110" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Vigência" Binding="{Binding ValidityDisplay}" Width="190" ElementStyle="{StaticResource CellText}" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
