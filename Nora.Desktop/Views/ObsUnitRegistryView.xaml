<UserControl x:Class="Nora.Desktop.Views.ObsUnitRegistryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels">
  <Border Style="{StaticResource Card}" Margin="0,0,0,24">
    <StackPanel IsEnabled="{Binding CanEditDraft}">
      <TextBlock Text="Cadastro de pacientes da UBS" FontSize="21" FontWeight="SemiBold" />
      <TextBlock Text="Consulte os cadastros da UBS e registre os dados que serão conferidos no aplicativo do paciente." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,14" />
      <Expander Header="Escolher ou trocar UBS" IsExpanded="{Binding ObsUnitSelectionOpen}" Margin="0,0,0,8"><views:ObsUnitPickerView Margin="0,8,0,0" /></Expander>
      <StackPanel Margin="0,12,0,8"><TextBlock Text="{Binding ActiveObsUnitLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding ActiveObsUnitRegion}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
      <StackPanel IsEnabled="{Binding HasActiveObsUnit}">
        <Button Content="Atualizar cadastros da UBS" Click="OnRefresh" HorizontalAlignment="Left" Margin="0,0,0,10" />
        <TextBlock Text="Pesquisar por nome, CPF, e-mail ou telefone" /><TextBox Text="{Binding ObsRegistrySearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar cadastro da UBS" />
        <WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Situação na UBS" /><ComboBox SelectedValue="{Binding ObsRegistryStatusFilter}" SelectedValuePath="Content" MinWidth="150" AutomationProperties.Name="Filtrar situação na UBS"><ComboBoxItem Content="Todos" /><ComboBoxItem Content="Ativos" /><ComboBoxItem Content="Desativados" /></ComboBox></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Presença no aplicativo" /><ComboBox SelectedValue="{Binding ObsRegistryPresenceFilter}" SelectedValuePath="Content" MinWidth="150" AutomationProperties.Name="Filtrar presença na UBS"><ComboBoxItem Content="Todos" /><ComboBoxItem Content="Online" /><ComboBoxItem Content="Offline" /></ComboBox></StackPanel><StackPanel><TextBlock Text="Ordenar por" /><ComboBox SelectedValue="{Binding ObsRegistrySort}" SelectedValuePath="Content" MinWidth="150" AutomationProperties.Name="Ordenar cadastro da UBS"><ComboBoxItem Content="Mais recentes" /><ComboBoxItem Content="Nome A–Z" /><ComboBoxItem Content="Nome Z–A" /><ComboBoxItem Content="Maior score" /><ComboBoxItem Content="Menor score" /></ComboBox></StackPanel></WrapPanel>
        <TextBlock Text="{x:Static vm:WorkspaceViewModel.ScorePriorityText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,8" AutomationProperties.Name="Efeito do score" />
        <ListBox ItemsSource="{Binding FilteredObsRegistry}" SelectedItem="{Binding SelectedObsRegistry}" MaxHeight="240" MinHeight="60" AutomationProperties.Name="Cadastros de referência da UBS" MouseDoubleClick="OnPatientDoubleClick" PreviewKeyDown="OnPatientKeyDown">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold" /><TextBlock Text="{Binding FormattedCpf, StringFormat='CPF: {0}'}" /><TextBlock Text="{Binding Email}" /><TextBlock Text="{Binding PhoneDisplay}" /><TextBlock Text="{Binding ActiveDisplay}" /><TextBlock Text="{Binding PresenceDisplay}" /><TextBlock Text="{Binding ScoreDisplay, StringFormat='Score (12 meses): {0}'}" Style="{StaticResource Muted}" FontSize="12" AutomationProperties.Name="Score do paciente nos últimos 12 meses" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Margin="0,10,0,0"><Button Content="Ver ficha da UBS" Click="OnDetails" IsEnabled="{Binding HasSelectedObsRegistry}" Margin="0,0,8,8" /><Button Content="Editar ficha" Click="OnEdit" IsEnabled="{Binding HasSelectedObsRegistry}" Margin="0,0,8,8" /><Button Content="{Binding ObsRegistryActiveAction}" Click="OnSetActive" IsEnabled="{Binding HasSelectedObsRegistry}" Margin="0,0,8,8" /><Button Content="Novo cadastro" Click="OnNew" Margin="0,0,8,8" /></WrapPanel>
        <Expander Header="Corrigir somente o e-mail" Margin="0,8,0,0"><StackPanel>
          <TextBlock Text="Selecione o paciente acima e informe o endereço atualizado." TextWrapping="Wrap" Margin="0,12,0,4" />
          <TextBox Text="{Binding CorrectedObsEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail corrigido da UBS" Margin="0,6,0,4" /><TextBlock Text="{Binding CorrectedObsEmailError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.Name="Erro do e-mail corrigido" />
          <Button Content="Corrigir e-mail" Click="OnUpdateEmail" HorizontalAlignment="Left" />
        </StackPanel></Expander>
        <Expander Header="{Binding ObsRegistryDraftTitle}" IsExpanded="{Binding ObsRegistryDraftOpen}" Margin="0,14,0,0"><StackPanel Margin="0,12,0,0">
          <TextBlock Text="Nome completo" /><TextBox Text="{Binding ObsRegistryName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome no cadastro da UBS" />
          <TextBlock Text="CPF" /><TextBox Text="{Binding ObsRegistryCpf, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditingObsRegistry}" AutomationProperties.Name="CPF no cadastro da UBS" />
          <TextBlock Text="E-mail cadastrado" /><TextBox Text="{Binding ObsRegistryEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail no cadastro da UBS" Margin="0,6,0,4" /><TextBlock Text="{Binding ObsRegistryEmailError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.Name="Erro do e-mail do cadastro" />
          <TextBlock Text="Telefone (opcional)" /><TextBox Text="{Binding ObsRegistryPhone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Telefone no cadastro da UBS" Margin="0,6,0,4" /><TextBlock Text="{Binding ObsRegistryPhoneError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.Name="Erro do telefone do cadastro" />
          <TextBlock Text="Endereço (opcional)" FontWeight="SemiBold" Margin="0,4,0,8" />
          <DockPanel><Button Content="Buscar CEP do paciente" Click="OnLookupCep" DockPanel.Dock="Right" Margin="8,6,0,16" /><TextBox Text="{Binding ObsRegistryCep, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="CEP no cadastro da UBS" /></DockPanel>
          <TextBlock Text="Logradouro" /><TextBox Text="{Binding ObsRegistryStreet, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Logradouro no cadastro da UBS" />
          <TextBlock Text="Número" /><TextBox Text="{Binding ObsRegistryNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Número no cadastro da UBS" />
          <TextBlock Text="Complemento" /><TextBox Text="{Binding ObsRegistryComplement, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Complemento no cadastro da UBS" />
          <TextBlock Text="Bairro" /><TextBox Text="{Binding ObsRegistryNeighborhood, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bairro no cadastro da UBS" />
          <TextBlock Text="Cidade" /><TextBox Text="{Binding ObsRegistryCity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cidade no cadastro da UBS" />
          <TextBlock Text="UF" /><TextBox Text="{Binding ObsRegistryState, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="UF no cadastro da UBS" MaxLength="2" CharacterCasing="Upper" />
          <Button Content="{Binding ObsRegistrySaveLabel}" Click="OnCreate" HorizontalAlignment="Left" />
        </StackPanel></Expander>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
