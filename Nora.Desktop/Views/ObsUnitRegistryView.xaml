<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.ObsUnitRegistryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels">
  <UserControl.Resources>
    <Style x:Key="PatientRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Margin" Value="2,3" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12"><ContentPresenter /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter TargetName="Row" Property="Background" Value="{DynamicResource PatientAlternateBrush}" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource BrandSoftBrush}" /><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /><Setter TargetName="Row" Property="BorderThickness" Value="2" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Border Style="{StaticResource Card}" Margin="0,0,0,24" ToolTip="Consulte e registre os dados que serão conferidos no aplicativo do paciente.">
    <StackPanel IsEnabled="{Binding CanEditDraft}">
      <Expander Header="Escolher ou trocar UBS" Style="{StaticResource ObsExpander}" IsExpanded="{Binding ObsUnitSelectionOpen}" Margin="0,0,0,8"><views:ObsUnitPickerView Margin="0,8,0,0" /></Expander>
      <StackPanel Margin="0,12,0,8"><TextBlock Text="{Binding ActiveObsUnitLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding ActiveObsUnitRegion}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
      <StackPanel IsEnabled="{Binding HasActiveObsUnit}">
        <Button Content="+ Novo cadastro" Style="{StaticResource ObsPrimaryButton}" Click="OnNew" HorizontalAlignment="Right" Margin="0,0,0,8" />
        <Expander Style="{StaticResource ObsExpander}" Header="{Binding ObsRegistryDraftTitle}" IsExpanded="{Binding ObsRegistryDraftOpen}" Margin="0,14,0,0"><StackPanel Margin="0,12,0,0">
          <TextBlock Text="Nome completo" /><TextBox Text="{Binding ObsRegistryName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome no cadastro da UBS"  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/>
          <TextBlock Text="CPF" /><TextBox Text="{Binding ObsRegistryCpf, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditingObsRegistry}" AutomationProperties.Name="CPF no cadastro da UBS"  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/>
          <TextBlock Text="E-mail cadastrado" /><TextBox Text="{Binding ObsRegistryEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail no cadastro da UBS" Margin="0,6,0,4"  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/><TextBlock Text="{Binding ObsRegistryEmailError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.Name="Erro do e-mail do cadastro" />
          <TextBlock Text="Telefone (opcional)" /><TextBox Text="{Binding ObsRegistryPhone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Telefone no cadastro da UBS" Margin="0,6,0,4"  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/><TextBlock Text="{Binding ObsRegistryPhoneError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.Name="Erro do telefone do cadastro" />
          <TextBlock Text="Endereço (opcional)" FontWeight="SemiBold" Margin="0,4,0,8" />
          <TextBlock Text="CEP" /><TextBox Text="{Binding ObsRegistryCep, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnCepChanged" AutomationProperties.Name="CEP no cadastro da UBS" ToolTip="Ao digitar os oito dígitos, o endereço é consultado automaticamente."  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/>
          <TextBlock Text="Logradouro" /><TextBox Text="{Binding ObsRegistryStreet, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Logradouro no cadastro da UBS"  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/>
          <TextBlock Text="Número" /><TextBox Text="{Binding ObsRegistryNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Número no cadastro da UBS"  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/>
          <TextBlock Text="Complemento" /><TextBox Text="{Binding ObsRegistryComplement, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Complemento no cadastro da UBS"  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/>
          <TextBlock Text="Bairro" /><TextBox Text="{Binding ObsRegistryNeighborhood, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bairro no cadastro da UBS"  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/>
          <TextBlock Text="Cidade" /><TextBox Text="{Binding ObsRegistryCity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Cidade no cadastro da UBS"  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/>
          <TextBlock Text="UF" /><TextBox Text="{Binding ObsRegistryState, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="UF no cadastro da UBS" MaxLength="2" CharacterCasing="Upper"  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/>
          <Button Content="{Binding ObsRegistrySaveLabel}" Click="OnCreate" Style="{StaticResource ObsPrimaryButton}" HorizontalAlignment="Left"  enter:EnterNavigation.Group="ObsUnitRegistryView.patient"/>
        </StackPanel></Expander>
        <Button Style="{StaticResource IconRefreshButton}" Click="OnRefresh" HorizontalAlignment="Right" Margin="0,0,0,10" AutomationProperties.Name="Atualizar cadastros da UBS" ToolTip="Atualizar cadastros da UBS" />
        <views:PageFilterGroup Label="Pacientes" FilterKey="patients">
          <StackPanel>
            <TextBlock Text="Pesquisar por nome, CPF, e-mail ou telefone" /><Grid><TextBox Text="{Binding ObsRegistrySearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar cadastro da UBS" MinHeight="42" Padding="36,10,10,10"  enter:EnterNavigation.Group="ObsUnitRegistryView.filters"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SecondaryBrush}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0" /></Grid>
            <WrapPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Situação na UBS" /><ComboBox SelectedValue="{Binding ObsRegistryStatusFilter}" SelectedValuePath="Content" MinWidth="150" AutomationProperties.Name="Filtrar situação na UBS" enter:EnterNavigation.Group="ObsUnitRegistryView.filters"><ComboBoxItem Content="Todos" /><ComboBoxItem Content="Ativos" /><ComboBoxItem Content="Desativados" /></ComboBox></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Presença no aplicativo" /><ComboBox SelectedValue="{Binding ObsRegistryPresenceFilter}" SelectedValuePath="Content" MinWidth="150" AutomationProperties.Name="Filtrar presença na UBS" enter:EnterNavigation.Group="ObsUnitRegistryView.filters"><ComboBoxItem Content="Todos" /><ComboBoxItem Content="Online" /><ComboBoxItem Content="Offline" /></ComboBox></StackPanel><StackPanel><TextBlock Text="Ordenar por" /><ComboBox SelectedValue="{Binding ObsRegistrySort}" SelectedValuePath="Content" MinWidth="150" AutomationProperties.Name="Ordenar cadastro da UBS" enter:EnterNavigation.Group="ObsUnitRegistryView.filters"><ComboBoxItem Content="Mais recentes" /><ComboBoxItem Content="Nome A–Z" /><ComboBoxItem Content="Nome Z–A" /><ComboBoxItem Content="Maior score" /><ComboBoxItem Content="Menor score" /></ComboBox></StackPanel></WrapPanel>
          </StackPanel>
        </views:PageFilterGroup>
        <ListBox ItemsSource="{Binding FilteredObsRegistry}" SelectedItem="{Binding SelectedObsRegistry}" AlternationCount="2" ItemContainerStyle="{StaticResource PatientRow}" MaxHeight="380" MinHeight="60" AutomationProperties.Name="Cadastros de referência da UBS" MouseDoubleClick="OnPatientDoubleClick" PreviewKeyDown="OnPatientKeyDown">
          <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold" /><TextBlock Text="{Binding FormattedCpf, StringFormat='CPF: {0}'}" /><TextBlock Text="{Binding Email}" /><TextBlock Text="{Binding PhoneDisplay}" /><TextBlock Text="{Binding ActiveDisplay}" /><TextBlock Text="{Binding PresenceDisplay}" /><TextBlock Text="{Binding ScoreDisplay, StringFormat='Score (12 meses): {0}'}" Style="{StaticResource Muted}" FontSize="12" AutomationProperties.Name="Score do paciente nos últimos 12 meses" ToolTip="{x:Static vm:WorkspaceViewModel.ScorePriorityText}" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Margin="0,10,0,0"><Button Content="Ver ficha da UBS" Style="{StaticResource ObsPrimaryButton}" Click="OnDetails" IsEnabled="{Binding HasSelectedObsRegistry}" Margin="0,0,8,8" /><Button Content="Editar ficha" Style="{StaticResource ObsPrimaryButton}" Click="OnEdit" IsEnabled="{Binding HasSelectedObsRegistry}" Margin="0,0,8,8" /><Button Content="{Binding ObsRegistryActiveAction}" Style="{StaticResource ObsPrimaryButton}" Click="OnSetActive" IsEnabled="{Binding HasSelectedObsRegistry}" Margin="0,0,8,8" /></WrapPanel>
        <Expander Header="Corrigir somente o e-mail" Margin="0,8,0,0"><StackPanel>
          <TextBlock Text="Selecione o paciente acima e informe o endereço atualizado." TextWrapping="Wrap" Margin="0,12,0,4" />
          <TextBox Text="{Binding CorrectedObsEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail corrigido da UBS" Margin="0,6,0,4"  enter:EnterNavigation.Group="ObsUnitRegistryView.email"/><TextBlock Text="{Binding CorrectedObsEmailError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.Name="Erro do e-mail corrigido" />
          <Button Content="Corrigir e-mail" Click="OnUpdateEmail" HorizontalAlignment="Left"  enter:EnterNavigation.Group="ObsUnitRegistryView.email"/>
        </StackPanel></Expander>

      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
