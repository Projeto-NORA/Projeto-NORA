<UserControl x:Class="Nora.Desktop.Views.ObsUnitNoticeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Aviso das telas que dependem de uma UBS ativa: explica o que falta e abre o pop-up "Trocar perfil". -->
  <Border Background="{DynamicResource BrandSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,18" AutomationProperties.Name="UBS necessária" Visibility="{Binding NeedsObsUnitChoice, Converter={StaticResource BoolVisibility}}">
    <StackPanel>
      <TextBlock Text="{Binding ObsUnitPrompt}" TextWrapping="Wrap" />
      <Button Content="Escolher UBS" Click="OnChoose" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="Escolher UBS" ToolTip="Abre o pop-up para escolher a UBS em que você vai trabalhar."/>
    </StackPanel>
  </Border>
</UserControl>
