<UserControl x:Class="Nora.Desktop.Views.ObsUnitNoticeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Aviso curto das telas que dependem de uma UBS ativa, no visual de NoticeItem: diz o que falta e o botão abre o pop-up "Trocar perfil". -->
  <ContentControl Style="{StaticResource NoticeItem}" Margin="0,0,0,18" AutomationProperties.Name="UBS necessária" Visibility="{Binding NeedsObsUnitChoice, Converter={StaticResource BoolVisibility}}">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding ObsUnitPrompt}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Escolher UBS" Click="OnChoose" Margin="16,0,0,0" MinHeight="36" AutomationProperties.Name="Escolher UBS" ToolTip="Abre o pop-up para escolher a UBS em que você vai trabalhar." />
    </Grid>
  </ContentControl>
</UserControl>
