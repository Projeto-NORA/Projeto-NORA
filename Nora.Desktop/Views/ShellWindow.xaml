<Window x:Class="Nora.Desktop.Views.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" Width="1320" Height="860" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" Title="{Binding Profile.Name}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Width="{Binding SidebarWidth}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,24">
        <StackPanel DockPanel.Dock="Top">
          <ItemsControl ItemsSource="{Binding Navigation}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" IsEnabled="{Binding Available}" HorizontalContentAlignment="Left" BorderThickness="0" Padding="10,12" Margin="0,0,0,6" ToolTipService.ShowOnDisabled="True" ToolTipService.IsEnabled="{Binding DataContext.ShowSidebarTips, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Title}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                      <Setter Property="ToolTip" Value="{Binding Title}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Id}" Value="home"><Setter Property="ToolTip" Value="Abra a visão geral do seu espaço de trabalho." /></DataTrigger>
                        <DataTrigger Binding="{Binding Id}" Value="patients"><Setter Property="ToolTip" Value="Consulte e cadastre pacientes da unidade." /></DataTrigger>
                        <DataTrigger Binding="{Binding Id}" Value="queue"><Setter Property="ToolTip" Value="Acompanhe e organize a fila de Vaga Relâmpago." /></DataTrigger>
                        <DataTrigger Binding="{Binding Id}" Value="slots"><Setter Property="ToolTip" Value="Abra e acompanhe vagas oferecidas aos pacientes." /></DataTrigger>
                        <DataTrigger Binding="{Binding Id}" Value="indicators"><Setter Property="ToolTip" Value="Consulte os indicadores agregados da rede." /></DataTrigger>
                        <DataTrigger Binding="{Binding Available}" Value="False"><Setter Property="ToolTip" Value="Esta área aguarda a definição das próximas funcionalidades." /></DataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="home" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="home" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="patients" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="patients" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="queue" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="queue" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="slots" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="slots" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="indicators" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="indicators" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" FontSize="18" Width="24" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" Margin="10,0,0,0" Visibility="{Binding DataContext.SidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Command="{Binding ToggleSidebarCommand}" ToolTip="Recolha ou expanda a barra de navegação. Atalho: Ctrl+B." ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Alternar barra lateral" Margin="0,0,0,10">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
          </Button>
          <Button x:Name="AccountButton" Click="OnAccountMenu" HorizontalContentAlignment="Left" BorderThickness="0" Padding="6,12" ToolTip="Abra as configurações ou saia da conta." ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Menu da conta NORA">
            <Button.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
                <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="5"><ItemsPresenter /></Border></ControlTemplate></ContextMenu.Template>
                <ContextMenu.Resources><Style TargetType="MenuItem">
                  <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Padding" Value="14,10" /><Setter Property="MinWidth" Value="180" />
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Frame" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" /></Border><ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource BrandSoftBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45" /></Trigger>
                  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                </Style></ContextMenu.Resources>
                <MenuItem Header="Configurações" Command="{Binding NavigateCommand}" CommandParameter="settings" AutomationProperties.Name="Configurações" />
                <MenuItem Header="Sair da conta" Command="{Binding Workspace.LogoutCommand}" AutomationProperties.Name="Sair da conta" />
              </ContextMenu>
            </Button.ContextMenu>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource BrandBrush}"><TextBlock Text="N" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource BrandTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}"><TextBlock Text="NORA" FontWeight="SemiBold" FontSize="14" /><TextBlock Text="{Binding WorkspaceName}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="NoWrap" /></StackPanel>
            </Grid>
          </Button>
        </StackPanel>
        <Grid />
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,0" Height="72">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Workspace.ShowPatients}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid>
          <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
        </Grid>
      </Border>
      <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PageContainer" Margin="32,32,32,24">
          <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}" />
          <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}" />
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="1" Panel.ZIndex="10" AutomationProperties.Name="Ações do item selecionado">
        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource FloatingActions}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsHome}" Value="True" /><Condition Binding="{Binding Workspace.HasPatientActionSelection}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsHome}" Value="True" /><Condition Binding="{Binding Workspace.HasQueueActionSelection}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
          <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsHome}" Value="True" /><Condition Binding="{Binding Workspace.HasSlotActionSelection}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger>
        </Style.Triggers></Style></Border.Style>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Workspace.ActionSelectionLabel}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
          <Button Grid.Column="1" Content="Detalhes" Click="OnActionDetails" ToolTip="Veja os detalhes do item selecionado. Você também pode usar duplo clique ou Enter." AutomationProperties.Name="Detalhes do item selecionado" Margin="0,0,8,0" />
          <Button Grid.Column="2" Content="{Binding Workspace.PatientActiveActionLabel}" Click="OnSetPatientActive" IsEnabled="{Binding Workspace.CanSetPatientActive}" Visibility="{Binding Workspace.HasPatientActionSelection, Converter={StaticResource BoolVisibility}}" ToolTip="Altere o acesso do paciente. A confirmação explica os efeitos antes de continuar." AutomationProperties.Name="Alterar status da conta do paciente" Margin="0,0,8,0" />
          <Button Grid.Column="3" Content="Cancelar entrada selecionada" Command="{Binding Workspace.CancelQueueCommand}" Visibility="{Binding Workspace.HasQueueActionSelection, Converter={StaticResource BoolVisibility}}" ToolTip="Cancele a entrada selecionada na fila de Vaga Relâmpago." Margin="0,0,8,0" />
          <Button Grid.Column="4" Content="×" Command="{Binding Workspace.ClearSelectionCommand}" FontSize="20" MinWidth="36" Padding="8" ToolTip="Desfaça a seleção e feche a barra de ações." AutomationProperties.Name="Desfazer seleção" />
        </Grid>
      </Border>
      <Border Grid.Row="1" Panel.ZIndex="10" AutomationProperties.Name="Ações do atendimento selecionado">
        <Border.Style><Style TargetType="Border" BasedOn="{StaticResource FloatingActions}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsHome}" Value="True" /><Condition Binding="{Binding HasSelection}" Value="True" /><Condition Binding="{Binding Workspace.IsSignedOut}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding SelectedRow.Description}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
          <Button Grid.Column="1" Content="Detalhes" Click="OnLegacyDetails" ToolTip="Veja as informações disponíveis deste atendimento." AutomationProperties.Name="Detalhes do atendimento selecionado" Margin="0,0,8,0" />
          <Button Grid.Column="2" Content="×" Click="OnClearLegacySelection" FontSize="20" MinWidth="36" Padding="8" ToolTip="Desfaça a seleção e feche a barra de ações." AutomationProperties.Name="Desfazer seleção do atendimento" />
        </Grid>
      </Border>
      <Border Grid.Row="2" Background="{DynamicResource BrandSoftBrush}" Padding="24,10" Visibility="{Binding HasPreferenceError, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" />
      </Border>
    </Grid>
  </Grid>
</Window>
