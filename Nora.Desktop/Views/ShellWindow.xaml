<Window x:Class="Nora.Desktop.Views.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Width="1320" Height="860" MinWidth="980" MinHeight="640" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" Title="{Binding Profile.Name}">
  <!-- Barra de título própria: o Windows continua dono da moldura (arrastar, encaixar, cantos); a faixa de 35 px no topo é a "TitleBar".
       WindowStyle="None" é de propósito: com a moldura padrão a janela maximizada ganha uma borda invisível de 9 px e vaza do monitor (a ShellWindow.TitleBar.cs ajusta o resto). -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="35" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Geometry x:Key="HealthUnitIcon">M 2,21 V 11 H 6 V 4 H 18 V 11 H 22 V 21 Z M 9,21 V 16 H 15 V 21 M 9.5,9.5 H 14.5 M 12,7 V 12</Geometry>
    <Geometry x:Key="SpecialtiesIcon">M 3,3 V 9 A 5,5 0 0 0 13,9 V 3 M 3,3 H 5 M 13,3 H 11 M 8,14 V 16 A 6,6 0 0 0 20,16 V 13 M 20,9 A 2,2 0 1 1 20,13 A 2,2 0 1 1 20,9 Z</Geometry>
    <Geometry x:Key="ReportsIcon">M 5,3 H 15 L 20,8 V 21 H 5 Z M 15,3 V 8 H 20 M 9,17 V 15 M 12.5,17 V 13 M 16,17 V 11</Geometry>
  </Window.Resources>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static views:ChartCommands.Show}" Executed="OnShowChart" />
  </Window.CommandBindings>
  <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid x:Name="ShellLayout" Grid.Row="1">
    <Grid.ColumnDefinitions>
      <!-- Largura mínima e máxima da barra lateral: ver ApplySidebarState (a mínima some enquanto ela está recolhida). -->
      <ColumnDefinition x:Name="SidebarColumn" Width="{Binding SidebarColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="380" />
      <ColumnDefinition Width="{Binding SidebarSplitterWidth}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border x:Name="Sidebar" Background="{DynamicResource SidebarGradientBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
      <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ShowPasswordRequired}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding ShowCompactAccess}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
      <Grid x:Name="SidebarContent" HorizontalAlignment="Left" Width="{Binding SidebarWidth}">
      <DockPanel Margin="12,20,12,16">
        <StackPanel DockPanel.Dock="Top">
          <!-- Marca: o "N" troca com o tema (marinho no claro, branco no escuro). -->
          <Grid Margin="8,0,8,24" ToolTip="NORA: plataforma de acompanhamento do paciente e da rede de saúde." ToolTipService.IsEnabled="{Binding ShowSidebarTips}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Image x:Name="SidebarBrandMark" Source="{DynamicResource BrandMarkImage}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" AutomationProperties.Name="Logotipo NORA" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="NORA" FontWeight="Bold" FontSize="17" /><TextBlock Text="{Binding WorkspaceName}" Foreground="{DynamicResource SecondaryBrush}" FontSize="10" FontWeight="SemiBold" /></StackPanel>
          </Grid>
          <Button Style="{StaticResource NavBackButton}" Command="{Binding MainMenuCommand}" Visibility="{Binding ShowingSubmenu, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8" ToolTip="Volta à lista das áreas principais. A página aberta continua a mesma." ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Voltar ao menu">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBlock Text="Voltar ao menu" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <TextBlock Text="{Binding SidebarHeading}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Margin="12,4,0,10" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="8,8,8,10" />
          <Button Style="{StaticResource NavItemButton}" Command="{Binding NavigateCommand}" CommandParameter="settings" Margin="0,0,0,6" ToolTip="Aparência, atalhos, foto de perfil e preferências deste computador." ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Configurações">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22" VerticalAlignment="Center" /><TextBlock Text="Configurações" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="AvatarButton" Style="{StaticResource AvatarButton}" Click="OnPhotoMenu" Margin="6,0,0,0" IsEnabled="{Binding Workspace.IsAuthenticated}" ToolTip="Foto de perfil: clique para alterar ou remover." ToolTipService.ShowOnDisabled="False" AutomationProperties.Name="Foto de perfil">
              <views:AccountAvatar DataContext="{Binding Workspace}" Size="36" />
            </Button>
            <Button x:Name="AccountButton" Grid.Column="1" Style="{StaticResource NavItemButton}" Click="OnAccountMenu" Padding="8,8" ToolTip="Conta conectada: abra as configurações ou saia." ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Menu da conta NORA">
              <Button.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Style="{StaticResource NoraContextMenu}">
                  <MenuItem Header="Configurações" Command="{Binding NavigateCommand}" CommandParameter="settings" AutomationProperties.Name="Configurações" ToolTip="Abre as configurações do aplicativo."/>
                  <MenuItem Header="Dados do perfil" Click="OnOpenProfile" IsEnabled="{Binding Workspace.IsAuthenticated}" AutomationProperties.Name="Dados do perfil" ToolTip="Mostra e altera o nome da conta."/>
                  <MenuItem Header="Sair da conta" Command="{Binding Workspace.LogoutCommand}" AutomationProperties.Name="Sair da conta" ToolTip="Encerra a sessão desta conta."/>
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Workspace.AccountName}" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Workspace.UnitLabel}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Button>
          </Grid>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="SidebarList" ItemsSource="{Binding SidebarItems}" RenderTransformOrigin="0,0" AutomationProperties.Name="Menu de navegação">
            <ItemsControl.RenderTransform><TranslateTransform x:Name="SidebarSlide" /></ItemsControl.RenderTransform>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource NavItemButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Route}" IsEnabled="{Binding Available}" Margin="0,0,0,4" ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True" ToolTipService.IsEnabled="{Binding DataContext.ShowSidebarTips, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding AutomationName}" Tag="{Binding IsSelected}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid Width="22" VerticalAlignment="Center">
                      <TextBlock x:Name="NavigationGlyph" FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                      <Path x:Name="NavigationVector" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Visibility="{Binding HasBadge, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource BrandBrush}" CornerRadius="10" MinWidth="22" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource BrandTextBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Opacity="0.6" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasChildren, Converter={StaticResource BoolVisibility}}" />
                  </Grid>
                </Button>
                <DataTemplate.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="units" /><Condition Binding="{Binding Sub}" Value="{x:Null}" /></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavigationVector" Property="Data" Value="{StaticResource HealthUnitIcon}" />
                    <Setter TargetName="NavigationVector" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NavigationGlyph" Property="Visibility" Value="Collapsed" />
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="specialties" /><Condition Binding="{Binding Sub}" Value="{x:Null}" /></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavigationVector" Property="Data" Value="{StaticResource SpecialtiesIcon}" />
                    <Setter TargetName="NavigationVector" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NavigationGlyph" Property="Visibility" Value="Collapsed" />
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="reports" /><Condition Binding="{Binding Sub}" Value="{x:Null}" /></MultiDataTrigger.Conditions>
                    <Setter TargetName="NavigationVector" Property="Data" Value="{StaticResource ReportsIcon}" />
                    <Setter TargetName="NavigationVector" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NavigationGlyph" Property="Visibility" Value="Collapsed" />
                  </MultiDataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      </Grid>
    </Border>
    <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Arraste para ajustar a largura da barra lateral.">
      <GridSplitter.Style><Style TargetType="GridSplitter"><Style.Triggers><DataTrigger Binding="{Binding SidebarExpanded}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding ShowPasswordRequired}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding ShowCompactAccess}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></GridSplitter.Style>
    </GridSplitter>
    <Grid x:Name="WorkspaceLayout" Background="{DynamicResource BackgroundGradientBrush}">
      <!-- Troca obrigatória de senha: sem menu lateral, a área principal ocupa a janela inteira. -->
      <Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Style.Triggers><DataTrigger Binding="{Binding ShowPasswordRequired}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /></DataTrigger><DataTrigger Binding="{Binding ShowCompactAccess}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border x:Name="PageHeader" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="32,0,32,0" Height="56">
        <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ShowCompactAccess}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding PageLabel}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="1" Background="{DynamicResource BrandSoftBrush}" CornerRadius="12" Padding="12,6" VerticalAlignment="Center" ToolTip="Unidade ou escopo da conta conectada. O ponto verde indica sessão ativa."><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource SecondaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Workspace.IsAuthenticated}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding Workspace.UnitLabel}" FontSize="11" Foreground="{DynamicResource TextBrush}" /></StackPanel></Border>
          <Button x:Name="FiltersButton" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0,0,0" Padding="14,7"
                  Click="OnOpenFilters" PreviewMouseLeftButtonUp="OnFiltersButtonMouseUp" AutomationProperties.Name="Filtros" ToolTip="Altere os filtros da tela atual.">
            <StackPanel Orientation="Horizontal">
              <Path Data="M 1,1 H 15 L 10,7 V 13 L 6,15 V 7 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0" />
              <TextBlock Text="Filtros" VerticalAlignment="Center" FontWeight="SemiBold" />
              <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="5" Stretch="Fill" VerticalAlignment="Center" Margin="8,0,0,0" RenderTransformOrigin="0.5,0.5">
                <Path.Style><Style TargetType="Path"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0" /></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsOpen, ElementName=FiltersPopup}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Path.Style>
              </Path>
            </StackPanel>
          </Button>
          <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=FiltersButton}" Placement="Bottom" StaysOpen="False" Closed="OnCloseFilters" VerticalOffset="6" AllowsTransparency="True">
            <Border x:Name="FilterPopupBody" Padding="16" Width="450" MaxHeight="440" CornerRadius="12" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" PreviewKeyDown="OnFilterPopupKeyDown" KeyboardNavigation.TabNavigation="Cycle">
              <DockPanel>
                <Button Content="Limpar filtros" DockPanel.Dock="Bottom" HorizontalAlignment="Left" Click="OnClearFilters" Margin="0,10,0,0" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="FilterGroups" />
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Popup>
        </Grid>
      </Border>
      <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" Visibility="{Binding Workspace.ShowProgress, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Operação em andamento" />
      <!-- Faixa comum de retorno: vale para todas as abas dos dois perfis e para Configurações. -->
      <StackPanel Grid.Row="1">
        <Border AutomationProperties.Name="Retorno da ação" Padding="16,12" CornerRadius="12" Margin="32,16,32,0" Visibility="{Binding Workspace.HasMessage, Converter={StaticResource BoolVisibility}}">
          <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#061E3B" /></Border.Effect>
          <Border.Style><Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="success"><Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" /></DataTrigger>
              <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="error"><Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" /></DataTrigger>
            </Style.Triggers></Style></Border.Style>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Workspace.MessageIcon}" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                  <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Workspace.Message}">
              <Run Text="{Binding Workspace.MessageKindLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Workspace.Message, Mode=OneWay}" />
            </TextBlock>
            <Button Grid.Column="2" Style="{StaticResource CircleIconButton}" Content="&#xE711;" Command="{Binding Workspace.DismissMessageCommand}" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Dispensar mensagem" AutomationProperties.Name="Dispensar mensagem" />
          </Grid>
        </Border>
        <Border Margin="32,12,32,0" Padding="16,10" CornerRadius="12" Background="{DynamicResource WarningSurfaceBrush}" AutomationProperties.Name="Aviso de dados desatualizados" Visibility="{Binding Workspace.IsDataStale, Converter={StaticResource BoolVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="{Binding Workspace.StaleLabel}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          </Grid>
        </Border>
      </StackPanel>
      <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,32,32,16"><Grid x:Name="PageContainer" views:SubPage.Current="{Binding SubPage}">
          <Grid.RenderTransform><TranslateTransform x:Name="PageSlide" /></Grid.RenderTransform>
          <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}" />
          <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}" />
          <views:PasswordChangeRequiredView DataContext="{Binding Workspace}" Visibility="{Binding MustChangePassword, Converter={StaticResource BoolVisibility}}" />
        </Grid>
        <!-- Marca d'água discreta dos desenvolvedores, no estilo dos rodapés de softwares conhecidos. -->
        <StackPanel x:Name="Watermark" Style="{StaticResource Watermark}">
          <Image Source="{DynamicResource BrandMarkImage}" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Elaborado por: Luana Pinheiro (luana.pinheiro.cruz@gmail.com) e Mateus Todeschini (mateustodeschini123@gmail.com)" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowCompactAccess, Converter={StaticResource BoolVisibility}}">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
          <ContentControl x:Name="DesktopAccessHost" DataContext="{Binding Workspace}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="3" Background="{DynamicResource BrandSoftBrush}" Padding="24,10" Visibility="{Binding HasPreferenceError, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" />
      </Border>
    </Grid>
  </Grid>
  <!-- Barra de título própria: ferramentas à esquerda (menu, voltar, avançar, pesquisar) e os três botões da janela à direita. O nome do aplicativo não é desenhado (fica em Window.Title). -->
  <Border x:Name="TitleBar" Grid.Row="0" Height="35" Background="{DynamicResource TitleBarBrush}">
    <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding FullScreen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="0" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel x:Name="TitleTools" Orientation="Horizontal" Margin="8,0,0,0" HorizontalAlignment="Left" ClipToBounds="True" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding ShowCompactAccess}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding ShowPasswordRequired}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <Button x:Name="ToggleSidebarButton" Style="{StaticResource TitleBarToolButton}" Command="{Binding ToggleSidebarCommand}" ToolTip="Abrir ou fechar a barra de navegação" AutomationProperties.Name="Abrir ou fechar a barra de navegação">
          <Path Data="M 1.5,1.5 H 12.5 V 12.5 H 1.5 Z M 5.5,1.5 V 12.5" Width="14" Height="14" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" />
        </Button>
        <Button x:Name="NavBackButton" Style="{StaticResource TitleBarToolButton}" Command="{Binding BackCommand}" ToolTip="{Binding BackTip}" AutomationProperties.Name="Voltar para a página anterior">
          <Path Data="M 7.75,3.25 L 3.25,8 L 7.75,12.75 M 3.25,8 L 15.25,8" Width="16" Height="16" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Button>
        <Button x:Name="NavForwardButton" Style="{StaticResource TitleBarToolButton}" Command="{Binding ForwardCommand}" ToolTip="{Binding ForwardTip}" AutomationProperties.Name="Avançar para a próxima página">
          <Path Data="M 8.25,3.25 L 12.75,8 L 8.25,12.75 M 12.75,8 L 0.75,8" Width="16" Height="16" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Button>
        <Button x:Name="TitleSearchButton" Style="{StaticResource TitleBarToolButton}" Click="OnTitleSearch" ToolTip="Pesquisar na tela (Ctrl + F)" AutomationProperties.Name="Pesquisar na tela">
          <Path Data="M 6,1.5 A 4.5,4.5 0 1 1 6,10.5 A 4.5,4.5 0 1 1 6,1.5 Z M 9.4,9.4 L 13,13" Width="14" Height="14" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarWindowButton}" Click="OnMinimizeWindow" ToolTip="Minimizar" AutomationProperties.Name="Minimizar janela">
          <Path Data="M 0,5 H 10" Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
        </Button>
        <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarWindowButton}" Click="OnMaximizeRestoreWindow" ToolTip="Maximizar" AutomationProperties.Name="Maximizar janela">
          <Grid Width="10" Height="10">
            <Path x:Name="MaximizeIcon" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
            <Path x:Name="RestoreIcon" Data="M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z M 2.5,2.5 V 0.5 H 9.5 V 7.5 H 7.5" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Visibility="Collapsed" />
          </Grid>
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" Click="OnCloseWindow" ToolTip="Fechar" AutomationProperties.Name="Fechar janela">
          <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
  <!-- Fundo escurecido enquanto um diálogo da marca está aberto: cobre a janela inteira, inclusive a barra de título. -->
  <Border x:Name="DialogOverlay" Grid.RowSpan="2" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed" IsHitTestVisible="True" />
  </Grid>
</Window>
