<Window x:Class="Nora.Desktop.Views.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" Width="1320" Height="860" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" Title="{Binding Profile.Name}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding SidebarColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="208" MaxWidth="380" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarGradientBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ShowPasswordRequired}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
      <DockPanel Margin="16,24">
        <StackPanel DockPanel.Dock="Top">
          <Border Background="{DynamicResource BrandGradientBrush}" CornerRadius="18" Padding="14" Margin="0,0,0,22">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="38" Height="38" CornerRadius="12" Background="#33FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1"><TextBlock Text="N" Foreground="{DynamicResource BrandTextBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="NORA" Foreground="{DynamicResource BrandTextBrush}" FontWeight="Bold" FontSize="15" /><TextBlock Text="{Binding WorkspaceName}" Foreground="#D9FFFFFF" FontSize="10" FontWeight="SemiBold" /></StackPanel>
            </Grid>
          </Border>
          <TextBlock Text="{Binding NavigationHeading}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Margin="10,0,0,10" />
          <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Navigation}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" IsEnabled="{Binding Available}" HorizontalContentAlignment="Left" BorderThickness="0" Padding="10,12" Margin="0,0,0,6" ToolTipService.ShowOnDisabled="True" ToolTipService.IsEnabled="{Binding DataContext.ShowSidebarTips, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Title}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                      <Setter Property="ToolTip" Value="{Binding Title}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Id}" Value="home"><Setter Property="ToolTip" Value="Abra a visão geral do seu espaço de trabalho." /></DataTrigger>
                        <DataTrigger Binding="{Binding Id}" Value="patients"><Setter Property="ToolTip" Value="Consulte e cadastre pacientes da unidade." /></DataTrigger>
                        <DataTrigger Binding="{Binding Id}" Value="queue"><Setter Property="ToolTip" Value="Acompanhe e organize a fila de Vaga Relâmpago." /></DataTrigger>
                        <DataTrigger Binding="{Binding Id}" Value="agenda"><Setter Property="ToolTip" Value="Consulte a agenda da unidade em formato de calendário." /></DataTrigger>
                        <DataTrigger Binding="{Binding Id}" Value="slots"><Setter Property="ToolTip" Value="Abra e acompanhe vagas oferecidas aos pacientes." /></DataTrigger>
                        <DataTrigger Binding="{Binding Id}" Value="indicators"><Setter Property="ToolTip" Value="Consulte os indicadores agregados da rede." /></DataTrigger>
                        <DataTrigger Binding="{Binding Id}" Value="alerts"><Setter Property="ToolTip" Value="Acompanhe alertas operacionais da unidade." /></DataTrigger>
                        <DataTrigger Binding="{Binding Available}" Value="False"><Setter Property="ToolTip" Value="Esta área aguarda a definição das próximas funcionalidades." /></DataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="home" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="home" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="patients" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="patients" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="queue" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="queue" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="slots" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="slots" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="agenda" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="agenda" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="indicators" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="indicators" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="alerts" />
                            <Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="alerts" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="units" /><Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="units" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" /></MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="specialties" /><Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="specialties" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" /></MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="network" /><Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="network" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" /></MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="capacity" /><Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="capacity" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" /></MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="reports" /><Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="reports" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" /></MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="communication" /><Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="communication" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" /></MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Id}" Value="users" /><Condition Binding="{Binding DataContext.Page, RelativeSource={RelativeSource AncestorType=Window}}" Value="users" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" /></MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" FontSize="18" Width="24" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" Margin="10,0,0,0" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl></ScrollViewer>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button Command="{Binding NavigateCommand}" CommandParameter="settings" HorizontalContentAlignment="Left" BorderThickness="0" Padding="10,12" Margin="0,0,0,8" ToolTip="Abra as configurações do software." ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Configurações">
            <StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="24" VerticalAlignment="Center" /><TextBlock Text="Configurações" Margin="10,0,0,0" /></StackPanel>
          </Button>
          <Button x:Name="AccountButton" Click="OnAccountMenu" HorizontalContentAlignment="Left" BorderThickness="0" Padding="6,12" ToolTip="Abra as configurações ou saia da conta." ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Menu da conta NORA">
            <Button.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
                <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="5"><ItemsPresenter /></Border></ControlTemplate></ContextMenu.Template>
                <ContextMenu.Resources><Style TargetType="MenuItem">
                  <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Padding" Value="14,10" /><Setter Property="MinWidth" Value="180" />
                  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Frame" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True" /></Border><ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource BrandSoftBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45" /></Trigger>
                  </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                </Style></ContextMenu.Resources>
                <MenuItem Header="Configurações" Command="{Binding NavigateCommand}" CommandParameter="settings" AutomationProperties.Name="Configurações" />
                <MenuItem Header="Sair da conta" Command="{Binding Workspace.LogoutCommand}" AutomationProperties.Name="Sair da conta" />
              </ContextMenu>
            </Button.ContextMenu>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource BrandBrush}"><TextBlock Text="{Binding Workspace.AccountInitials}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrandTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Workspace.AccountName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Workspace.UnitLabel}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Grid>
          </Button>
        </StackPanel>
        <Grid />
      </DockPanel>
    </Border>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Arraste para ajustar a largura da barra lateral.">
      <GridSplitter.Style><Style TargetType="GridSplitter"><Style.Triggers><DataTrigger Binding="{Binding ShowPasswordRequired}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></GridSplitter.Style>
    </GridSplitter>
    <Grid Background="{DynamicResource BackgroundGradientBrush}">
      <!-- Troca obrigatória de senha: sem menu lateral, a área principal ocupa a janela inteira. -->
      <Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Style.Triggers><DataTrigger Binding="{Binding ShowPasswordRequired}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource SidebarGradientBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,0" Height="78">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding PageLabel}" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="{Binding SectionSummary}" Style="{StaticResource Muted}" FontSize="11" /></StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource BrandSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource SecondaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Workspace.IsAuthenticated}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding Workspace.UnitLabel}" FontSize="11" Foreground="{DynamicResource TextBrush}" /></StackPanel></Border>
        </Grid>
      </Border>
      <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" Visibility="{Binding Workspace.ShowProgress, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Operação em andamento" />
      <!-- Faixa comum de retorno: vale para todas as abas dos dois perfis e para Configurações. -->
      <StackPanel Grid.Row="1">
        <Border AutomationProperties.Name="Retorno da ação" Padding="14,10" CornerRadius="10" BorderThickness="1" Margin="32,16,32,0" Visibility="{Binding Workspace.HasMessage, Converter={StaticResource BoolVisibility}}">
          <Border.Style><Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="success"><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
              <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="error"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
            </Style.Triggers></Style></Border.Style>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Workspace.MessageIcon}" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                  <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Workspace.Message}">
              <Run Text="{Binding Workspace.MessageKindLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Workspace.Message, Mode=OneWay}" />
            </TextBlock>
            <Button Grid.Column="2" Content="×" Command="{Binding Workspace.DismissMessageCommand}" FontSize="18" MinWidth="32" MinHeight="32" Padding="6,0" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Dispensar mensagem" AutomationProperties.Name="Dispensar mensagem" />
          </Grid>
        </Border>
        <Border Margin="32,10,32,0" Padding="14,8" CornerRadius="10" BorderThickness="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource WarningBrush}" AutomationProperties.Name="Aviso de dados desatualizados" Visibility="{Binding Workspace.IsDataStale, Converter={StaticResource BoolVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="{Binding Workspace.StaleLabel}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          </Grid>
        </Border>
      </StackPanel>
      <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PageContainer" Margin="32,32,32,24">
          <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}" />
          <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}" />
          <views:PasswordChangeRequiredView DataContext="{Binding Workspace}" Visibility="{Binding MustChangePassword, Converter={StaticResource BoolVisibility}}" />
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="3" Background="{DynamicResource BrandSoftBrush}" Padding="24,10" Visibility="{Binding HasPreferenceError, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" />
      </Border>
    </Grid>
  </Grid>
</Window>
