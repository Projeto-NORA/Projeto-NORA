<Window x:Class="Nora.Desktop.Views.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" Width="1320" Height="860" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" Title="{Binding Profile.Name}">
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static views:ChartCommands.Show}" Executed="OnShowChart" />
  </Window.CommandBindings>
  <Grid>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding SidebarColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="208" MaxWidth="380" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarGradientBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding ShowPasswordRequired}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
      <DockPanel Margin="12,20,12,16">
        <StackPanel DockPanel.Dock="Top">
          <!-- Marca: o "N" troca com o tema (marinho no claro, branco no escuro). -->
          <Grid Margin="8,0,8,24" ToolTip="NORA: plataforma de acompanhamento do paciente e da rede de saúde." ToolTipService.IsEnabled="{Binding ShowSidebarTips}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Image x:Name="SidebarBrandMark" Source="{DynamicResource BrandMarkImage}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" AutomationProperties.Name="Logotipo NORA" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="NORA" FontWeight="Bold" FontSize="17" /><TextBlock Text="{Binding WorkspaceName}" Foreground="{DynamicResource SecondaryBrush}" FontSize="10" FontWeight="SemiBold" /></StackPanel>
          </Grid>
          <Button Style="{StaticResource NavBackButton}" Command="{Binding MainMenuCommand}" Visibility="{Binding ShowingSubmenu, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8" ToolTip="Volta à lista das áreas principais. A página aberta continua a mesma." ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Voltar ao menu">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBlock Text="Voltar ao menu" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <TextBlock Text="{Binding SidebarHeading}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Margin="12,4,0,10" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="8,8,8,10" />
          <Button Style="{StaticResource NavItemButton}" Command="{Binding NavigateCommand}" CommandParameter="settings" Margin="0,0,0,6" ToolTip="Aparência, atalhos, foto de perfil e preferências deste computador." ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Configurações">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="22" VerticalAlignment="Center" /><TextBlock Text="Configurações" Margin="10,0,0,0" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button x:Name="AvatarButton" Style="{StaticResource AvatarButton}" Click="OnPhotoMenu" Margin="6,0,0,0" IsEnabled="{Binding Workspace.IsAuthenticated}" ToolTip="Foto de perfil: clique para alterar ou remover." ToolTipService.ShowOnDisabled="False" AutomationProperties.Name="Foto de perfil">
              <views:AccountAvatar DataContext="{Binding Workspace}" Size="36" />
            </Button>
            <Button x:Name="AccountButton" Grid.Column="1" Style="{StaticResource NavItemButton}" Click="OnAccountMenu" Padding="8,8" ToolTip="Conta conectada: abra as configurações ou saia." ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Menu da conta NORA">
              <Button.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Style="{StaticResource NoraContextMenu}">
                  <MenuItem Header="Configurações" Command="{Binding NavigateCommand}" CommandParameter="settings" AutomationProperties.Name="Configurações" ToolTip="Abre as configurações do aplicativo."/>
                  <MenuItem Header="Sair da conta" Command="{Binding Workspace.LogoutCommand}" AutomationProperties.Name="Sair da conta" ToolTip="Encerra a sessão desta conta."/>
                </ContextMenu>
              </Button.ContextMenu>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Workspace.AccountName}" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Workspace.UnitLabel}" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Button>
          </Grid>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="SidebarList" ItemsSource="{Binding SidebarItems}" RenderTransformOrigin="0,0" AutomationProperties.Name="Menu de navegação">
            <ItemsControl.RenderTransform><TranslateTransform x:Name="SidebarSlide" /></ItemsControl.RenderTransform>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource NavItemButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Route}" IsEnabled="{Binding Available}" Margin="0,0,0,4" ToolTip="{Binding Tip}" ToolTipService.ShowOnDisabled="True" ToolTipService.IsEnabled="{Binding DataContext.ShowSidebarTips, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding AutomationName}" Tag="{Binding IsSelected}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" FontSize="16" Width="22" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="2" Visibility="{Binding HasBadge, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource BrandBrush}" CornerRadius="10" MinWidth="22" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource BrandTextBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" /></Border>
                    <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Opacity="0.6" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasChildren, Converter={StaticResource BoolVisibility}}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Arraste para ajustar a largura da barra lateral.">
      <GridSplitter.Style><Style TargetType="GridSplitter"><Style.Triggers><DataTrigger Binding="{Binding ShowPasswordRequired}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></GridSplitter.Style>
    </GridSplitter>
    <Grid Background="{DynamicResource BackgroundGradientBrush}">
      <!-- Troca obrigatória de senha: sem menu lateral, a área principal ocupa a janela inteira. -->
      <Grid.Style><Style TargetType="Grid"><Setter Property="Grid.Column" Value="2" /><Style.Triggers><DataTrigger Binding="{Binding ShowPasswordRequired}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="3" /></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,0,32,0" Height="56">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <!-- Seta de voltar: volta para a página anterior da pilha de histórico (Alt + seta para a esquerda). -->
          <Button x:Name="BackButton" Style="{StaticResource CircleIconButton}" Command="{Binding BackCommand}" Content="&#xE72B;" Margin="0,0,12,0" ToolTip="{Binding BackTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Voltar para a página anterior" />
          <TextBlock Grid.Column="1" Text="{Binding PageLabel}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="2" Background="{DynamicResource BrandSoftBrush}" CornerRadius="12" Padding="12,6" VerticalAlignment="Center" ToolTip="Unidade ou escopo da conta conectada. O ponto verde indica sessão ativa."><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource SecondaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Workspace.IsAuthenticated}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding Workspace.UnitLabel}" FontSize="11" Foreground="{DynamicResource TextBrush}" /></StackPanel></Border>
        </Grid>
      </Border>
      <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3" VerticalAlignment="Bottom" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" Visibility="{Binding Workspace.ShowProgress, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Operação em andamento" />
      <!-- Faixa comum de retorno: vale para todas as abas dos dois perfis e para Configurações. -->
      <StackPanel Grid.Row="1">
        <Border AutomationProperties.Name="Retorno da ação" Padding="16,12" CornerRadius="12" Margin="32,16,32,0" Visibility="{Binding Workspace.HasMessage, Converter={StaticResource BoolVisibility}}">
          <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.08" Color="#061E3B" /></Border.Effect>
          <Border.Style><Style TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InfoSurfaceBrush}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="success"><Setter Property="Background" Value="{DynamicResource SuccessSurfaceBrush}" /></DataTrigger>
              <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="error"><Setter Property="Background" Value="{DynamicResource ErrorSurfaceBrush}" /></DataTrigger>
            </Style.Triggers></Style></Border.Style>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Workspace.MessageIcon}" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="success"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
                  <DataTrigger Binding="{Binding Workspace.MessageKindName}" Value="error"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Workspace.Message}">
              <Run Text="{Binding Workspace.MessageKindLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Workspace.Message, Mode=OneWay}" />
            </TextBlock>
            <Button Grid.Column="2" Style="{StaticResource CircleIconButton}" Content="&#xE711;" Command="{Binding Workspace.DismissMessageCommand}" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Dispensar mensagem" AutomationProperties.Name="Dispensar mensagem" />
          </Grid>
        </Border>
        <Border Margin="32,12,32,0" Padding="16,10" CornerRadius="12" Background="{DynamicResource WarningSurfaceBrush}" AutomationProperties.Name="Aviso de dados desatualizados" Visibility="{Binding Workspace.IsDataStale, Converter={StaticResource BoolVisibility}}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="{Binding Workspace.StaleLabel}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          </Grid>
        </Border>
      </StackPanel>
      <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,32,32,16"><Grid x:Name="PageContainer" views:SubPage.Current="{Binding SubPage}">
          <Grid.RenderTransform><TranslateTransform x:Name="PageSlide" /></Grid.RenderTransform>
          <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}" />
          <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}" />
          <views:PasswordChangeRequiredView DataContext="{Binding Workspace}" Visibility="{Binding MustChangePassword, Converter={StaticResource BoolVisibility}}" />
        </Grid>
        <!-- Marca d'água discreta dos desenvolvedores, no estilo dos rodapés de softwares conhecidos. -->
        <StackPanel x:Name="Watermark" Style="{StaticResource Watermark}">
          <Image Source="{DynamicResource BrandMarkImage}" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="Elaborado por: Luana Pinheiro (luana.pinheiro.cruz@gmail.com) e Mateus Todeschini (mateustodeschini123@gmail.com)" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="3" Background="{DynamicResource BrandSoftBrush}" Padding="24,10" Visibility="{Binding HasPreferenceError, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite" />
      </Border>
    </Grid>
  </Grid>
  <!-- Fundo escurecido enquanto um diálogo da marca está aberto. -->
  <Border x:Name="DialogOverlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed" IsHitTestVisible="True" />
  </Grid>
</Window>
