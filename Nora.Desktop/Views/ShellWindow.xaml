<Window x:Class="Nora.Desktop.Views.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" Width="1320" Height="860" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" Title="{Binding Profile.Name}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Width="{Binding SidebarWidth}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,24">
        <StackPanel DockPanel.Dock="Top">
          <Grid Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="48" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource BrandBrush}">
              <TextBlock Text="N" FontSize="25" FontWeight="Bold" Foreground="{DynamicResource BrandTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}">
              <TextBlock Text="NORA" FontSize="23" FontWeight="Bold" />
              <TextBlock Text="{Binding WorkspaceName}" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="ESPAÇO DE TRABALHO" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Margin="10,0,0,14" Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}" />
          <ItemsControl ItemsSource="{Binding Navigation}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" IsEnabled="{Binding Available}" HorizontalContentAlignment="Left" BorderThickness="0" Padding="10,12" Margin="0,0,0,6" ToolTip="{Binding Title}" ToolTipService.ShowOnDisabled="True" ToolTipService.IsEnabled="{Binding DataContext.ShowSidebarTips, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Title}">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                      <Style.Triggers>
                        <MultiDataTrigger>
                          <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Id}" Value="home" />
                            <Condition Binding="{Binding DataContext.IsHome, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                          </MultiDataTrigger.Conditions>
                          <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                        </MultiDataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Icon}" FontSize="18" Width="24" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}" Margin="10,0,0,0" Visibility="{Binding DataContext.SidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVisibility}}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,18" Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}">
            <StackPanel>
              <TextBlock Text="Em construção, com propósito." FontWeight="SemiBold" FontSize="13" />
              <TextBlock Text="A base da sua plataforma de cuidado." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
            </StackPanel>
          </Border>
          <Button Command="{Binding NavigateCommand}" CommandParameter="settings" HorizontalContentAlignment="Left" Margin="0,0,0,8" BorderThickness="0" ToolTip="Configurações · Ctrl+," ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Configurações">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSettings}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Width="22" />
              <TextBlock Text="Configurações" Margin="8,0,0,0" Visibility="{Binding SidebarExpanded, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>
          </Button>
          <Button Command="{Binding ToggleSidebarCommand}" ToolTip="Alternar barra lateral · Ctrl+B" ToolTipService.IsEnabled="{Binding ShowSidebarTips}" AutomationProperties.Name="Alternar barra lateral">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
          </Button>
        </StackPanel>
        <Grid />
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="72" />
        <RowDefinition Height="*" />
        <RowDefinition Height="34" />
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,0">
        <Grid>
          <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="15" Padding="12,7">
              <TextBlock Text="Integração pendente" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" />
            </Border>
            <TextBlock Text="{Binding Profile.Name}" FontWeight="SemiBold" Margin="18,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PageContainer" Margin="32,32,32,24">
          <views:HomeView Visibility="{Binding IsHome, Converter={StaticResource BoolVisibility}}" />
          <views:SettingsView Visibility="{Binding IsSettings, Converter={StaticResource BoolVisibility}}" />
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,7">
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </Border>
    </Grid>
  </Grid>
</Window>