<UserControl x:Class="Nora.Desktop.Views.StaffAccountsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Margin="0,0,0,18">
    <StackPanel IsEnabled="{Binding CanOperate}">
      <TextBlock Text="Contas do OBS" FontSize="19" FontWeight="SemiBold" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,12" Text="Contas criadas ou redefinidas aqui usam senha provisória, trocada no primeiro acesso." />
      <WrapPanel Margin="0,0,0,12">
        <Button Content="Atualizar contas e UBS" Click="OnLoad" Margin="0,0,8,8" />
        <Button Content="{Binding StaffActiveActionLabel}" Style="{StaticResource DeactivateButton}" Tag="{Binding SelectedStaff.IsActive}" Click="OnChangeActive" IsEnabled="{Binding CanChangeStaffActive}" Margin="0,0,8,8" ToolTip="Desativar encerra as sessões da conta e preserva as concessões de UBS." />
      </WrapPanel>
      <DataGrid ItemsSource="{Binding Staff}" SelectedItem="{Binding SelectedStaff}" MaxHeight="300" MinHeight="64" CanUserSortColumns="True" AutomationProperties.Name="Contas OBS">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Nome" Binding="{Binding FullName}" Width="*" MinWidth="150" />
          <DataGridTextColumn Header="Perfil" Binding="{Binding RoleDisplay}" Width="130" />
          <DataGridTextColumn Header="E-mail" Binding="{Binding EmailDisplay}" Width="*" MinWidth="150" />
          <DataGridTextColumn Header="Situação" Binding="{Binding StatusDisplay}" Width="110" />
          <DataGridTextColumn Header="Troca de senha pendente" Binding="{Binding PendingDisplay}" Width="190" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding StaffState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding StaffState, Converter={StaticResource TextVisibility}}" />
      <TextBlock Text="{Binding SelectedStaffLabel}" FontWeight="SemiBold" Margin="0,10,0,12" />
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" /><Style.Triggers><DataTrigger Binding="{Binding SelectedStaff}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <StackPanel MaxWidth="460" HorizontalAlignment="Left">
          <TextBlock Text="Redefinir senha provisória da conta selecionada" FontWeight="SemiBold" />
          <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" Text="As sessões da conta são encerradas e a troca será exigida no próximo acesso." />
          <TextBlock Text="Nova senha provisória (8 a 256 caracteres)" FontWeight="SemiBold" FontSize="12" />
          <PasswordBox x:Name="ResetPassword" Margin="0,6,0,12" AutomationProperties.Name="Nova senha provisória da conta" />
          <TextBlock Text="{Binding StaffResetPasswordError}" Style="{StaticResource FieldError}" Visibility="{Binding StaffResetPasswordError, Converter={StaticResource TextVisibility}}" />
          <TextBlock Text="Confirmar a senha provisória" FontWeight="SemiBold" FontSize="12" />
          <PasswordBox x:Name="ResetConfirm" Margin="0,6,0,12" AutomationProperties.Name="Confirmação da senha provisória da conta" />
          <TextBlock Text="{Binding StaffResetConfirmError}" Style="{StaticResource FieldError}" Visibility="{Binding StaffResetConfirmError, Converter={StaticResource TextVisibility}}" />
          <Button Content="Redefinir senha provisória" Click="OnReset" IsEnabled="{Binding CanResetStaffPassword}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
