<UserControl x:Class="Nora.Desktop.Views.StaffAccountsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Contas do OBS (atendentes e administradores das UBS): listagem aberta. Senhas criadas ou redefinidas aqui são provisórias e exigem troca no primeiro acesso. A conta nova e a redefinição de senha são pop-ups. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <views:PageFilterGroup Label="Contas OBS" SearchFields="FullName,EmailDisplay,RoleDisplay,StatusDisplay,UnitsDisplay" ItemsTarget="{Binding ElementName=StaffList}" />
      <views:PageActions>
        <Button Style="{StaticResource NewItemButton}" Content="Nova conta" Click="OnNew" AutomationProperties.Name="Nova conta" ToolTip="Cria uma conta de equipe: nome, e-mail, perfil e senha provisória, sem CPF. Depois, conceda as UBS que ela operará." />
      </views:PageActions>
    </StackPanel>
    <Grid Grid.Row="1">
      <ListBox x:Name="StaffList" Style="{StaticResource OpenList}" ItemsSource="{Binding Staff}" AutomationProperties.Name="Contas OBS"
               views:ListingBehavior.Balloon="{Binding ElementName=Balloon}" views:ListingBehavior.LabelPath="FullName" views:ListingBehavior.PluralName="contas" views:ListingBehavior.Feminine="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid AutomationProperties.Name="{Binding SelectorLabel}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding FullName}" Style="{StaticResource ItemTitleText}" />
                <TextBlock Text="{Binding MetaLine}" Style="{StaticResource ItemMetaText}" />
              </StackPanel>
              <views:StatusTag Grid.Column="1" Text="{Binding TagText}" Tone="{Binding StatusTone}" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <views:ListEmptyText List="{Binding ElementName=StaffList}" EmptyText="{Binding StaffState}" NoMatchText="Nenhuma conta encontrada para esta busca." Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="4,8" />
      <views:SelectionBalloon x:Name="Balloon">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="ResetButton" Style="{StaticResource ListActionEditButton}" views:SelectionBalloon.SingleItemOnly="True" Content="Redefinir senha provisória" Click="OnReset" ToolTip="Define uma nova senha provisória para a conta; as sessões dela são encerradas." />
          <Button x:Name="ReactivateButton" Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconRestoreGeometry}" Content="Reativar" Click="OnReactivate" ToolTip="Reativa as contas desativadas selecionadas; as concessões de UBS preservadas voltam a valer." />
          <Button x:Name="DeactivateButton" Style="{StaticResource ListActionDangerButton}" Content="Desativar" Click="OnDeactivate" ToolTip="Desativa as contas ativas selecionadas: encerra as sessões e preserva as concessões de UBS (pede confirmação)." AutomationProperties.Name="Desativar conta" />
        </StackPanel>
      </views:SelectionBalloon>
    </Grid>
  </Grid>
</UserControl>
