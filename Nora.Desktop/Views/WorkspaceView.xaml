<UserControl x:Class="Nora.Desktop.Views.WorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <UserControl.Resources>
    <views:HalfWidthConverter x:Key="HalfWidth" />
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Margin" Value="0,6,0,16" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Margin" Value="0,6,0,16" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="{Binding IsSignedOut, Converter={StaticResource BoolVisibility}}">
      <StackPanel MaxWidth="520" HorizontalAlignment="Left" Width="520" IsEnabled="{Binding CanLogin}">
        <TextBlock Text="Entre no seu espaço de trabalho" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock Text="Use CPF ou e-mail. Suas preferências continuam disponíveis em Configurações." Style="{StaticResource Muted}" Margin="0,0,0,20" />
        <TextBlock Text="Endereço da API" />
        <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Endereço da API" />
        <TextBlock Text="CPF ou e-mail" />
        <TextBox x:Name="IdentifierInput" Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="CPF ou e-mail" />
        <TextBlock Text="Senha" />
        <PasswordBox x:Name="LoginPassword" AutomationProperties.Name="Senha de acesso" KeyDown="OnLoginKeyDown" />
        <Button Content="Entrar" Click="OnLogin" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" ToolTip="Entre para acessar os dados da sua unidade." />
      </StackPanel>
    </Border>
    <Border Background="{DynamicResource BrandSoftBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,24" Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}">
      <StackPanel>
        <TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" />
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" />
      </StackPanel>
    </Border>
    <StackPanel Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisibility}}">
      <Border Margin="0,0,0,24" Visibility="{Binding ShowPatients, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
          <TextBlock Text="Pacientes" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource BrandBrush}" Margin="0,0,0,22" />
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Text="Pesquisar paciente" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding PatientSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar pacientes" Margin="0,6,0,0" Background="{DynamicResource SurfaceBrush}" ToolTip="Pesquise pelo nome, CPF, e-mail ou telefone." /></StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Presença" FontWeight="SemiBold" FontSize="12" /><ComboBox SelectedValue="{Binding PatientPresenceFilter}" SelectedValuePath="Content" Margin="0,6,0,0" AutomationProperties.Name="Filtrar presença do paciente" ToolTip="Mostre todos os pacientes ou filtre por presença no APPNORA."><ComboBoxItem Content="Todos" /><ComboBoxItem Content="Online" /><ComboBoxItem Content="Offline" /></ComboBox></StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Status da conta" FontWeight="SemiBold" FontSize="12" /><ComboBox SelectedValue="{Binding PatientStatusFilter}" SelectedValuePath="Content" Margin="0,6,0,0" AutomationProperties.Name="Filtrar status da conta do paciente" ToolTip="Encontre contas ativas ou desativadas, independentemente da presença no APPNORA."><ComboBoxItem Content="Todos" /><ComboBoxItem Content="Ativos" /><ComboBoxItem Content="Desativados" /></ComboBox></StackPanel>
            <StackPanel Grid.Column="3"><TextBlock Text="Ordenar por" FontWeight="SemiBold" FontSize="12" /><ComboBox SelectedValue="{Binding PatientSort}" SelectedValuePath="Content" Margin="0,6,0,0" AutomationProperties.Name="Ordenar pacientes" ToolTip="Escolha a ordem da listagem de pacientes."><ComboBoxItem Content="Mais recentes" /><ComboBoxItem Content="Nome A–Z" /><ComboBoxItem Content="Nome Z–A" /></ComboBox></StackPanel>
          </Grid>
          <DataGrid x:Name="PatientList" ItemsSource="{Binding FilteredPatients}" SelectedItem="{Binding SelectedPatient}" MaxHeight="460" MinHeight="64" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="None" BorderThickness="0" RowHeight="NaN" MinRowHeight="64" AlternatingRowBackground="{DynamicResource PatientAlternateBrush}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" CanUserResizeColumns="False" AutomationProperties.Name="Pacientes cadastrados" SelectionChanged="OnListSelectionChanged" PreviewMouseLeftButtonDown="OnListPointerSelection" MouseDoubleClick="OnListDoubleClick" PreviewKeyDown="OnListKeyDown">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="*">
                <DataGridTemplateColumn.CellTemplate><DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding PresenceDisplay}">
                          <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource SecondaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullName}" />
                      </Grid>
                      <Grid x:Name="ContactLine" Margin="16,5,12,0">
                        <WrapPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Email}" MaxWidth="{Binding ActualWidth, ElementName=ContactLine, Converter={StaticResource HalfWidth}}" HorizontalAlignment="Left" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" ToolTip="{Binding Email}" Margin="0,0,6,0" />
                          <StackPanel Orientation="Horizontal"><TextBlock Text=" | CPF: " Foreground="{DynamicResource SecondaryBrush}" FontSize="12" TextWrapping="NoWrap" /><TextBlock Text="{Binding FormattedCpf}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" TextWrapping="NoWrap" /><TextBlock Text=" | " Foreground="{DynamicResource SecondaryBrush}" FontSize="12" TextWrapping="NoWrap" /><TextBlock Text="{Binding PhoneDisplay}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" TextWrapping="NoWrap" /></StackPanel>
                        </WrapPanel>
                      </Grid>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding PresenceDisplay}" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="18,0,0,0" ToolTip="A presença indica atividade recente do paciente no APPNORA." />
                  </Grid>
                </DataTemplate></DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Nenhum paciente cadastrado." Style="{StaticResource Muted}" Margin="0,14" Visibility="{Binding HasNoPatients, Converter={StaticResource BoolVisibility}}" />
          <TextBlock Text="Nenhum paciente encontrado para esta pesquisa." Style="{StaticResource Muted}" Margin="0,14" Visibility="{Binding HasNoPatientResults, Converter={StaticResource BoolVisibility}}" />
          <Expander Header="Cadastrar paciente" IsExpanded="False" Margin="0,20,0,0" ToolTip="Cadastre um paciente para acessar o APPNORA." AutomationProperties.Name="Abrir cadastro de paciente">
            <StackPanel Margin="0,16,0,0" IsEnabled="{Binding CanEditDraft}">
              <TextBlock Text="Nome completo" />
              <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nome completo do paciente" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0"><TextBlock Text="CPF" /><TextBox Text="{Binding Cpf, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="CPF do paciente" /></StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="E-mail" /><TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail do paciente" /></StackPanel>
              </Grid>
              <TextBlock Text="Telefone (opcional)" />
              <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Telefone do paciente" ToolTip="Informe DDD e número de telefone, se disponível." />
              <TextBlock Text="Senha inicial · 8 a 256 caracteres" />
              <PasswordBox x:Name="PatientPassword" AutomationProperties.Name="Senha inicial do paciente" />
              <Button Content="Cadastrar paciente" Click="OnRegisterPatient" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" IsEnabled="{Binding CanOperate}" ToolTip="Salve o cadastro e permita o acesso do paciente ao APPNORA." />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="{Binding ShowQueue, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
          <TextBlock Text="Fila de Vaga Relâmpago" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="A ordem é a de entrada. Cada oferta tem 10 minutos para resposta; recusa ou expiração passa ao próximo." Style="{StaticResource Muted}" Margin="0,8,0,16" />
          <TextBlock Text="Paciente para incluir na fila" FontSize="12" FontWeight="SemiBold" />
          <DockPanel Margin="0,6,0,20">
            <Button Content="Incluir selecionado na fila" Command="{Binding EnqueueCommand}" DockPanel.Dock="Right" Margin="12,0,0,0" ToolTip="Inclua o paciente na fila. A ordem de atendimento das ofertas é a de entrada." />
            <ComboBox ItemsSource="{Binding Patients}" SelectedItem="{Binding SelectedPatient}" DisplayMemberPath="FullName" AutomationProperties.Name="Paciente para incluir na fila" ToolTip="Escolha o paciente que deseja incluir na fila de Vaga Relâmpago." />
          </DockPanel>
          <DataGrid ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedQueue}" MaxHeight="300" MinHeight="64" RowHeight="NaN" MinRowHeight="64" HeadersVisibility="None" SelectionMode="Single" SelectionUnit="FullRow" AutomationProperties.Name="Fila de Vaga Relâmpago" SelectionChanged="OnListSelectionChanged" PreviewMouseLeftButtonDown="OnListPointerSelection" MouseDoubleClick="OnListDoubleClick" PreviewKeyDown="OnListKeyDown">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding PatientName}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding PatientName}" /><TextBlock Text="{Binding EnteredAtDisplay, StringFormat='Entrada: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,0" /><TextBlock Text="{Binding StatusDisplay}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" /></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding PresenceDisplay}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="18,0,0,0" />
              </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Nenhuma entrada na fila." Style="{StaticResource Muted}" Margin="0,14" Visibility="{Binding HasNoQueue, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,24" Visibility="{Binding ShowSlots, Converter={StaticResource BoolVisibility}}">
        <StackPanel>
          <TextBlock Text="Vagas Relâmpago" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Descreva a oportunidade. O servidor oferece a vaga ao próximo paciente da fila." Style="{StaticResource Muted}" Margin="0,8,0,16" />
          <StackPanel IsEnabled="{Binding CanEditDraft}">
            <TextBlock Text="Descrição da vaga" />
            <TextBox Text="{Binding SlotLabel, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Descrição da vaga" />
            <Button Content="Abrir vaga" Command="{Binding CreateSlotCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,20" ToolTip="Ofereça esta vaga ao próximo paciente da fila." />
          </StackPanel>
          <DataGrid ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}" MaxHeight="280" MinHeight="64" RowHeight="NaN" MinRowHeight="64" HeadersVisibility="None" AutomationProperties.Name="Vagas abertas" SelectionChanged="OnListSelectionChanged" PreviewMouseLeftButtonDown="OnListPointerSelection" MouseDoubleClick="OnListDoubleClick" PreviewKeyDown="OnListKeyDown">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" /><TextBlock Text="{Binding CreatedAtDisplay, StringFormat='Criada em: {0}'}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,5,0,0" /></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" Margin="18,0,0,0" />
              </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Nenhuma vaga cadastrada." Style="{StaticResource Muted}" Margin="0,14" Visibility="{Binding HasNoSlots, Converter={StaticResource BoolVisibility}}" />
        </StackPanel>
      </Border>
      <StackPanel Visibility="{Binding IsMunicipal, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="Indicadores agregados" FontSize="26" FontWeight="SemiBold" />
        <TextBlock Text="Totais fornecidos pela API, sem identificação de pacientes." Style="{StaticResource Muted}" Margin="0,8,0,20" />
        <UniformGrid Columns="2">
          <Border Style="{StaticResource Card}" Margin="0,0,8,16"><StackPanel><TextBlock Text="Pacientes cadastrados" /><TextBlock Text="{Binding PatientCount}" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="8,0,0,16"><StackPanel><TextBlock Text="Pacientes aguardando" /><TextBlock Text="{Binding WaitingCount}" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16"><StackPanel><TextBlock Text="Vagas abertas" /><TextBlock Text="{Binding SlotCount}" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="8,0,0,16"><StackPanel><TextBlock Text="Ofertas aceitas" /><TextBlock Text="{Binding AcceptedCount}" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel></Border>
        </UniformGrid>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
