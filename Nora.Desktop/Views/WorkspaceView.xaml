<UserControl x:Class="Nora.Desktop.Views.WorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <UserControl.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Margin" Value="0,6,0,16" />
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
      <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Margin" Value="0,6,0,16" />
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24" MaxWidth="480" HorizontalAlignment="Center" Visibility="{Binding IsSignedOut, Converter={StaticResource BoolVisibility}}">
      <StackPanel>
      <StackPanel IsEnabled="{Binding CanLogin}">
        <TextBlock Text="Entre no seu espaço de trabalho" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock Text="Use o e-mail e a senha da sua conta; no primeiro acesso, a senha provisória." Style="{StaticResource Muted}" Margin="0,0,0,20" />
        <TextBlock Text="E-mail" />
        <TextBox x:Name="IdentifierInput" Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="E-mail" />
        <TextBlock Text="Senha" />
        <PasswordBox x:Name="LoginPassword" AutomationProperties.Name="Senha de acesso" KeyDown="OnLoginKeyDown" />
        <Expander x:Name="ServerExpander" Header="Servidor (avançado)" Margin="0,0,0,14" AutomationProperties.Name="Servidor, configuração avançada">
          <StackPanel Margin="0,8,0,0">
            <TextBlock Text="Endereço do servidor" />
            <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Endereço do servidor" />
          </StackPanel>
        </Expander>
        <!-- Computador do OBS (P-014): só aparece no OBS. A atendente precisa de computador ativado; o administrador entra normalmente. -->
        <StackPanel Visibility="{Binding HasDeviceSupport, Converter={StaticResource BoolVisibility}}">
          <Border Background="{DynamicResource BrandSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14" AutomationProperties.Name="Situação deste computador">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,2,10,0" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Text="{Binding DeviceStateLabel}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Grid>
          </Border>
          <CheckBox x:Name="KeepSignedInBox" HorizontalAlignment="Left" Content="Manter conectado neste computador" IsChecked="{Binding KeepSignedIn, Mode=TwoWay}" IsEnabled="{Binding DeviceActivated}" Margin="0,0,0,14" AutomationProperties.Name="Manter conectado neste computador" ToolTip="Disponível só em computador ativado. A sessão fica guardada com a proteção do seu usuário do Windows." ToolTipService.ShowOnDisabled="True" />
          <StackPanel Visibility="{Binding ShowActivation, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8">
            <TextBlock Text="Código de ativação" />
            <TextBox x:Name="ActivationInput" Text="{Binding ActivationCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" CharacterCasing="Upper" AutomationProperties.Name="Código de ativação do computador" ToolTip="O administrador da UBS gera o código em Configurações da UBS, Computadores. Vale 15 minutos e uma única vez." KeyDown="OnActivationKeyDown" />
            <Button Content="Ativar com código" Click="OnActivate" IsEnabled="{Binding CanActivateWithCode}" HorizontalAlignment="Left" Margin="0,0,0,8" ToolTip="Ativa este computador para a UBS do código." ToolTipService.ShowOnDisabled="True" />
          </StackPanel>
        </StackPanel>
        <Button Content="Entrar" Click="OnLogin" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" ToolTip="Entre para acessar os dados da sua unidade." />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding OpeningSteps}" ItemTemplate="{StaticResource ProgressStepTemplate}" Margin="0,14,0,0" Visibility="{Binding HasOpeningSteps, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Passos da abertura" />
      </StackPanel>
    </Border>
    <StackPanel Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolVisibility}}">
      <views:ObsUnitRegistryView Visibility="{Binding ShowPatients, Converter={StaticResource BoolVisibility}}" />
      <views:UnitQueueView Visibility="{Binding ShowQueue, Converter={StaticResource BoolVisibility}}" />
      <views:UnitLightningSlotsView Visibility="{Binding ShowSlots, Converter={StaticResource BoolVisibility}}" />
      <StackPanel Visibility="{Binding IsMunicipal, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="Indicadores agregados" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20" />
        <UniformGrid Columns="2">
          <Border Style="{StaticResource Card}" Margin="0,0,8,16"><StackPanel><TextBlock Text="Pacientes cadastrados" /><TextBlock Text="{Binding PatientCount}" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="8,0,0,16"><StackPanel><TextBlock Text="Pacientes aguardando" /><TextBlock Text="{Binding WaitingCount}" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,16"><StackPanel><TextBlock Text="Vagas abertas" /><TextBlock Text="{Binding SlotCount}" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="8,0,0,16"><StackPanel><TextBlock Text="Ofertas aceitas" /><TextBlock Text="{Binding AcceptedCount}" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0" /></StackPanel></Border>
        </UniformGrid>
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
