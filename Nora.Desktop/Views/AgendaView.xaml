<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.AgendaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <UserControl.Resources>
    <Style x:Key="AgendaSegment" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="16,8" /><Setter Property="MinHeight" Value="36" /><Setter Property="MinWidth" Value="76" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style x:Key="AgendaDayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="70" /><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="12,8" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding IsOutsideMonth}" Value="True"><Setter Property="Opacity" Value="0.45" /></DataTrigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" /><Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger></Style.Triggers></Style>
  </UserControl.Resources>
  <StackPanel>
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button Content="Dia" Command="{Binding SelectAgendaDayCommand}" ToolTip="Mostra a agenda de um dia."><Button.Style><Style TargetType="Button" BasedOn="{StaticResource AgendaSegment}"><Style.Triggers><DataTrigger Binding="{Binding IsAgendaDay}" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" /><Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Semana" Command="{Binding SelectAgendaWeekCommand}" ToolTip="Mostra a agenda da semana."><Button.Style><Style TargetType="Button" BasedOn="{StaticResource AgendaSegment}"><Style.Triggers><DataTrigger Binding="{Binding IsAgendaWeek}" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" /><Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Border></Grid>
    <views:ObsUnitNoticeView />
    <Button Content="+ Agendar nova consulta" Style="{StaticResource ObsPrimaryButton}" Click="OnToggleBooking" HorizontalAlignment="Right" IsEnabled="{Binding HasActiveObsUnit}" Margin="0,0,0,16" AutomationProperties.Name="Agendar nova consulta" ToolTip="Abre o formulário de nova consulta."/>
        <Border x:Name="BookingPanel" Visibility="Collapsed" Style="{StaticResource Card}" Margin="0,0,0,18" IsEnabled="{Binding HasActiveObsUnit}" ToolTip="A consulta usa o dia selecionado no calendário abaixo. Escolha um horário futuro."><StackPanel Margin="0,12,0,0">
          <TextBlock Text="{Binding BookingIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="Paciente cadastrado na UBS" /><ComboBox ItemsSource="{Binding ActiveObsRegistry}" SelectedItem="{Binding AppointmentPatient}" DisplayMemberPath="FullName" AutomationProperties.Name="Paciente da consulta"  enter:EnterNavigation.Group="AgendaView.book"/>
          <!-- UBS com profissional ativo: só o catálogo (especialidade, profissional, horário livre da grade). -->
          <StackPanel Visibility="{Binding UsesCatalogBooking, Converter={StaticResource BoolVisibility}}">
            <StackPanel.Resources><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,6,0,12" /></Style></StackPanel.Resources>
            <TextBlock Text="Especialidade" /><ComboBox ItemsSource="{Binding BookingSpecialties}" SelectedItem="{Binding BookingSpecialty}" DisplayMemberPath="Name" AutomationProperties.Name="Especialidade da consulta pelo catálogo"  enter:EnterNavigation.Group="AgendaView.book"/>
            <TextBlock Text="Profissional" /><ComboBox ItemsSource="{Binding BookingProfessionals}" SelectedItem="{Binding BookingProfessional}" DisplayMemberPath="FullName" AutomationProperties.Name="Profissional da consulta pelo catálogo"  enter:EnterNavigation.Group="AgendaView.book"/>
            <TextBlock Text="Horário livre" /><TextBlock Text="{Binding BookingWindowLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,6" />
            <ListBox ItemsSource="{Binding BookingSlots}" SelectedItem="{Binding BookingSlot}" DisplayMemberPath="Display" MinHeight="72" MaxHeight="220" AutomationProperties.Name="Horários livres" enter:EnterNavigation.Group="AgendaView.book" />
            <TextBlock Text="{Binding BookingState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding BookingState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding BookingSelectionLabel}" FontWeight="SemiBold" Margin="0,8,0,8" />
            <Button Style="{StaticResource ObsPrimaryButton}" Content="Agendar" Click="OnCreate" HorizontalAlignment="Left" IsEnabled="{Binding CanBook}" ToolTip="Marca a consulta no horário escolhido." enter:EnterNavigation.Group="AgendaView.book"/>
          </StackPanel>
          <!-- UBS sem profissional ativo: texto livre, como antes. -->
          <StackPanel Visibility="{Binding UsesFreeTextBooking, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Especialidade" /><ComboBox ItemsSource="{Binding ObsSpecialties}" SelectedValue="{Binding AppointmentSpecialty}" SelectedValuePath="Name" DisplayMemberPath="Name" Margin="0,6,0,12" AutomationProperties.Name="Especialidade da consulta" ToolTip="Especialidades cadastradas na rede (lista da Secretaria)."  enter:EnterNavigation.Group="AgendaView.book"/><TextBlock Text="Profissional" /><TextBox Text="{Binding AppointmentProfessional, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Profissional da consulta"  enter:EnterNavigation.Group="AgendaView.book"/><TextBlock Text="Horário inicial (HH:mm)" /><TextBox Text="{Binding AppointmentStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horário inicial da consulta"  enter:EnterNavigation.Group="AgendaView.book"/><TextBlock Text="Horário final (HH:mm)" /><TextBox Text="{Binding AppointmentEnd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horário final da consulta"  enter:EnterNavigation.Group="AgendaView.book"/><Button Style="{StaticResource ObsPrimaryButton}" Content="Agendar" Click="OnCreate" HorizontalAlignment="Left" IsEnabled="{Binding CanBook}" ToolTip="Marca a consulta no horário escolhido." enter:EnterNavigation.Group="AgendaView.book"/></StackPanel>
        </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24" ToolTip="Selecione um dia para ver os horários. Os marcadores coloridos indicam as situações das consultas."><StackPanel><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="‹" MinWidth="42" Padding="8" Click="OnPrevious" ToolTip="Período anterior" AutomationProperties.Name="Período anterior" /><StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="{Binding AgendaRangeLabel}" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" /></StackPanel><Button Grid.Column="2" Content="›" MinWidth="42" Padding="8" Click="OnNext" ToolTip="Próximo período" AutomationProperties.Name="Próximo período" /></Grid>
      <WrapPanel Margin="0,0,0,12" ToolTip="As cores indicam as situações das consultas em cada dia; um dia pode ter mais de uma situação." AutomationProperties.Name="Legenda das situações da agenda">
        <TextBlock Text="Legenda:" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" Margin="0,0,10,8" />
        <Border Background="#E8D8FF" CornerRadius="8" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Agendada" Foreground="#5B21B6" /></Border>
        <Border Background="#FFF2C6" CornerRadius="8" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Chamada" Foreground="#754B00" /></Border>
        <Border Background="#DCF4E5" CornerRadius="8" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Concluída" Foreground="#137A52" /></Border>
        <Border Background="#FFE4D2" CornerRadius="8" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Falta" Foreground="#B54708" /></Border>
        <Border Background="#FFE0E5" CornerRadius="8" Padding="10,5" Margin="0,0,8,8"><TextBlock Text="Cancelada" Foreground="#B4233E" /></Border>
      </WrapPanel>
      <UniformGrid Columns="7" Margin="0,0,0,8"><TextBlock Text="Seg" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Ter" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Qua" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Qui" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Sex" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Sáb" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Dom" FontWeight="SemiBold" TextAlignment="Center" /></UniformGrid>
      <ItemsControl ItemsSource="{Binding AgendaDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AgendaDayButton}" ToolTip="{Binding AutomationLabel}" AutomationProperties.Name="{Binding AutomationLabel}"><StackPanel><TextBlock Text="{Binding DayNumber}" Style="{StaticResource SectionTitle}" /><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Ellipse Width="9" Height="9" Fill="#8053D6" Margin="0,0,4,0" Visibility="{Binding HasScheduled, Converter={StaticResource BoolVisibility}}" /><Ellipse Width="9" Height="9" Fill="#D89700" Margin="0,0,4,0" Visibility="{Binding HasCalled, Converter={StaticResource BoolVisibility}}" /><Ellipse Width="9" Height="9" Fill="#137A52" Margin="0,0,4,0" Visibility="{Binding HasCompleted, Converter={StaticResource BoolVisibility}}" /><Ellipse Width="9" Height="9" Fill="#CF5B12" Margin="0,0,4,0" Visibility="{Binding HasMissed, Converter={StaticResource BoolVisibility}}" /><Ellipse Width="9" Height="9" Fill="#B4233E" Visibility="{Binding HasCancelled, Converter={StaticResource BoolVisibility}}" /></StackPanel></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,18,0,0"><StackPanel IsEnabled="{Binding CanEditDraft}"><TextBlock Text="{Binding SelectedAgendaDateLabel}" FontWeight="SemiBold" /><StackPanel Margin="0,4,0,8"><TextBlock Text="{Binding ActiveObsUnitLabel}" /><TextBlock Text="{Binding ActiveObsUnitRegion}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel><Button Style="{StaticResource IconRefreshButton}" Click="OnLoad" HorizontalAlignment="Right" IsEnabled="{Binding HasActiveObsUnit}" AutomationProperties.Name="Atualizar agenda" ToolTip="Atualizar agenda" />
        <views:PageFilterGroup Label="Consultas do período" SearchFields="PatientName,Specialty,Professional,StatusDisplay" ItemsTarget="{Binding ElementName=AppointmentsFilterList}" />
        <ListBox x:Name="AppointmentsFilterList" ItemsSource="{Binding Appointments}" SelectedItem="{Binding SelectedAppointment}" AutomationProperties.Name="Consultas da UBS" MinHeight="65" MaxHeight="320" Margin="0,12,0,0" MouseDoubleClick="OnAppointmentDoubleClick" PreviewKeyDown="OnAppointmentKeyDown" ToolTip="Duplo clique ou Enter abre a ficha da consulta.">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border CornerRadius="10" Padding="14" Margin="2,3" TextElement.Foreground="#102A43">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#E8D8FF" /><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="called"><Setter Property="Background" Value="#FFF2C6" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="completed"><Setter Property="Background" Value="#DCF4E5" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="missed"><Setter Property="Background" Value="#FFE4D2" /></DataTrigger><DataTrigger Binding="{Binding Status}" Value="cancelled"><Setter Property="Background" Value="#FFE0E5" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel>
            <TextBlock Text="{Binding PatientName}" Style="{StaticResource SectionTitle}" Foreground="#102A43" />
            <WrapPanel Margin="0,7,0,0"><TextBlock Text="{Binding AgendaDayDisplay, StringFormat='Dia: {0}'}" FontWeight="SemiBold" Margin="0,0,22,4" Foreground="#102A43" /><TextBlock Text="{Binding AgendaTimeDisplay, StringFormat='Horário: {0}'}" FontWeight="Bold" Foreground="#102A43" /></WrapPanel>
            <TextBlock Text="{Binding FormattedCpf, StringFormat='CPF: {0}'}" Foreground="#102A43" /><TextBlock Text="{Binding Specialty, StringFormat='Especialidade: {0}'}" Foreground="#102A43" /><TextBlock Text="{Binding Professional, StringFormat='Profissional: {0}'}" Foreground="#102A43" /><TextBlock Text="{Binding StatusDisplay, StringFormat='Situação: {0}'}" FontWeight="Bold" Foreground="#102A43" />
            <TextBlock Text="{Binding BookedByDisplay, StringFormat='Marcada por: {0}'}" Foreground="#34445A" FontSize="12" />
            <!-- Confirmação de presença: o ícone acompanha o texto, nunca é o único sinal. -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding HasConfirmationInfo, Converter={StaticResource BoolVisibility}}">
              <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,2,6,0" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE7BA;" /><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsConfirmed}" Value="True"><Setter Property="Text" Value="&#xE73E;" /><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding ConfirmationDisplay}" Foreground="#102A43" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
        <TextBlock Text="{Binding AgendaStateText}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
        <WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource ObsPrimaryButton}" Content="Chamar" Tag="called" Click="OnStatus" IsEnabled="{Binding CanCallAppointment}" Margin="0,0,8,8" ToolTip="Chama o paciente para o atendimento."/><Button Style="{StaticResource ObsPrimaryButton}" Content="Concluir" Tag="completed" Click="OnStatus" IsEnabled="{Binding CanCompleteAppointment}" Margin="0,0,8,8" ToolTip="Registra a consulta como concluída."/><Button Style="{StaticResource ObsPrimaryButton}" Content="Registrar falta" Tag="missed" Click="OnStatus" IsEnabled="{Binding CanMissAppointment}" Margin="0,0,8,8" ToolTip="Registra que o paciente faltou."/><Button Style="{StaticResource ObsPrimaryButton}" Content="Cancelar consulta" Tag="cancelled" Click="OnStatus" IsEnabled="{Binding CanCancelAppointment}" Margin="0,0,8,8" ToolTip="Cancela a consulta e libera o horário."/></WrapPanel>

      </StackPanel></Border>
    </StackPanel></Border>

  </StackPanel>
</UserControl>
