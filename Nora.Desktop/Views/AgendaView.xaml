<UserControl x:Class="Nora.Desktop.Views.AgendaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" views:PageLayout.Fill="True">
  <UserControl.Resources>
    <views:AppointmentTextConverter x:Key="AppointmentText" />
    <views:AppointmentToneConverter x:Key="AppointmentTone" />
    <views:WideBlockConverter x:Key="WideBlock" />
    <Geometry x:Key="ChevronLeftGeometry">M 10.5,3.5 L 5,9 L 10.5,14.5</Geometry>
    <Geometry x:Key="ChevronRightGeometry">M 7.5,3.5 L 13,9 L 7.5,14.5</Geometry>

    <!-- Dia do calendário do mês: o número dentro de um círculo; selecionado = fundo azul bem claro na célula e círculo azul bebê no número; hoje = contorno; fora do mês = esmaecido; embaixo, uma bolinha por situação. -->
    <Style x:Key="AgendaDayButton" TargetType="Button">
      <Setter Property="Height" Value="50" /><Setter Property="Margin" Value="2" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Cell" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.6">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Width="30" Height="30" HorizontalAlignment="Center">
              <Ellipse x:Name="Disc" Fill="Transparent" Stroke="Transparent" StrokeThickness="1.2" />
              <TextBlock Text="{Binding DayNumber}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="8" Margin="0,2,0,0">
              <Ellipse Width="7" Height="7" Margin="1.5,0" Fill="{DynamicResource StatusScheduledBrush}" Visibility="{Binding HasScheduled, Converter={StaticResource BoolVisibility}}" />
              <Ellipse Width="7" Height="7" Margin="1.5,0" Fill="{DynamicResource StatusCalledBrush}" Visibility="{Binding HasCalled, Converter={StaticResource BoolVisibility}}" />
              <Ellipse Width="7" Height="7" Margin="1.5,0" Fill="{DynamicResource StatusCompletedBrush}" Visibility="{Binding HasCompleted, Converter={StaticResource BoolVisibility}}" />
              <Ellipse Width="7" Height="7" Margin="1.5,0" Fill="{DynamicResource StatusMissedBrush}" Visibility="{Binding HasMissed, Converter={StaticResource BoolVisibility}}" />
              <Ellipse Width="7" Height="7" Margin="1.5,0" Fill="{DynamicResource StatusCancelledBrush}" Visibility="{Binding HasCancelled, Converter={StaticResource BoolVisibility}}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
          <DataTrigger Binding="{Binding IsSelected}" Value="True">
            <Setter TargetName="Cell" Property="Background" Value="{DynamicResource ToneBlueSurfaceBrush}" />
            <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource ButtonHoverBrush}" />
            <Setter TargetName="Disc" Property="Stroke" Value="{DynamicResource ListItemFocusBrush}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></DataTrigger>
          <DataTrigger Binding="{Binding IsOutsideMonth}" Value="True"><Setter Property="Opacity" Value="0.45" /></DataTrigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Dia do mini-calendário do ano: o fundo fica mais forte com a quantidade de consultas (1-2, 3-5, 6 ou mais); dia de fora do mês fica em branco. -->
    <Style x:Key="AgendaMiniDayButton" TargetType="Button">
      <Setter Property="Height" Value="21" /><Setter Property="Margin" Value="0.5" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Cell" CornerRadius="11" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.4">
          <TextBlock x:Name="Number" Text="{Binding DayNumber}" FontSize="12" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
          <DataTrigger Binding="{Binding Intensity}" Value="1"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource ToneBlueSurfaceBrush}" /><Setter TargetName="Number" Property="FontWeight" Value="SemiBold" /></DataTrigger>
          <DataTrigger Binding="{Binding Intensity}" Value="2"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource ListItemFocusBrush}" /><Setter TargetName="Number" Property="Foreground" Value="{DynamicResource BrandTextBrush}" /><Setter TargetName="Number" Property="FontWeight" Value="SemiBold" /></DataTrigger>
          <DataTrigger Binding="{Binding Intensity}" Value="3"><Setter TargetName="Cell" Property="Background" Value="{DynamicResource StatusScheduledBrush}" /><Setter TargetName="Number" Property="Foreground" Value="{DynamicResource BrandTextBrush}" /><Setter TargetName="Number" Property="FontWeight" Value="Bold" /></DataTrigger>
          <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></DataTrigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsOutsideMonth}" Value="True"><Setter Property="Visibility" Value="Hidden" /></DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- Título do mês no mini-calendário: um botão (abre a visão Mês nele). -->
    <Style x:Key="AgendaMonthTitleButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" CornerRadius="6" Background="Transparent" Padding="8,3" HorizontalAlignment="Left">
          <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
          <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></DataTrigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Cabeçalho da grade da semana: dia da semana e número; um clique abre a visão Dia nele. -->
    <Style x:Key="AgendaWeekHeaderButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Margin" Value="1,0" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" CornerRadius="8" Background="Transparent" Padding="4,5">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{Binding WeekdayLabel}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center" />
            <Grid Width="28" Height="28" Margin="0,2,0,0">
              <Ellipse x:Name="Disc" Fill="Transparent" />
              <TextBlock x:Name="Number" Text="{Binding DayNumber}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
          <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter TargetName="Disc" Property="Fill" Value="{DynamicResource BrandBrush}" /><Setter TargetName="Number" Property="Foreground" Value="{DynamicResource BrandTextBrush}" /></DataTrigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- A grade da semana é uma lista de seleção: o painel é o AgendaWeekPanel e a rolagem é a da lista. -->
    <Style x:Key="AgendaWeekList" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" />
      <Setter Property="SelectionMode" Value="Extended" /><Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="False" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
        <ScrollViewer x:Name="PART_Scroll" Focusable="False" Padding="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- O bloco da consulta na grade: colorido pela situação (fundo do tom e faixa na cor viva), com o nome e o horário. -->
    <Style x:Key="AgendaBlockItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Padding" Value="0" />
      <Setter Property="AutomationProperties.Name" Value="{Binding ., Converter={StaticResource AppointmentText}, ConverterParameter=summary}" />
      <Setter Property="ToolTip" Value="{Binding ., Converter={StaticResource AppointmentText}, ConverterParameter=summary}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Grid>
          <Border x:Name="Frame" CornerRadius="6" Background="{DynamicResource ToneBlueSurfaceBrush}" ClipToBounds="True">
            <Grid>
              <Border x:Name="Accent" Width="4" HorizontalAlignment="Left" Background="{DynamicResource StatusScheduledBrush}" />
              <StackPanel Margin="9,1,3,0" VerticalAlignment="Top" ClipToBounds="True">
                <TextBlock Text="{Binding PatientName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Text="{Binding ., Converter={StaticResource AppointmentText}, ConverterParameter=grid}" Visibility="{Binding ActualWidth, ElementName=Frame, Converter={StaticResource WideBlock}}" FontSize="10.5" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </StackPanel>
            </Grid>
          </Border>
          <Border x:Name="Ring" CornerRadius="6" BorderThickness="1.6" BorderBrush="Transparent" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding Status}" Value="called"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ToneVioletSurfaceBrush}" /><Setter TargetName="Accent" Property="Background" Value="{DynamicResource StatusCalledBrush}" /></DataTrigger>
          <DataTrigger Binding="{Binding Status}" Value="completed"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ToneGreenSurfaceBrush}" /><Setter TargetName="Accent" Property="Background" Value="{DynamicResource StatusCompletedBrush}" /></DataTrigger>
          <DataTrigger Binding="{Binding Status}" Value="missed"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource TonePinkSurfaceBrush}" /><Setter TargetName="Accent" Property="Background" Value="{DynamicResource StatusMissedBrush}" /></DataTrigger>
          <DataTrigger Binding="{Binding Status}" Value="cancelled"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ToneYellowSurfaceBrush}" /><Setter TargetName="Accent" Property="Background" Value="{DynamicResource StatusCancelledBrush}" /></DataTrigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ListItemFocusBrush}" /><Setter TargetName="Ring" Property="BorderThickness" Value="1.2" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ListItemFocusBrush}" /><Setter TargetName="Ring" Property="BorderThickness" Value="1.4" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ListItemSelectedBorderBrush}" /><Setter TargetName="Ring" Property="BorderThickness" Value="2" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Ações do balão por situação: o nome da ação é o Content e a situação que ela grava é o Tag. -->
    <Style x:Key="AgendaCallAction" TargetType="Button" BasedOn="{StaticResource ListActionButton}">
      <Setter Property="Content" Value="Chamar" /><Setter Property="Tag" Value="called" />
      <Setter Property="views:ListAction.Icon" Value="{StaticResource IconBellGeometry}" />
      <Setter Property="ToolTip" Value="Chama o paciente para o atendimento." /><Setter Property="AutomationProperties.Name" Value="Chamar" />
    </Style>
    <Style x:Key="AgendaCompleteAction" TargetType="Button" BasedOn="{StaticResource ListActionButton}">
      <Setter Property="Content" Value="Concluir" /><Setter Property="Tag" Value="completed" />
      <Setter Property="views:ListAction.Icon" Value="{StaticResource IconCheckGeometry}" />
      <Setter Property="ToolTip" Value="Registra a consulta como concluída." /><Setter Property="AutomationProperties.Name" Value="Concluir" />
    </Style>
    <Style x:Key="AgendaMissAction" TargetType="Button" BasedOn="{StaticResource ListActionButton}">
      <Setter Property="Content" Value="Registrar falta" /><Setter Property="Tag" Value="missed" />
      <Setter Property="views:ListAction.Icon" Value="{StaticResource IconWarningGeometry}" />
      <Setter Property="ToolTip" Value="Registra que o paciente faltou." /><Setter Property="AutomationProperties.Name" Value="Registrar falta" />
    </Style>
    <Style x:Key="AgendaCancelAction" TargetType="Button" BasedOn="{StaticResource ListActionDangerButton}">
      <Setter Property="Content" Value="Cancelar" /><Setter Property="Tag" Value="cancelled" />
      <Setter Property="ToolTip" Value="Cancela a consulta e libera o horário." /><Setter Property="AutomationProperties.Name" Value="Cancelar consulta" />
    </Style>

    <Style x:Key="AgendaLegendText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" /><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="AgendaWeekdayText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <!-- Uma linha da lista do dia: paciente, o horário e, à direita, a situação em etiqueta colorida. -->
    <DataTemplate x:Key="AgendaRowTemplate">
      <Grid AutomationProperties.Name="{Binding ., Converter={StaticResource AppointmentText}, ConverterParameter=summary}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding PatientName}" Style="{StaticResource ItemTitleText}" />
          <TextBlock Text="{Binding ., Converter={StaticResource AppointmentText}}" Style="{StaticResource ItemMetaText}" />
        </StackPanel>
        <views:StatusTag Grid.Column="1" Text="{Binding StatusDisplay}" Tone="{Binding Status, Converter={StaticResource AppointmentTone}}" Margin="12,0,0,0" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <views:ObsUnitNoticeView />

    <!-- Cabeçalho da janela: pesquisa e período em linha e o botão de agendar à direita. Na janela principal tudo isto sobe para o cabeçalho; fora dela aparece aqui. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal">
      <views:PageFilterGroup Label="Consultas do período" SearchFields="PatientName,Specialty,Professional,StatusDisplay" ItemsTarget="{Binding ElementName=DayList}">
        <views:PageFilterGroup.Style><Style TargetType="views:PageFilterGroup"><Style.Triggers><DataTrigger Binding="{Binding IsAgendaYear}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></views:PageFilterGroup.Style>
      </views:PageFilterGroup>
      <views:PageFilterGroup Label="Período da agenda" Inline="True">
        <views:SegmentedToggle x:Name="PeriodToggle" ItemsSource="{Binding AgendaPeriods}" SelectedItem="{Binding AgendaViewMode, Mode=TwoWay}" AutomationProperties.Name="Período da agenda" ToolTip="Mostra a agenda por dia, semana, mês ou ano.">
          <views:SegmentedToggle.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource SegmentedToggleItem}"><Setter Property="Padding" Value="10,0" /></Style></views:SegmentedToggle.ItemContainerStyle>
        </views:SegmentedToggle>
      </views:PageFilterGroup>
      <views:PageActions>
        <Button Style="{StaticResource NewItemButton}" Padding="12,0" Content="Agendar nova consulta" Click="OnNewAppointment" IsEnabled="{Binding HasActiveObsUnit}" AutomationProperties.Name="Agendar nova consulta" ToolTip="Abre o agendamento de uma nova consulta." />
      </views:PageActions>
    </StackPanel>

    <!-- Período: anterior, rótulo, próximo e Hoje; ao lado, a legenda das cores (só onde há cor de situação). -->
    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource CircleIconButton}" Click="OnPrevious" ToolTip="Período anterior" AutomationProperties.Name="Período anterior">
          <Path Data="{StaticResource ChevronLeftGeometry}" Width="18" Height="18" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Button>
        <TextBlock Text="{Binding AgendaRangeLabel}" MinWidth="176" Margin="6,0" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Período mostrado" AutomationProperties.LiveSetting="Polite" />
        <Button Style="{StaticResource CircleIconButton}" Click="OnNext" ToolTip="Próximo período" AutomationProperties.Name="Próximo período">
          <Path Data="{StaticResource ChevronRightGeometry}" Width="18" Height="18" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Button>
        <Button Content="Hoje" Click="OnToday" Margin="10,0,0,0" Padding="14,0" MinHeight="32" MinWidth="0" ToolTip="Volta para hoje." AutomationProperties.Name="Ir para hoje" />
      </StackPanel>
      <Viewbox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" Stretch="Uniform" StretchDirection="DownOnly" AutomationProperties.Name="Legenda das situações da agenda" ToolTip="As cores indicam as situações das consultas; um dia pode ter mais de uma situação.">
        <Viewbox.Style><Style TargetType="Viewbox"><Style.Triggers><DataTrigger Binding="{Binding ShowsAgendaLegend}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Viewbox.Style>
        <StackPanel Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusScheduledBrush}" Margin="10,0,5,0" VerticalAlignment="Center" /><TextBlock Text="Agendada" Style="{StaticResource AgendaLegendText}" />
          <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusCalledBrush}" Margin="10,0,5,0" VerticalAlignment="Center" /><TextBlock Text="Chamada" Style="{StaticResource AgendaLegendText}" />
          <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusCompletedBrush}" Margin="10,0,5,0" VerticalAlignment="Center" /><TextBlock Text="Concluída" Style="{StaticResource AgendaLegendText}" />
          <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusMissedBrush}" Margin="10,0,5,0" VerticalAlignment="Center" /><TextBlock Text="Falta" Style="{StaticResource AgendaLegendText}" />
          <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusCancelledBrush}" Margin="10,0,5,0" VerticalAlignment="Center" /><TextBlock Text="Cancelada" Style="{StaticResource AgendaLegendText}" />
        </StackPanel>
      </Viewbox>
    </Grid>

    <!-- Dia e Mês: a lista das consultas do dia; no Mês, o calendário vem em cima. -->
    <Grid Grid.Row="3">
      <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowsAgendaDayList}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <StackPanel x:Name="MonthCalendar" Margin="0,0,0,6" AutomationProperties.Name="Calendário do mês">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsAgendaMonth}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <UniformGrid Columns="7" Margin="2,0,2,4">
          <TextBlock Text="Seg" Style="{StaticResource AgendaWeekdayText}" /><TextBlock Text="Ter" Style="{StaticResource AgendaWeekdayText}" /><TextBlock Text="Qua" Style="{StaticResource AgendaWeekdayText}" /><TextBlock Text="Qui" Style="{StaticResource AgendaWeekdayText}" /><TextBlock Text="Sex" Style="{StaticResource AgendaWeekdayText}" /><TextBlock Text="Sáb" Style="{StaticResource AgendaWeekdayText}" /><TextBlock Text="Dom" Style="{StaticResource AgendaWeekdayText}" />
        </UniformGrid>
        <ItemsControl ItemsSource="{Binding AgendaDays}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AgendaDayButton}" ToolTip="{Binding AutomationLabel}" AutomationProperties.Name="{Binding AutomationLabel}" />
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      <Grid Grid.Row="1">
        <ListBox x:Name="DayList" Style="{StaticResource OpenList}" ItemsSource="{Binding Appointments}" ItemTemplate="{StaticResource AgendaRowTemplate}" AutomationProperties.Name="Consultas da UBS"
                 views:ListingBehavior.Balloon="{Binding ElementName=DayBalloon}" views:ListingBehavior.LabelPath="PatientName" views:ListingBehavior.KeyPath="Id" views:ListingBehavior.PluralName="consultas" views:ListingBehavior.Feminine="True" />
        <StackPanel x:Name="DayState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16" Visibility="Collapsed" IsHitTestVisible="False">
          <ProgressBar x:Name="DayProgress" IsIndeterminate="True" Width="160" Height="3" Margin="0,0,0,10" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" AutomationProperties.Name="Lendo a agenda" />
          <TextBlock x:Name="DayStateText" Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <views:SelectionBalloon x:Name="DayBalloon">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource AgendaCallAction}" Click="OnStatus" IsEnabled="{Binding CanCallAppointment}" />
            <Button Style="{StaticResource AgendaCompleteAction}" Click="OnStatus" IsEnabled="{Binding CanCompleteAppointment}" />
            <Button Style="{StaticResource AgendaMissAction}" Click="OnStatus" IsEnabled="{Binding CanMissAppointment}" />
            <Button Style="{StaticResource AgendaCancelAction}" Click="OnStatus" IsEnabled="{Binding CanCancelAppointment}" />
          </StackPanel>
        </views:SelectionBalloon>
      </Grid>
    </Grid>

    <!-- Semana: os sete dias no topo, as horas na lateral e cada consulta como um bloco no seu dia e horário. -->
    <Grid Grid.Row="3">
      <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsAgendaWeek}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="WeekHeaderSpacer" Width="0" /></Grid.ColumnDefinitions>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding AgendaWeekDays}" AutomationProperties.Name="Dias da semana">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Button Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AgendaWeekHeaderButton}" ToolTip="Abrir o dia" AutomationProperties.Name="{Binding AutomationLabel}" />
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
      <Grid Grid.Row="1">
        <ListBox x:Name="WeekList" Style="{StaticResource AgendaWeekList}" ItemsSource="{Binding Appointments}" ItemContainerStyle="{StaticResource AgendaBlockItem}" AutomationProperties.Name="Consultas da semana"
                 views:ListingBehavior.Balloon="{Binding ElementName=WeekBalloon}" views:ListingBehavior.LabelPath="PatientName" views:ListingBehavior.KeyPath="Id" views:ListingBehavior.PluralName="consultas" views:ListingBehavior.Feminine="True">
          <ListBox.ItemsPanel><ItemsPanelTemplate>
            <views:AgendaWeekPanel WeekStart="{Binding AgendaWeekStart}" FirstHour="{Binding AgendaWeekFirstHour}" LastHour="{Binding AgendaWeekLastHour}"
                                   LineBrush="{DynamicResource BorderBrush}" TextBrush="{DynamicResource SecondaryBrush}" TodayBrush="{DynamicResource ToneBlueSurfaceBrush}" />
          </ItemsPanelTemplate></ListBox.ItemsPanel>
        </ListBox>
        <StackPanel x:Name="WeekState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16" Visibility="Collapsed" IsHitTestVisible="False">
          <ProgressBar x:Name="WeekProgress" IsIndeterminate="True" Width="160" Height="3" Margin="0,0,0,10" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" AutomationProperties.Name="Lendo a agenda" />
          <TextBlock x:Name="WeekStateText" Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <views:SelectionBalloon x:Name="WeekBalloon">
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource AgendaCallAction}" Click="OnStatus" IsEnabled="{Binding CanCallAppointment}" />
            <Button Style="{StaticResource AgendaCompleteAction}" Click="OnStatus" IsEnabled="{Binding CanCompleteAppointment}" />
            <Button Style="{StaticResource AgendaMissAction}" Click="OnStatus" IsEnabled="{Binding CanMissAppointment}" />
            <Button Style="{StaticResource AgendaCancelAction}" Click="OnStatus" IsEnabled="{Binding CanCancelAppointment}" />
          </StackPanel>
        </views:SelectionBalloon>
      </Grid>
    </Grid>

    <!-- Ano: os 12 meses em grade 4x3, cada um um mini-calendário; o mês abre a visão Mês e o dia abre a visão Dia. -->
    <Grid Grid.Row="3">
      <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsAgendaYear}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl ItemsSource="{Binding AgendaMonths}" AutomationProperties.Name="Meses do ano">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <StackPanel Margin="8,2,8,6" AutomationProperties.Name="{Binding AutomationLabel}">
              <Button Style="{StaticResource AgendaMonthTitleButton}" Click="OnOpenMonth" Margin="0,0,0,4" ToolTip="Abrir o mês" AutomationProperties.Name="{Binding AutomationLabel}" />
              <UniformGrid Columns="7" Margin="0,0,0,2">
                <TextBlock Text="S" Style="{StaticResource AgendaWeekdayText}" FontSize="11" /><TextBlock Text="T" Style="{StaticResource AgendaWeekdayText}" FontSize="11" /><TextBlock Text="Q" Style="{StaticResource AgendaWeekdayText}" FontSize="11" /><TextBlock Text="Q" Style="{StaticResource AgendaWeekdayText}" FontSize="11" /><TextBlock Text="S" Style="{StaticResource AgendaWeekdayText}" FontSize="11" /><TextBlock Text="S" Style="{StaticResource AgendaWeekdayText}" FontSize="11" /><TextBlock Text="D" Style="{StaticResource AgendaWeekdayText}" FontSize="11" />
              </UniformGrid>
              <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AgendaMiniDayButton}" ToolTip="{Binding AutomationLabel}" AutomationProperties.Name="{Binding AutomationLabel}" />
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel x:Name="YearState" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8" Visibility="Collapsed" IsHitTestVisible="False">
        <ProgressBar IsIndeterminate="True" Width="160" Height="3" Margin="0,0,0,6" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandBrush}" AutomationProperties.Name="Lendo a agenda" />
        <TextBlock x:Name="YearStateText" Style="{StaticResource Muted}" TextAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
