<UserControl x:Class="Nora.Desktop.Views.AgendaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <UserControl.Resources>
    <Style x:Key="AgendaSegment" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="16,8" /><Setter Property="MinHeight" Value="36" /><Setter Property="MinWidth" Value="76" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style x:Key="AgendaDayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="70" /><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="12,8" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding IsOutsideMonth}" Value="True"><Setter Property="Opacity" Value="0.45" /></DataTrigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" /><Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger></Style.Triggers></Style>
    <!-- Selo de situação da consulta: o fundo traz a cor semântica do tema (tom de 16%) e o texto fica em TextBrush, para manter o contraste AA nos dois temas, também com o item selecionado. -->
    <Style x:Key="AgendaBadge" TargetType="ContentControl">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
      <Setter Property="Focusable" Value="False" />
      <!-- O TextBlock fica no ContentTemplate: dentro do Template ele perderia o peer de acessibilidade e o leitor de tela pularia a situação. -->
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12" TextAlignment="Center" Padding="10,5" /></DataTemplate></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl"><Grid><Border Background="{TemplateBinding Background}" Opacity="0.16" CornerRadius="8" /><ContentPresenter /></Grid></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="called"><Setter Property="Background" Value="{DynamicResource InfoBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="completed"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="missed"><Setter Property="Background" Value="{DynamicResource WarningBrush}" /></DataTrigger>
        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="cancelled"><Setter Property="Background" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Agenda da unidade" FontSize="28" FontWeight="SemiBold" /></StackPanel><Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button Content="Dia" Command="{Binding SelectAgendaDayCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource AgendaSegment}"><Style.Triggers><DataTrigger Binding="{Binding IsAgendaDay}" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" /><Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Semana" Command="{Binding SelectAgendaWeekCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource AgendaSegment}"><Style.Triggers><DataTrigger Binding="{Binding IsAgendaWeek}" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" /><Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Border></Grid>
    <views:ObsUnitNoticeView />
    <Border Style="{StaticResource Card}" Margin="0,0,0,24"><StackPanel><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="‹" MinWidth="42" Padding="8" Click="OnPrevious" ToolTip="Período anterior" AutomationProperties.Name="Período anterior" /><StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="{Binding AgendaRangeLabel}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /></StackPanel><Button Grid.Column="2" Content="›" MinWidth="42" Padding="8" Click="OnNext" ToolTip="Próximo período" AutomationProperties.Name="Próximo período" /></Grid>
      <UniformGrid Columns="7" Margin="0,0,0,8"><TextBlock Text="Seg" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Ter" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Qua" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Qui" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Sex" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Sáb" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Dom" FontWeight="SemiBold" TextAlignment="Center" /></UniformGrid>
      <ItemsControl ItemsSource="{Binding AgendaDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AgendaDayButton}" ToolTip="{Binding AutomationLabel}" AutomationProperties.Name="{Binding AutomationLabel}"><StackPanel><TextBlock Text="{Binding DayNumber}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding CountLabel}" FontSize="10" Opacity="0.85" Margin="0,3,0,0" Visibility="{Binding HasAppointments, Converter={StaticResource BoolVisibility}}" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,18,0,0"><StackPanel IsEnabled="{Binding CanEditDraft}"><TextBlock Text="{Binding SelectedAgendaDateLabel}" FontWeight="SemiBold" /><StackPanel Margin="0,4,0,8"><TextBlock Text="{Binding ActiveObsUnitLabel}" /><TextBlock Text="{Binding ActiveObsUnitRegion}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel><Button Content="Atualizar agenda" Click="OnLoad" HorizontalAlignment="Left" IsEnabled="{Binding HasActiveObsUnit}" />
        <ListBox ItemsSource="{Binding Appointments}" SelectedItem="{Binding SelectedAppointment}" AutomationProperties.Name="Consultas da UBS" MinHeight="65" MaxHeight="320" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0" MouseDoubleClick="OnAppointmentDoubleClick" PreviewKeyDown="OnAppointmentKeyDown" ToolTip="Duplo clique ou Enter abre a ficha da consulta.">
          <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></ListBox.Style>
          <ListBox.ItemTemplate><DataTemplate><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,16,0">
            <TextBlock Text="{Binding TimeDisplay}" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="{Binding PatientDisplay}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BookedByDisplay, StringFormat=Marcada por: {0}}" Style="{StaticResource Muted}" FontSize="12" />
            <!-- Confirmação de presença: o ícone acompanha o texto, nunca é o único sinal. -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding HasConfirmationInfo, Converter={StaticResource BoolVisibility}}">
              <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,2,6,0" VerticalAlignment="Center">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE7BA;" /><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsConfirmed}" Value="True"><Setter Property="Text" Value="&#xE73E;" /><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <TextBlock Text="{Binding ConfirmationDisplay}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,16,0"><TextBlock Text="{Binding Specialty, StringFormat=Especialidade: {0}}" /><TextBlock Text="{Binding Professional, StringFormat=Profissional: {0}}" Style="{StaticResource Muted}" FontSize="12" /></StackPanel>
          <ContentControl Grid.Column="2" Content="{Binding StatusDisplay}" Tag="{Binding Status}" Style="{StaticResource AgendaBadge}" MinWidth="96" VerticalAlignment="Top" />
        </Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        <TextBlock Text="{Binding AgendaStateText}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
        <WrapPanel Margin="0,12,0,0"><Button Content="Chamar" Tag="called" Click="OnStatus" IsEnabled="{Binding CanCallAppointment}" Margin="0,0,8,8" /><Button Content="Concluir" Tag="completed" Click="OnStatus" IsEnabled="{Binding CanCompleteAppointment}" Margin="0,0,8,8" /><Button Content="Registrar falta" Tag="missed" Click="OnStatus" IsEnabled="{Binding CanMissAppointment}" Margin="0,0,8,8" /><Button Content="Cancelar consulta" Style="{StaticResource DangerButton}" Tag="cancelled" Click="OnStatus" IsEnabled="{Binding CanCancelAppointment}" Margin="0,0,8,8" /><Button Content="Gerar Vaga Relâmpago" Click="OnCreateLightning" IsEnabled="{Binding CanCreateLightning}" ToolTip="Disponível para consulta cancelada com início no futuro." ToolTipService.ShowOnDisabled="True" Margin="0,0,8,8" /></WrapPanel>
        <TextBlock Text="Selecione uma consulta na lista para liberar estas ações." Margin="0,0,0,4"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedAppointment}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding Appointments.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Expander Header="Agendar consulta" Margin="0,12,0,0" IsEnabled="{Binding HasActiveObsUnit}"><StackPanel Margin="0,12,0,0">
          <TextBlock Text="{Binding BookingIntro}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="Paciente cadastrado na UBS" /><ComboBox ItemsSource="{Binding ActiveObsRegistry}" SelectedItem="{Binding AppointmentPatient}" DisplayMemberPath="FullName" AutomationProperties.Name="Paciente da consulta" />
          <!-- UBS com profissional ativo: só o catálogo (especialidade, profissional, horário livre da grade). -->
          <StackPanel Visibility="{Binding UsesCatalogBooking, Converter={StaticResource BoolVisibility}}">
            <StackPanel.Resources><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,6,0,12" /></Style></StackPanel.Resources>
            <TextBlock Text="Especialidade" /><ComboBox ItemsSource="{Binding BookingSpecialties}" SelectedItem="{Binding BookingSpecialty}" DisplayMemberPath="Name" AutomationProperties.Name="Especialidade da consulta pelo catálogo" />
            <TextBlock Text="Profissional" /><ComboBox ItemsSource="{Binding BookingProfessionals}" SelectedItem="{Binding BookingProfessional}" DisplayMemberPath="FullName" AutomationProperties.Name="Profissional da consulta pelo catálogo" />
            <TextBlock Text="Horário livre" /><TextBlock Text="{Binding BookingWindowLabel}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,6" />
            <ListBox ItemsSource="{Binding BookingSlots}" SelectedItem="{Binding BookingSlot}" DisplayMemberPath="Display" MinHeight="72" MaxHeight="220" AutomationProperties.Name="Horários livres" />
            <TextBlock Text="{Binding BookingState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding BookingState, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding BookingSelectionLabel}" FontWeight="SemiBold" Margin="0,8,0,8" />
            <Button Content="Agendar" Click="OnCreate" HorizontalAlignment="Left" IsEnabled="{Binding CanBook}" />
          </StackPanel>
          <!-- UBS sem profissional ativo: texto livre, como antes. -->
          <StackPanel Visibility="{Binding UsesFreeTextBooking, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Especialidade" /><TextBox Text="{Binding AppointmentSpecialty, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Especialidade da consulta" /><TextBlock Text="Profissional" /><TextBox Text="{Binding AppointmentProfessional, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Profissional da consulta" /><TextBlock Text="Horário inicial (HH:mm)" /><TextBox Text="{Binding AppointmentStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horário inicial da consulta" /><TextBlock Text="Horário final (HH:mm)" /><TextBox Text="{Binding AppointmentEnd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horário final da consulta" /><TextBlock Text="A consulta será criada no dia selecionado acima, com início no futuro e duração de até 12 horas." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" /><Button Content="Agendar" Click="OnCreate" HorizontalAlignment="Left" IsEnabled="{Binding CanBook}" /></StackPanel>
        </StackPanel></Expander>
      </StackPanel></Border>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Legenda da agenda" FontSize="18" FontWeight="SemiBold" /><WrapPanel Margin="0,14,0,0"><ContentControl Content="Agendada" Tag="scheduled" Style="{StaticResource AgendaBadge}" Width="104" Margin="0,0,8,8" /><ContentControl Content="Chamada" Tag="called" Style="{StaticResource AgendaBadge}" Width="104" Margin="0,0,8,8" /><ContentControl Content="Concluída" Tag="completed" Style="{StaticResource AgendaBadge}" Width="104" Margin="0,0,8,8" /><ContentControl Content="Falta" Tag="missed" Style="{StaticResource AgendaBadge}" Width="104" Margin="0,0,8,8" /><ContentControl Content="Cancelada" Tag="cancelled" Style="{StaticResource AgendaBadge}" Width="104" Margin="0,0,8,8" /></WrapPanel><TextBlock Text="Quem marcou e a confirmação de presença aparecem em cada consulta." Style="{StaticResource Muted}" Margin="0,10,0,0" /></StackPanel></Border>
  </StackPanel>
</UserControl>
