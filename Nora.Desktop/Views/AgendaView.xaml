<UserControl x:Class="Nora.Desktop.Views.AgendaView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="AgendaSegment" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="16,8" /><Setter Property="MinHeight" Value="36" /><Setter Property="MinWidth" Value="76" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style x:Key="AgendaDayButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="58" /><Setter Property="Margin" Value="4" /><Setter Property="Padding" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding IsOutsideMonth}" Value="True"><Setter Property="Opacity" Value="0.45" /></DataTrigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" /><Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger></Style.Triggers></Style>
  </UserControl.Resources>
  <StackPanel>
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Agenda da unidade" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="Calendário de consultas, disponibilidade e situação dos atendimentos." Style="{StaticResource Muted}" Margin="0,8,0,0" /></StackPanel><Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="13" Padding="4" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Button Content="Dia" Command="{Binding SelectAgendaDayCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource AgendaSegment}"><Style.Triggers><DataTrigger Binding="{Binding IsAgendaDay}" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" /><Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Semana" Command="{Binding SelectAgendaWeekCommand}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource AgendaSegment}"><Style.Triggers><DataTrigger Binding="{Binding IsAgendaWeek}" Value="True"><Setter Property="Background" Value="{DynamicResource BrandGradientBrush}" /><Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Border></Grid>
    <Border Style="{StaticResource Card}" Margin="0,0,0,24"><StackPanel><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="‹" MinWidth="42" Padding="8" Click="OnPrevious" ToolTip="Período anterior" /><StackPanel Grid.Column="1" HorizontalAlignment="Center"><TextBlock Text="{Binding AgendaRangeLabel}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Selecione um dia para consultar os horários recebidos da unidade." Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" /></StackPanel><Button Grid.Column="2" Content="›" MinWidth="42" Padding="8" Click="OnNext" ToolTip="Próximo período" /></Grid>
      <UniformGrid Columns="7" Margin="0,0,0,8"><TextBlock Text="Seg" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Ter" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Qua" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Qui" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Sex" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Sáb" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Dom" FontWeight="SemiBold" TextAlignment="Center" /></UniformGrid>
      <ItemsControl ItemsSource="{Binding AgendaDays}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectCalendarDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource AgendaDayButton}" ToolTip="{Binding Date, StringFormat='Selecionar {0:dd/MM/yyyy}'}"><StackPanel><TextBlock Text="{Binding DayNumber}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Selecionado" FontSize="10" Opacity="0.78" Margin="0,3,0,0" Visibility="{Binding IsSelected, Converter={StaticResource BoolVisibility}}" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="12" Padding="14" Margin="0,18,0,0"><StackPanel><TextBlock Text="{Binding SelectedAgendaDateLabel}" FontWeight="SemiBold" /><TextBlock Text="Confirme uma UBS em Pacientes e atualize a agenda para consultar o período." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" /><TextBlock Text="{Binding ActiveObsUnitLabel}" Margin="0,8,0,8" /><Button Content="Atualizar agenda" Click="OnLoad" HorizontalAlignment="Left" IsEnabled="{Binding HasActiveObsUnit}" />
        <ListBox ItemsSource="{Binding Appointments}" SelectedItem="{Binding SelectedAppointment}" AutomationProperties.Name="Consultas da UBS" MinHeight="65" MaxHeight="260" Margin="0,12,0,0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6"><TextBlock Text="{Binding TimeDisplay}" FontWeight="SemiBold" /><TextBlock Text="{Binding PatientName}" /><TextBlock Text="{Binding Specialty}" /><TextBlock Text="{Binding Professional}" /><TextBlock Text="{Binding StatusDisplay}" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <WrapPanel Margin="0,12,0,0"><Button Content="Chamar" Tag="called" Click="OnStatus" Margin="0,0,8,8" /><Button Content="Concluir" Tag="completed" Click="OnStatus" Margin="0,0,8,8" /><Button Content="Registrar falta" Tag="missed" Click="OnStatus" Margin="0,0,8,8" /><Button Content="Cancelar consulta" Tag="cancelled" Click="OnStatus" Margin="0,0,8,8" /><Button Content="Gerar Vaga Relâmpago" Click="OnCreateLightning" Margin="0,0,8,8" /></WrapPanel>
        <Expander Header="Agendar consulta" Margin="0,12,0,0" IsEnabled="{Binding HasActiveObsUnit}"><StackPanel Margin="0,12,0,0"><TextBlock Text="Paciente cadastrado na UBS" /><ComboBox ItemsSource="{Binding ActiveObsRegistry}" SelectedItem="{Binding AppointmentPatient}" DisplayMemberPath="FullName" AutomationProperties.Name="Paciente da consulta" /><TextBlock Text="Especialidade" /><TextBox Text="{Binding AppointmentSpecialty, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="Profissional" /><TextBox Text="{Binding AppointmentProfessional, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="Horário inicial (HH:mm)" /><TextBox Text="{Binding AppointmentStart, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="Horário final (HH:mm)" /><TextBox Text="{Binding AppointmentEnd, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="A consulta será criada no dia selecionado acima." Style="{StaticResource Muted}" Margin="0,0,0,8" /><Button Content="Agendar" Click="OnCreate" HorizontalAlignment="Left" /></StackPanel></Expander>
      </StackPanel></Border>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Legenda da agenda" FontSize="18" FontWeight="SemiBold" /><WrapPanel Margin="0,14,0,0"><Border Background="#FFF2C6" CornerRadius="8" Width="104" Padding="10,6" Margin="0,0,8,8"><TextBlock Text="Livre" Foreground="#754B00" TextAlignment="Center" /></Border><Border Background="#E8D8FF" CornerRadius="8" Width="104" Padding="10,6" Margin="0,0,8,8"><TextBlock Text="Ocupado" Foreground="#5B21B6" TextAlignment="Center" /></Border><Border Background="#FFE0E5" CornerRadius="8" Width="104" Padding="10,6" Margin="0,0,8,8"><TextBlock Text="Cancelado" Foreground="#B4233E" TextAlignment="Center" /></Border><Border Background="#DCF4E5" CornerRadius="8" Width="104" Padding="10,6" Margin="0,0,8,8"><TextBlock Text="Concluído" Foreground="#137A52" TextAlignment="Center" /></Border></WrapPanel><TextBlock Text="Os estados só serão preenchidos por consultas reais; nenhuma consulta de demonstração é criada nesta tela." Style="{StaticResource Muted}" Margin="0,10,0,0" /></StackPanel></Border>
  </StackPanel>
</UserControl>
