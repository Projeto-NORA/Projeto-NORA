<Window x:Class="Nora.Desktop.Views.IndicatorChartWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" Width="640" Height="520" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" Title="Gráfico do indicador">
  <!-- Pop-up do botão de gráfico do cartão: só o título, o alternador Linha | Pizza e o gráfico. O pop-up é o cartão: nada de card dentro dele. -->
  <Border x:Name="Frame" Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24,20,16,20" MouseLeftButtonDown="OnDrag">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22" Color="#061E3B" /></Border.Effect>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <views:ChartPanel x:Name="ChartHost" />
      <Button Grid.Column="1" Style="{StaticResource CircleIconButton}" IsCancel="True" Click="OnClose" Margin="8,0,0,0" ToolTip="Fechar o gráfico" AutomationProperties.Name="Fechar gráfico" VerticalAlignment="Top">
        <Path Data="{StaticResource IconCloseGeometry}" Width="18" Height="18" Stretch="None" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      </Button>
    </Grid>
  </Border>
</Window>
