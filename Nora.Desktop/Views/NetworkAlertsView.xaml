<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.NetworkAlertsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views" views:PageLayout.Fill="True">
  <!-- Alertas da rede avaliados pela API (GET /api/municipal/alerts), com filtros de UBS e região. UBS sem base pronta ficam de fora. Listagem aberta na tela inteira: item em duas linhas (tipo e especialidade; UBS, valor e limite), etiqueta da categoria à direita, balão com "Ver detalhes" e a ficha no duplo clique. -->
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <views:PageFilterGroup Label="Alertas da rede" FilterKey="networkSearch" Inline="True" IsEnabled="{Binding CanFilterAlerts}"><views:NetworkSearchField Label="Alertas da rede" /></views:PageFilterGroup>
      <views:PageFilterGroup Label="Alertas da rede" FilterKey="networkAlerts">
        <WrapPanel IsEnabled="{Binding CanFilterAlerts}">
          <StackPanel Width="190" Margin="0,0,12,0"><TextBlock Text="UBS" FontWeight="SemiBold" FontSize="12" />
            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding AlertsUnitFilter}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar alertas por UBS" enter:EnterNavigation.Group="NetworkAlertsView.filters" /></StackPanel>
          <StackPanel Width="190" Margin="0,0,12,0"><TextBlock Text="Região" FontWeight="SemiBold" FontSize="12" />
            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding RegionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AlertsRegion}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar alertas por região" enter:EnterNavigation.Group="NetworkAlertsView.filters" /></StackPanel>
        </WrapPanel>
      </views:PageFilterGroup>
      <TextBlock Text="{Binding NetworkAlertsLoadingLabel}" Style="{StaticResource Muted}" FontSize="12" Visibility="{Binding NetworkAlertsLoadingLabel, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      <ContentControl Style="{StaticResource NoticeItem}" Visibility="{Binding ShowNetworkAlertsWarning, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Estado dos alertas da rede">
        <TextBlock Text="{Binding NetworkAlertsState}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </ContentControl>
      <TextBlock Text="{Binding NetworkAlertsState}" TextWrapping="Wrap" Visibility="{Binding ShowNetworkAlertsInfo, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Estado dos alertas da rede" />
      <TextBlock Text="{Binding NetworkAlertsFootnote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding NetworkAlertsFootnote, Converter={StaticResource TextVisibility}}" />
      <TextBlock x:Name="SearchEmpty" Text="Nenhum alerta encontrado para esta busca." Style="{StaticResource Muted}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <Grid Grid.Row="1">
      <ListBox x:Name="AlertList" Style="{StaticResource OpenList}" ItemsSource="{Binding NetworkAlerts}" AutomationProperties.Name="Alertas da rede"
               views:ListingBehavior.Balloon="{Binding ElementName=Balloon}" views:ListingBehavior.LabelPath="Name" views:ListingBehavior.KeyPath="Key" views:ListingBehavior.PluralName="alertas" views:ListingBehavior.ComplementPath="UnitName">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid AutomationProperties.Name="{Binding AutomationLabel}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitleText}" />
                <TextBlock Text="{Binding MetaLine}" Style="{StaticResource ItemMetaText}" />
              </StackPanel>
              <views:StatusTag Grid.Column="1" Text="{Binding Category}" Tone="{Binding Tone}" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <views:SelectionBalloon x:Name="Balloon">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconEyeGeometry}" views:SelectionBalloon.SingleItemOnly="True" Content="Ver detalhes" Click="OnDetails" AutomationProperties.Name="Ver detalhes do alerta" ToolTip="Abre a ficha do alerta (o mesmo que o duplo clique)." />
        </StackPanel>
      </views:SelectionBalloon>
    </Grid>
  </Grid>
</UserControl>
