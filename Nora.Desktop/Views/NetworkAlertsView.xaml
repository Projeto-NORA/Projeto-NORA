<UserControl x:Class="Nora.Desktop.Views.NetworkAlertsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Alertas da rede avaliados pela API (GET /api/municipal/alerts), com filtros de UBS e região. UBS sem base pronta ficam de fora. -->
  <UserControl.Resources>
    <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style>
  </UserControl.Resources>
  <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,20" AutomationProperties.Name="Filtros dos alertas">
      <StackPanel>
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding NetworkAlertsLoadingLabel}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Text="Filtros dos alertas" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="Cada escolha avalia os alertas de novo, uma vez." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" />
        <WrapPanel IsEnabled="{Binding CanFilterAlerts}">
          <StackPanel Width="230" Margin="0,0,12,0"><TextBlock Text="UBS" FontWeight="SemiBold" FontSize="12" />
            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding AlertsUnitFilter}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar alertas por UBS" /></StackPanel>
          <StackPanel Width="230" Margin="0,0,12,0"><TextBlock Text="Região" FontWeight="SemiBold" FontSize="12" />
            <ComboBox Margin="0,6,0,0" ItemsSource="{Binding RegionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AlertsRegion}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar alertas por região" /></StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18" AutomationProperties.Name="Alertas da rede">
      <StackPanel>
        <DockPanel><Button DockPanel.Dock="Right" Content="Atualizar alertas" Click="OnRefresh" IsEnabled="{Binding CanOperate}" ToolTip="Avalia os alertas da rede de novo, com os filtros escolhidos." /><TextBlock Text="Alertas da rede" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap" Text="Fila alta numa especialidade, espera longa, taxa de faltas e ocupação da grade acima do limite, e metas fora, por UBS. Os limites vêm da configuração da API. Nenhum dado pessoal aparece." />
        <DataGrid ItemsSource="{Binding NetworkAlerts}" CanUserSortColumns="True" MaxHeight="420" MinHeight="64" AutomationProperties.Name="Alertas da rede">
          <DataGrid.Columns>
            <DataGridTextColumn Header="UBS" Binding="{Binding UnitName}" Width="1.2*" MinWidth="140" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Tipo" Binding="{Binding Title}" Width="2*" MinWidth="250" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Especialidade" Binding="{Binding SpecialtyDisplay}" Width="*" MinWidth="110" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="110" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Limite" Binding="{Binding Threshold}" Width="110" ElementStyle="{StaticResource CellText}" />
            <DataGridTextColumn Header="Desde" Binding="{Binding Since}" Width="140" ElementStyle="{StaticResource CellText}" />
          </DataGrid.Columns>
        </DataGrid>
        <Border Background="{DynamicResource BrandSoftBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,10,0,0" Visibility="{Binding NetworkAlertsState, Converter={StaticResource TextVisibility}}" AutomationProperties.Name="Estado dos alertas da rede">
          <TextBlock Text="{Binding NetworkAlertsState}" TextWrapping="Wrap" MaxWidth="900" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <TextBlock Text="{Binding NetworkAlertsFootnote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0" Visibility="{Binding NetworkAlertsFootnote, Converter={StaticResource TextVisibility}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
