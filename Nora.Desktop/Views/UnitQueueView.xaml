<UserControl x:Class="Nora.Desktop.Views.UnitQueueView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Margin="0,0,0,24"><StackPanel IsEnabled="{Binding CanOperate}">
    <TextBlock Text="Fila da UBS" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="Confirme uma UBS em Pacientes. As vagas são oferecidas pela ordem de entrada para a mesma especialidade." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12" />
    <TextBlock Text="{Binding ActiveObsUnitLabel}" FontWeight="SemiBold" Margin="0,0,0,10" />
    <StackPanel IsEnabled="{Binding HasActiveObsUnit}">
      <TextBlock Text="Paciente cadastrado na UBS" /><ComboBox ItemsSource="{Binding ActiveObsRegistry}" SelectedItem="{Binding WaitingPatient}" DisplayMemberPath="FullName" AutomationProperties.Name="Paciente da fila da UBS" />
      <TextBlock Text="Especialidade" /><TextBox Text="{Binding WaitingSpecialty, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Especialidade da fila da UBS" />
      <WrapPanel><Button Content="Incluir na fila da UBS" Click="OnAdd" Margin="0,0,8,8" /><Button Content="Atualizar fila da UBS" Click="OnLoad" Margin="0,0,8,8" /></WrapPanel>
      <DataGrid ItemsSource="{Binding UnitWaitingList}" SelectedItem="{Binding SelectedWaitingEntry}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="64" MaxHeight="360" AutomationProperties.Name="Fila por especialidade da UBS">
        <DataGrid.Columns><DataGridTextColumn Header="Paciente" Binding="{Binding PatientName}" Width="*" /><DataGridTextColumn Header="Especialidade" Binding="{Binding Specialty}" Width="*" /><DataGridTextColumn Header="Entrada" Binding="{Binding EnteredAtDisplay}" Width="*" /><DataGridTextColumn Header="Situação" Binding="{Binding StatusDisplay}" Width="*" /></DataGrid.Columns>
      </DataGrid>
      <Button Content="Cancelar entrada da UBS" Click="OnCancel" HorizontalAlignment="Left" Margin="0,12,0,0" />
    </StackPanel>
  </StackPanel></Border>
</UserControl>
