<UserControl x:Class="Nora.Desktop.Views.StaffUnitFormView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Conceder ou retirar o acesso de uma conta a uma UBS, no pop-up: a conta, a explicação e a UBS a escolher. -->
  <StackPanel>
    <TextBlock x:Name="AccountText" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock x:Name="HintText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,14" />
    <views:FormGrid MaxColumns="1">
      <StackPanel>
        <TextBlock x:Name="LabelText" Style="{StaticResource FieldLabelText}" />
        <ComboBox x:Name="UnitPicker" DisplayMemberPath="SelectorLabel" IsSynchronizedWithCurrentItem="False" views:EnterNavigation.Group="StaffUnitFormView.unit" />
      </StackPanel>
    </views:FormGrid>
  </StackPanel>
</UserControl>
