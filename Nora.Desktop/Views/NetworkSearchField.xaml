<UserControl x:Class="Nora.Desktop.Views.NetworkSearchField" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="140" HorizontalAlignment="Left" VerticalAlignment="Center" Focusable="False">
  <!-- Campo "Pesquisar" em linha das telas de números da rede (mesma aparência do campo das listas: lupa à direita). O texto é a pesquisa do ViewModel; cada tela liga os seus cartões, gráficos e tabelas a ele com NetworkSearchBinding. -->
  <TextBox x:Name="Box" Style="{StaticResource SearchField}" Tag="Pesquisar" Text="{Binding NetworkSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Pesquisar" />
</UserControl>
