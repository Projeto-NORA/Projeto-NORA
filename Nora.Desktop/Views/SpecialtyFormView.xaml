<UserControl x:Class="Nora.Desktop.Views.SpecialtyFormView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Cadastro e renomeação de especialidade, no pop-up (sem card). O DataContext é o WorkspaceViewModel. -->
  <views:FormGrid MaxColumns="1">
    <StackPanel>
      <TextBlock Text="Nome da especialidade (2 a 120 caracteres)" Style="{StaticResource FieldLabelText}" />
      <TextBox Text="{Binding SpecialtyDraftName, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Nome da especialidade" views:EnterNavigation.Group="SpecialtyFormView.specialty" />
      <TextBlock Text="{Binding SpecialtyNameError}" Style="{StaticResource FieldError}" Margin="0,4,0,0" Visibility="{Binding SpecialtyNameError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </views:FormGrid>
</UserControl>
