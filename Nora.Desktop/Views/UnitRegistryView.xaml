<UserControl xmlns:enter="clr-namespace:Nora.Desktop.Views" x:Class="Nora.Desktop.Views.UnitRegistryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <StackPanel>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
      <TextBlock Text="Cadastros da UBS selecionada" FontSize="19" FontWeight="SemiBold" />
      <TextBlock Text="{Binding SelectedUnitLabel}" FontWeight="SemiBold" Margin="0,8,0,0" />
      <TextBlock Text="{Binding UnitRegistryHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12" />
      <Button Content="Consultar pacientes da UBS" Click="OnReadRegistry" IsEnabled="{Binding CanReadUnitRegistry}" HorizontalAlignment="Left" Margin="0,0,0,12" />
      <views:PageFilterGroup Label="Cadastros da UBS selecionada" SearchFields="FullName,FormattedCpf,Email,PhoneDisplay,ActiveDisplay" ItemsTarget="{Binding ElementName=RegistryFilterList}" />
        <DataGrid x:Name="RegistryFilterList" ItemsSource="{Binding UnitRegistry}" CanUserSortColumns="True" MaxHeight="300" MinHeight="64" AutomationProperties.Name="Pacientes da UBS selecionada">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Nome" Binding="{Binding FullName}" Width="*" MinWidth="140" />
            <DataGridTextColumn Header="CPF" Binding="{Binding FormattedCpf}" SortMemberPath="Cpf" Width="135" />
            <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*" MinWidth="150" />
            <DataGridTextColumn Header="Telefone" Binding="{Binding PhoneDisplay}" SortMemberPath="Phone" Width="150" />
            <DataGridTextColumn Header="Situação" Binding="{Binding ActiveDisplay}" SortMemberPath="IsActive" Width="165" />
            <DataGridTextColumn Header="Aplicativo" Binding="{Binding PresenceDisplay}" SortMemberPath="IsOnline" Width="165" />
            <DataGridTextColumn Header="Cadastro em" Binding="{Binding CreatedAtDisplay}" SortMemberPath="CreatedAt" Width="140" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding UnitRegistryState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding UnitRegistryState, Converter={StaticResource TextVisibility}}" />
      </StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel>
        <TextBlock Text="Agenda da UBS selecionada" FontSize="19" FontWeight="SemiBold"  ToolTip="Informe o período (no máximo 366 dias). A consulta traz uma única requisição e é registrada no histórico de acesso; a situação filtra só o que já foi carregado." Margin="0,0,0,12" />
        <views:PageFilterGroup Label="Consultas da UBS selecionada" FilterKey="municipalAgenda"><StackPanel>
          <WrapPanel IsEnabled="{Binding CanOperate}">
            <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="De (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding UnitAgendaFromText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data inicial da agenda"  enter:EnterNavigation.Group="UnitRegistryView.agenda"/></StackPanel>
            <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="Até (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding UnitAgendaToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data final da agenda"  enter:EnterNavigation.Group="UnitRegistryView.agenda"/></StackPanel>
            <StackPanel Width="190" Margin="0,0,12,8"><TextBlock Text="Situação" FontWeight="SemiBold" FontSize="12" />
              <ComboBox Margin="0,6,0,0" ItemsSource="{x:Static vm:WorkspaceViewModel.AppointmentStatusOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding UnitAgendaStatus}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar agenda por situação"  enter:EnterNavigation.Group="UnitRegistryView.agenda"/></StackPanel>
            <Button Content="Consultar agenda da UBS" Click="OnReadAppointments" IsEnabled="{Binding CanReadUnitRegistry}" VerticalAlignment="Bottom" Margin="0,0,0,8"  enter:EnterNavigation.Group="UnitRegistryView.agenda"/>
          </WrapPanel>
          <TextBlock Text="{Binding UnitAgendaRangeError}" Style="{StaticResource FieldError}" Margin="0,0,0,10" Visibility="{Binding UnitAgendaRangeError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </views:PageFilterGroup>
      <DataGrid ItemsSource="{Binding VisibleMunicipalAppointments}" CanUserSortColumns="True" MaxHeight="300" MinHeight="64" AutomationProperties.Name="Consultas da UBS selecionada">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Data e hora" Binding="{Binding TimeDisplay}" SortMemberPath="StartsAt" Width="215" />
          <DataGridTextColumn Header="Paciente" Binding="{Binding PatientName}" Width="*" MinWidth="130" />
          <DataGridTextColumn Header="CPF" Binding="{Binding FormattedCpf}" SortMemberPath="Cpf" Width="135" />
          <DataGridTextColumn Header="Especialidade" Binding="{Binding Specialty}" Width="*" MinWidth="110" />
          <DataGridTextColumn Header="Profissional" Binding="{Binding Professional}" Width="*" MinWidth="110" />
          <DataGridTextColumn Header="Situação" Binding="{Binding StatusDisplay}" Width="110" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding MunicipalAppointmentsState}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding MunicipalAppointmentsState, Converter={StaticResource TextVisibility}}" />
    </StackPanel></Border>
  </StackPanel>
</UserControl>
