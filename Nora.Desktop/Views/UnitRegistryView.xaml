<UserControl x:Class="Nora.Desktop.Views.UnitRegistryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Nora.Desktop.ViewModels" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Cadastros de referência: duas listagens abertas da UBS escolhida (Cadastros e Agenda), alternadas no cabeçalho. A consulta é nominal e registrada no histórico de acesso, por isso só roda quando a pessoa pede (botão no Filtros). -->
  <UserControl.Resources>
    <views:ListMetaJoinConverter x:Key="MetaJoin" />
    <views:ListBoolTextConverter x:Key="InactiveTag" TrueText="" FalseText="Desativado" />
    <views:ListAppointmentToneConverter x:Key="AppointmentTone" />
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <views:PageFilterGroup x:Name="RegistrySearch" Label="Cadastros da UBS selecionada" SearchFields="FullName,FormattedCpf,Email,PhoneDisplay,ActiveDisplay" ItemsTarget="{Binding ElementName=RegistryList}" />
      <views:PageFilterGroup x:Name="AgendaSearch" Label="Consultas da UBS selecionada" SearchFields="PatientName,FormattedCpf,Specialty,Professional,StatusDisplay,TimeDisplay" ItemsTarget="{Binding ElementName=AgendaList}" Visibility="Collapsed" />
      <views:PageFilterGroup x:Name="RegistryFilters" Label="Cadastros da UBS">
        <StackPanel>
          <TextBlock Text="UBS" Style="{StaticResource FieldLabelText}" />
          <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="SelectorLabel" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="UBS para consultar" views:EnterNavigation.Group="UnitRegistryView.registry" />
          <TextBlock Text="{Binding UnitRegistryHint}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,10" />
          <Button Content="Consultar pacientes da UBS" Click="OnReadRegistry" IsEnabled="{Binding CanReadUnitRegistry}" HorizontalAlignment="Left" ToolTip="Lê os pacientes da UBS escolhida." views:EnterNavigation.Group="UnitRegistryView.registry" />
        </StackPanel>
      </views:PageFilterGroup>
      <views:PageFilterGroup x:Name="AgendaFilters" Label="Agenda da UBS" FilterKey="municipalAgenda" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="UBS" Style="{StaticResource FieldLabelText}" />
          <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" DisplayMemberPath="SelectorLabel" IsSynchronizedWithCurrentItem="False" Margin="0,0,0,10" AutomationProperties.Name="UBS para consultar a agenda" views:EnterNavigation.Group="UnitRegistryView.agenda" />
          <TextBlock Text="Período (no máximo 366 dias). A consulta é uma só requisição e fica registrada no histórico de acesso; a situação filtra só o que já foi carregado." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
          <TextBlock Text="De (dd/mm/aaaa)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding UnitAgendaFromText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Data inicial da agenda" views:EnterNavigation.Group="UnitRegistryView.agenda" />
          <TextBlock Text="Até (dd/mm/aaaa)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding UnitAgendaToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Data final da agenda" views:EnterNavigation.Group="UnitRegistryView.agenda" />
          <TextBlock Text="Situação" Style="{StaticResource FieldLabelText}" />
          <ComboBox Margin="0,0,0,10" ItemsSource="{x:Static vm:WorkspaceViewModel.AppointmentStatusOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding UnitAgendaStatus}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar agenda por situação" views:EnterNavigation.Group="UnitRegistryView.agenda" />
          <TextBlock Text="{Binding UnitAgendaRangeError}" Style="{StaticResource FieldError}" Margin="0,0,0,10" Visibility="{Binding UnitAgendaRangeError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
          <Button Content="Consultar agenda da UBS" Click="OnReadAppointments" IsEnabled="{Binding CanReadUnitRegistry}" HorizontalAlignment="Left" ToolTip="Lê a agenda da UBS no período." views:EnterNavigation.Group="UnitRegistryView.agenda" />
        </StackPanel>
      </views:PageFilterGroup>
      <views:PageActions>
        <views:SegmentedToggle x:Name="ModeToggle" AutomationProperties.Name="Mostrar cadastros ou agenda da UBS" SelectionChanged="OnModeChanged" />
      </views:PageActions>
    </StackPanel>
    <Grid Grid.Row="1">
      <!-- Cadastros de referência da UBS escolhida -->
      <ListBox x:Name="RegistryList" Style="{StaticResource OpenList}" ItemsSource="{Binding UnitRegistry}" AutomationProperties.Name="Pacientes da UBS selecionada"
               views:ListingBehavior.Balloon="{Binding ElementName=RegistryBalloon}" views:ListingBehavior.LabelPath="FullName" views:ListingBehavior.KeyPath="Cpf" views:ListingBehavior.PluralName="cadastros">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid AutomationProperties.Name="{Binding FullName}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding FullName}" Style="{StaticResource ItemTitleText}" />
                <TextBlock Style="{StaticResource ItemMetaText}">
                  <TextBlock.Text><MultiBinding Converter="{StaticResource MetaJoin}"><Binding Path="FormattedCpf" /><Binding Path="Email" /><Binding Path="Phone" /></MultiBinding></TextBlock.Text>
                </TextBlock>
              </StackPanel>
              <views:StatusTag Grid.Column="1" Text="{Binding IsActive, Converter={StaticResource InactiveTag}}" Tone="Pink" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <views:ListEmptyText x:Name="RegistryEmpty" List="{Binding ElementName=RegistryList}" EmptyText="{Binding UnitRegistryState}" NoMatchText="Nenhum cadastro encontrado para esta busca." Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="4,8" />
      <views:SelectionBalloon x:Name="RegistryBalloon">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconEyeGeometry}" views:SelectionBalloon.SingleItemOnly="True" Content="Ver ficha" Click="OnViewRegistry" ToolTip="Abre a ficha do cadastro." />
        </StackPanel>
      </views:SelectionBalloon>
      <!-- Agenda da UBS escolhida -->
      <ListBox x:Name="AgendaList" Style="{StaticResource OpenList}" ItemsSource="{Binding VisibleMunicipalAppointments}" AutomationProperties.Name="Consultas da UBS selecionada" Visibility="Collapsed"
               views:ListingBehavior.Balloon="{Binding ElementName=AgendaBalloon}" views:ListingBehavior.LabelPath="PatientName" views:ListingBehavior.PluralName="consultas" views:ListingBehavior.Feminine="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid AutomationProperties.Name="{Binding PatientName}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding PatientName}" Style="{StaticResource ItemTitleText}" />
                <TextBlock Style="{StaticResource ItemMetaText}">
                  <TextBlock.Text><MultiBinding Converter="{StaticResource MetaJoin}"><Binding Path="TimeDisplay" /><Binding Path="Specialty" /><Binding Path="Professional" /></MultiBinding></TextBlock.Text>
                </TextBlock>
              </StackPanel>
              <views:StatusTag Grid.Column="1" Text="{Binding StatusDisplay}" Tone="{Binding Status, Converter={StaticResource AppointmentTone}}" Margin="12,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <views:ListEmptyText x:Name="AgendaEmpty" List="{Binding ElementName=AgendaList}" EmptyText="{Binding MunicipalAppointmentsState}" NoMatchText="Nenhuma consulta encontrada para esta busca." Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="4,8" />
      <views:SelectionBalloon x:Name="AgendaBalloon">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconEyeGeometry}" views:SelectionBalloon.SingleItemOnly="True" Content="Ver ficha" Click="OnViewAppointment" ToolTip="Abre a ficha da consulta." />
        </StackPanel>
      </views:SelectionBalloon>
    </Grid>
  </Grid>
</UserControl>
