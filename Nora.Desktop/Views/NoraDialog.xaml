<Window x:Class="Nora.Desktop.Views.NoraDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="460" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14" Title="NORA">
  <!-- Diálogo padrão da marca (avisos, confirmações e erros): o fundo escurece na janela dona, o cartão entra com um leve zoom. -->
  <Border x:Name="Frame" Margin="18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24,22,24,20" RenderTransformOrigin="0.5,0.5" Opacity="0" AutomationProperties.Name="{Binding Title}">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22" Color="#061E3B" /></Border.Effect>
    <Border.RenderTransform><ScaleTransform x:Name="Zoom" ScaleX="0.96" ScaleY="0.96" /></Border.RenderTransform>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border x:Name="IconCircle" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top" Margin="0,2,16,0">
        <TextBlock x:Name="IconGlyph" FontFamily="Segoe MDL2 Assets" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" MouseLeftButtonDown="OnDrag" Background="Transparent">
        <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock x:Name="MessageText" FontSize="14" LineHeight="21" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <Button x:Name="SecondaryButton" MinWidth="112" Margin="0,0,10,0" IsCancel="True" Click="OnSecondary" />
        <Button x:Name="PrimaryButton" MinWidth="112" IsDefault="True" Style="{StaticResource ObsPrimaryButton}" Click="OnPrimary" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
