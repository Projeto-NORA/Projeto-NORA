<UserControl x:Class="Nora.Desktop.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Histórico de ações da gestão: listagem aberta só de leitura. Concessões e revogações de UBS, consultas nominais da gestão, ações sobre contas OBS e criação de bases de UBS, das mais recentes para as mais antigas. Não mostra CPF nem e-mail. -->
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <views:PageFilterGroup Label="Histórico de ações" SearchFields="ActionDisplay,ActorDisplay,AccountDisplay,UnitDisplay,OccurredAtDisplay" ItemsTarget="{Binding ElementName=HistoryList}" />
      <views:PageFilterGroup Label="Consulta do histórico" FilterKey="history">
        <StackPanel IsEnabled="{Binding CanOperate}">
          <TextBlock Text="De (dd/mm/aaaa)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding HistoryFromText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Data inicial do histórico" views:EnterNavigation.Group="HistoryView.history" />
          <TextBlock Text="Até (dd/mm/aaaa)" Style="{StaticResource FieldLabelText}" />
          <TextBox Text="{Binding HistoryToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" AutomationProperties.Name="Data final do histórico" views:EnterNavigation.Group="HistoryView.history" />
          <TextBlock Text="UBS" Style="{StaticResource FieldLabelText}" />
          <ComboBox Margin="0,0,0,10" ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding HistoryUnitFilter}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar histórico por UBS" views:EnterNavigation.Group="HistoryView.history" />
          <TextBlock Text="{Binding HistoryRangeError}" Style="{StaticResource FieldError}" Margin="0,0,0,10" Visibility="{Binding HistoryRangeError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
          <Button Content="Consultar histórico" Click="OnQuery" IsEnabled="{Binding CanQueryHistory}" HorizontalAlignment="Left" ToolTip="Busca o histórico com os filtros escolhidos." views:EnterNavigation.Group="HistoryView.history" />
        </StackPanel>
      </views:PageFilterGroup>
    </StackPanel>
    <Grid Grid.Row="1">
      <ListBox x:Name="HistoryList" Style="{StaticResource OpenList}" ItemsSource="{Binding HistoryEvents}" AutomationProperties.Name="Histórico de ações"
               views:ListingBehavior.Balloon="{Binding ElementName=Balloon}" views:ListingBehavior.LabelPath="ActionDisplay" views:ListingBehavior.KeyPath="Cursor" views:ListingBehavior.PluralName="ações" views:ListingBehavior.Feminine="True">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel AutomationProperties.Name="{Binding ActionDisplay}">
              <TextBlock Text="{Binding ActionDisplay}" Style="{StaticResource ItemTitleText}" />
              <TextBlock Text="{Binding MetaLine}" Style="{StaticResource ItemMetaText}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <views:ListEmptyText List="{Binding ElementName=HistoryList}" EmptyText="{Binding HistoryState}" NoMatchText="Nenhuma ação encontrada para esta busca." Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="4,8" />
      <views:SelectionBalloon x:Name="Balloon">
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ListActionButton}" views:ListAction.Icon="{StaticResource IconEyeGeometry}" views:SelectionBalloon.SingleItemOnly="True" Content="Ver ficha" Click="OnView" ToolTip="Abre a ficha da ação." />
        </StackPanel>
      </views:SelectionBalloon>
    </Grid>
    <DockPanel Grid.Row="2" Margin="2,10,0,0" Visibility="{Binding HistoryFooter, Converter={StaticResource TextVisibility}}">
      <Button DockPanel.Dock="Right" Content="Carregar mais" Click="OnMore" Margin="12,0,0,0" Visibility="{Binding CanLoadMoreHistory, Converter={StaticResource BoolVisibility}}" ToolTip="Traz as 100 ações anteriores às que já estão na lista." />
      <TextBlock Text="{Binding HistoryFooter}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </DockPanel>
  </Grid>
</UserControl>
