<UserControl x:Class="Nora.Desktop.Views.HistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Margin="0,0,0,18">
    <StackPanel>
      <TextBlock Text="Histórico de ações" FontSize="19" FontWeight="SemiBold" />
      <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,12" Text="Das mais recentes às mais antigas. Não mostra CPF nem e-mail." />
      <WrapPanel IsEnabled="{Binding CanOperate}">
        <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="De (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding HistoryFromText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data inicial do histórico" /></StackPanel>
        <StackPanel Width="150" Margin="0,0,12,8"><TextBlock Text="Até (dd/mm/aaaa)" FontWeight="SemiBold" FontSize="12" /><TextBox Text="{Binding HistoryToText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="Data final do histórico" /></StackPanel>
        <StackPanel Width="210" Margin="0,0,12,8"><TextBlock Text="UBS" FontWeight="SemiBold" FontSize="12" />
          <ComboBox Margin="0,6,0,0" ItemsSource="{Binding UnitFilterOptions}" DisplayMemberPath="SelectorLabel" SelectedValuePath="Id" SelectedValue="{Binding HistoryUnitFilter}" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Filtrar histórico por UBS" /></StackPanel>
        <Button Content="Consultar histórico" Click="OnQuery" IsEnabled="{Binding CanQueryHistory}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
      </WrapPanel>
      <TextBlock Text="{Binding HistoryRangeError}" Style="{StaticResource FieldError}" Margin="0,0,0,10" Visibility="{Binding HistoryRangeError, Converter={StaticResource TextVisibility}}" AutomationProperties.LiveSetting="Polite" />
      <DataGrid ItemsSource="{Binding HistoryEvents}" MaxHeight="380" MinHeight="64" AutomationProperties.Name="Histórico de ações">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Data e hora" Binding="{Binding OccurredAtDisplay}" SortMemberPath="OccurredAt" Width="165" />
          <DataGridTextColumn Header="Ação" Binding="{Binding ActionDisplay}" Width="*" MinWidth="190" />
          <DataGridTextColumn Header="Quem fez" Binding="{Binding ActorDisplay}" Width="*" MinWidth="130" />
          <DataGridTextColumn Header="Conta" Binding="{Binding AccountDisplay}" Width="*" MinWidth="130" />
          <DataGridTextColumn Header="UBS" Binding="{Binding UnitDisplay}" Width="*" MinWidth="130" />
        </DataGrid.Columns>
      </DataGrid>
      <DockPanel Margin="0,10,0,0">
        <Button DockPanel.Dock="Right" Content="Carregar mais" Click="OnMore" IsEnabled="{Binding CanLoadMoreHistory}" Margin="12,0,0,0" ToolTip="Traz as 100 ações anteriores às que já estão na lista." />
        <TextBlock Text="{Binding HistoryState}" Style="{StaticResource Muted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
    </StackPanel>
  </Border>
</UserControl>
