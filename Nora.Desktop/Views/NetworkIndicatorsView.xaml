<UserControl x:Class="Nora.Desktop.Views.NetworkIndicatorsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <!-- Indicadores da rede (Desempenho). Cabeçalho: pesquisa, Período em linha (com Personalizado), Filtros (UBS, região, especialidade e as datas) e o alternador cards / gráficos. Cards: o resumo do período em cartões coloridos e a tabela por região. Gráficos: a grade de gráficos, sem tabelas. -->
  <UserControl.Resources>
    <Style x:Key="CardsModeOnly" TargetType="StackPanel">
      <Style.Triggers><DataTrigger Binding="{Binding Mode, ElementName=ModeToggle}" Value="Charts"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="ChartsModeOnly" TargetType="views:NetworkChartsView">
      <Setter Property="Visibility" Value="Collapsed" />
      <Style.Triggers><DataTrigger Binding="{Binding Mode, ElementName=ModeToggle}" Value="Charts"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
    </Style>
  </UserControl.Resources>
  <StackPanel>
    <views:PageFilterGroup Label="Indicadores" FilterKey="networkSearch" Inline="True" IsEnabled="{Binding CanFilterNetwork}"><views:NetworkSearchField Label="Indicadores" /></views:PageFilterGroup>
    <views:NetworkFiltersView AllowCustom="True" />
    <views:PageActions><views:ViewModeToggle x:Name="ModeToggle" ScreenKey="indicators" /></views:PageActions>
    <TextBlock x:Name="SearchEmpty" Text="Nenhum resultado para esta busca." Style="{StaticResource Muted}" Margin="0,12,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
    <StackPanel Style="{StaticResource CardsModeOnly}">
      <TextBlock Text="{Binding PeriodSummaryTitle}" Style="{StaticResource SectionTitle}" Margin="0,16,0,10" />
      <ItemsControl x:Name="PeriodCards" ItemsSource="{Binding OverviewCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-8,0" Focusable="False" AutomationProperties.Name="Indicadores do período" />
      <TextBlock Text="{Binding MetricsStateText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Visibility="{Binding MetricsStateText, Converter={StaticResource TextVisibility}}" />
      <views:RegionPerformanceTable x:Name="Regions" Margin="0,22,0,0" />
      <Expander Header="Consultas por dia" Margin="0,16,0,0" AutomationProperties.Name="Tabela das consultas por dia">
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="Um dia por linha, com os mesmos números do gráfico. Dias sem consultas não aparecem; em períodos longos o gráfico agrupa por semana ou mês, mas esta tabela continua por dia." Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
          <DataGrid x:Name="DailyGrid" ItemsSource="{Binding DailyRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True" MaxHeight="280" MinHeight="64" RowHeight="40" AutomationProperties.Name="Consultas por dia">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Data" Binding="{Binding DateDisplay}" SortMemberPath="Date" Width="140" />
              <DataGridTextColumn Header="Concluídas" Binding="{Binding Completed}" Width="*" />
              <DataGridTextColumn Header="Faltas" Binding="{Binding Missed}" Width="*" />
              <DataGridTextColumn Header="Canceladas" Binding="{Binding Cancelled}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Expander>
      <views:ScoreNoteView Margin="0,12,0,0" />
    </StackPanel>
    <views:NetworkChartsView x:Name="Charts" Margin="0,16,0,0" Style="{StaticResource ChartsModeOnly}" />
  </StackPanel>
</UserControl>
