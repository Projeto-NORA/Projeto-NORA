<UserControl x:Class="Nora.Desktop.Views.NetworkIndicatorsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:Nora.Desktop.Views">
  <StackPanel>
    <views:NetworkFiltersView />
    <ItemsControl ItemsSource="{Binding OverviewCards}" ItemTemplate="{StaticResource MetricCardTemplate}" ItemsPanel="{StaticResource ThreeColumnPanel}" Margin="-6,0,-6,6" AutomationProperties.Name="Indicadores do período" />
    <TextBlock Text="{Binding MetricsStateText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" Visibility="{Binding MetricsStateText, Converter={StaticResource TextVisibility}}" />
    <views:ScoreNoteView />
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Comparativo por região" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="Regiões agrupadas sem diferenciar maiúsculas. A barra acompanha o comparecimento; o valor escrito ao lado é a informação." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" />
        <DataGrid ItemsSource="{Binding RegionPerformance}" CanUserSortColumns="True" MaxHeight="340" MinHeight="64" AutomationProperties.Name="Comparativo por região">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Região" Binding="{Binding Name}" Width="*" MinWidth="130" />
            <DataGridTemplateColumn Header="Comparecimento" SortMemberPath="ScoreSort" Width="210">
              <DataGridTemplateColumn.CellTemplate><DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Border Width="100" Height="10" CornerRadius="5" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <Border HorizontalAlignment="Left" Width="{Binding ScoreBar}" CornerRadius="4" Background="{DynamicResource SuccessBrush}" />
                  </Border>
                  <TextBlock Text="{Binding ScoreDisplay}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Concluídas" Binding="{Binding Completed}" Width="100" />
            <DataGridTextColumn Header="Faltas" Binding="{Binding Missed}" Width="80" />
            <DataGridTextColumn Header="Cancelamentos" Binding="{Binding Cancelled}" Width="125" />
            <DataGridTextColumn Header="Na fila" Binding="{Binding ActiveEntries}" Width="80" />
            <DataGridTextColumn Header="Espera média" Binding="{Binding WaitDisplay}" SortMemberPath="WaitSort" Width="125" />
          </DataGrid.Columns>
        </DataGrid>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Card}" Margin="0,0,0,18">
      <StackPanel>
        <TextBlock Text="Série no tempo" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="Consultas por dia, pela data marcada, com os filtros acima." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,12" />
        <views:EvolutionChartView />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
