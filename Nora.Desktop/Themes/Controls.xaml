  <!-- As duas linhas do item da listagem: o título em destaque e a linha de dados (montada no ViewModel, só com o que foi informado). -->
  <Style x:Key="ItemTitleText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="ItemMetaText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="TextWrapping" Value="NoWrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- Item da listagem aberta: cartão arredondado solto na tela (canto 8, 12,8, espaço de 4). A moldura de seleção é uma segunda borda por cima, para a seleção (1,6 px) não empurrar o conteúdo. -->
  <Style x:Key="OpenListItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Grid>
        <Border x:Name="Frame" Background="{DynamicResource ListItemBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
        <Border x:Name="Ring" CornerRadius="8" BorderThickness="1.6" BorderBrush="Transparent" IsHitTestVisible="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ListItemAlternateBrush}" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ListItemHoverBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ListItemFocusBrush}" /><Setter TargetName="Ring" Property="BorderThickness" Value="1.4" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ListItemSelectedBrush}" /><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ListItemSelectedBorderBrush}" /><Setter TargetName="Ring" Property="BorderThickness" Value="1.6" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Variante baixa, para listas com muitos itens (11,6 e espaço de 3). -->
  <Style x:Key="OpenListItemLow" TargetType="ListBoxItem" BasedOn="{StaticResource OpenListItem}">
    <Setter Property="Padding" Value="11,6" /><Setter Property="Margin" Value="0,0,0,3" />
  </Style>
  <!-- Listagem aberta: sem borda nem fundo, seleção do Windows Explorer (SelectionMode Extended: clique, setas, Ctrl, Shift), rolagem por pixel e virtualização ligada. A seleção NÃO é reimplementada: o balão e o segundo clique vêm do ListingBehavior. -->
  <Style x:Key="OpenList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="AlternationCount" Value="2" />
    <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource OpenListItem}" />
  </Style>
  <Style x:Key="OpenListLow" TargetType="ListBox" BasedOn="{StaticResource OpenList}">
    <Setter Property="ItemContainerStyle" Value="{StaticResource OpenListItemLow}" />
  </Style>
  <!-- Botões de ação do balão: 38 px de altura, canto 6, ícone desenhado (ListAction.Icon) e rótulo curto ao lado (o Content). Sem rótulo, o botão é só o ícone. -->
  <Style x:Key="ListActionButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource ListActionBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListActionBorderBrush}" />
    <Setter Property="BorderThickness" Value="1.4" />
    <Setter Property="Height" Value="38" /><Setter Property="MinWidth" Value="38" />
    <Setter Property="Padding" Value="10,0,12,0" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
          <Path x:Name="Glyph" Data="{Binding (views:ListAction.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="18" Height="18" Stretch="None" VerticalAlignment="Center" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <ContentPresenter x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="views:ListAction.Icon" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" /><Setter TargetName="Label" Property="Margin" Value="0" /></Trigger>
        <Trigger Property="HasContent" Value="False"><Setter TargetName="Label" Property="Margin" Value="0" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ListActionHoverBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ListActionEditButton" TargetType="Button" BasedOn="{StaticResource ListActionButton}">
    <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" />
    <Setter Property="Background" Value="{DynamicResource ListActionEditBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListActionEditBrush}" />
    <Setter Property="views:ListAction.Icon" Value="{StaticResource IconEditGeometry}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
          <Path x:Name="Glyph" Data="{Binding (views:ListAction.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="18" Height="18" Stretch="None" VerticalAlignment="Center" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <ContentPresenter x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="views:ListAction.Icon" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" /><Setter TargetName="Label" Property="Margin" Value="0" /></Trigger>
        <Trigger Property="HasContent" Value="False"><Setter TargetName="Label" Property="Margin" Value="0" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ListActionEditHoverBrush}" /><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ListActionEditHoverBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BrandTextBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Perigo: lixeira BRANCA em fundo VERMELHO. É o único jeito de remover, desativar, revogar, encerrar ou cancelar a partir de uma listagem (e sempre com confirmação). -->
  <Style x:Key="ListActionDangerButton" TargetType="Button" BasedOn="{StaticResource ListActionEditButton}">
    <Setter Property="Background" Value="{DynamicResource ListActionDangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ListActionDangerBrush}" />
    <Setter Property="views:ListAction.Icon" Value="{StaticResource IconTrashGeometry}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
          <Path x:Name="Glyph" Data="{Binding (views:ListAction.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="18" Height="18" Stretch="None" VerticalAlignment="Center" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <ContentPresenter x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="views:ListAction.Icon" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" /><Setter TargetName="Label" Property="Margin" Value="0" /></Trigger>
        <Trigger Property="HasContent" Value="False"><Setter TargetName="Label" Property="Margin" Value="0" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ListActionDangerHoverBrush}" /><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ListActionDangerHoverBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BrandTextBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- O X do balão: 30x30, sem peso visual. -->
  <Style x:Key="SelectionBalloonCloseButton" TargetType="Button">
    <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1.4" CornerRadius="6">
        <Path Data="{StaticResource IconCloseGeometry}" Width="18" Height="18" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ListActionHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- O balão de ações: canto 12, 18,10, a 26 da base, sombra 20/6/0,22 e fundo tingido de azul. Flutua sobre a lista (mesma célula, embaixo) e NUNCA reserva espaço nela. Esconde-se sozinho: o ListingBehavior mostra e esconde. -->
  <Style TargetType="views:SelectionBalloon">
    <Setter Property="Visibility" Value="Collapsed" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,0,26" />
    <Setter Property="Panel.ZIndex" Value="15" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="views:SelectionBalloon">
      <Border x:Name="Balloon" Background="{DynamicResource SelectionBalloonBrush}" BorderBrush="{DynamicResource SelectionBalloonBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,10" SnapsToDevicePixels="True">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.22" Color="Black" /></Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" MaxWidth="320" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{TemplateBinding Label}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="ComplementText" Text="{TemplateBinding Complement}" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center" MaxWidth="280" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="{Binding Complement, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TextVisibility}}" />
          <Border x:Name="LeadingDivider" Width="1" Margin="14,3" Background="{DynamicResource SelectionBalloonBorderBrush}" />
          <ContentPresenter x:Name="ActionsHost" VerticalAlignment="Center" />
          <Border x:Name="TrailingDivider" Width="1" Margin="14,3" Background="{DynamicResource SelectionBalloonBorderBrush}" />
          <Button x:Name="PART_Close" Style="{StaticResource SelectionBalloonCloseButton}" ToolTip="Cancelar seleção (Esc)" AutomationProperties.Name="Cancelar seleção" />
        </StackPanel>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="HasActions" Value="False"><Setter TargetName="LeadingDivider" Property="Visibility" Value="Collapsed" /><Setter TargetName="ActionsHost" Property="Visibility" Value="Collapsed" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Botão "+ Novo ..." (primário, com o mais desenhado). O Content é só o texto ("Novo profissional"). -->
  <Style x:Key="NewItemButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="MinHeight" Value="40" /><Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Bold" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Data="{StaticResource IconPlusGeometry}" Width="18" Height="18" Stretch="None" VerticalAlignment="Center" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Aviso destacado em amarelo (ex.: "Horário ainda não informado"). O Content é o texto. -->
  <Style x:Key="NoticeItem" TargetType="ContentControl">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
      <Border Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Path Data="{StaticResource IconWarningGeometry}" Width="18" Height="18" Stretch="None" VerticalAlignment="Center" Margin="0,0,12,0" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
        </Grid>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Etiqueta de situação: arredondada, no tom do tema (Tone). Sem texto, some. -->
  <Style TargetType="views:StatusTag">
    <Setter Property="Focusable" Value="False" /><Setter Property="IsTabStop" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="views:StatusTag">
      <Border x:Name="Frame" Background="{DynamicResource ToneNeutralSurfaceBrush}" CornerRadius="10" Padding="10,3">
        <TextBlock x:Name="Label" Text="{TemplateBinding Text}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ToneNeutralTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Tone" Value="Blue"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ToneBlueSurfaceBrush}" /><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ToneBlueTextBrush}" /></Trigger>
        <Trigger Property="Tone" Value="Green"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ToneGreenSurfaceBrush}" /><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ToneGreenTextBrush}" /></Trigger>
        <Trigger Property="Tone" Value="Yellow"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ToneYellowSurfaceBrush}" /><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ToneYellowTextBrush}" /></Trigger>
        <Trigger Property="Tone" Value="Pink"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource TonePinkSurfaceBrush}" /><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TonePinkTextBrush}" /></Trigger>
        <Trigger Property="Tone" Value="Violet"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ToneVioletSurfaceBrush}" /><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ToneVioletTextBrush}" /></Trigger>
        <Trigger Property="Tone" Value="Teal"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ToneTealSurfaceBrush}" /><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource ToneTealTextBrush}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
    </Style.Triggers>
  </Style>
  <!-- ===== Alternadores, gráficos e pop-ups (26/11/2026) ===== -->
  <!-- Ícones desenhados (18x18) do alternador cards / gráficos. -->
  <Geometry x:Key="IconCardsGeometry">M 3.4,3.4 L 7.8,3.4 L 7.8,7.8 L 3.4,7.8 Z M 10.2,3.4 L 14.6,3.4 L 14.6,7.8 L 10.2,7.8 Z M 3.4,10.2 L 7.8,10.2 L 7.8,14.6 L 3.4,14.6 Z M 10.2,10.2 L 14.6,10.2 L 14.6,14.6 L 10.2,14.6 Z</Geometry>
  <Geometry x:Key="IconChartGeometry">M 2.8,2.8 L 2.8,15.2 L 15.2,15.2 M 5.6,11.6 L 8.6,8 L 11,10.2 L 15,4.6</Geometry>
  <Geometry x:Key="IconCopyGeometry">M 6.4,6.4 L 14.6,6.4 L 14.6,14.6 L 6.4,14.6 Z M 11.6,6.4 L 11.6,3.4 L 3.4,3.4 L 3.4,11.6 L 6.4,11.6</Geometry>
  <!-- Um segmento do alternador: o selecionado vira uma pílula branca com contorno da marca e texto em destaque (nunca só a cor); o hover é azul bebê. -->
  <Style x:Key="SegmentedToggleItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.FontWeight="{TemplateBinding FontWeight}" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ButtonHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></MultiTrigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsKeyboardFocused" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Frame" Property="Background" Value="{DynamicResource BrandSoftBrush}" /></MultiTrigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="views:SegmentedToggle">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource SegmentedToggleItem}" />
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="views:SegmentedToggle">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
        <ItemsPresenter />
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Botão do cabeçalho que alterna cards e gráficos: mostra o ícone do modo em que a tela está. -->
  <Style TargetType="views:ViewModeToggle">
    <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="views:ViewModeToggle">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Path x:Name="Icon" Data="{StaticResource IconCardsGeometry}" Width="18" Height="18" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="Mode" Value="Charts"><Setter TargetName="Icon" Property="Data" Value="{StaticResource IconChartGeometry}" /></Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource BrandSoftBrush}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource BrandBrush}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
