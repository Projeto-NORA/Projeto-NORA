<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="InfoBrush" Color="#135EA8" />
  <SolidColorBrush x:Key="WarningBrush" Color="#8A5A00" />
  <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF2C7" />
  <SolidColorBrush x:Key="BrandTextBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="BackgroundBrush" Color="#F4F7FB" />
  <SolidColorBrush x:Key="SuccessBrush" Color="#137A52" />
  <SolidColorBrush x:Key="BrandBrush" Color="#063B7A" />
  <!-- Números e destaques em texto sobre as superfícies: contraste de pelo menos 4,5:1 nos dois temas. -->
  <SolidColorBrush x:Key="AccentTextBrush" Color="#063B7A" />
  <SolidColorBrush x:Key="BorderBrush" Color="#D5E0EC" />
  <SolidColorBrush x:Key="TextBrush" Color="#102A43" />
  <SolidColorBrush x:Key="BrandSoftBrush" Color="#E6F0FA" />
  <SolidColorBrush x:Key="SecondaryBrush" Color="#38546E" />
  <!-- Hover de todo botão (e de itens de menu): azul bebê. -->
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="#D1E7FF" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#B4233E" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EDF3F9" />
  <SolidColorBrush x:Key="PatientAlternateBrush" Color="#F6F9FC" />
  <SolidColorBrush x:Key="TooltipBrush" Color="#E5F1FF" />
  <SolidColorBrush x:Key="TooltipTextBrush" Color="#34445A" />
  <SolidColorBrush x:Key="TooltipBorderBrush" Color="#B6D1EB" />
  <LinearGradientBrush x:Key="BackgroundGradientBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F8FBFF" Offset="0" /><GradientStop Color="#EEF5FC" Offset="0.52" /><GradientStop Color="#E6F0FA" Offset="1" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#EEF6FF" Offset="1" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#052F65" Offset="0" /><GradientStop Color="#0759A3" Offset="0.56" /><GradientStop Color="#0A70B0" Offset="1" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="BrandGradientHoverBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#064889" Offset="0" /><GradientStop Color="#0B6FAE" Offset="0.58" /><GradientStop Color="#0E78B3" Offset="1" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#F7FBFF" Offset="1" /></LinearGradientBrush>
  <!-- Marca: o "N" marinho no tema claro (troca com o tema, inclusive no modo Sistema). -->
  <BitmapImage x:Key="BrandMarkImage" UriSource="pack://application:,,,/Nora.Desktop;component/Assets/nora_n_navy.png" DecodePixelWidth="128" />
  <SolidColorBrush x:Key="OverlayBrush" Color="#590A1A2E" />
  <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#E3F4EC" />
  <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#FBE7EB" />
  <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#E3EEFA" />
  <SolidColorBrush x:Key="HoverBrush" Color="#DCEBFE" />
  <!-- Barra de título própria: mesma superfície da barra lateral (cor do topo do degradê), para as duas lerem como uma peça só. -->
  <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="TitleBarCloseHoverBrush" Color="#E3262E" />
  <SolidColorBrush x:Key="DividerBrush" Color="#E4EBF3" />
  <SolidColorBrush x:Key="ChartBrush1" Color="#3B82F6" />
  <SolidColorBrush x:Key="ChartBrush2" Color="#12A175" />
  <SolidColorBrush x:Key="ChartBrush3" Color="#EBAA00" />
  <SolidColorBrush x:Key="ChartBrush4" Color="#E5486B" />
  <SolidColorBrush x:Key="ChartBrush5" Color="#8B5CF6" />
  <SolidColorBrush x:Key="ChartBrush6" Color="#27AEEB" />
  <!-- ===== Listagens abertas, balão de ações, botões de ação, tons e situações (26/11/2026) ===== -->
  <!-- Item da listagem solta: fundo, faixa alternada, passar o cursor, selecionado (borda de destaque) e foco de teclado. -->
  <SolidColorBrush x:Key="ListItemBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ListItemAlternateBrush" Color="#F1F6FC" />
  <SolidColorBrush x:Key="ListItemHoverBrush" Color="#E3EFFE" />
  <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#DCE9FD" />
  <SolidColorBrush x:Key="ListItemSelectedBorderBrush" Color="#3B82C4" />
  <SolidColorBrush x:Key="ListItemFocusBrush" Color="#5B9BD5" />
  <!-- Balão de ações: um degrau azul acima da lista, para nunca se confundir com as linhas. -->
  <SolidColorBrush x:Key="SelectionBalloonBrush" Color="#DCEBFF" />
  <SolidColorBrush x:Key="SelectionBalloonBorderBrush" Color="#8FB8E6" />
  <!-- Botões de ação do balão: neutro, editar e perigo (lixeira branca em fundo vermelho), cada um com o seu hover. -->
  <SolidColorBrush x:Key="ListActionBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ListActionBorderBrush" Color="#8FA9C4" />
  <SolidColorBrush x:Key="ListActionHoverBrush" Color="#D1E7FF" />
  <SolidColorBrush x:Key="ListActionEditBrush" Color="#1F6FBF" />
  <SolidColorBrush x:Key="ListActionEditHoverBrush" Color="#185AA0" />
  <SolidColorBrush x:Key="ListActionDangerBrush" Color="#C02626" />
  <SolidColorBrush x:Key="ListActionDangerHoverBrush" Color="#A11D1D" />
  <!-- Tons dos cartões e das etiquetas de situação: fundo suave + cor do texto (contraste de pelo menos 4,5:1 entre os dois). -->
  <SolidColorBrush x:Key="ToneBlueSurfaceBrush" Color="#E1EEFF" />
  <SolidColorBrush x:Key="ToneBlueTextBrush" Color="#0F4C9A" />
  <SolidColorBrush x:Key="ToneGreenSurfaceBrush" Color="#DCF4E5" />
  <SolidColorBrush x:Key="ToneGreenTextBrush" Color="#0E6B47" />
  <SolidColorBrush x:Key="ToneYellowSurfaceBrush" Color="#FFF2C6" />
  <SolidColorBrush x:Key="ToneYellowTextBrush" Color="#7A5200" />
  <SolidColorBrush x:Key="TonePinkSurfaceBrush" Color="#FFE0E5" />
  <SolidColorBrush x:Key="TonePinkTextBrush" Color="#A3213A" />
  <SolidColorBrush x:Key="ToneVioletSurfaceBrush" Color="#EBE2FF" />
  <SolidColorBrush x:Key="ToneVioletTextBrush" Color="#5B3AB0" />
  <SolidColorBrush x:Key="ToneTealSurfaceBrush" Color="#D7F3F6" />
  <SolidColorBrush x:Key="ToneTealTextBrush" Color="#0B6674" />
  <SolidColorBrush x:Key="ToneNeutralSurfaceBrush" Color="#EDF3F9" />
  <SolidColorBrush x:Key="ToneNeutralTextBrush" Color="#38546E" />
  <!-- Situação da consulta em cor viva (bolinha do calendário, legenda e gráficos). A etiqueta e o fundo usam os tons: Agendada azul, Chamada violeta, Concluída verde, Falta rosa, Cancelada amarelo. -->
  <SolidColorBrush x:Key="StatusScheduledBrush" Color="#3B82F6" />
  <SolidColorBrush x:Key="StatusCalledBrush" Color="#8B5CF6" />
  <SolidColorBrush x:Key="StatusCompletedBrush" Color="#12A175" />
  <SolidColorBrush x:Key="StatusMissedBrush" Color="#E5486B" />
  <SolidColorBrush x:Key="StatusCancelledBrush" Color="#EBAA00" />
</ResourceDictionary>
